@{
    ViewData["Title"] = "Bảng Điều Khiển Quản Trị Hệ Thống";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title { font-family: 'Playfair Display', serif; font-size: 36px; font-weight: 700; color: #805528; margin-bottom: 4px; }
        .page-subtitle { font-family: 'Inter', sans-serif; color: #50453b; font-size: 16px; margin-bottom: 32px; }
        
        /* KPI Cards */
        .kpi-card { background: #ffffff; border-radius: 16px; padding: 24px; box-shadow: 0 12px 24px -8px rgba(30, 41, 59, 0.05); border: 1px solid rgba(212, 195, 182, 0.3); font-family: 'Inter', sans-serif; height: 100%; display: flex; align-items: center; transition: all 0.3s ease; }
        .kpi-card:hover { transform: translateY(-4px); box-shadow: 0 20px 32px -8px rgba(30, 41, 59, 0.1); }
        .kpi-icon-wrapper { width: 56px; height: 56px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 20px; flex-shrink: 0; }
        .kpi-icon-wrapper.primary { background-color: #f6f3ef; color: #805528; }
        .kpi-icon-wrapper.success { background-color: #e2f5ea; color: #0b5c2d; }
        .kpi-icon-wrapper.info { background-color: #d3e4fe; color: #0b1c30; }
        .kpi-icon-wrapper.danger { background-color: #ffdad6; color: #ba1a1a; }
        .kpi-details h3 { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: #1c1c1a; margin-bottom: 4px; }
        .kpi-details p { color: #50453b; font-size: 14px; font-weight: 500; margin-bottom: 0; }
        
        /* Section styling */
        .section-header { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: #805528; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
        
        /* Quick actions */
        .action-card { background: #ffffff; border-radius: 16px; padding: 24px; box-shadow: 0 12px 24px -8px rgba(30, 41, 59, 0.05); border: 1px solid rgba(212, 195, 182, 0.3); font-family: 'Inter', sans-serif; margin-bottom: 30px; }
        .btn-luxury { background-color: #dfa974; color: #633d11; font-family: 'Inter', sans-serif; font-weight: 600; border-radius: 8px; padding: 12px 20px; border: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.3s ease; text-decoration: none; width: 100%; cursor: pointer; }
        .btn-luxury:hover { background-color: #805528; color: #ffffff; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2); text-decoration: none; }
        .btn-outline-luxury { background-color: transparent; color: #805528; border: 1.5px solid #dfa974; font-family: 'Inter', sans-serif; font-weight: 600; border-radius: 8px; padding: 12px 20px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.3s ease; text-decoration: none; width: 100%; }
        .btn-outline-luxury:hover { background-color: #f6f3ef; color: #633d11; text-decoration: none; }
        .btn-disabled { background-color: #f0ede9; color: #a4b5ce; border: none; cursor: not-allowed; }
        .btn-disabled:hover { background-color: #f0ede9; color: #a4b5ce; transform: none; box-shadow: none; }
        
        /* Table */
        .table-luxury { background: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08); border: 1px solid rgba(212, 195, 182, 0.3); font-family: 'Inter', sans-serif; margin-bottom: 24px; }
        .table-luxury table { width: 100%; border-collapse: collapse; margin-bottom: 0; }
        .table-luxury th { background-color: #fcf9f5; color: #805528; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; padding: 16px 24px; border-bottom: 2px solid rgba(212, 195, 182, 0.3); text-align: left; }
        .table-luxury td { padding: 16px 24px; border-bottom: 1px solid #f0ede9; color: #1c1c1a; font-size: 15px; vertical-align: middle; }
        .table-luxury tbody tr:hover { background-color: #faf8f5; }
        .table-luxury tbody tr:last-child td { border-bottom: none; }
        
        .status-badge { display: inline-flex; align-items: center; padding: 6px 12px; border-radius: 20px; font-size: 13px; font-weight: 600; }
        .status-badge.verified { background-color: #e2f5ea; color: #0b5c2d; }
        .status-badge.unverified { background-color: #fff8e6; color: #946c00; }
        .status-badge.blocked { background-color: #ffdad6; color: #ba1a1a; margin-top: 4px; }
        .role-badge { display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 13px; font-weight: 500; background-color: #f0ede9; color: #50453b; }
        
        .material-symbols-outlined { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; font-size: 24px; }
    </style>
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h2 class="page-title">Quản Trị Hệ Thống</h2>
        <p class="page-subtitle">Giám sát tài khoản nhân viên và thiết lập bảo mật</p>
    </div>
    <div class="page-subtitle" style="margin-bottom: 8px;">
        <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle; margin-right: 4px;">calendar_today</span>
        @DateTime.Now.ToString("dd MMMM, yyyy")
    </div>
</div>

<!-- KPI Cards -->
<div class="row mb-5">
    <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
        <div class="kpi-card">
            <div class="kpi-icon-wrapper primary">
                <span class="material-symbols-outlined">group</span>
            </div>
            <div class="kpi-details">
                <h3>@ViewBag.TotalStaff</h3>
                <p>Tổng Nhân Viên</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
        <div class="kpi-card">
            <div class="kpi-icon-wrapper success">
                <span class="material-symbols-outlined">verified_user</span>
            </div>
            <div class="kpi-details">
                <h3>@ViewBag.ActiveAccounts</h3>
                <p>Đang Hoạt Động</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
        <div class="kpi-card">
            <div class="kpi-icon-wrapper info">
                <span class="material-symbols-outlined">shield_person</span>
            </div>
            <div class="kpi-details">
                <h3>@ViewBag.SystemRoles</h3>
                <p>Nhóm Quyền</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
        <div class="kpi-card">
            <div class="kpi-icon-wrapper danger">
                <span class="material-symbols-outlined">block</span>
            </div>
            <div class="kpi-details">
                <h3>@ViewBag.InactiveAccounts</h3>
                <p>Bị Khóa / Chờ Duyệt</p>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="action-card">
    <h5 class="section-header">
        <span class="material-symbols-outlined">bolt</span> Thao tác nhanh
    </h5>
    <div class="row">
        <div class="col-md-3 mb-3 mb-md-0">
            <a asp-controller="StaffAccounts" asp-action="Create" class="btn-luxury">
                <span class="material-symbols-outlined" style="font-size: 20px;">person_add</span> Tạo Tài Khoản
            </a>
        </div>
        <div class="col-md-3 mb-3 mb-md-0">
            <a asp-controller="StaffAccounts" asp-action="Index" class="btn-outline-luxury">
                <span class="material-symbols-outlined" style="font-size: 20px;">list_alt</span> Quản Lý Tài Khoản
            </a>
        </div>
        <div class="col-md-3 mb-3 mb-md-0">
            <a asp-controller="DatabaseBackups" asp-action="Index" class="btn-luxury">
                <span class="material-symbols-outlined" style="font-size: 20px;">backup</span> Sao Lưu Dữ Liệu
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="DatabaseBackups" asp-action="Index" class="btn-luxury">
                <span class="material-symbols-outlined" style="font-size: 20px;">restore</span> Khôi Phục Hệ Thống
            </a>
        </div>
    </div>
</div>

<!-- Recent Staff Registrations Table -->
<div class="row">
    <div class="col-lg-12">
        <h5 class="section-header">
            <span class="material-symbols-outlined">history</span> Tài Khoản Vừa Tạo
        </h5>
        
        <div class="table-luxury">
            <table>
                <thead>
                    <tr>
                        <th>Họ và Tên</th>
                        <th>Email</th>
                        <th>Số Điện Thoại</th>
                        <th>Vai Trò (Role)</th>
                        <th>Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.RecentStaff != null)
                    {
                        foreach (var user in ViewBag.RecentStaff as IEnumerable<PhucNguyenResort.Models.User>)
                        {
                            <tr>
                                <td style="font-weight: 600;">@user.FullName</td>
                                <td style="color: #50453b;">@user.Email</td>
                                <td style="color: #50453b;">@(user.PhoneNumber ?? "Chưa có")</td>
                                <td>
                                    <span class="role-badge">@user.Role?.RoleName</span>
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column; align-items: flex-start;">
                                        @if (user.IsActive)
                                        {
                                            <span class="status-badge verified">Verified</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge unverified">Unverified</span>
                                        }
                                        
                                        @if (user.IsBlocked)
                                        {
                                            <span class="status-badge blocked">Blocked</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; color: #a4b5ce; padding: 32px;">
                                Chưa có tài khoản nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
