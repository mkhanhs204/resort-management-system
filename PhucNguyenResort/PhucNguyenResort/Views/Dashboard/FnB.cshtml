@{
    ViewData["Title"] = "F&B Staff Dashboard";
    Layout = "_DashboardLayout";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center" style="border-bottom: 2px solid #eee; padding-bottom: 15px;">
            <div>
                <h2 style="font-family: 'Lora', serif; font-weight: bold; color: #1a1a1a; margin-bottom: 5px;">
                    <i class="fa fa-cutlery mr-2" style="color: #007bff;"></i> F&B Staff — Restaurant & Room Service
                </h2>
                <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Manage KOT orders, table reservations, and charge meals to guest rooms.</p>
            </div>
            <div class="text-muted" style="font-family: 'Cabin', sans-serif; font-size: 14px;">
                <i class="fa fa-calendar mr-2"></i> @DateTime.Now.ToString("dd MMMM, yyyy")
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row mb-4">
    <div class="col-lg-4 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #007bff;">
            <h4 style="color: #007bff;"><i class="fa fa-table"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Total Restaurant Tables</p>
        </div>
    </div>
    <div class="col-lg-4 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #28a745;">
            <h4 style="color: #28a745;"><i class="fa fa-check-square-o"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Available Tables</p>
        </div>
    </div>
    <div class="col-lg-4 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #dc3545;">
            <h4 style="color: #dc3545;"><i class="fa fa-users"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Occupied Tables</p>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mb-4">
    <div class="col-lg-12">
        <div class="card-box" style="border-left: 5px solid #007bff;">
            <h5 style="font-family: 'Lora', serif; font-weight: bold; margin-bottom: 15px;">
                <i class="fa fa-bolt mr-2" style="color: #007bff;"></i> Quick Actions
            </h5>
            <div class="row">
                <div class="col-md-4 mb-2">
                    <a asp-controller="Dashboard" asp-action="FoodOrders" class="btn btn-outline-primary btn-block" style="font-family: 'Cabin', sans-serif;">
                        <i class="fa fa-list mr-2"></i> Manage Food Orders
                    </a>
                </div>
                <div class="col-md-4 mb-2">
                    <button class="btn btn-outline-primary btn-block" style="font-family: 'Cabin', sans-serif;" disabled>
                        <i class="fa fa-calendar-plus-o mr-2"></i> Manage Table Reservations
                    </button>
                </div>
                <div class="col-md-4 mb-2">
                    <button class="btn btn-outline-primary btn-block" style="font-family: 'Cabin', sans-serif;" disabled>
                        <i class="fa fa-credit-card mr-2"></i> Charge to Room
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Today's Table Reservations (Placeholder) -->
<div class="row">
    <div class="col-lg-12">
        <div class="card-box">
            <h5 style="font-family: 'Lora', serif; font-weight: bold; margin-bottom: 20px;">
                <i class="fa fa-clock-o mr-2" style="color: #007bff;"></i> Today's Table Reservations
            </h5>
            <div class="table-responsive">
                <table class="table table-hover" style="font-family: 'Cabin', sans-serif;">
                    <thead>
                        <tr class="bg-light">
                            <th>Table No.</th>
                            <th>Guest Name</th>
                            <th>Time</th>
                            <th>Party Size</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fa fa-info-circle mr-2"></i> Reservation data will be loaded when backend is connected.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


