@model PhucNguyenResort.ViewModels.Dashboard.ReceptionistDashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển Lễ tân";
    Layout = "_DashboardLayout";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center" style="border-bottom: 2px solid #eee; padding-bottom: 15px;">
            <div>
                <h2 style="font-family: 'Lora', serif; font-weight: bold; color: #1a1a1a; margin-bottom: 5px;">
                    <i class="fa fa-calendar-check-o mr-2" style="color: #dfa974;"></i> Bảng điều khiển Lễ tân
                </h2>
                <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Quản lý đặt phòng, nhận/trả phòng, cập nhật trạng thái phòng.</p>
            </div>
            <div class="text-muted" style="font-family: 'Cabin', sans-serif; font-size: 14px;">
                <i class="fa fa-calendar mr-2"></i> @DateTime.Now.ToString("dd MMMM, yyyy")
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #dfa974;">
            <h4 style="color: #dfa974;"><i class="fa fa-sign-in"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">@Model.TodaysArrivals</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Khách đến hôm nay</p>
            <small class="text-muted">Dự kiến nhận phòng</small>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #007bff;">
            <h4 style="color: #007bff;"><i class="fa fa-bed"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">@Model.ActiveStayGuests</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Khách đang lưu trú</p>
            <small class="text-muted">Đã nhận phòng</small>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #dc3545;">
            <h4 style="color: #dc3545;"><i class="fa fa-sign-out"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">@Model.TodaysDepartures</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Khách đi hôm nay</p>
            <small class="text-muted">Dự kiến trả phòng</small>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #28a745;">
            <h4 style="color: #28a745;"><i class="fa fa-check-circle"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">@Model.AvailableRooms</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Phòng trống</p>
            <small class="text-muted">Sẵn sàng phục vụ</small>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mb-4">
    <div class="col-lg-12">
        <div class="card-box" style="border-left: 5px solid #dfa974;">
            <h5 style="font-family: 'Lora', serif; font-weight: bold; margin-bottom: 15px;">
                <i class="fa fa-bolt mr-2" style="color: #dfa974;"></i> Thao tác nhanh
            </h5>
            <div class="row">
                <div class="col-md-3 mb-2">
                    <a asp-controller="Home" asp-action="SearchRooms" class="btn btn-outline-dark btn-block" style="font-family: 'Cabin', sans-serif;">
                        <i class="fa fa-plus mr-2"></i> Đặt phòng trực tiếp
                    </a>
                </div>
                <div class="col-md-3 mb-2">
                    <a asp-controller="Bookings" asp-action="Index" class="btn btn-outline-dark btn-block" style="font-family: 'Cabin', sans-serif;">
                        <i class="fa fa-list mr-2"></i> Tất cả đặt phòng
                    </a>
                </div>
                <div class="col-md-3 mb-2">
                    <a asp-controller="Rooms" asp-action="Index" class="btn btn-outline-dark btn-block" style="font-family: 'Cabin', sans-serif;">
                        <i class="fa fa-bed mr-2"></i> Trạng thái phòng
                    </a>
                </div>
                <div class="col-md-3 mb-2">
                    <button class="btn btn-outline-dark btn-block" style="font-family: 'Cabin', sans-serif;" disabled>
                        <i class="fa fa-file-text mr-2"></i> Xuất Tạm Trú
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Bookings Table -->
<div class="row">
    <div class="col-lg-12">
        <div class="card-box">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 style="font-family: 'Lora', serif; font-weight: bold; margin: 0;">
                    <i class="fa fa-clock-o mr-2" style="color: #dfa974;"></i> Đặt phòng gần đây
                </h5>
                <a asp-controller="Bookings" asp-action="Index" class="btn btn-sm btn-dark" style="font-family: 'Cabin', sans-serif;">
                    Xem tất cả <i class="fa fa-arrow-right ml-1"></i>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover" style="font-family: 'Cabin', sans-serif;">
                    <thead>
                        <tr class="bg-light">
                            <th>Mã ĐP</th>
                            <th>Khách hàng</th>
                            <th>Nhận phòng</th>
                            <th>Trả phòng</th>
                            <th>Trạng thái</th>
                            <th>Phòng</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentBookings != null && Model.RecentBookings.Any())
                        {
                            foreach (var booking in Model.RecentBookings)
                            {
                                <tr>
                                    <td>#@booking.BookingId</td>
                                    <td>@(booking.User?.FullName ?? "N/A")</td>
                                    <td>@booking.CheckInDate.ToString("dd/MM/yyyy")</td>
                                    <td>@booking.CheckOutDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @{
                                            var badgeClass = booking.BookingStatus switch
                                            {
                                                PhucNguyenResort.Enums.BookingStatus.Reserved => "badge-info",
                                                PhucNguyenResort.Enums.BookingStatus.CheckedIn => "badge-primary",
                                                PhucNguyenResort.Enums.BookingStatus.CheckedOut => "badge-success",
                                                PhucNguyenResort.Enums.BookingStatus.Cancelled => "badge-danger",
                                                _ => "badge-secondary"
                                            };
                                            
                                            var statusText = booking.BookingStatus switch
                                            {
                                                PhucNguyenResort.Enums.BookingStatus.Reserved => "Đã đặt",
                                                PhucNguyenResort.Enums.BookingStatus.CheckedIn => "Đã nhận phòng",
                                                PhucNguyenResort.Enums.BookingStatus.CheckedOut => "Đã trả phòng",
                                                PhucNguyenResort.Enums.BookingStatus.Cancelled => "Đã hủy",
                                                _ => booking.BookingStatus.ToString()
                                            };
                                        }
                                        <span class="badge @badgeClass">@statusText</span>
                                    </td>
                                    <td>@(booking.BookingDetails.FirstOrDefault()?.Room?.RoomNumber ?? "Chưa xếp")</td>
                                    <td class="text-center">
                                        <a asp-controller="Reception" asp-action="Details" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="fa fa-info-circle mr-2"></i> Không có dữ liệu đặt phòng.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
