@{
    ViewData["Title"] = "Housekeeping Dashboard";
    Layout = "_DashboardLayout";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center" style="border-bottom: 2px solid #eee; padding-bottom: 15px;">
            <div>
                <h2 style="font-family: 'Lora', serif; font-weight: bold; color: #1a1a1a; margin-bottom: 5px;">
                    <i class="fa fa-paint-brush mr-2" style="color: #6c757d;"></i> Housekeeping — Cleaning Queue
                </h2>
                <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">View dirty rooms, update cleaning status, report maintenance issues.</p>
            </div>
            <div class="text-muted" style="font-family: 'Cabin', sans-serif; font-size: 14px;">
                <i class="fa fa-calendar mr-2"></i> @DateTime.Now.ToString("dd MMMM, yyyy")
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row mb-4">
    <div class="col-lg-4 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #dc3545;">
            <h4 style="color: #dc3545;"><i class="fa fa-exclamation-triangle"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Rooms Need Cleaning</p>
            <small class="text-muted">Dirty / Post-checkout</small>
        </div>
    </div>
    <div class="col-lg-4 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #ffc107;">
            <h4 style="color: #ffc107;"><i class="fa fa-refresh fa-spin"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Currently Cleaning</p>
            <small class="text-muted">In progress</small>
        </div>
    </div>
    <div class="col-lg-4 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #28a745;">
            <h4 style="color: #28a745;"><i class="fa fa-check-circle"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Cleaned Today</p>
            <small class="text-muted">Ready for guests</small>
        </div>
    </div>
</div>

<!-- Rooms Needing Cleaning (Placeholder Table) -->
<div class="row">
    <div class="col-lg-12">
        <div class="card-box" style="border-left: 5px solid #6c757d;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 style="font-family: 'Lora', serif; font-weight: bold; margin: 0;">
                    <i class="fa fa-list mr-2" style="color: #6c757d;"></i> Rooms Needing Cleaning
                </h5>
                <span class="text-muted" style="font-family: 'Cabin', sans-serif; font-size: 13px;">
                    Click "Mark Cleaned" when the room is ready for check-in.
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover" style="font-family: 'Cabin', sans-serif;">
                    <thead>
                        <tr class="bg-light">
                            <th>Room Number</th>
                            <th>Category</th>
                            <th>Current Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="fa fa-info-circle mr-2"></i> Room data will be loaded when backend is connected.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Report Maintenance -->
<div class="row mt-3">
    <div class="col-lg-12">
        <div class="card-box" style="border-left: 5px solid #ffc107;">
            <h5 style="font-family: 'Lora', serif; font-weight: bold; margin-bottom: 15px;">
                <i class="fa fa-wrench mr-2" style="color: #ffc107;"></i> Report Maintenance Issue
            </h5>
            <p class="text-muted" style="font-family: 'Cabin', sans-serif;">
                Spotted a broken fixture or equipment issue? Report it here so the Maintenance team can respond.
            </p>
            <button class="btn btn-outline-warning" style="font-family: 'Cabin', sans-serif;" disabled>
                <i class="fa fa-exclamation-circle mr-2"></i> Submit Maintenance Report
            </button>
        </div>
    </div>
</div>
