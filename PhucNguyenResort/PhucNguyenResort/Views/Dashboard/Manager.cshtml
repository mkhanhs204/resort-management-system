@{
    ViewData["Title"] = "Business Manager Dashboard";
    Layout = "_DashboardLayout";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center" style="border-bottom: 2px solid #eee; padding-bottom: 15px;">
            <div>
                <h2 style="font-family: 'Lora', serif; font-weight: bold; color: #1a1a1a; margin-bottom: 5px;">
                    <i class="fa fa-bar-chart mr-2" style="color: #28a745;"></i> Business Manager
                </h2>
                <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Revenue analytics, occupancy rates, and resort operations overview.</p>
            </div>
            <div class="text-muted" style="font-family: 'Cabin', sans-serif; font-size: 14px;">
                <i class="fa fa-calendar mr-2"></i> @DateTime.Now.ToString("dd MMMM, yyyy")
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #28a745;">
            <h4 style="color: #28a745;"><i class="fa fa-money"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Total Revenue</p>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #007bff;">
            <h4 style="color: #007bff;"><i class="fa fa-percent"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--%</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Occupancy Rate</p>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #ffc107;">
            <h4 style="color: #ffc107;"><i class="fa fa-star"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">-- / 5.0</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Average Guest Rating</p>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #17a2b8;">
            <h4 style="color: #17a2b8;"><i class="fa fa-comments"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Total Reviews</p>
        </div>
    </div>
</div>

<div class="row">
    <!-- Quick Management Links -->
    <div class="col-lg-6 mb-4">
        <div class="card-box h-100" style="border-left: 5px solid #28a745;">
            <h5 style="font-family: 'Lora', serif; font-weight: bold; margin-bottom: 20px;">
                <i class="fa fa-link mr-2" style="color: #dfa974;"></i> Quick Management Links
            </h5>
            <div class="list-group" style="font-family: 'Cabin', sans-serif;">
                <a asp-controller="RoomCategories" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <span><i class="fa fa-bed mr-2 text-primary"></i> Room Categories & Pricing</span>
                    <span class="badge badge-primary badge-pill"><i class="fa fa-chevron-right"></i></span>
                </a>
                <a asp-controller="RestaurantMenus" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <span><i class="fa fa-cutlery mr-2 text-success"></i> F&B Menu Items</span>
                    <span class="badge badge-success badge-pill"><i class="fa fa-chevron-right"></i></span>
                </a>
                <a asp-controller="Tours" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <span><i class="fa fa-map-marker mr-2 text-warning"></i> Tour Packages</span>
                    <span class="badge badge-warning badge-pill"><i class="fa fa-chevron-right"></i></span>
                </a>
                <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <span><i class="fa fa-file-pdf-o mr-2 text-danger"></i> Export Reports (PDF/Excel)</span>
                    <span class="badge badge-danger badge-pill"><i class="fa fa-chevron-right"></i></span>
                </a>
            </div>
        </div>
    </div>

    <!-- Recent Customer Reviews (Placeholder) -->
    <div class="col-lg-6 mb-4">
        <div class="card-box h-100" style="border-left: 5px solid #ffc107;">
            <h5 style="font-family: 'Lora', serif; font-weight: bold; margin-bottom: 20px;">
                <i class="fa fa-star mr-2" style="color: #ffc107;"></i> Recent Customer Reviews
            </h5>
            <div class="text-center text-muted py-5" style="font-family: 'Cabin', sans-serif;">
                <i class="fa fa-info-circle fa-2x mb-3 d-block"></i>
                <p>Review data will be loaded when backend is connected.</p>
            </div>
        </div>
    </div>
</div>
