@{
    ViewData["Title"] = "Dashboard";
    Layout = "_DashboardLayout";
}

<div class="row">
    <div class="col-lg-12 text-center" style="padding: 80px 20px;">
        <i class="fa fa-dashboard fa-4x mb-4 d-block" style="color: #dfa974;"></i>
        <h2 style="font-family: 'Lora', serif; font-weight: bold; color: #1a1a1a;">
            Welcome, @(User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : "Staff Member")!
        </h2>
        <p class="text-muted mt-3" style="font-family: 'Cabin', sans-serif; font-size: 16px;">
            Your role does not have a dedicated dashboard page configured yet.<br/>
            Please contact the System Administrator if you believe this is an error.
        </p>
        <a href="/" class="btn btn-outline-dark mt-3" style="font-family: 'Cabin', sans-serif;">
            <i class="fa fa-globe mr-2"></i> Return to Website
        </a>
    </div>
</div>
