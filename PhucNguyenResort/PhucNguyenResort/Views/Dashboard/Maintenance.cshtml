@{
    ViewData["Title"] = "Maintenance Dashboard";
    Layout = "_DashboardLayout";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center" style="border-bottom: 2px solid #eee; padding-bottom: 15px;">
            <div>
                <h2 style="font-family: 'Lora', serif; font-weight: bold; color: #1a1a1a; margin-bottom: 5px;">
                    <i class="fa fa-wrench mr-2" style="color: #dc3545;"></i> Maintenance Staff — Engineering & Repairs
                </h2>
                <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">View repair requests, manage equipment status, and mark repairs complete.</p>
            </div>
            <div class="text-muted" style="font-family: 'Cabin', sans-serif; font-size: 14px;">
                <i class="fa fa-calendar mr-2"></i> @DateTime.Now.ToString("dd MMMM, yyyy")
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row mb-4">
    <div class="col-lg-4 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #dc3545;">
            <h4 style="color: #dc3545;"><i class="fa fa-exclamation-circle"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Open Repair Requests</p>
            <small class="text-muted">Awaiting attention</small>
        </div>
    </div>
    <div class="col-lg-4 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #ffc107;">
            <h4 style="color: #ffc107;"><i class="fa fa-cog fa-spin"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Rooms Under Maintenance</p>
            <small class="text-muted">Currently being repaired</small>
        </div>
    </div>
    <div class="col-lg-4 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #28a745;">
            <h4 style="color: #28a745;"><i class="fa fa-thumbs-up"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Completed This Week</p>
            <small class="text-muted">Repairs finished</small>
        </div>
    </div>
</div>

<!-- Rooms Under Maintenance (Placeholder Table) -->
<div class="row">
    <div class="col-lg-12">
        <div class="card-box" style="border-left: 5px solid #dc3545;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 style="font-family: 'Lora', serif; font-weight: bold; margin: 0;">
                    <i class="fa fa-wrench mr-2" style="color: #dc3545;"></i> Rooms Currently Under Maintenance
                </h5>
                <span class="text-muted" style="font-family: 'Cabin', sans-serif; font-size: 13px;">
                    Click "Complete Repair" when room is fixed (room will move to Needs Cleaning).
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover" style="font-family: 'Cabin', sans-serif;">
                    <thead>
                        <tr class="bg-light">
                            <th>Room Number</th>
                            <th>Category</th>
                            <th>Issue Description</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fa fa-info-circle mr-2"></i> Maintenance data will be loaded when backend is connected.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
