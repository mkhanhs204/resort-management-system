@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Tour Guide Dashboard";
    Layout = "_DashboardLayout";

    var upcomingCount = 0;
    var ongoingCount = 0;
    var completedCount = 0;
    var activeSchedules = new List<dynamic>();

    if (Model != null)
    {
        foreach (var s in Model)
        {
            var status = ViewData[$"Status_{s.ScheduleId}"]?.ToString() ?? "Upcoming";
            if (status == "Cancelled") continue;
            activeSchedules.Add(s);

            if (status == "Upcoming") upcomingCount++;
            else if (status == "Ongoing") ongoingCount++;
            else if (status == "Completed") completedCount++;
        }
    }
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .luxury-wrapper {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: #fdfbf7;
        padding: 25px;
        border-radius: 24px;
    }

    .premium-header {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border-radius: 20px;
        padding: 30px;
        color: white;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
    }

    .luxury-title {
        font-family: 'Playfair Display', serif;
        color: #c29953;
        font-weight: 700;
    }

    .luxury-card-stat {
        background: #ffffff;
        border: 1px solid rgba(194, 153, 83, 0.15);
        border-radius: 18px;
        padding: 20px;
        transition: all 0.3s ease;
    }

    .luxury-card-stat:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 25px rgba(194, 153, 83, 0.08);
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .dashboard-panel {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        padding: 22px;
        height: 100%;
    }

    .notice-item {
        border-left: 3px solid #c29953;
        background: #fdfbf7;
        padding: 12px;
        border-radius: 0 10px 10px 0;
        margin-bottom: 12px;
        font-size: 13px;
    }

    .btn-gold {
        background: linear-gradient(135deg, #c29953 0%, #a37f41 100%);
        color: #ffffff !important;
        border: none;
        padding: 8px 16px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 12px;
    }
</style>

<div class="luxury-wrapper">
    <!-- Header Banner -->
    <div class="premium-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="text-uppercase small font-weight-bold" style="color: #c29953; letter-spacing: 2px;">Phuc Nguyen Luxury Resort</span>
            <h1 class="luxury-title mt-1 mb-1" style="font-size: 28px;">Tour Guide Overview</h1>
            <p class="mb-0 opacity-75" style="color: #94a3b8; font-size: 13px;">Hệ thống quản lý hiệu suất và điều hành tour tổng quan dành cho Hướng dẫn viên.</p>
        </div>
        <div class="text-right d-none d-md-block">
            <div class="small text-uppercase opacity-50" style="letter-spacing: 1px; color: #94a3b8;">Ngày làm việc</div>
            <div class="font-weight-bold" style="font-size: 16px; color: #c29953;"><i class="fa-regular fa-calendar-days me-2"></i>@DateTime.Now.ToString("dd MMMM, yyyy")</div>
        </div>
    </div>

    <!-- Hàng Thống kê KPI -->
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="luxury-card-stat">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Đang Diễn Ra</div>
                        <h3 class="font-weight-bold my-1 text-dark">@ongoingCount</h3>
                    </div>
                    <div class="stat-icon" style="background: rgba(8, 145, 178, 0.1); color: #0891b2;">
                        <i class="fa-solid fa-person-walking-luggage"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="luxury-card-stat">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Chờ Khởi Hành</div>
                        <h3 class="font-weight-bold my-1 text-dark">@upcomingCount</h3>
                    </div>
                    <div class="stat-icon" style="background: rgba(217, 119, 6, 0.1); color: #d97706;">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="luxury-card-stat">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Đã Hoàn Thành</div>
                        <h3 class="font-weight-bold my-1 text-dark">@completedCount</h3>
                    </div>
                    <div class="stat-icon" style="background: rgba(22, 163, 74, 0.1); color: #16a34a;">
                        <i class="fa-solid fa-square-check"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="luxury-card-stat">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Tỉ Lệ Hoàn Thành</div>
                        <h3 class="font-weight-bold my-1 text-dark">100%</h3>
                    </div>
                    <div class="stat-icon" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Khung Bố cục Tổng quan -->
    <div class="row">
        <!-- Cột trái: Trạng thái Tour hiện tại & Lịch trình rút gọn -->
        <div class="col-lg-8 mb-4">
            <div class="dashboard-panel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="m-0 font-weight-bold text-dark" style="font-family: 'Playfair Display', serif;"><i class="fa-solid fa-person-chalkboard me-2 text-warning"></i>Hoạt Động Đang Diễn Ra</h5>
                    <a asp-controller="TourGuide" asp-action="Index" class="btn btn-sm btn-outline-secondary" style="border-radius: 8px; font-size: 11px;">Xem tất cả lịch trình</a>
                </div>

                @{
                    var ongoingTour = activeSchedules != null 
                        ? activeSchedules.FirstOrDefault(s => (ViewData[$"Status_{s.ScheduleId}"]?.ToString() ?? "") == "Ongoing") 
                        : null;
                }

                @if (ongoingTour != null)
                {
                    <div class="p-4 border border-info rounded-lg mb-0" style="background: rgba(6, 182, 212, 0.02); border-radius: 14px;">
                        <div class="row align-items-center">
                            <div class="col-md-7">
                                <span class="badge bg-info text-white mb-2"><i class="fa-solid fa-spinner fa-spin me-1"></i> LIVE OPERATING</span>
                                <h4 class="text-dark font-weight-bold">@ongoingTour.Tour?.TourName</h4>
                                <p class="text-muted small mb-0"><i class="fa-regular fa-clock me-1"></i> Thời gian: @ongoingTour.StartTime.ToString(@"hh\:mm") - @ViewData[$"EndTime_{ongoingTour.ScheduleId}"]</p>
                            </div>
                            <div class="col-md-5 text-md-right mt-3 mt-md-0">
                                <span class="d-block text-muted small mb-2">Sức chứa: <strong>@ongoingTour.AvailableSlots Slots còn trống</strong></span>
                                <a asp-controller="TourGuide" asp-action="Participants" asp-route-scheduleId="@ongoingTour.ScheduleId" class="btn btn-gold">
                                    <i class="fa-solid fa-users-viewfinder me-1"></i> Điểm Danh Đoàn Khách
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted bg-light" style="border-radius: 14px;">
                        <i class="fa-solid fa-umbrella-beach fa-2x mb-2 text-muted opacity-50"></i>
                        <p class="small mb-0 font-weight-bold">Hiện tại bạn không có tour nào đang chạy.</p>
                    </div>
                }

                <!-- Các tour tiếp theo trong ngày -->
                <h6 class="font-weight-bold text-dark mt-4 mb-3"><i class="fa-regular fa-calendar-check me-2 text-secondary"></i>Các Tour Sắp Khởi Hành Tiếp Theo</h6>
                <div class="table-responsive">
                    <table class="table table-sm align-middle text-center mb-0" style="font-size: 13px;">
                        <thead>
                            <tr class="text-muted">
                                <th>Mã Tour</th>
                                <th class="text-left">Tên Tour</th>
                                <th>Giờ Chạy</th>
                                <th>Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var nextTours = activeSchedules != null 
                                    ? activeSchedules.Where(s => (ViewData[$"Status_{s.ScheduleId}"]?.ToString() ?? "") == "Upcoming").Take(2).ToList()
                                    : new List<dynamic>();
                            }
                            @if (nextTours.Any())
                            {
                                foreach (var t in nextTours)
                                {
                                    <tr>
                                        <td class="font-weight-bold">#@t.ScheduleId.ToString("D3")</td>
                                        <td class="text-left font-weight-bold">@t.Tour?.TourName</td>
                                        <td>@t.StartTime.ToString(@"hh\:mm")</td>
                                        <td><span class="badge bg-warning text-dark font-weight-bold">Chuẩn bị</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-2 small">Không có lịch trình sắp tới tiếp theo.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Cột phải: Thông báo từ quản lý & Check-list công cụ hỗ trợ -->
        <div class="col-lg-4 mb-4">
            <div class="dashboard-panel">
                <h5 class="font-weight-bold text-dark mb-3" style="font-family: 'Playfair Display', serif;"><i class="fa-solid fa-bullhorn me-2 text-danger"></i>Thông Báo Quản Lý</h5>
                <div class="notice-container">
                    <div class="notice-item">
                        <strong>[⚠️ Chú ý Thời Tiết]</strong> Biển động nhẹ vào buổi chiều, các tour đường thủy chú ý áo phao đầy đủ cho du khách.
                    </div>
                    <div class="notice-item">
                        <strong>[📢 Quy định mới]</strong> Hoàn thành báo cáo sĩ số khách (Manifest) chậm nhất 15 phút sau khi khởi hành tour.
                    </div>
                </div>

                <h5 class="font-weight-bold text-dark mt-4 mb-3" style="font-family: 'Playfair Display', serif;"><i class="fa-solid fa-toolbox me-2 text-success"></i>Thiết Bị & Chuẩn Bị</h5>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent">
                        <span><i class="fa-solid fa-walkie-talkie me-2 text-muted"></i> Bộ đàm điều hành Resort</span>
                        <span class="badge bg-success text-white">Đã nhận / Kênh 02</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent">
                        <span><i class="fa-solid fa-briefcase-medical me-2 text-muted"></i> Túi y tế sơ cứu di động</span>
                        <span class="badge bg-success text-white">Sẵn sàng</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent">
                        <span><i class="fa-solid fa-id-card me-2 text-muted"></i> Thẻ Hướng Dẫn Viên PhucNguyen</span>
                        <span class="badge bg-secondary text-white">Luôn mang theo</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>