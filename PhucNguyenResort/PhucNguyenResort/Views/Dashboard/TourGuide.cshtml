@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Tour Guide Overview";
    Layout = "_DashboardLayout";

    var upcomingCount = 0;
    var ongoingCount = 0;
    var completedCount = 0;
    var activeSchedules = new List<dynamic>();

    if (Model != null)
    {
        foreach (var s in Model)
        {
            var status = ViewData[$"Status_{s.ScheduleId}"]?.ToString() ?? "Upcoming";
            if (status == "Cancelled") continue;
            activeSchedules.Add(s);

            if (status == "Upcoming") upcomingCount++;
            else if (status == "Ongoing") ongoingCount++;
            else if (status == "Completed") completedCount++;
        }
    }
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title { font-family: 'Playfair Display', serif; font-size: 36px; font-weight: 700; color: #805528; margin-bottom: 4px; }
        .page-subtitle { font-family: 'Inter', sans-serif; color: #50453b; font-size: 16px; margin-bottom: 32px; }
        
        /* KPI Cards */
        .kpi-card { background: #ffffff; border-radius: 16px; padding: 24px; box-shadow: 0 12px 24px -8px rgba(30, 41, 59, 0.05); border: 1px solid rgba(212, 195, 182, 0.3); font-family: 'Inter', sans-serif; height: 100%; display: flex; align-items: center; transition: all 0.3s ease; }
        .kpi-card:hover { transform: translateY(-4px); box-shadow: 0 20px 32px -8px rgba(30, 41, 59, 0.1); }
        .kpi-icon-wrapper { width: 56px; height: 56px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 20px; flex-shrink: 0; }
        .kpi-icon-wrapper.primary { background-color: #f6f3ef; color: #805528; }
        .kpi-icon-wrapper.success { background-color: #e2f5ea; color: #0b5c2d; }
        .kpi-icon-wrapper.warning { background-color: #fff8e6; color: #946c00; }
        .kpi-icon-wrapper.info { background-color: #d3e4fe; color: #0b1c30; }
        .kpi-details h3 { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: #1c1c1a; margin-bottom: 4px; }
        .kpi-details p { color: #50453b; font-size: 14px; font-weight: 500; margin-bottom: 0; }
        
        /* Section styling */
        .section-header { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: #805528; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
        .action-card { background: #ffffff; border-radius: 16px; padding: 24px; box-shadow: 0 12px 24px -8px rgba(30, 41, 59, 0.05); border: 1px solid rgba(212, 195, 182, 0.3); font-family: 'Inter', sans-serif; height: 100%; }
        
        /* List Group */
        .luxury-list .list-group-item { border: none; border-bottom: 1px solid rgba(212, 195, 182, 0.3); padding: 16px 8px; background-color: transparent; font-weight: 500; color: #1c1c1a; transition: all 0.2s; }
        .luxury-list .list-group-item:hover { background-color: #fcf9f5; border-radius: 8px; padding-left: 16px; color: #805528; }
        .luxury-list .list-group-item:last-child { border-bottom: none; }
        
        /* Table */
        .table-luxury { background: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid rgba(212, 195, 182, 0.3); font-family: 'Inter', sans-serif; margin-bottom: 16px; }
        .table-luxury table { width: 100%; border-collapse: collapse; margin-bottom: 0; }
        .table-luxury th { background-color: #fcf9f5; color: #805528; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; padding: 16px; border-bottom: 2px solid rgba(212, 195, 182, 0.3); text-align: left; }
        .table-luxury td { padding: 16px; border-bottom: 1px solid #f0ede9; color: #1c1c1a; font-size: 14px; vertical-align: middle; }
        .table-luxury tbody tr:hover { background-color: #faf8f5; }
        .table-luxury tbody tr:last-child td { border-bottom: none; }
        
        .status-badge { display: inline-flex; align-items: center; padding: 6px 12px; border-radius: 20px; font-size: 13px; font-weight: 600; }
        .status-badge.confirmed { background-color: #e2f5ea; color: #0b5c2d; }
        .status-badge.pending { background-color: #fff8e6; color: #946c00; }
        .status-badge.seated { background-color: #d3e4fe; color: #0b1c30; }
        .status-badge.completed { background-color: #f0ede9; color: #50453b; }
        .status-badge.noshow { background-color: #e3e3e3; color: #1c1c1a; }
        .status-badge.cancelled { background-color: #ffdad6; color: #ba1a1a; }
        
        .btn-outline-luxury { background-color: transparent; color: #805528; border: 1.5px solid #dfa974; font-family: 'Inter', sans-serif; font-weight: 600; border-radius: 8px; padding: 6px 16px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.3s ease; text-decoration: none; font-size: 14px; }
        .btn-outline-luxury:hover { background-color: #f6f3ef; color: #633d11; text-decoration: none; }
        
        .material-symbols-outlined { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; font-size: 24px; vertical-align: middle; }

        .notice-item { border-left: 3px solid #dfa974; background: #fcf9f5; padding: 12px; border-radius: 0 10px 10px 0; margin-bottom: 12px; font-size: 14px; color: #50453b; font-family: 'Inter', sans-serif; }
    </style>
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h2 class="page-title">Tổng Quan Hướng Dẫn Viên</h2>
        <p class="page-subtitle">Hệ thống quản lý hiệu suất và điều hành tour tổng quan dành cho Hướng dẫn viên</p>
    </div>
    <div class="page-subtitle" style="margin-bottom: 8px;">
        <span class="material-symbols-outlined" style="font-size: 18px; margin-right: 4px;">calendar_today</span>
        @DateTime.Now.ToString("dd MMMM, yyyy")
    </div>
</div>

<!-- KPI Cards -->
<div class="row mb-5">
    <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
        <div class="kpi-card">
            <div class="kpi-icon-wrapper info">
                <span class="material-symbols-outlined">directions_walk</span>
            </div>
            <div class="kpi-details">
                <h3>@ongoingCount</h3>
                <p>Đang Diễn Ra</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
        <div class="kpi-card">
            <div class="kpi-icon-wrapper warning">
                <span class="material-symbols-outlined">hourglass_top</span>
            </div>
            <div class="kpi-details">
                <h3>@upcomingCount</h3>
                <p>Chờ Khởi Hành</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
        <div class="kpi-card">
            <div class="kpi-icon-wrapper success">
                <span class="material-symbols-outlined">check_circle</span>
            </div>
            <div class="kpi-details">
                <h3>@completedCount</h3>
                <p>Đã Hoàn Thành</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3 mb-lg-0">
        <div class="kpi-card">
            <div class="kpi-icon-wrapper primary">
                <span class="material-symbols-outlined">trending_up</span>
            </div>
            <div class="kpi-details">
                <h3>100%</h3>
                <p>Tỉ Lệ Hoàn Thành</p>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-lg-8 mb-4 mb-lg-0">
        <div class="action-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="section-header mb-0">
                    <span class="material-symbols-outlined">tour</span> Hoạt Động Đang Diễn Ra
                </h5>
                <a asp-controller="TourGuide" asp-action="Index" class="btn-outline-luxury">
                    Xem tất cả
                </a>
            </div>

            @{
                var ongoingTour = activeSchedules != null 
                    ? activeSchedules.FirstOrDefault(s => (ViewData[$"Status_{s.ScheduleId}"]?.ToString() ?? "") == "Ongoing") 
                    : null;
            }

            @if (ongoingTour != null)
            {
                <div class="p-4 rounded-lg mb-4" style="background: #e2f5ea; border: 1px solid #0b5c2d; border-radius: 12px; font-family: 'Inter', sans-serif;">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <span class="status-badge confirmed mb-2"><span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px;">autorenew</span> LIVE OPERATING</span>
                            <h4 style="color: #0b5c2d; font-family: 'Playfair Display', serif; font-weight: 700; font-size: 20px; margin-bottom: 4px;">@ongoingTour.Tour?.TourName</h4>
                            <p style="color: #0b5c2d; font-size: 14px; margin-bottom: 0;">
                                <span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px; vertical-align: text-bottom;">schedule</span>
                                Thời gian: @ongoingTour.StartTime.ToString(@"hh\:mm") - @ViewData[$"EndTime_{ongoingTour.ScheduleId}"]
                            </p>
                        </div>
                        <div class="col-md-4 text-md-right mt-3 mt-md-0">
                            <span class="d-block small mb-2" style="color: #0b5c2d;">Sức chứa: <strong>@ongoingTour.AvailableSlots Slots còn trống</strong></span>
                            <a asp-controller="TourGuide" asp-action="Participants" asp-route-scheduleId="@ongoingTour.ScheduleId" class="btn-outline-luxury" style="background: #ffffff; border-color: #0b5c2d; color: #0b5c2d;">
                                <span class="material-symbols-outlined" style="font-size: 18px;">group</span> Điểm Danh
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-4 mb-4" style="background: #f6f3ef; border-radius: 12px; color: #805528;">
                    <span class="material-symbols-outlined" style="font-size: 40px; margin-bottom: 8px;">beach_access</span>
                    <p class="mb-0" style="font-weight: 500;">Hiện tại bạn không có tour nào đang chạy.</p>
                </div>
            }

            <h5 class="section-header mt-4 mb-3" style="font-size: 18px;">
                <span class="material-symbols-outlined" style="font-size: 20px;">calendar_month</span> Các Tour Sắp Khởi Hành Tiếp Theo
            </h5>
            
            <div class="table-luxury">
                <table>
                    <thead>
                        <tr>
                            <th>Mã Tour</th>
                            <th>Tên Tour</th>
                            <th>Giờ Chạy</th>
                            <th>Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var nextTours = activeSchedules != null 
                                ? activeSchedules.Where(s => (ViewData[$"Status_{s.ScheduleId}"]?.ToString() ?? "") == "Upcoming" && s.TourDate?.Date == DateTime.Today).ToList()
                                : new List<dynamic>();
                        }
                        @if (nextTours.Any())
                        {
                            foreach (var t in nextTours)
                            {
                                <tr>
                                    <td style="font-weight: 600;">#@t.ScheduleId.ToString("D3")</td>
                                    <td>@t.Tour?.TourName</td>
                                    <td style="font-weight: 500;">@t.StartTime.ToString(@"hh\:mm")</td>
                                    <td><span class="status-badge pending">Chuẩn bị</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 24px; color: #a4b5ce;">
                                    Không có lịch trình sắp tới tiếp theo.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="action-card mb-4" style="background: linear-gradient(135deg, #fdfbf7 0%, #f6f3ef 100%);">
            <h5 class="section-header">
                <span class="material-symbols-outlined" style="color: #dfa974;">routine</span> Thời Tiết Dự Kiến
            </h5>
            <div class="mt-3">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <h4 style="font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: #1c1c1a; margin-bottom: 4px;">Hòa Lạc</h4>
                        <p style="color: #827569; font-size: 14px; font-weight: 500; margin-bottom: 0;">Hôm nay</p>
                    </div>
                    <span id="current-weather-icon" class="material-symbols-outlined" style="font-size: 40px; color: #f59e0b; font-variation-settings: 'FILL' 1;">light_mode</span>
                </div>
                <div style="display: flex; align-items: flex-end; gap: 16px; margin-top: 16px;">
                    <span id="current-temperature" style="font-size: 36px; font-weight: 700; color: #1c1c1a; line-height: 1;">--°C</span>
                    <div style="color: #50453b; font-size: 13px; padding-bottom: 4px;">
                        <p id="current-weather-desc" style="margin-bottom: 2px; font-weight: 600;">Đang tải...</p>
                        <p id="current-weather-details" style="margin-bottom: 0;">Độ ẩm: --% • Gió: --km/h</p>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 24px; padding-top: 16px; border-top: 1px solid rgba(212, 195, 182, 0.5); text-align: center;">
                    <div>
                        <p style="font-size: 12px; color: #827569; margin-bottom: 4px;">Ngày mai</p>
                        <span id="day1-icon" class="material-symbols-outlined" style="color: #f59e0b; font-size: 24px; margin-bottom: 4px;">partly_cloudy_day</span>
                        <p id="day1-temp" style="font-size: 14px; font-weight: 600; color: #1c1c1a; margin-bottom: 0;">--°</p>
                    </div>
                    <div>
                        <p style="font-size: 12px; color: #827569; margin-bottom: 4px;">Ngày 3</p>
                        <span id="day2-icon" class="material-symbols-outlined" style="color: #f59e0b; font-size: 24px; margin-bottom: 4px; font-variation-settings: 'FILL' 1;">light_mode</span>
                        <p id="day2-temp" style="font-size: 14px; font-weight: 600; color: #1c1c1a; margin-bottom: 0;">--°</p>
                    </div>
                    <div>
                        <p style="font-size: 12px; color: #827569; margin-bottom: 4px;">Ngày 4</p>
                        <span id="day3-icon" class="material-symbols-outlined" style="color: #a4b5ce; font-size: 24px; margin-bottom: 4px; font-variation-settings: 'FILL' 1;">cloud</span>
                        <p id="day3-temp" style="font-size: 14px; font-weight: 600; color: #1c1c1a; margin-bottom: 0;">--°</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Tọa độ Hòa Lạc
            const lat = 21.0116; 
            const lon = 105.5283;
            const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code&daily=weather_code,temperature_2m_max&timezone=Asia%2FBangkok&forecast_days=4`;

            function getWeatherInfo(code) {
                if (code === 0) return { text: 'Quang đãng', icon: 'light_mode', color: '#f59e0b' };
                if (code >= 1 && code <= 3) return { text: 'Có mây', icon: 'partly_cloudy_day', color: '#f59e0b' };
                if (code === 45 || code === 48) return { text: 'Sương mù', icon: 'foggy', color: '#a4b5ce' };
                if (code >= 51 && code <= 67) return { text: 'Mưa', icon: 'rainy', color: '#3b82f6' };
                if (code >= 71 && code <= 77) return { text: 'Tuyết', icon: 'ac_unit', color: '#93c5fd' };
                if (code >= 80 && code <= 82) return { text: 'Mưa rào', icon: 'rainy', color: '#3b82f6' };
                if (code >= 95) return { text: 'Dông sét', icon: 'thunderstorm', color: '#64748b' };
                return { text: 'Không rõ', icon: 'cloud', color: '#a4b5ce' };
            }

            fetch(url)
                .then(res => res.json())
                .then(data => {
                    const current = data.current;
                    const daily = data.daily;
                    
                    const currInfo = getWeatherInfo(current.weather_code);
                    
                    // Cập nhật thời tiết hiện tại
                    const iconEl = document.getElementById('current-weather-icon');
                    if(iconEl) {
                        iconEl.innerText = currInfo.icon;
                        iconEl.style.color = currInfo.color;
                    }
                    
                    const tempEl = document.getElementById('current-temperature');
                    if(tempEl) tempEl.innerText = Math.round(current.temperature_2m) + '°C';
                    
                    const descEl = document.getElementById('current-weather-desc');
                    if(descEl) descEl.innerText = currInfo.text;
                    
                    const detailsEl = document.getElementById('current-weather-details');
                    if(detailsEl) detailsEl.innerText = `Độ ẩm: ${current.relative_humidity_2m}% • Gió: ${current.wind_speed_10m}km/h`;

                    // Cập nhật dự báo 3 ngày tiếp theo
                    for (let i = 1; i <= 3; i++) {
                        const dInfo = getWeatherInfo(daily.weather_code[i]);
                        
                        const dIconEl = document.getElementById(`day${i}-icon`);
                        if(dIconEl) {
                            dIconEl.innerText = dInfo.icon;
                            dIconEl.style.color = dInfo.color;
                        }
                        
                        const dTempEl = document.getElementById(`day${i}-temp`);
                        if(dTempEl) dTempEl.innerText = Math.round(daily.temperature_2m_max[i]) + '°';
                    }
                })
                .catch(err => {
                    console.error("Error fetching weather:", err);
                    const descEl = document.getElementById('current-weather-desc');
                    if(descEl) descEl.innerText = 'Không thể tải dữ liệu';
                });
        });
    </script>
}