@{
    ViewData["Title"] = "Tour Guide Dashboard";
    Layout = "_DashboardLayout";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center" style="border-bottom: 2px solid #eee; padding-bottom: 15px;">
            <div>
                <h2 style="font-family: 'Lora', serif; font-weight: bold; color: #1a1a1a; margin-bottom: 5px;">
                    <i class="fa fa-map-o mr-2" style="color: #17a2b8;"></i> Tour Guide — Schedules & Attendance
                </h2>
                <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">View assigned tours, check guest lists, manage attendance.</p>
            </div>
            <div class="text-muted" style="font-family: 'Cabin', sans-serif; font-size: 14px;">
                <i class="fa fa-calendar mr-2"></i> @DateTime.Now.ToString("dd MMMM, yyyy")
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row mb-4">
    <div class="col-lg-4 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #17a2b8;">
            <h4 style="color: #17a2b8;"><i class="fa fa-calendar"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Upcoming Scheduled Tours</p>
        </div>
    </div>
    <div class="col-lg-4 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #ffc107;">
            <h4 style="color: #ffc107;"><i class="fa fa-play-circle"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Ongoing Tours</p>
        </div>
    </div>
    <div class="col-lg-4 col-md-6 mb-3">
        <div class="card-box text-center h-100" style="border-top: 4px solid #28a745;">
            <h4 style="color: #28a745;"><i class="fa fa-check-circle"></i></h4>
            <h3 class="mt-2" style="font-family: 'Lora', serif; font-weight: bold;">--</h3>
            <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Completed Today</p>
        </div>
    </div>
</div>

<!-- Upcoming Tour Schedules (Placeholder Table) -->
<div class="row">
    <div class="col-lg-12">
        <div class="card-box" style="border-left: 5px solid #17a2b8;">
            <h5 style="font-family: 'Lora', serif; font-weight: bold; margin-bottom: 20px;">
                <i class="fa fa-list-alt mr-2" style="color: #17a2b8;"></i> Upcoming Tour Schedules
            </h5>
            <div class="table-responsive">
                <table class="table table-hover" style="font-family: 'Cabin', sans-serif;">
                    <thead>
                        <tr class="bg-light">
                            <th>Schedule ID</th>
                            <th>Tour Name</th>
                            <th>Date</th>
                            <th>Start Time</th>
                            <th>Slots Left</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="fa fa-info-circle mr-2"></i> Tour schedule data will be loaded when backend is connected.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
