@model PhucNguyenResort.ViewModels.Users.ProfileVM
@{
    ViewData["Title"] = "Hồ Sơ Thành Viên - Phúc Nguyên Resort";
}
@section Styles {
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .active-link {
            border-left: 3px solid #805528;
            font-weight: 700;
            color: #805528 !important;
            background-color: #f6f3ef;
        }
        .luxury-card {
            background-color: #FFFFFF;
            border: 1px solid rgba(226, 232, 240, 0.6);
            box-shadow: 0 24px 40px -10px rgba(30, 41, 59, 0.04);
        }
        .form-input-focus:focus {
            outline: none;
            border-color: #DFA974;
            box-shadow: 0 0 0 1px #DFA974;
        }
        .transition-soft {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
    </style>
}

<div class="pt-8 pb-section-gap-lg max-w-container-max mx-auto px-margin-desktop">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
        <!-- Sidebar (4 columns) -->
        <aside class="md:col-span-4 space-y-stack-md">
            <div class="luxury-card rounded-xl p-8 text-center flex flex-col items-center">
                <div class="relative group cursor-pointer mb-6">
                    <div class="w-32 h-32 rounded-full bg-primary-container text-white flex items-center justify-center text-4xl font-headline-lg shadow-lg">
                        @(Model.FullName?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                </div>
                <h2 class="font-headline-sm text-headline-sm text-primary mb-1">@Model.FullName</h2>
                <p class="font-body-md text-on-surface-variant opacity-70 mb-8">@Model.Email</p>

                <nav class="w-full space-y-2 text-left">
                    <a asp-controller="Profile" asp-action="Index" class="flex items-center gap-3 p-4 rounded-lg text-primary font-bold active-link transition-soft">
                        <span class="material-symbols-outlined">person</span>
                        <span class="font-label-lg text-label-lg">Hồ Sơ Cá Nhân</span>
                    </a>
                    <a asp-controller="Bookings" asp-action="MyBookings" class="flex items-center gap-3 p-4 rounded-lg text-on-surface-variant hover:bg-surface-container-low transition-soft">
                        <span class="material-symbols-outlined">history</span>
                        <span class="font-label-lg text-label-lg">Lịch Sử Đặt Phòng</span>
                    </a>
                    <a asp-controller="CustomerTourBooking" asp-action="MyTourBookings" class="flex items-center gap-3 p-4 rounded-lg text-on-surface-variant hover:bg-surface-container-low transition-soft">
                        <span class="material-symbols-outlined">tour</span>
                        <span class="font-label-lg text-label-lg">Lịch Sử Đặt Tour</span>
                    </a>
                    <a asp-controller="TableReservations" asp-action="MyReservations" class="flex items-center gap-3 p-4 rounded-lg text-on-surface-variant hover:bg-surface-container-low transition-soft">
                        <span class="material-symbols-outlined">restaurant</span>
                        <span class="font-label-lg text-label-lg">Lịch Sử Đặt Bàn</span>
                    </a>
                    <a asp-controller="FoodOrders" asp-action="MyOrders" class="flex items-center gap-3 p-4 rounded-lg text-on-surface-variant hover:bg-surface-container-low transition-soft">
                        <span class="material-symbols-outlined">fastfood</span>
                        <span class="font-label-lg text-label-lg">Lịch Sử Đặt Đồ Ăn</span>
                    </a>
                    <hr class="border-outline/10 my-4" />
                    <a asp-controller="Account" asp-action="Logout" class="flex items-center gap-3 p-4 rounded-lg text-error hover:bg-error-container/20 transition-soft">
                        <span class="material-symbols-outlined">logout</span>
                        <span class="font-label-lg text-label-lg">Đăng Xuất</span>
                    </a>
                </nav>
            </div>


        </aside>

        <!-- Main Content (8 columns) -->
        <div class="md:col-span-8 space-y-gutter">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="bg-primary-container/20 text-on-primary-container p-4 rounded-xl border border-primary-container/30 text-center text-sm mb-6">
                    <span class="material-symbols-outlined align-middle mr-2 text-primary">check_circle</span>
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="bg-error-container/20 text-error p-4 rounded-xl border border-error-container/30 text-center text-sm mb-6">
                    <span class="material-symbols-outlined align-middle mr-2">error</span>
                    @TempData["ErrorMessage"]
                </div>
            }

            <form asp-controller="Profile" asp-action="Update" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />

                <!-- Personal Info Section -->
                <section class="luxury-card rounded-xl p-8 mb-gutter">
                    <div class="flex justify-between items-center mb-10">
                        <div>
                            <h1 class="font-headline-md text-headline-md text-primary">Thông Tin Cá Nhân</h1>
                            <p class="font-body-md text-on-surface-variant">Quản lý thông tin tài khoản của bạn.</p>
                        </div>
                        <span class="px-4 py-2 bg-tertiary-fixed text-on-tertiary-container rounded-full text-xs font-bold flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">verified</span>
                            ĐÃ XÁC MINH
                        </span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-stack-lg">
                        <div class="flex flex-col gap-2">
                            <label asp-for="FullName" class="font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Họ và Tên</label>
                            <input asp-for="FullName" class="bg-surface-container-low border border-outline/20 rounded-xl px-4 py-3 form-input-focus transition-soft font-body-md" />
                            <span asp-validation-for="FullName" class="text-error text-sm"></span>
                        </div>

                        <div class="flex flex-col gap-2">
                            <label class="font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Địa Chỉ Email</label>
                            <input asp-for="Email" class="bg-surface-container border border-outline/10 rounded-xl px-4 py-3 text-on-surface-variant cursor-not-allowed font-body-md outline-none" readonly />
                            <span class="text-[10px] text-on-surface-variant/60">* Email không thể thay đổi</span>
                        </div>

                        <div class="flex flex-col gap-2">
                            <label asp-for="PhoneNumber" class="font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Số Điện Thoại</label>
                            <input asp-for="PhoneNumber" class="bg-surface-container-low border border-outline/20 rounded-xl px-4 py-3 form-input-focus transition-soft font-body-md" />
                            <span asp-validation-for="PhoneNumber" class="text-error text-sm"></span>
                        </div>

                        <div class="flex flex-col gap-2">
                            <label asp-for="DateOfBirth" class="font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Ngày Sinh</label>
                            <input asp-for="DateOfBirth" type="date" class="bg-surface-container-low border border-outline/20 rounded-xl px-4 py-3 form-input-focus transition-soft font-body-md" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="DateOfBirth" class="text-error text-sm"></span>
                        </div>

                        <div class="flex flex-col gap-2 md:col-span-2">
                            <label asp-for="Nationality" class="font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Quốc Tịch</label>
                            <input asp-for="Nationality" class="bg-surface-container-low border border-outline/20 rounded-xl px-4 py-3 form-input-focus transition-soft font-body-md" placeholder="Ví dụ: Việt Nam" />
                            <span asp-validation-for="Nationality" class="text-error text-sm"></span>
                        </div>

                        <div class="flex flex-col gap-2 md:col-span-2">
                            <label asp-for="Address" class="font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Địa Chỉ Thường Trú</label>
                            <textarea asp-for="Address" class="bg-surface-container-low border border-outline/20 rounded-xl px-4 py-3 form-input-focus transition-soft font-body-md" rows="3"></textarea>
                            <span asp-validation-for="Address" class="text-error text-sm"></span>
                        </div>
                    </div>
                </section>

                <!-- Passport/ID Section -->
                <section class="luxury-card rounded-xl p-8 mb-gutter">
                    <h3 class="font-headline-sm text-headline-sm text-primary mb-6">Giấy Tờ Tùy Thân</h3>
                    
                    <div class="flex flex-col gap-2 mb-8">
                        <label asp-for="PassportNumberString" class="font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Số Hộ Chiếu / CCCD</label>
                        <input asp-for="PassportNumberString" class="bg-surface-container-low border border-outline/20 rounded-xl px-4 py-3 form-input-focus transition-soft font-body-md w-full" placeholder="Nhập số hộ chiếu hoặc CMND" />
                        <span asp-validation-for="PassportNumberString" class="text-error text-sm"></span>
                    </div>

                    <div class="bg-surface-container-low border-2 border-dashed border-outline/20 rounded-xl p-10 text-center flex flex-col items-center group hover:border-primary/50 transition-soft relative overflow-hidden">
                        <input asp-for="PassportImageFile" type="file" id="passportFile" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                        <div class="w-20 h-20 rounded-full bg-white shadow-sm flex items-center justify-center mb-4 group-hover:scale-110 transition-soft">
                            <span class="material-symbols-outlined text-primary text-4xl">contact_page</span>
                        </div>
                        <p class="font-headline-sm text-headline-sm mb-2" id="fileNameDisplay">Tải Lên Passport/CCCD</p>
                        <p class="text-on-surface-variant max-w-md mb-2">Yêu cầu ảnh chụp rõ nét để thủ tục check-in diễn ra nhanh chóng hơn tại resort.</p>
                        <span asp-validation-for="PassportImageFile" class="text-error text-sm block"></span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.PassportImage))
                    {
                        <div class="mt-8 flex items-center gap-6 p-4 bg-surface-container rounded-xl">
                            <img src="@Model.PassportImage" alt="Passport" class="w-24 h-16 object-cover rounded shadow-sm opacity-80" />
                            <div class="flex-1">
                                <p class="font-label-lg text-label-lg">Ảnh Hiện Tại</p>
                                <p class="text-xs text-on-surface-variant">Đã được xác minh</p>
                            </div>
                            <span class="material-symbols-outlined text-primary">verified</span>
                        </div>
                    }
                </section>

                <!-- Action Buttons -->
                <div class="flex justify-end gap-stack-md pt-4 mb-10">
                    <button type="reset" class="px-8 py-4 border-2 border-primary text-primary rounded-xl font-label-lg text-label-lg shadow-sm hover:bg-primary/10 scale-100 hover:scale-[1.02] active:scale-95 transition-all duration-300 font-bold uppercase tracking-widest">Hủy Bỏ Thay Đổi</button>
                    <button type="submit" class="px-12 py-4 bg-primary-container text-on-primary-container rounded-xl font-label-lg text-label-lg shadow-lg hover:shadow-xl scale-100 hover:scale-[1.02] active:scale-95 transition-all duration-300 font-bold uppercase tracking-widest">
                        Lưu Thông Tin
                    </button>
                </div>
            </form>

            <!-- Change Password (Collapsible Interaction) -->
            <section class="luxury-card rounded-xl overflow-hidden mb-gutter">
                <button type="button" class="w-full p-8 flex justify-between items-center hover:bg-surface-container-low transition-colors group" id="pw-toggle">
                    <div class="flex items-center gap-4">
                        <span class="material-symbols-outlined text-primary">lock</span>
                        <h3 class="font-headline-sm text-headline-sm text-primary">Đổi Mật Khẩu</h3>
                    </div>
                    <span class="material-symbols-outlined transform transition-transform duration-300" id="pw-chevron">expand_more</span>
                </button>
                <div class="px-8 pb-8 hidden space-y-stack-lg animate-fade-in" id="pw-content">
                    <form asp-controller="Profile" asp-action="ChangePassword" method="post" class="space-y-4 pt-4 border-t border-outline/10">
                        @Html.AntiForgeryToken()
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="flex flex-col gap-2 md:col-span-2">
                                <label for="currentPassword" class="font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Mật Khẩu Hiện Tại <span class="text-error">*</span></label>
                                <input type="password" id="currentPassword" name="currentPassword" required class="bg-surface-container-low border border-outline/20 rounded-xl px-4 py-3 form-input-focus transition-soft font-body-md" placeholder="Nhập mật khẩu hiện tại" />
                            </div>
                            <div class="flex flex-col gap-2">
                                <label for="newPassword" class="font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Mật Khẩu Mới <span class="text-error">*</span></label>
                                <input type="password" id="newPassword" name="newPassword" required minlength="6" class="bg-surface-container-low border border-outline/20 rounded-xl px-4 py-3 form-input-focus transition-soft font-body-md" placeholder="Nhập mật khẩu mới" />
                            </div>
                            <div class="flex flex-col gap-2">
                                <label for="confirmPassword" class="font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Xác Nhận Mật Khẩu Mới <span class="text-error">*</span></label>
                                <input type="password" id="confirmPassword" name="confirmPassword" required class="bg-surface-container-low border border-outline/20 rounded-xl px-4 py-3 form-input-focus transition-soft font-body-md" placeholder="Nhập lại mật khẩu mới" />
                            </div>
                        </div>
                        <div class="flex justify-end pt-4">
                            <button type="submit" class="px-8 py-3 bg-primary-container text-on-primary-container rounded-xl font-label-lg text-label-lg shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-95 transition-all duration-300 font-bold uppercase tracking-widest">
                                Cập Nhật Mật Khẩu
                            </button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // File upload display
        document.getElementById('passportFile').addEventListener('change', function(e) {
            const fileName = e.target.files[0] ? e.target.files[0].name : 'Tải Lên Passport/CCCD';
            document.getElementById('fileNameDisplay').textContent = fileName;
        });

        // Collapsible Password Section
        const pwToggle = document.getElementById('pw-toggle');
        const pwContent = document.getElementById('pw-content');
        const pwChevron = document.getElementById('pw-chevron');

        pwToggle.addEventListener('click', () => {
            const isHidden = pwContent.classList.contains('hidden');
            if (isHidden) {
                pwContent.classList.remove('hidden');
                pwChevron.style.transform = 'rotate(180deg)';
            } else {
                pwContent.classList.add('hidden');
                pwChevron.style.transform = 'rotate(0deg)';
            }
        });

        // Micro-interactions for form focus
        const inputs = document.querySelectorAll('input, textarea');
        inputs.forEach(input => {
            input.addEventListener('focus', () => {
                input.parentElement.querySelector('label')?.classList.add('text-primary');
            });
            input.addEventListener('blur', () => {
                input.parentElement.querySelector('label')?.classList.remove('text-primary');
            });
        });
    </script>
}
