@{
    ViewData["Title"] = "Liên Hệ";
}

@section Styles {
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .luxury-shadow {
            box-shadow: 0 24px 40px rgba(30, 41, 59, 0.06);
        }
        .hero-overlay {
            background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.7) 100%);
        }
    </style>
}

<main class="pt-0 pb-section-gap-lg bg-background">
    <!-- Hero Section -->
    <section class="relative h-[450px] min-h-[300px] w-full overflow-hidden mb-16">
        <div class="absolute inset-0 w-full h-full bg-cover bg-center" style="background-image: url('/img/hero/hero-1.jpg')"></div>
        <div class="absolute inset-0 hero-overlay flex flex-col justify-center items-center px-margin-mobile md:px-margin-desktop text-center">
            <div class="max-w-container-max mx-auto w-full flex flex-col items-center mt-10">
                <span class="bg-primary-container text-on-primary-container px-4 py-1 rounded-full text-label-sm font-label-lg uppercase tracking-widest mb-4 inline-block">Hỗ Trợ Khách Hàng</span>
                <h1 class="font-display-lg text-display-lg text-white mb-4">Liên Hệ Với Chúng Tôi</h1>
                <p class="font-headline-sm text-headline-sm text-white/90 max-w-2xl italic">
                    Phúc Nguyên Resort luôn sẵn sàng lắng nghe và giải đáp mọi thắc mắc của quý khách. Hãy để chúng tôi đồng hành cùng kỳ nghỉ tuyệt vời của bạn.
                </p>
            </div>
        </div>
    </section>

    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop mb-16">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
            
            <!-- Left Info Column -->
            <div class="lg:col-span-5 space-y-6">
                <!-- Location -->
                <div class="bg-surface-container-lowest p-8 rounded-2xl luxury-shadow border border-outline-variant/30 flex items-start gap-5 transition-transform hover:-translate-y-1">
                    <div class="w-14 h-14 rounded-full bg-primary-container/30 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-primary text-3xl">location_on</span>
                    </div>
                    <div>
                        <h4 class="font-headline-sm text-headline-sm text-on-surface mb-2">Địa Chỉ Resort</h4>
                        <p class="font-body-md text-body-md text-on-surface-variant">123 Đường Ven Biển, Xã Lộc Tiến<br />Huyện Phú Lộc, Thừa Thiên Huế</p>
                    </div>
                </div>

                <!-- Phone -->
                <div class="bg-surface-container-lowest p-8 rounded-2xl luxury-shadow border border-outline-variant/30 flex items-start gap-5 transition-transform hover:-translate-y-1">
                    <div class="w-14 h-14 rounded-full bg-primary-container/30 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-primary text-3xl">phone_in_talk</span>
                    </div>
                    <div>
                        <h4 class="font-headline-sm text-headline-sm text-on-surface mb-2">Đường Dây Nóng</h4>
                        <p class="font-body-md text-body-md text-on-surface-variant">Đặt phòng: +84 (234) 389 8888<br />Lễ tân 24/7: +84 901 234 567</p>
                    </div>
                </div>

                <!-- Email -->
                <div class="bg-surface-container-lowest p-8 rounded-2xl luxury-shadow border border-outline-variant/30 flex items-start gap-5 transition-transform hover:-translate-y-1">
                    <div class="w-14 h-14 rounded-full bg-primary-container/30 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-primary text-3xl">mail</span>
                    </div>
                    <div>
                        <h4 class="font-headline-sm text-headline-sm text-on-surface mb-2">Email Trực Tuyến</h4>
                        <p class="font-body-md text-body-md text-on-surface-variant">Hỗ trợ: support@phucnguyenresort.com<br />Tuyển dụng: hr@phucnguyenresort.com</p>
                    </div>
                </div>
            </div>

            <!-- Right Form Column -->
            <div class="lg:col-span-7">
                <div class="bg-surface-container-lowest p-8 md:p-10 rounded-2xl luxury-shadow border border-outline-variant/30 h-full">
                    <div class="mb-8">
                        <span class="font-label-lg text-label-lg text-primary uppercase tracking-[0.2em] mb-2 block font-bold">Gửi Lời Nhắn</span>
                        <h3 class="font-headline-lg text-headline-sm text-on-surface">Chúng tôi có thể giúp gì cho bạn?</h3>
                    </div>

                    <form action="#" id="contact-form" class="space-y-5">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-label-sm text-on-surface-variant mb-2">Họ và Tên</label>
                                <input type="text" class="w-full px-4 py-3 rounded-lg border border-outline-variant/50 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors bg-surface" placeholder="Nhập tên của bạn" required />
                            </div>
                            <div>
                                <label class="block text-label-sm text-on-surface-variant mb-2">Địa chỉ Email</label>
                                <input type="email" class="w-full px-4 py-3 rounded-lg border border-outline-variant/50 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors bg-surface" placeholder="Nhập email của bạn" required />
                            </div>
                        </div>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-2">Tiêu đề</label>
                            <input type="text" class="w-full px-4 py-3 rounded-lg border border-outline-variant/50 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors bg-surface" placeholder="Vd: Đặt phòng khách đoàn" required />
                        </div>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-2">Nội dung</label>
                            <textarea class="w-full px-4 py-3 rounded-lg border border-outline-variant/50 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors bg-surface min-h-[150px] resize-y" placeholder="Nội dung lời nhắn của bạn..." required></textarea>
                        </div>
                        <button type="submit" class="w-full bg-primary text-on-primary py-4 rounded-xl font-bold text-label-lg uppercase tracking-widest hover:bg-primary/90 transition-all flex justify-center items-center gap-2 mt-4 shadow-md">
                            <span>Gửi Ngay</span>
                            <span class="material-symbols-outlined text-[20px]">send</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Map Section -->
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="rounded-2xl overflow-hidden luxury-shadow border border-outline-variant/30 h-[450px]">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3826.960416972741!2d107.96578051416715!3d16.426786988661054!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3141a0293eb04fa7%3A0x6b607ce2c8bb7e2c!2sPh%C3%BA%20L%E1%BB%99c%2C%20Thua%20Thien%20Hue%2C%20Vietnam!5e0!3m2!1sen!2s!4v1622615414631!5m2!1sen!2s" class="w-full h-full border-0" allowfullscreen="" loading="lazy"></iframe>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Hiệu ứng mượt mà khi submit form
            $('#contact-form').submit(function(e) {
                e.preventDefault();
                let btn = $(this).find('button[type="submit"]');
                let originalContent = btn.html();
                
                btn.html('<span class="material-symbols-outlined animate-spin text-[20px]">sync</span> <span>Đang gửi...</span>');
                btn.prop('disabled', true);
                btn.addClass('opacity-70');
                
                // Giả lập delay gửi mail
                setTimeout(function() {
                    btn.html('<span class="material-symbols-outlined text-[20px]" style="font-variation-settings: \'FILL\' 1;">check_circle</span> <span>Đã Gửi Thành Công</span>');
                    btn.removeClass('bg-primary hover:bg-primary/90 opacity-70');
                    btn.addClass('!bg-green-600 hover:!bg-green-700');
                    
                    $('#contact-form')[0].reset();
                    
                    setTimeout(function() {
                        btn.html(originalContent);
                        btn.removeClass('!bg-green-600 hover:!bg-green-700');
                        btn.addClass('bg-primary hover:bg-primary/90');
                        btn.prop('disabled', false);
                    }, 3000);
                }, 1500);
            });
        });
    </script>
}
