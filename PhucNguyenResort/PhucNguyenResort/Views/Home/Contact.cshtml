@{
    ViewData["Title"] = "Liên Hệ";
}

<style>
    /* Premium Contact Page Styles */
    .contact-hero {
        position: relative;
        padding: 180px 0 100px;
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }
    
    .contact-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.7) 0%, rgba(15, 23, 42, 0.9) 100%);
    }

    .contact-hero-text {
        position: relative;
        z-index: 1;
        text-align: center;
        color: #fff;
    }

    .contact-hero-text h1 {
        font-size: 56px;
        font-family: "Playfair Display", serif;
        font-weight: 700;
        margin-bottom: 20px;
        color: #dfa974;
        text-shadow: 0 4px 15px rgba(0,0,0,0.3);
        animation: slideDown 1s ease-out;
    }

    .contact-hero-text p {
        font-size: 18px;
        max-width: 600px;
        margin: 0 auto;
        color: #e2e8f0;
        animation: fadeIn 1.5s ease-out;
    }

    .contact-section {
        padding: 100px 0;
        background-color: #f8fafc;
    }

    /* Glassmorphism Form */
    .contact-form-wrapper {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 50px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0,0,0,0.05);
        border: 1px solid rgba(255, 255, 255, 0.5);
        position: relative;
        z-index: 10;
        margin-top: -80px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .contact-form-wrapper:hover {
        transform: translateY(-5px);
        box-shadow: 0 30px 60px rgba(223, 169, 116, 0.15), 0 1px 3px rgba(0,0,0,0.05);
    }

    .form-title {
        font-family: "Playfair Display", serif;
        color: #1e293b;
        font-size: 32px;
        margin-bottom: 30px;
        font-weight: 600;
        text-align: center;
    }

    .premium-input {
        background: #f1f5f9;
        border: 2px solid transparent;
        border-radius: 12px;
        padding: 15px 20px;
        width: 100%;
        margin-bottom: 20px;
        color: #334155;
        font-size: 15px;
        transition: all 0.3s ease;
    }

    .premium-input:focus {
        background: #ffffff;
        border-color: #dfa974;
        outline: none;
        box-shadow: 0 0 0 4px rgba(223, 169, 116, 0.1);
    }

    textarea.premium-input {
        min-height: 150px;
        resize: vertical;
    }

    .btn-premium {
        background: #dfa974;
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 16px 40px;
        font-size: 16px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        width: 100%;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(223, 169, 116, 0.3);
    }

    .btn-premium:hover {
        background: #c58f58;
        transform: translateY(-2px);
        box-shadow: 0 15px 25px rgba(223, 169, 116, 0.4);
    }

    /* Info Cards */
    .info-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 40px 30px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
        height: 100%;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: 1px solid #f1f5f9;
        position: relative;
        overflow: hidden;
    }

    .info-card::before {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: #dfa974;
        transform: scaleX(0);
        transition: transform 0.4s ease;
        transform-origin: left;
    }

    .info-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(223, 169, 116, 0.1);
    }

    .info-card:hover::before {
        transform: scaleX(1);
    }

    .info-icon {
        width: 70px;
        height: 70px;
        background: rgba(223, 169, 116, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px;
        color: #dfa974;
        font-size: 28px;
        transition: all 0.3s ease;
    }

    .info-card:hover .info-icon {
        background: #dfa974;
        color: #ffffff;
        transform: scale(1.1);
    }

    .info-card h4 {
        font-size: 20px;
        font-family: "Playfair Display", serif;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 15px;
    }

    .info-card p {
        color: #64748b;
        font-size: 15px;
        line-height: 1.6;
        margin: 0;
    }

    /* Google Map */
    .map-container {
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        height: 500px;
        margin-top: 50px;
    }

    .map-container iframe {
        width: 100%;
        height: 100%;
        border: 0;
        filter: grayscale(20%) contrast(1.1);
    }

    @@keyframes slideDown {
        from { opacity: 0; transform: translateY(-30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
</style>

<!-- Hero Section Begin -->
<section class="contact-hero" style="background-image: url('/img/hero/hero-1.jpg');">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="contact-hero-text">
                    <h1>Liên Hệ Với Chúng Tôi</h1>
                    <p>Phúc Nguyên Resort luôn sẵn sàng lắng nghe và giải đáp mọi thắc mắc của quý khách. Hãy để chúng tôi đồng hành cùng kỳ nghỉ tuyệt vời của bạn.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Hero Section End -->

<!-- Contact Section Begin -->
<section class="contact-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-5 col-md-6 mb-5">
                <!-- Info Cards -->
                <div class="row">
                    <div class="col-lg-12 mb-4">
                        <div class="info-card">
                            <div class="info-icon">
                                <i class="fa fa-map-marker"></i>
                            </div>
                            <h4>Địa Chỉ Resort</h4>
                            <p>123 Đường Ven Biển, Xã Lộc Tiến<br />Huyện Phú Lộc, Thừa Thiên Huế</p>
                        </div>
                    </div>
                    <div class="col-lg-12 mb-4">
                        <div class="info-card">
                            <div class="info-icon">
                                <i class="fa fa-phone"></i>
                            </div>
                            <h4>Đường Dây Nóng</h4>
                            <p>Đặt phòng: +84 (234) 389 8888<br />Lễ tân 24/7: +84 901 234 567</p>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="info-card">
                            <div class="info-icon">
                                <i class="fa fa-envelope"></i>
                            </div>
                            <h4>Email Trực Tuyến</h4>
                            <p>Hỗ trợ: support@phucnguyenresort.com<br />Tuyển dụng: hr@phucnguyenresort.com</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 offset-lg-1 col-md-6">
                <!-- Glassmorphism Contact Form -->
                <div class="contact-form-wrapper">
                    <h3 class="form-title">Gửi Lời Nhắn</h3>
                    <form action="#" id="contact-form">
                        <div class="row">
                            <div class="col-lg-6">
                                <input type="text" class="premium-input" placeholder="Họ và Tên của bạn" required>
                            </div>
                            <div class="col-lg-6">
                                <input type="email" class="premium-input" placeholder="Địa chỉ Email" required>
                            </div>
                            <div class="col-lg-12">
                                <input type="text" class="premium-input" placeholder="Tiêu đề (Vd: Đặt phòng khách đoàn)" required>
                            </div>
                            <div class="col-lg-12">
                                <textarea class="premium-input" placeholder="Nội dung lời nhắn của bạn..." required></textarea>
                            </div>
                            <div class="col-lg-12">
                                <button type="submit" class="btn-premium">Gửi Ngay</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <!-- Map Container -->
                <div class="map-container">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3826.960416972741!2d107.96578051416715!3d16.426786988661054!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3141a0293eb04fa7%3A0x6b607ce2c8bb7e2c!2sPh%C3%BA%20L%E1%BB%99c%2C%20Thua%20Thien%20Hue%2C%20Vietnam!5e0!3m2!1sen!2s!4v1622615414631!5m2!1sen!2s" allowfullscreen="" loading="lazy"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Contact Section End -->

@section Scripts {
    <script>
        $(document).ready(function() {
            // Hiệu ứng mượt mà khi submit form
            $('#contact-form').submit(function(e) {
                e.preventDefault();
                let btn = $(this).find('button[type="submit"]');
                let originalText = btn.text();
                
                btn.html('<i class="fa fa-spinner fa-spin"></i> Đang gửi...');
                btn.prop('disabled', true);
                
                // Giả lập delay gửi mail
                setTimeout(function() {
                    btn.html('<i class="fa fa-check"></i> Đã Gửi Thành Công');
                    btn.css('background-color', '#28a745');
                    btn.css('box-shadow', '0 10px 20px rgba(40, 167, 69, 0.3)');
                    
                    $('#contact-form')[0].reset();
                    
                    setTimeout(function() {
                        btn.html(originalText);
                        btn.css('background-color', '');
                        btn.css('box-shadow', '');
                        btn.prop('disabled', false);
                    }, 3000);
                }, 1500);
            });
        });
    </script>
}
