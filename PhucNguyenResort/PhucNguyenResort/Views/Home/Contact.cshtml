@{
    ViewData["Title"] = "Liên Hệ";
}
@section Styles {
    <link rel="stylesheet" href="~/css/contact-premium.css" asp-append-version="true" />
}

<!-- Hero Section Begin -->
<section class="contact-hero" style="background-image: url('/img/hero/hero-1.jpg');">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="contact-hero-text">
                    <h1>Liên Hệ Với Chúng Tôi</h1>
                    <p>Phúc Nguyên Resort luôn sẵn sàng lắng nghe và giải đáp mọi thắc mắc của quý khách. Hãy để chúng tôi đồng hành cùng kỳ nghỉ tuyệt vời của bạn.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Hero Section End -->

<!-- Contact Section Begin -->
<section class="contact-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-5 col-md-6 mb-5">
                <!-- Info Cards -->
                <div class="row">
                    <div class="col-lg-12 mb-4">
                        <div class="info-card">
                            <div class="info-icon">
                                <i class="fa fa-map-marker"></i>
                            </div>
                            <h4>Địa Chỉ Resort</h4>
                            <p>123 Đường Ven Biển, Xã Lộc Tiến<br />Huyện Phú Lộc, Thừa Thiên Huế</p>
                        </div>
                    </div>
                    <div class="col-lg-12 mb-4">
                        <div class="info-card">
                            <div class="info-icon">
                                <i class="fa fa-phone"></i>
                            </div>
                            <h4>Đường Dây Nóng</h4>
                            <p>Đặt phòng: +84 (234) 389 8888<br />Lễ tân 24/7: +84 901 234 567</p>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="info-card">
                            <div class="info-icon">
                                <i class="fa fa-envelope"></i>
                            </div>
                            <h4>Email Trực Tuyến</h4>
                            <p>Hỗ trợ: support@phucnguyenresort.com<br />Tuyển dụng: hr@phucnguyenresort.com</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 offset-lg-1 col-md-6">
                <!-- Glassmorphism Contact Form -->
                <div class="contact-form-wrapper">
                    <h3 class="form-title">Gửi Lời Nhắn</h3>
                    <form action="#" id="contact-form">
                        <div class="row">
                            <div class="col-lg-6">
                                <input type="text" class="premium-input" placeholder="Họ và Tên của bạn" required>
                            </div>
                            <div class="col-lg-6">
                                <input type="email" class="premium-input" placeholder="Địa chỉ Email" required>
                            </div>
                            <div class="col-lg-12">
                                <input type="text" class="premium-input" placeholder="Tiêu đề (Vd: Đặt phòng khách đoàn)" required>
                            </div>
                            <div class="col-lg-12">
                                <textarea class="premium-input" placeholder="Nội dung lời nhắn của bạn..." required></textarea>
                            </div>
                            <div class="col-lg-12">
                                <button type="submit" class="btn-premium">Gửi Ngay</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <!-- Map Container -->
                <div class="map-container">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3826.960416972741!2d107.96578051416715!3d16.426786988661054!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3141a0293eb04fa7%3A0x6b607ce2c8bb7e2c!2sPh%C3%BA%20L%E1%BB%99c%2C%20Thua%20Thien%20Hue%2C%20Vietnam!5e0!3m2!1sen!2s!4v1622615414631!5m2!1sen!2s" allowfullscreen="" loading="lazy"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Contact Section End -->

@section Scripts {
    <script>
        $(document).ready(function() {
            // Hiệu ứng mượt mà khi submit form
            $('#contact-form').submit(function(e) {
                e.preventDefault();
                let btn = $(this).find('button[type="submit"]');
                let originalText = btn.text();
                
                btn.html('<i class="fa fa-spinner fa-spin"></i> Đang gửi...');
                btn.prop('disabled', true);
                
                // Giả lập delay gửi mail
                setTimeout(function() {
                    btn.html('<i class="fa fa-check"></i> Đã Gửi Thành Công');
                    btn.css('background-color', '#28a745');
                    btn.css('box-shadow', '0 10px 20px rgba(40, 167, 69, 0.3)');
                    
                    $('#contact-form')[0].reset();
                    
                    setTimeout(function() {
                        btn.html(originalText);
                        btn.css('background-color', '');
                        btn.css('box-shadow', '');
                        btn.prop('disabled', false);
                    }, 3000);
                }, 1500);
            });
        });
    </script>
}
