@model IEnumerable<PhucNguyenResort.Models.RoomCategory>

@{
    ViewData["Title"] = "Kết Quả Tìm Kiếm";
}

@section Styles {
    <link rel="stylesheet" href="~/css/search-premium.css" asp-append-version="true" />
}

<!-- Search Hero Section Begin -->
<section class="search-hero" style="background-image: url('/img/room/room-b2.jpg');">
    <div class="search-hero-overlay"></div>
    <div class="container search-hero-content">
        <div class="row">
            <div class="col-lg-12">
                <h2 class="search-hero-title">Phòng Trống Phù Hợp</h2>
                <div class="search-hero-breadcrumb">
                    <a asp-controller="Home" asp-action="Index">Trang Chủ</a>
                    <span>/ Tìm Kiếm</span>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Search Hero Section End -->

<!-- Search Details Section Begin -->
<section class="search-details-section spad pt-0">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <form asp-controller="Home" asp-action="SearchRooms" method="get" class="search-criteria-wrapper">
                    <h5 class="mb-4" style="font-family: 'Playfair Display', serif; color: #1e293b; font-size: 24px; font-weight: 700;">Điều Chỉnh Ngày Đặt & Số Khách</h5>
                    <div class="row w-100 m-0">
                        <div class="col-lg-2 col-md-4 mb-3 mb-lg-0 pl-0">
                            <label style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">Nhận Phòng</label>
                            <input type="text" name="checkIn" class="form-control date-input luxury-input" value="@ViewBag.CheckIn" required autocomplete="off" placeholder="Chọn ngày">
                        </div>
                        <div class="col-lg-2 col-md-4 mb-3 mb-lg-0">
                            <label style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">Trả Phòng</label>
                            <input type="text" name="checkOut" class="form-control date-input luxury-input" value="@ViewBag.CheckOut" required autocomplete="off" placeholder="Chọn ngày">
                        </div>
                        <div class="col-lg-2 col-md-4 mb-3 mb-lg-0">
                            <label style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">Người Lớn</label>
                            <select name="adultsCount" class="form-control luxury-select">
                                @for(int i=1; i<=5; i++) {
                                    if(ViewBag.AdultsCount == i) {
                                        <option value="@i" selected>@i</option>
                                    } else {
                                        <option value="@i">@i</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-4 mb-3 mb-lg-0">
                            <label style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">Trẻ Em</label>
                            <select name="childrenCount" class="form-control luxury-select">
                                @for(int i=0; i<=4; i++) {
                                    if(ViewBag.ChildrenCount == i) {
                                        <option value="@i" selected>@i</option>
                                    } else {
                                        <option value="@i">@i</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-4 mb-3 mb-lg-0">
                            <label style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">Phòng</label>
                            <select name="roomCount" class="form-control luxury-select">
                                @for(int i=1; i<=3; i++) {
                                    if(ViewBag.RoomCount == i) {
                                        <option value="@i" selected>@i Phòng</option>
                                    } else {
                                        <option value="@i">@i Phòng</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-4 d-flex align-items-end pr-0">
                            <div class="d-flex w-100">
                                <button type="submit" class="btn flex-grow-1 luxury-btn">Lọc</button>
                                @if (ViewBag.IsFiltered != null && (bool)ViewBag.IsFiltered)
                                {
                                    <a asp-controller="Home" asp-action="SearchRooms" class="btn ml-2 d-flex justify-content-center align-items-center luxury-btn-outline" title="Xóa Bộ Lọc"><i class="fa fa-refresh"></i></a>
                                }
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="row">
            @if (Model != null && Model.Any())
            {
                <div class="col-lg-12 mb-4">
                    @if (ViewBag.IsFiltered != null && (bool)ViewBag.IsFiltered)
                    {
                        <h3 style="font-family: 'Playfair Display', serif; color: #dfa974;">Tuyệt vời! Chúng tôi tìm thấy @Model.Count() loại phòng phù hợp.</h3>
                    }
                    else
                    {
                        <h3 style="font-family: 'Playfair Display', serif; color: #dfa974;">Khám phá @Model.Count() loại phòng tuyệt đẹp của chúng tôi.</h3>
                    }
                </div>

                <form asp-controller="Bookings" asp-action="Create" method="get" class="w-100" id="multiRoomForm">
                    <input type="hidden" name="checkIn" value="@ViewBag.CheckIn" />
                    <input type="hidden" name="checkOut" value="@ViewBag.CheckOut" />
                    <input type="hidden" name="adults" value="@ViewBag.AdultsCount" />
                    <input type="hidden" name="children" value="@ViewBag.ChildrenCount" />
                    <div class="row">
                        <!-- Left Column: Room List -->
                        <div class="col-lg-8">
                            <div class="row">
                @{
                int imgIndex = 1;
                int roomIndex = 0;
                }
                @foreach (var room in Model)
                {
                    string bgImage = string.IsNullOrEmpty(room.ImageUrl) || room.ImageUrl.Contains("category-") 
                                     ? $"/img/room/room-{imgIndex}.jpg" 
                                     : room.ImageUrl.Replace(" ", "%20");

                    imgIndex++;
                    if (imgIndex > 6) imgIndex = 1;
                    
                    int preQty = (ViewBag.PreselectId != null && ViewBag.PreselectId == room.CategoryId) ? (ViewBag.PreselectQty ?? 1) : 0;

                    <div class="col-12 mb-4">
                        <div class="card border-0 luxury-list-card">
                            <div class="row no-gutters h-100">
                                <div class="col-md-4">
                                    <div class="card-img-wrapper h-100">
                                        <img src="@bgImage" class="card-img-top h-100" style="object-fit: cover;" alt="@room.CategoryName">
                                    </div>
                                </div>
                                <div class="col-md-5 d-flex flex-column justify-content-center" style="padding: 30px;">
                                    <h4 class="card-title" style="font-family: 'Playfair Display', serif; font-size: 24px; color: #1e293b; font-weight: 700; margin-bottom: 10px;">@room.CategoryName</h4>
                                    <p class="card-text text-muted" style="font-size: 15px; line-height: 1.6; margin-bottom: 15px;">
                                        Tận hưởng không gian lưu trú lý tưởng cho @ViewBag.AdultsCount người lớn, @ViewBag.ChildrenCount trẻ em. Tiện nghi đầy đủ và dịch vụ 24/7.
                                    </p>
                                    <div class="room-amenities">
                                        <span class="amenity-pill"><i class="fa fa-arrows-alt"></i> 30 m²</span>
                                        <span class="amenity-pill"><i class="fa fa-user"></i> Tối đa @(room.MaxAdults ?? 2) NL, @(room.MaxChildren ?? 1) TE</span>
                                    </div>
                                </div>
                                <div class="col-md-3 d-flex flex-column justify-content-center align-items-center" style="padding: 30px; background: #f8fafc; border-left: 1px solid #e2e8f0;">
                                    <div class="price-text mb-3 text-center">
                                        <div style="font-size: 22px; font-weight: 700; color: #dfa974;">@(room.PricePerNight?.ToString("N0") ?? "0") VNĐ</div>
                                        <div style="font-size: 13px; color: #64748b;">/ Đêm</div>
                                    </div>
                                    
                                    @if (ViewBag.IsFiltered != null && (bool)ViewBag.IsFiltered && room.AvailableRoomsCount > 0)
                                    {
                                        <div style="color: #dc3545; font-size: 14px; font-weight: 600; margin-bottom: 8px;">
                                            Còn @room.AvailableRoomsCount phòng
                                        </div>
                                    }

                                    <div class="quantity-selector w-100 mb-3">
                                        <div class="input-group luxury-qty-group">
                                            <div class="input-group-prepend">
                                                <button class="btn btn-qty" type="button" onclick="decrementQty(this)">-</button>
                                            </div>
                                            <input type="hidden" name="RoomSelections[@roomIndex].CategoryId" value="@room.CategoryId" />
                                            <input type="number" name="RoomSelections[@roomIndex].Quantity" class="form-control text-center room-qty" value="@preQty" min="0" max="@((ViewBag.IsFiltered != null && (bool)ViewBag.IsFiltered) ? room.AvailableRoomsCount : 10)" readonly data-price="@(room.PricePerNight ?? 0)" />
                                            <div class="input-group-append">
                                                <button class="btn btn-qty" type="button" onclick="incrementQty(this)">+</button>
                                            </div>
                                        </div>
                                    </div>
                                    <a asp-controller="Home" asp-action="RoomDetails" asp-route-id="@room.CategoryId" class="btn luxury-btn-outline w-100" style="height: 40px; line-height: 38px; padding: 0;">Xem Chi Tiết</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    roomIndex++;
                }
                    </div>
                </div>
                        
                        <!-- Right Column: Sidebar Cart -->
                        <div class="col-lg-4 d-none d-lg-block">
                            <div class="booking-sidebar-card sticky-top" style="top: 100px; background: #fff; border: 1px solid #eaeaea; border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); padding: 25px; margin-bottom: 30px;">
                                <h3 style="font-family: 'Playfair Display', serif; font-size: 22px; color: #1e293b; font-weight: 700; margin-bottom: 20px; border-bottom: 1px solid #eaeaea; padding-bottom: 15px;">Chuyến đi</h3>
                                
                                <div class="trip-details mb-4">
                                    <h5 style="font-size: 16px; color: #1e293b; font-weight: 600; margin-bottom: 10px;">Phúc Nguyên Resort</h5>
                                    <div style="font-size: 14px; color: #64748b; margin-bottom: 5px;">
                                        <i class="fa fa-calendar mr-2" style="color: #dfa974;"></i>
                                        @ViewBag.CheckIn <i class="fa fa-arrow-right mx-1" style="font-size: 10px;"></i> @ViewBag.CheckOut
                                    </div>
                                    <div style="font-size: 14px; color: #64748b;">
                                        <i class="fa fa-user mr-2" style="color: #dfa974;"></i>
                                        @ViewBag.AdultsCount Người lớn, @ViewBag.ChildrenCount Trẻ em
                                    </div>
                                </div>

                                <div id="sidebar-selected-rooms" class="mb-4" style="border-top: 1px dashed #eaeaea; padding-top: 15px;">
                                    <!-- Selected rooms will be injected here by JS -->
                                    <div class="text-center text-muted py-3" id="sidebar-empty-msg" style="font-size: 14px; font-style: italic;">
                                        Chưa có phòng nào được chọn.
                                    </div>
                                </div>

                                <div class="sidebar-total" style="border-top: 1px solid #eaeaea; padding-top: 15px; margin-bottom: 20px;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span style="font-size: 16px; color: #1e293b; font-weight: 600;">Tổng cộng:</span>
                                        <span id="sidebar-total-price" style="font-size: 24px; color: #dfa974; font-weight: 700;">0 đ</span>
                                    </div>
                                    <div style="font-size: 12px; color: #888; text-align: right;">(Đã bao gồm thuế, phí)</div>
                                </div>

                                <button type="button" class="btn w-100" id="sidebar-btn-submit" onclick="submitMultiRoomForm()" style="background-color: #dfa974; color: white; padding: 14px; font-weight: 600; font-size: 16px; text-transform: uppercase; border-radius: 4px; transition: 0.3s;" disabled>Tiếp tục</button>
                                
                                <div class="mt-4 p-3" style="background: #fff8f0; border-radius: 6px; border: 1px solid #f9e5cc;">
                                    <div style="display: flex; align-items: flex-start;">
                                        <i class="fa fa-credit-card mt-1 mr-2" style="color: #d39e6a;"></i>
                                        <div>
                                            <strong style="color: #d39e6a; font-size: 13px; display: block; margin-bottom: 3px;">THANH TOÁN AN TOÀN</strong>
                                            <span style="font-size: 12px; color: #666;">Bảo mật mọi thông tin giao dịch của bạn bằng mã hóa SSL 256-bit.</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                
                <!-- Sticky Checkout Bar (Mobile Only) -->
                <div class="sticky-checkout-bar d-block d-lg-none">
                    <div class="container d-flex justify-content-between align-items-center">
                        <div class="checkout-info">
                            <span class="total-rooms-label">Đã chọn: <strong id="totalRoomsCount">0</strong> phòng</span>
                            <span class="total-price-label d-none d-md-inline-block ml-4">Tổng tạm tính: <strong id="totalPriceAmount" style="color: #dfa974; font-size: 24px;">0 VNĐ</strong></span>
                        </div>
                        <button type="button" class="btn luxury-btn px-4 px-md-5" id="btnSubmitBooking" onclick="submitMultiRoomForm()" disabled>Tiến Hành Đặt</button>
                    </div>
                </div>
                </form>
            }
            else
            {
                <div class="col-lg-12 text-center py-5">
                    <img src="/img/not-found.svg" alt="No rooms" style="max-width: 200px; margin-bottom: 30px; opacity: 0.5; filter: grayscale(100%);" onerror="this.style.display='none'">
                    <h3 style="font-family: 'Playfair Display', serif; color: #1e293b; margin-bottom: 15px;">Rất tiếc! Không còn phòng trống.</h3>
                    <p style="color: #64748b; font-size: 18px; max-width: 600px; margin: 0 auto 30px;">
                        Các loại phòng thỏa mãn yêu cầu của bạn đã được đặt hết trong khoảng thời gian từ @ViewBag.CheckIn đến @ViewBag.CheckOut.
                    </p>
                    <a asp-controller="Home" asp-action="Index" class="btn text-white" style="background-color: #dfa974; border-radius: 0; padding: 14px 30px; font-weight: 600; font-size: 14px; text-transform: uppercase;">Thay Đổi Ngày Đặt</a>
                </div>
            }
        </div>
    </div>
</section>
<!-- Search Details Section End -->

@section Scripts {
    <script>
        function submitMultiRoomForm() {
            var totalRooms = parseInt(document.getElementById('totalRoomsCount').innerText) || 0;
            if (totalRooms <= 0) {
                alert('Vui lòng chọn số lượng ít nhất một phòng để tiếp tục!');
                return;
            }
            document.getElementById('multiRoomForm').submit();
        }

        function calculateTotal() {
            var totalRooms = 0;
            var totalPrice = 0;
            var selectedRoomsHtml = '';
            var hasSelection = false;

            document.querySelectorAll('.room-qty').forEach(function(input) {
                var qty = parseInt(input.value) || 0;
                if (qty > 0) {
                    var price = parseFloat(input.getAttribute('data-price')) || 0;
                    totalRooms += qty;
                    totalPrice += (qty * price);
                    hasSelection = true;

                    // Get room name from the DOM tree
                    var cardBody = input.closest('.luxury-list-card');
                    var roomName = cardBody.querySelector('.card-title').innerText;
                    var roomPriceStr = (price * qty).toLocaleString('vi-VN');

                    selectedRoomsHtml += `
                        <div class="sidebar-room-item" style="margin-bottom: 12px;">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <strong style="font-size: 14px; color: #1e293b; max-width: 70%; line-height: 1.4;">${roomName}</strong>
                                <span style="font-size: 14px; font-weight: 600; color: #dfa974;">${roomPriceStr} đ</span>
                            </div>
                            <div style="font-size: 13px; color: #64748b;">x${qty} phòng</div>
                        </div>
                    `;
                }
            });

            // Update Desktop Sidebar
            var sidebarMsg = document.getElementById('sidebar-empty-msg');
            var sidebarList = document.getElementById('sidebar-selected-rooms');
            var sidebarBtn = document.getElementById('sidebar-btn-submit');
            var sidebarTotal = document.getElementById('sidebar-total-price');

            if (hasSelection) {
                sidebarMsg.style.display = 'none';
                // Remove existing items, keep the empty msg element
                Array.from(sidebarList.children).forEach(child => {
                    if (child.id !== 'sidebar-empty-msg') sidebarList.removeChild(child);
                });
                // Append new HTML
                sidebarList.insertAdjacentHTML('beforeend', selectedRoomsHtml);
                sidebarBtn.disabled = false;
                sidebarTotal.innerText = totalPrice.toLocaleString('vi-VN') + ' đ';
            } else {
                sidebarMsg.style.display = 'block';
                Array.from(sidebarList.children).forEach(child => {
                    if (child.id !== 'sidebar-empty-msg') sidebarList.removeChild(child);
                });
                sidebarBtn.disabled = true;
                sidebarTotal.innerText = '0 đ';
            }

            // Update Mobile Bottom Bar
            document.getElementById('totalRoomsCount').innerText = totalRooms;
            document.getElementById('totalPriceAmount').innerText = totalPrice.toLocaleString('vi-VN') + ' VNĐ';
            document.getElementById('btnSubmitBooking').disabled = (totalRooms === 0);
        }

        function decrementQty(btn) {
            var input = btn.closest('.input-group').querySelector('.room-qty');
            var val = parseInt(input.value) || 0;
            var min = parseInt(input.min) || 0;
            if (val > min) {
                input.value = val - 1;
                calculateTotal();
            }
        }

        function incrementQty(btn) {
            var input = btn.closest('.input-group').querySelector('.room-qty');
            var val = parseInt(input.value) || 0;
            var max = parseInt(input.max) || 10;
            if (val < max) {
                input.value = val + 1;
                calculateTotal();
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            calculateTotal();
        });
    </script>
}
