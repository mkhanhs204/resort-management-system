@model IEnumerable<PhucNguyenResort.Models.RoomCategory>

@{
    ViewData["Title"] = "Kết Quả Tìm Kiếm";
}

@section Styles {
    <link rel="stylesheet" href="~/css/search-premium.css" asp-append-version="true" />
}

<!-- Search Hero Section Begin -->
<section class="search-hero" style="background-image: url('/img/room/room-b2.jpg');">
    <div class="search-hero-overlay"></div>
    <div class="container search-hero-content">
        <div class="row">
            <div class="col-lg-12">
                <h2 class="search-hero-title">Phòng Trống Phù Hợp</h2>
                <div class="search-hero-breadcrumb">
                    <a asp-controller="Home" asp-action="Index">Trang Chủ</a>
                    <span>/ Tìm Kiếm</span>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Search Hero Section End -->

<!-- Search Details Section Begin -->
<section class="search-details-section spad pt-0">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <form asp-controller="Home" asp-action="SearchRooms" method="get" class="search-criteria-wrapper">
                    <h5 class="mb-4" style="font-family: 'Playfair Display', serif; color: #1e293b; font-size: 24px; font-weight: 700;">Điều Chỉnh Ngày Đặt & Số Khách</h5>
                    <div class="row w-100 m-0">
                        <div class="col-lg-2 col-md-4 mb-3 mb-lg-0 pl-0">
                            <label style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">Nhận Phòng</label>
                            <input type="text" name="checkIn" class="form-control date-input luxury-input" value="@ViewBag.CheckIn" required autocomplete="off" placeholder="Chọn ngày">
                        </div>
                        <div class="col-lg-2 col-md-4 mb-3 mb-lg-0">
                            <label style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">Trả Phòng</label>
                            <input type="text" name="checkOut" class="form-control date-input luxury-input" value="@ViewBag.CheckOut" required autocomplete="off" placeholder="Chọn ngày">
                        </div>
                        <div class="col-lg-2 col-md-4 mb-3 mb-lg-0">
                            <label style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">Người Lớn</label>
                            <select name="adultsCount" class="form-control luxury-select">
                                @for(int i=1; i<=5; i++) {
                                    if(ViewBag.AdultsCount == i) {
                                        <option value="@i" selected>@i</option>
                                    } else {
                                        <option value="@i">@i</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-4 mb-3 mb-lg-0">
                            <label style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">Trẻ Em</label>
                            <select name="childrenCount" class="form-control luxury-select">
                                @for(int i=0; i<=4; i++) {
                                    if(ViewBag.ChildrenCount == i) {
                                        <option value="@i" selected>@i</option>
                                    } else {
                                        <option value="@i">@i</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-4 mb-3 mb-lg-0">
                            <label style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">Phòng</label>
                            <select name="roomCount" class="form-control luxury-select">
                                @for(int i=1; i<=3; i++) {
                                    if(ViewBag.RoomCount == i) {
                                        <option value="@i" selected>@i Phòng</option>
                                    } else {
                                        <option value="@i">@i Phòng</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-4 d-flex align-items-end pr-0">
                            <div class="d-flex w-100">
                                <button type="submit" class="btn flex-grow-1 luxury-btn">Lọc</button>
                                @if (ViewBag.IsFiltered != null && (bool)ViewBag.IsFiltered)
                                {
                                    <a asp-controller="Home" asp-action="SearchRooms" class="btn ml-2 d-flex justify-content-center align-items-center luxury-btn-outline" title="Xóa Bộ Lọc"><i class="fa fa-refresh"></i></a>
                                }
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="row">
            @if (Model != null && Model.Any())
            {
                <div class="col-lg-12 mb-4">
                    @if (ViewBag.IsFiltered != null && (bool)ViewBag.IsFiltered)
                    {
                        <h3 style="font-family: 'Playfair Display', serif; color: #dfa974;">Tuyệt vời! Chúng tôi tìm thấy @Model.Count() loại phòng phù hợp.</h3>
                    }
                    else
                    {
                        <h3 style="font-family: 'Playfair Display', serif; color: #dfa974;">Khám phá @Model.Count() loại phòng tuyệt đẹp của chúng tôi.</h3>
                    }
                </div>

                int imgIndex = 1;
                foreach (var room in Model)
                {
                    string bgImage = string.IsNullOrEmpty(room.ImageUrl) || room.ImageUrl.Contains("category-") 
                                     ? $"/img/room/room-b{imgIndex}.jpg" 
                                     : room.ImageUrl.Replace(" ", "%20");

                    imgIndex++;
                    if (imgIndex > 4) imgIndex = 1;

                    <div class="col-lg-4 col-md-6 mb-5">
                        <div class="card h-100 border-0 luxury-card">
                            <div class="card-img-wrapper">
                                <img src="@bgImage" class="card-img-top" alt="@room.CategoryName">
                                <div class="price-pill">
                                    @(room.PricePerNight?.ToString("N0") ?? "0") VNĐ <span>/ Đêm</span>
                                </div>
                            </div>
                            <div class="card-body d-flex flex-column" style="padding: 30px;">
                                <h4 class="card-title" style="font-family: 'Playfair Display', serif; font-size: 24px; color: #1e293b; font-weight: 700; margin-bottom: 15px;">@room.CategoryName</h4>
                                <p class="card-text text-muted" style="font-size: 15px; line-height: 1.7; margin-bottom: 25px; flex-grow: 1;">
                                    Tận hưởng không gian lưu trú lý tưởng cho @ViewBag.AdultsCount người lớn, @ViewBag.ChildrenCount trẻ em. Tiện nghi đầy đủ, view tuyệt đẹp và dịch vụ phòng 24/7.
                                </p>
                                <div class="room-amenities mb-4">
                                    <span class="amenity-pill"><i class="fa fa-arrows-alt"></i> 30 m²</span>
                                    <span class="amenity-pill"><i class="fa fa-user"></i> Tối đa @(room.MaxAdults ?? 2) người lớn, @(room.MaxChildren ?? 1) trẻ em</span>
                                </div>
                                <a asp-controller="Home" asp-action="RoomDetails" asp-route-id="@room.CategoryId" 
                                   class="btn w-100 luxury-book-btn">
                                    Chi Tiết & Đặt Phòng
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-lg-12 text-center py-5">
                    <img src="/img/not-found.svg" alt="No rooms" style="max-width: 200px; margin-bottom: 30px; opacity: 0.5; filter: grayscale(100%);" onerror="this.style.display='none'">
                    <h3 style="font-family: 'Playfair Display', serif; color: #1e293b; margin-bottom: 15px;">Rất tiếc! Không còn phòng trống.</h3>
                    <p style="color: #64748b; font-size: 18px; max-width: 600px; margin: 0 auto 30px;">
                        Các loại phòng thỏa mãn yêu cầu của bạn đã được đặt hết trong khoảng thời gian từ @ViewBag.CheckIn đến @ViewBag.CheckOut.
                    </p>
                    <a asp-controller="Home" asp-action="Index" class="btn text-white" style="background-color: #dfa974; border-radius: 0; padding: 14px 30px; font-weight: 600; font-size: 14px; text-transform: uppercase;">Thay Đổi Ngày Đặt</a>
                </div>
            }
        </div>
    </div>
</section>
<!-- Search Details Section End -->
