@model IEnumerable<PhucNguyenResort.Models.RoomCategory>

@{
    ViewData["Title"] = "Tìm Kiếm Phòng";
}

<div>
    <!-- Hero Banner -->
    <section class="relative h-[600px] flex flex-col justify-center items-center text-center px-margin-mobile overflow-hidden">
        <div class="absolute inset-0 z-0">
            <div class="w-full h-full bg-cover bg-center transition-transform duration-1000 hover:scale-105" style="background-image: url('https://nhaxinhdesign.com/wp-content/uploads/2023/02/noi-that-re-sort-10.jpg')">
            </div>
            <div class="absolute inset-0 bg-on-surface/40"></div>
        </div>
        <div class="relative z-10">
            <nav class="mb-4">
                <ol class="flex items-center justify-center space-x-2 text-surface-container-lowest/80 font-label-sm text-label-sm uppercase tracking-widest">
                    <li><a class="hover:text-primary-fixed" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><span class="material-symbols-outlined text-[14px]">chevron_right</span></li>
                    <li class="text-white">Tìm Kiếm Phòng</li>
                </ol>
            </nav>
            <h1 class="font-headline-lg text-headline-lg text-white mb-2">Phòng Trống Phù Hợp</h1>
            <p class="text-white/80 font-body-md text-body-md max-w-lg mx-auto">Khám phá không gian nghỉ dưỡng sang trọng bậc nhất giữa lòng thiên nhiên.</p>
        </div>
    </section>

    <!-- Sticky Search Bar -->
    <section class="sticky top-[64px] z-40 bg-surface shadow-sm border-b border-outline-variant/10">
        <div class="max-w-container-max mx-auto px-margin-desktop py-4">
            <form asp-controller="Home" asp-action="SearchRooms" method="get" class="flex flex-wrap md:flex-nowrap items-center gap-6">
                @{
                    string isoCheckIn = "";
                    string isoCheckOut = "";
                    if (!string.IsNullOrEmpty(ViewBag.CheckIn) && !string.IsNullOrEmpty(ViewBag.CheckOut))
                    {
                        isoCheckIn = DateTime.ParseExact(ViewBag.CheckIn, "dd/MM/yyyy", null).ToString("yyyy-MM-dd");
                        isoCheckOut = DateTime.ParseExact(ViewBag.CheckOut, "dd/MM/yyyy", null).ToString("yyyy-MM-dd");
                    }
                }
                
                <div class="flex-1 min-w-[140px]">
                    <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">Ngày Đến</label>
                    <div class="flex items-center border border-outline-variant/30 rounded-lg px-3 py-2 bg-surface-container-low focus-within:border-primary-container transition-colors">
                        <span class="material-symbols-outlined text-outline mr-2 text-[20px]">event</span>
                        <input type="date" id="checkInSearch" name="checkIn" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="bg-transparent border-none outline-none text-body-md font-medium w-full" value="@isoCheckIn" required>
                    </div>
                </div>
                
                <div class="flex-1 min-w-[140px]">
                    <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">Ngày Đi</label>
                    <div class="flex items-center border border-outline-variant/30 rounded-lg px-3 py-2 bg-surface-container-low focus-within:border-primary-container transition-colors">
                        <span class="material-symbols-outlined text-outline mr-2 text-[20px]">event</span>
                        <input type="date" id="checkOutSearch" name="checkOut" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="bg-transparent border-none outline-none text-body-md font-medium w-full" value="@isoCheckOut" required>
                    </div>
                </div>
                
                <div class="flex-1 min-w-[110px]">
                    <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">Người Lớn</label>
                    <div class="flex items-center border border-outline-variant/30 rounded-lg px-3 py-2 bg-surface-container-low focus-within:border-primary-container transition-colors">
                        <span class="material-symbols-outlined text-outline mr-2 text-[20px]">person</span>
                        <select name="adultsCount" class="bg-transparent border-none outline-none text-body-md font-medium w-full">
                            @for (int i = 1; i <= 10; i++)
                            {
                                if (ViewBag.AdultsCount == i)
                                {
                                    <option value="@i" selected>@i</option>
                                }
                                else
                                {
                                    <option value="@i">@i</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="flex-1 min-w-[110px]">
                    <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">Trẻ Em</label>
                    <div class="flex items-center border border-outline-variant/30 rounded-lg px-3 py-2 bg-surface-container-low focus-within:border-primary-container transition-colors">
                        <span class="material-symbols-outlined text-outline mr-2 text-[20px]">child_care</span>
                        <select name="childrenCount" class="bg-transparent border-none outline-none text-body-md font-medium w-full">
                            @for (int i = 0; i <= 10; i++)
                            {
                                if (ViewBag.ChildrenCount == i)
                                {
                                    <option value="@i" selected>@i</option>
                                }
                                else
                                {
                                    <option value="@i">@i</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                
                <div class="flex-shrink-0">
                    <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">&nbsp;</label>
                    <button type="submit" class="flex items-center border border-outline-variant/30 rounded-lg px-6 py-2 bg-surface-container-low hover:border-primary-container hover:text-primary transition-colors h-[42px]">
                        <span class="material-symbols-outlined text-outline mr-2">search</span>
                        <span class="text-body-md font-medium">Tìm</span>
                    </button>
                </div>
            </form>
        </div>
    </section>

    <!-- Main Content Area -->
    <div class="max-w-container-max mx-auto px-margin-desktop py-section-gap-md">
        <div class="flex flex-col lg:flex-row gap-gutter">
            
            <!-- Room List (Left Column) -->
            <div class="lg:w-2/3 flex flex-col gap-8">
                <div class="flex justify-between items-end mb-4">
                    <h2 class="font-headline-sm text-headline-sm text-on-surface">Kết quả tìm kiếm (@(Model?.Count() ?? 0) phòng)</h2>
                    <div class="text-on-surface-variant font-label-lg text-label-lg border-b border-outline-variant/50 cursor-pointer hover:text-primary">Sắp xếp: Giá thấp đến cao</div>
                </div>
                
                @if (Model != null && Model.Any())
                {
                    int i = 0;
                    foreach (var room in Model)
                    {
                        i++;
                        string bgImage = string.IsNullOrEmpty(room.ImageUrl) ? $"/img/room/room-b{((i % 4) + 1)}.jpg" : room.ImageUrl;
                        
                        <div class="flex flex-col md:flex-row bg-surface-container-lowest border border-outline-variant/20 rounded-xl overflow-hidden luxury-shadow transition-all duration-500 hover:-translate-y-1">
                            <div class="md:w-2/5 relative h-64 md:h-auto">
                                <img class="w-full h-full object-cover" src="@bgImage" alt="@room.CategoryName" />
                            </div>
                            <div class="md:w-3/5 p-6 flex flex-col">
                                <div class="flex justify-between items-start mb-2">
                                    <h3 class="font-headline-sm text-headline-sm text-on-surface">@room.CategoryName</h3>
                                    @{
                                        var reviews = ViewBag.Reviews as IEnumerable<PhucNguyenResort.ViewModels.Reviews.ReviewListVM>;
                                        if (reviews != null)
                                        {
                                            var roomReviews = reviews.Where(r => r.ServiceType == "Room" && r.ServiceName == room.CategoryName);
                                            if (roomReviews.Any())
                                            {
                                                var avgRating = roomReviews.Average(r => r.Rating) ?? 0.0;
                                                <div class="flex items-center text-primary-container">
                                                    <span class="material-symbols-outlined fill text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                                    <span class="ml-1 font-label-lg text-label-lg font-bold">@avgRating.ToString("F1")</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="flex items-center text-on-surface-variant">
                                                    <span class="text-[13px] italic whitespace-nowrap">Chưa có đánh giá</span>
                                                </div>
                                            }
                                        }
                                    }
                                </div>
                                <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2 mb-4">
                                    @(string.IsNullOrEmpty(room.Description) ? "Trải nghiệm tầm nhìn vô cực ra đại dương từ ban công riêng. Nội thất hiện đại kết hợp hoàn hảo giữa gỗ tự nhiên và đá cẩm thạch." : room.Description)
                                </p>
                                
                                <div class="flex flex-wrap gap-4 mb-6">
                                    <div class="flex items-center text-on-secondary-container font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined mr-1 text-[18px]">group</span> @(room.MaxAdults ?? 2) Người Lớn, @(room.MaxChildren ?? 0) Trẻ em
                                    </div>
                                    <div class="flex items-center text-on-secondary-container font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined mr-1 text-[18px]">king_bed</span> Giường King
                                    </div>
                                    <div class="flex items-center text-on-secondary-container font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined mr-1 text-[18px]">wifi</span> Free Wi-Fi
                                    </div>
                                    <div class="flex items-center text-on-secondary-container font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined mr-1 text-[18px]">hot_tub</span> Bồn tắm
                                    </div>
                                    @if (ViewBag.IsFiltered == true)
                                    {
                                        <div class="flex items-center text-green-600 font-semibold font-label-sm text-label-sm">
                                            <span class="material-symbols-outlined mr-1 text-[18px]">meeting_room</span> Còn @room.AvailableRoomsCount phòng trống
                                        </div>
                                    }
                                </div>
                                
                                <div class="mt-auto flex justify-between items-end border-t border-outline-variant/10 pt-4">
                                    <div>
                                        <span class="block text-on-surface-variant font-label-sm text-label-sm uppercase">Giá mỗi đêm</span>
                                        <span class="text-headline-sm text-primary font-bold">@room.PricePerNight?.ToString("N0")đ</span>
                                    </div>
                                    <div class="flex gap-2">
                                        <a asp-controller="Home" asp-action="RoomDetails" asp-route-id="@room.CategoryId" asp-route-checkIn="@ViewBag.CheckIn" asp-route-checkOut="@ViewBag.CheckOut" class="px-4 py-2 border border-outline-variant/50 rounded-lg text-on-surface-variant hover:bg-surface-container font-label-lg transition-colors flex items-center justify-center">
                                            Chi tiết
                                        </a>
                                        <button onclick="addToCart(@room.CategoryId, '@room.CategoryName', @(room.PricePerNight ?? 0), @room.AvailableRoomsCount)" class="bg-primary text-white font-label-lg px-6 py-2.5 rounded-lg hover:bg-on-primary-fixed-variant transition-colors luxury-shadow">
                                            Thêm
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="w-full text-center py-10 bg-surface-container-low rounded-xl">
                        <span class="material-symbols-outlined text-4xl text-outline mb-2 block">search_off</span>
                        <p class="font-body-lg text-on-surface-variant">Không tìm thấy phòng nào phù hợp với yêu cầu của bạn.</p>
                    </div>
                }
            </div>
            
            <!-- Sidebar Cart (Right Column) -->
            <aside class="lg:w-1/3">
                <form id="cartForm" asp-controller="Bookings" asp-action="Create" method="get" class="sticky top-[190px] z-30 bg-surface-container-low border border-outline-variant/20 rounded-xl p-4 luxury-shadow">
                    <input type="hidden" name="checkIn" id="cartCheckIn" value="@ViewBag.CheckIn" />
                    <input type="hidden" name="checkOut" id="cartCheckOut" value="@ViewBag.CheckOut" />
                    <input type="hidden" name="adults" value="@(ViewBag.AdultsCount ?? 2)" />
                    <input type="hidden" name="children" value="@(ViewBag.ChildrenCount ?? 0)" />
                    <div id="hiddenInputsContainer"></div>
                    
                    <h3 class="font-headline-sm text-[18px] text-on-surface mb-3 pb-2 border-b border-outline-variant/20">Tóm tắt chuyến đi</h3>
                    <div class="space-y-1.5 mb-4">
                        <div class="flex justify-between">
                            <span class="text-on-surface-variant text-[13px] font-medium">Check-in:</span>
                            <span class="font-bold text-on-surface text-[13px]" id="lblCheckIn">@(string.IsNullOrEmpty(ViewBag.CheckIn) ? "Chưa chọn" : ViewBag.CheckIn)</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-on-surface-variant text-[13px] font-medium">Check-out:</span>
                            <span class="font-bold text-on-surface text-[13px]" id="lblCheckOut">@(string.IsNullOrEmpty(ViewBag.CheckOut) ? "Chưa chọn" : ViewBag.CheckOut)</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-on-surface-variant text-[13px] font-medium">Số đêm:</span>
                            <span class="font-bold text-on-surface text-[13px]"><span id="lblNights">0</span> Đêm</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-on-surface-variant text-[13px] font-medium">Khách:</span>
                            <span class="font-bold text-on-surface text-[13px]">@(ViewBag.AdultsCount ?? 2) Người lớn@(ViewBag.ChildrenCount > 0 ? $", {ViewBag.ChildrenCount} Trẻ em" : "")</span>
                        </div>
                    </div>
                    
                    <div class="space-y-2 mb-4">
                        <div class="text-on-surface-variant font-label-sm text-[11px] uppercase tracking-widest border-b border-outline-variant/10 pb-1.5">Phòng đã chọn</div>
                        <div id="cartItemsContainer" class="flex flex-col gap-2 max-h-[20vh] overflow-y-auto pr-1">
                            <div class="flex items-center justify-center py-3 bg-surface/50 border border-dashed border-outline-variant/30 rounded-lg text-on-surface-variant italic text-center text-[13px]" id="emptyCartMsg">
                                Vui lòng chọn phòng để tiếp tục
                            </div>
                        </div>
                    </div>
                    
                    <div class="pt-3 border-t border-outline-variant/20 mb-4">
                        <div class="flex justify-between items-end">
                            <span class="text-[16px] font-medium text-on-surface">Tổng cộng:</span>
                            <div class="text-right">
                                <span class="block text-[10px] text-on-surface-variant mb-0.5">(Đã bao gồm VAT & phí)</span>
                                <span class="text-[20px] text-primary font-bold leading-none" id="lblTotal">0đ</span>
                            </div>
                        </div>
                    </div>
                    
                    <button type="submit" id="btnCheckout" disabled class="w-full bg-primary-container text-on-primary-container font-label-lg text-[13px] py-2.5 rounded-lg transition-all duration-300 uppercase tracking-widest disabled:opacity-50 disabled:cursor-not-allowed hover:opacity-90">
                        Thanh toán
                    </button>
                    <div class="mt-2 flex items-center justify-center gap-1.5 text-on-surface-variant text-[11px]">
                        <span class="material-symbols-outlined text-[13px]">lock</span>
                        Thanh toán bảo mật 100%
                    </div>
                </form>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var dateRangeInput = document.getElementById('dateRangeInput');
            if (dateRangeInput && !dateRangeInput.value) {
                // Initial placeholder value setup if necessary
            }

            var checkInElem = document.getElementById('checkInSearch');
            var checkOutElem = document.getElementById('checkOutSearch');
            if (checkInElem && checkOutElem) {
                checkInElem.addEventListener('change', function() {
                    checkOutElem.setAttribute('min', this.value);
                });
                if (checkInElem.value) {
                    checkOutElem.setAttribute('min', checkInElem.value);
                }
            }
        });

        // Cart State
        let cart = [];
        let totalNights = 0;

        // Parse date from dd/MM/yyyy to calculate nights
        function calculateNights() {
            const checkInStr = document.getElementById('cartCheckIn').value;
            const checkOutStr = document.getElementById('cartCheckOut').value;
            
            if (!checkInStr || !checkOutStr) return 0;
            
            const [d1, m1, y1] = checkInStr.split('/');
            const [d2, m2, y2] = checkOutStr.split('/');
            
            const dIn = new Date(y1, m1 - 1, d1);
            const dOut = new Date(y2, m2 - 1, d2);
            
            const diffTime = Math.abs(dOut - dIn);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            return diffDays > 0 ? diffDays : 0;
        }

        totalNights = calculateNights();
        document.getElementById('lblNights').innerText = totalNights;

        // Make addToCart globally accessible
        window.addToCart = function(categoryId, categoryName, pricePerNight, availableCount) {
            if (totalNights === 0) {
                alert('Vui lòng chọn Ngày nhận - trả phòng hợp lệ trước khi chọn phòng.');
                document.getElementById('dateRangeInput').focus();
                return;
            }

            const existingItem = cart.find(i => i.categoryId === categoryId);
            if (existingItem) {
                if (existingItem.quantity >= availableCount) {
                    alert(`Không thể chọn thêm. Chỉ còn ${availableCount} phòng trống cho loại phòng này.`);
                    return;
                }
                existingItem.quantity += 1;
            } else {
                if (availableCount <= 0) {
                    alert('Rất tiếc, loại phòng này đã hết phòng trống.');
                    return;
                }
                cart.push({
                    categoryId: categoryId,
                    categoryName: categoryName,
                    pricePerNight: pricePerNight,
                    availableCount: availableCount,
                    quantity: 1
                });
            }
            updateCartUI();
        };

        window.removeFromCart = function(categoryId) {
            cart = cart.filter(i => i.categoryId !== categoryId);
            updateCartUI();
        };

        window.decreaseCartQty = function(categoryId) {
            const item = cart.find(i => i.categoryId === categoryId);
            if (item) {
                item.quantity -= 1;
                if (item.quantity <= 0) {
                    removeFromCart(categoryId);
                } else {
                    updateCartUI();
                }
            }
        };

        window.increaseCartQty = function(categoryId) {
            const item = cart.find(i => i.categoryId === categoryId);
            if (item) {
                if (item.quantity >= item.availableCount) {
                    alert(`Không thể chọn thêm. Chỉ còn ${item.availableCount} phòng trống cho loại phòng này.`);
                    return;
                }
                item.quantity += 1;
                updateCartUI();
            }
        };

        function updateCartUI() {
            const container = document.getElementById('cartItemsContainer');
            const hiddenInputsContainer = document.getElementById('hiddenInputsContainer');
            const emptyMsg = document.getElementById('emptyCartMsg');
            const btnCheckout = document.getElementById('btnCheckout');
            const lblTotal = document.getElementById('lblTotal');

            // Clear containers
            hiddenInputsContainer.innerHTML = '';
            
            if (cart.length === 0) {
                container.innerHTML = `<div class="flex items-center justify-center py-10 bg-surface/50 border border-dashed border-outline-variant/30 rounded-lg text-on-surface-variant italic text-center" id="emptyCartMsg">
                    Vui lòng chọn phòng<br/>để tiếp tục
                </div>`;
                lblTotal.innerText = '0đ';
                btnCheckout.disabled = true;
                return;
            }

            // Not empty, rebuild HTML
            let html = '';
            let totalAmount = 0;

            cart.forEach((item, index) => {
                const roomTotal = item.pricePerNight * item.quantity * totalNights;
                totalAmount += roomTotal;
                
                // Add visible item
                html += `
                <div class="flex justify-between items-center p-3 bg-surface-container rounded-lg border border-outline-variant/20">
                    <div class="flex-1 min-w-0 mr-3">
                        <div class="font-bold text-on-surface text-label-lg truncate">${item.categoryName}</div>
                        <div class="text-label-sm text-on-surface-variant">${item.pricePerNight.toLocaleString('vi-VN')}đ/phòng</div>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <button type="button" onclick="decreaseCartQty(${item.categoryId})" class="w-8 h-8 rounded-full border border-outline-variant/30 flex items-center justify-center hover:bg-surface-container-high transition-colors text-on-surface">
                            <span class="material-symbols-outlined text-[16px]">remove</span>
                        </button>
                        <span class="font-bold text-on-surface text-label-lg w-5 text-center">${item.quantity}</span>
                        <button type="button" onclick="increaseCartQty(${item.categoryId})" class="w-8 h-8 rounded-full border border-outline-variant/30 flex items-center justify-center hover:bg-surface-container-high transition-colors text-on-surface">
                            <span class="material-symbols-outlined text-[16px]">add</span>
                        </button>
                        <button type="button" onclick="removeFromCart(${item.categoryId})" class="text-error hover:bg-error-container w-8 h-8 rounded-full flex items-center justify-center transition-colors ml-1">
                            <span class="material-symbols-outlined text-[18px]">delete</span>
                        </button>
                    </div>
                </div>`;

                // Add hidden inputs for form submission
                hiddenInputsContainer.innerHTML += `
                    <input type="hidden" name="RoomSelections[${index}].CategoryId" value="${item.categoryId}" />
                    <input type="hidden" name="RoomSelections[${index}].Quantity" value="${item.quantity}" />
                `;
            });

            container.innerHTML = html;
            lblTotal.innerText = totalAmount.toLocaleString('vi-VN') + 'đ';
            btnCheckout.disabled = false;
        }

        // Initialize UI in case there's preselect or we navigated back
        @if (ViewBag.PreselectId != null)
        {
            var preselectedRoom = Model?.FirstOrDefault(r => r.CategoryId == ViewBag.PreselectId);
            if (preselectedRoom != null)
            {
                <text>
                cart.push({
                    categoryId: @preselectedRoom.CategoryId,
                    categoryName: '@Html.Raw(preselectedRoom.CategoryName)',
                    pricePerNight: @(preselectedRoom.PricePerNight ?? 0),
                    availableCount: @preselectedRoom.AvailableRoomsCount,
                    quantity: @(ViewBag.PreselectQty ?? 1)
                });
                </text>
            }
        }
        updateCartUI();
    </script>
}
