@model IEnumerable<PhucNguyenResort.Models.RoomCategory>

@{
    ViewData["Title"] = "Tìm Kiếm Phòng";
}

<div class="pt-20">
    <!-- Hero Banner -->
    <section class="relative h-[300px] flex flex-col justify-center items-center text-center px-margin-mobile overflow-hidden">
        <div class="absolute inset-0 z-0">
            <div class="w-full h-full bg-cover bg-center transition-transform duration-1000 hover:scale-105" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDF_GSeazGYHkWMyoO3oze92q_KXMuVgiXVWHZ53XkNeOS4YVbQJEWyReDqkTZ09bJamHlqSGs8kUextTFsksmBZH-I19BGp9eZPiZcNKBMP-kv3eZklURWraINff0SV7P_QyvU099aA8uFCVwzvH76EUZF-lljWNSv_jwVBj6Plk5XyyCjXkw2vNomtsYzVlSbOBVLJRgDPJ5PD0kxTBMRg5ZrVZ3dory4vBuSNbqv7LpTpWNu4ZuefJMqS8bOsugXrx_NAWMKX70z')">
            </div>
            <div class="absolute inset-0 bg-on-surface/40"></div>
        </div>
        <div class="relative z-10">
            <nav class="mb-4">
                <ol class="flex items-center justify-center space-x-2 text-surface-container-lowest/80 font-label-sm text-label-sm uppercase tracking-widest">
                    <li><a class="hover:text-primary-fixed" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><span class="material-symbols-outlined text-[14px]">chevron_right</span></li>
                    <li class="text-white">Tìm Kiếm Phòng</li>
                </ol>
            </nav>
            <h1 class="font-headline-lg text-headline-lg text-white mb-2">Phòng Trống Phù Hợp</h1>
            <p class="text-white/80 font-body-md text-body-md max-w-lg mx-auto">Khám phá không gian nghỉ dưỡng sang trọng bậc nhất giữa lòng thiên nhiên.</p>
        </div>
    </section>

    <!-- Sticky Search Bar -->
    <section class="sticky top-20 z-40 bg-surface shadow-sm border-b border-outline-variant/10">
        <div class="max-w-container-max mx-auto px-margin-desktop py-4">
            <form asp-controller="Home" asp-action="SearchRooms" method="get" class="flex flex-wrap md:flex-nowrap items-center gap-6">
                @{
                    string isoCheckIn = "";
                    string isoCheckOut = "";
                    if (!string.IsNullOrEmpty(ViewBag.CheckIn) && !string.IsNullOrEmpty(ViewBag.CheckOut))
                    {
                        isoCheckIn = DateTime.ParseExact(ViewBag.CheckIn, "dd/MM/yyyy", null).ToString("yyyy-MM-dd");
                        isoCheckOut = DateTime.ParseExact(ViewBag.CheckOut, "dd/MM/yyyy", null).ToString("yyyy-MM-dd");
                    }
                }
                
                <div class="flex-1 min-w-[140px]">
                    <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">Ngày Đến</label>
                    <div class="flex items-center border border-outline-variant/30 rounded-lg px-3 py-2 bg-surface-container-low focus-within:border-primary-container transition-colors">
                        <span class="material-symbols-outlined text-outline mr-2 text-[20px]">event</span>
                        <input type="date" name="checkIn" class="bg-transparent border-none outline-none text-body-md font-medium w-full" value="@isoCheckIn" required>
                    </div>
                </div>
                
                <div class="flex-1 min-w-[140px]">
                    <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">Ngày Đi</label>
                    <div class="flex items-center border border-outline-variant/30 rounded-lg px-3 py-2 bg-surface-container-low focus-within:border-primary-container transition-colors">
                        <span class="material-symbols-outlined text-outline mr-2 text-[20px]">event</span>
                        <input type="date" name="checkOut" class="bg-transparent border-none outline-none text-body-md font-medium w-full" value="@isoCheckOut" required>
                    </div>
                </div>
                
                <div class="flex-1 min-w-[110px]">
                    <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">Người Lớn</label>
                    <div class="flex items-center border border-outline-variant/30 rounded-lg px-3 py-2 bg-surface-container-low focus-within:border-primary-container transition-colors">
                        <span class="material-symbols-outlined text-outline mr-2 text-[20px]">person</span>
                        <select name="adultsCount" class="bg-transparent border-none outline-none text-body-md font-medium w-full">
                            @for (int i = 1; i <= 10; i++)
                            {
                                if (ViewBag.AdultsCount == i)
                                {
                                    <option value="@i" selected>@i</option>
                                }
                                else
                                {
                                    <option value="@i">@i</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="flex-1 min-w-[110px]">
                    <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">Trẻ Em</label>
                    <div class="flex items-center border border-outline-variant/30 rounded-lg px-3 py-2 bg-surface-container-low focus-within:border-primary-container transition-colors">
                        <span class="material-symbols-outlined text-outline mr-2 text-[20px]">child_care</span>
                        <select name="childrenCount" class="bg-transparent border-none outline-none text-body-md font-medium w-full">
                            @for (int i = 0; i <= 10; i++)
                            {
                                if (ViewBag.ChildrenCount == i)
                                {
                                    <option value="@i" selected>@i</option>
                                }
                                else
                                {
                                    <option value="@i">@i</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                
                <div class="flex-shrink-0">
                    <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">&nbsp;</label>
                    <button type="submit" class="flex items-center border border-outline-variant/30 rounded-lg px-6 py-2 bg-surface-container-low hover:border-primary-container hover:text-primary transition-colors h-[42px]">
                        <span class="material-symbols-outlined text-outline mr-2">search</span>
                        <span class="text-body-md font-medium">Tìm</span>
                    </button>
                </div>
            </form>
        </div>
    </section>

    <!-- Main Content Area -->
    <div class="max-w-container-max mx-auto px-margin-desktop py-section-gap-md">
        <div class="flex flex-col lg:flex-row gap-gutter">
            
            <!-- Room List (Left Column) -->
            <div class="lg:w-2/3 flex flex-col gap-8">
                <div class="flex justify-between items-end mb-4">
                    <h2 class="font-headline-sm text-headline-sm text-on-surface">Kết quả tìm kiếm (@(Model?.Count() ?? 0) phòng)</h2>
                    <div class="text-on-surface-variant font-label-lg text-label-lg border-b border-outline-variant/50 cursor-pointer hover:text-primary">Sắp xếp: Giá thấp đến cao</div>
                </div>
                
                @if (Model != null && Model.Any())
                {
                    int i = 0;
                    foreach (var room in Model)
                    {
                        i++;
                        string bgImage = string.IsNullOrEmpty(room.ImageUrl) ? $"/img/room/room-b{((i % 4) + 1)}.jpg" : room.ImageUrl;
                        
                        <div class="flex flex-col md:flex-row bg-surface-container-lowest border border-outline-variant/20 rounded-xl overflow-hidden luxury-shadow transition-all duration-500 hover:-translate-y-1">
                            <div class="md:w-2/5 relative h-64 md:h-auto">
                                <img class="w-full h-full object-cover" src="@bgImage" alt="@room.CategoryName" />
                                @if (i == 1) {
                                    <div class="absolute top-4 left-4 bg-primary-container/90 text-on-primary-container text-label-sm px-3 py-1 rounded-full backdrop-blur-sm">Phổ biến nhất</div>
                                } else if (i == 2) {
                                    <div class="absolute top-4 left-4 bg-tertiary-container/90 text-on-tertiary-container text-label-sm px-3 py-1 rounded-full backdrop-blur-sm">Ưu đãi đặc biệt</div>
                                }
                            </div>
                            <div class="md:w-3/5 p-6 flex flex-col">
                                <div class="flex justify-between items-start mb-2">
                                    <h3 class="font-headline-sm text-headline-sm text-on-surface">@room.CategoryName</h3>
                                    <div class="flex items-center text-primary-container">
                                        <span class="material-symbols-outlined fill" style="font-variation-settings: 'FILL' 1;">star</span>
                                        <span class="ml-1 font-label-lg text-label-lg font-bold">4.9</span>
                                    </div>
                                </div>
                                <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2 mb-4">
                                    @(string.IsNullOrEmpty(room.Description) ? "Trải nghiệm tầm nhìn vô cực ra đại dương từ ban công riêng. Nội thất hiện đại kết hợp hoàn hảo giữa gỗ tự nhiên và đá cẩm thạch." : room.Description)
                                </p>
                                
                                <div class="flex flex-wrap gap-4 mb-6">
                                    <div class="flex items-center text-on-secondary-container font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined mr-1 text-[18px]">group</span> @(room.MaxAdults ?? 2) Người Lớn, @(room.MaxChildren ?? 0) Trẻ em
                                    </div>
                                    <div class="flex items-center text-on-secondary-container font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined mr-1 text-[18px]">king_bed</span> Giường King
                                    </div>
                                    <div class="flex items-center text-on-secondary-container font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined mr-1 text-[18px]">wifi</span> Free Wi-Fi
                                    </div>
                                    <div class="flex items-center text-on-secondary-container font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined mr-1 text-[18px]">hot_tub</span> Bồn tắm
                                    </div>
                                </div>
                                
                                <div class="mt-auto flex justify-between items-end border-t border-outline-variant/10 pt-4">
                                    <div>
                                        <span class="block text-on-surface-variant font-label-sm text-label-sm uppercase">Giá mỗi đêm</span>
                                        <span class="text-headline-sm text-primary font-bold">@room.PricePerNight?.ToString("N0")đ</span>
                                    </div>
                                    <div class="flex gap-2">
                                        <a asp-controller="Home" asp-action="RoomDetails" asp-route-id="@room.CategoryId" class="px-4 py-2 border border-outline-variant/50 rounded-lg text-on-surface-variant hover:bg-surface-container font-label-lg transition-colors flex items-center justify-center">
                                            Chi tiết
                                        </a>
                                        <button onclick="addToCart(@room.CategoryId, '@room.CategoryName', @(room.PricePerNight ?? 0))" class="bg-primary text-white font-label-lg px-6 py-2.5 rounded-lg hover:bg-on-primary-fixed-variant transition-colors luxury-shadow">
                                            Thêm
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="w-full text-center py-10 bg-surface-container-low rounded-xl">
                        <span class="material-symbols-outlined text-4xl text-outline mb-2 block">search_off</span>
                        <p class="font-body-lg text-on-surface-variant">Không tìm thấy phòng nào phù hợp với yêu cầu của bạn.</p>
                    </div>
                }
            </div>
            
            <!-- Sidebar Cart (Right Column) -->
            <aside class="lg:w-1/3">
                <form id="cartForm" asp-controller="Bookings" asp-action="Create" method="get" class="sticky top-44 bg-surface-container-low border border-outline-variant/20 rounded-xl p-8 luxury-shadow">
                    <input type="hidden" name="checkIn" id="cartCheckIn" value="@ViewBag.CheckIn" />
                    <input type="hidden" name="checkOut" id="cartCheckOut" value="@ViewBag.CheckOut" />
                    <input type="hidden" name="adults" value="@(ViewBag.AdultsCount ?? 2)" />
                    <input type="hidden" name="children" value="@(ViewBag.ChildrenCount ?? 0)" />
                    <div id="hiddenInputsContainer"></div>
                    
                    <h3 class="font-headline-sm text-headline-sm text-on-surface mb-6 pb-4 border-b border-outline-variant/20">Tóm tắt chuyến đi</h3>
                    <div class="space-y-6 mb-8">
                        <div class="flex justify-between">
                            <span class="text-on-surface-variant font-label-lg">Check-in:</span>
                            <span class="font-bold text-on-surface" id="lblCheckIn">@(string.IsNullOrEmpty(ViewBag.CheckIn) ? "Chưa chọn" : ViewBag.CheckIn)</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-on-surface-variant font-label-lg">Check-out:</span>
                            <span class="font-bold text-on-surface" id="lblCheckOut">@(string.IsNullOrEmpty(ViewBag.CheckOut) ? "Chưa chọn" : ViewBag.CheckOut)</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-on-surface-variant font-label-lg">Số đêm:</span>
                            <span class="font-bold text-on-surface"><span id="lblNights">0</span> Đêm</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-on-surface-variant font-label-lg">Khách:</span>
                            <span class="font-bold text-on-surface">@(ViewBag.AdultsCount ?? 2) Người lớn</span>
                        </div>
                    </div>
                    
                    <div class="space-y-4 mb-8">
                        <div class="text-on-surface-variant font-label-sm uppercase tracking-widest border-b border-outline-variant/10 pb-2">Phòng đã chọn</div>
                        <div id="cartItemsContainer" class="flex flex-col gap-3">
                            <div class="flex items-center justify-center py-10 bg-surface/50 border border-dashed border-outline-variant/30 rounded-lg text-on-surface-variant italic text-center" id="emptyCartMsg">
                                Vui lòng chọn phòng<br/>để tiếp tục
                            </div>
                        </div>
                    </div>
                    
                    <div class="pt-6 border-t border-outline-variant/20 mb-8">
                        <div class="flex justify-between items-end">
                            <span class="text-headline-sm text-on-surface">Tổng cộng:</span>
                            <div class="text-right">
                                <span class="block text-label-sm text-on-surface-variant">(Đã bao gồm VAT & phí)</span>
                                <span class="text-headline-md text-primary font-bold" id="lblTotal">0đ</span>
                            </div>
                        </div>
                    </div>
                    
                    <button type="submit" id="btnCheckout" disabled class="w-full bg-primary-container text-on-primary-container font-label-lg text-label-lg py-4 rounded-lg transition-all duration-300 uppercase tracking-widest disabled:opacity-50 disabled:cursor-not-allowed hover:opacity-90">
                        Thanh toán
                    </button>
                    <div class="mt-4 flex items-center justify-center gap-2 text-on-surface-variant font-label-sm">
                        <span class="material-symbols-outlined text-[16px]">lock</span>
                        Thanh toán bảo mật 100%
                    </div>
                </form>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var dateRangeInput = document.getElementById('dateRangeInput');
            if (dateRangeInput && !dateRangeInput.value) {
                // Initial placeholder value setup if necessary
            }
        });

        // Cart State
        let cart = [];
        let totalNights = 0;

        // Parse date from dd/MM/yyyy to calculate nights
        function calculateNights() {
            const checkInStr = document.getElementById('cartCheckIn').value;
            const checkOutStr = document.getElementById('cartCheckOut').value;
            
            if (!checkInStr || !checkOutStr) return 0;
            
            const [d1, m1, y1] = checkInStr.split('/');
            const [d2, m2, y2] = checkOutStr.split('/');
            
            const dIn = new Date(y1, m1 - 1, d1);
            const dOut = new Date(y2, m2 - 1, d2);
            
            const diffTime = Math.abs(dOut - dIn);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            return diffDays > 0 ? diffDays : 0;
        }

        totalNights = calculateNights();
        document.getElementById('lblNights').innerText = totalNights;

        // Make addToCart globally accessible
        window.addToCart = function(categoryId, categoryName, pricePerNight) {
            if (totalNights === 0) {
                alert('Vui lòng chọn Ngày nhận - trả phòng hợp lệ trước khi chọn phòng.');
                document.getElementById('dateRangeInput').focus();
                return;
            }

            const existingItem = cart.find(i => i.categoryId === categoryId);
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({
                    categoryId: categoryId,
                    categoryName: categoryName,
                    pricePerNight: pricePerNight,
                    quantity: 1
                });
            }
            updateCartUI();
        };

        window.removeFromCart = function(categoryId) {
            cart = cart.filter(i => i.categoryId !== categoryId);
            updateCartUI();
        };

        function updateCartUI() {
            const container = document.getElementById('cartItemsContainer');
            const hiddenInputsContainer = document.getElementById('hiddenInputsContainer');
            const emptyMsg = document.getElementById('emptyCartMsg');
            const btnCheckout = document.getElementById('btnCheckout');
            const lblTotal = document.getElementById('lblTotal');

            // Clear containers
            hiddenInputsContainer.innerHTML = '';
            
            if (cart.length === 0) {
                container.innerHTML = `<div class="flex items-center justify-center py-10 bg-surface/50 border border-dashed border-outline-variant/30 rounded-lg text-on-surface-variant italic text-center" id="emptyCartMsg">
                    Vui lòng chọn phòng<br/>để tiếp tục
                </div>`;
                lblTotal.innerText = '0đ';
                btnCheckout.disabled = true;
                return;
            }

            // Not empty, rebuild HTML
            let html = '';
            let totalAmount = 0;

            cart.forEach((item, index) => {
                const roomTotal = item.pricePerNight * item.quantity * totalNights;
                totalAmount += roomTotal;
                
                // Add visible item
                html += `
                <div class="flex justify-between items-center p-3 bg-surface-container rounded-lg border border-outline-variant/20">
                    <div>
                        <div class="font-bold text-on-surface text-label-lg">${item.categoryName}</div>
                        <div class="text-label-sm text-on-surface-variant">${item.quantity} phòng x ${item.pricePerNight.toLocaleString('vi-VN')}đ</div>
                    </div>
                    <button type="button" onclick="removeFromCart(${item.categoryId})" class="text-error hover:bg-error-container w-8 h-8 rounded-full flex items-center justify-center transition-colors">
                        <span class="material-symbols-outlined text-[18px]">delete</span>
                    </button>
                </div>`;

                // Add hidden inputs for form submission
                hiddenInputsContainer.innerHTML += `
                    <input type="hidden" name="RoomSelections[${index}].CategoryId" value="${item.categoryId}" />
                    <input type="hidden" name="RoomSelections[${index}].Quantity" value="${item.quantity}" />
                `;
            });

            container.innerHTML = html;
            lblTotal.innerText = totalAmount.toLocaleString('vi-VN') + 'đ';
            btnCheckout.disabled = false;
        }

        // Initialize UI in case there's preselect or we navigated back
        updateCartUI();
    </script>
}
