@model IEnumerable<PhucNguyenResort.Models.RoomCategory>
@{
    ViewData["Title"] = "Trang Chủ";

}

<!-- Hero Section Begin -->
<section class="hero-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="hero-text">
                    <h1>Phúc Nguyên Resort</h1>
                    <p>Trải nghiệm dịch vụ nghỉ dưỡng tuyệt vời hàng đầu, mang đến cho bạn không gian yên bình và những tiện nghi đẳng cấp nhất.</p>
                    <a href="#" class="primary-btn">Khám Phá Ngay</a>
                </div>
            </div>
            <div class="col-xl-4 col-lg-5 offset-xl-2 offset-lg-1">
                <div class="booking-form">
                    <h3>Đặt Phòng Của Bạn</h3>
                    <form action="#">
                        <div class="check-date">
                            <label for="date-in">Ngày Nhận Phòng:</label>
                            <input type="text" class="date-input" id="date-in">
                            <i class="icon_calendar"></i>
                        </div>
                        <div class="check-date">
                            <label for="date-out">Ngày Trả Phòng:</label>
                            <input type="text" class="date-input" id="date-out">
                            <i class="icon_calendar"></i>
                        </div>
                        <div class="select-option">
                            <label for="guest">Số Khách:</label>
                            <select id="guest">
                                <option value="">2 Người Lớn</option>
                                <option value="">3 Người Lớn</option>
                            </select>
                        </div>
                        <div class="select-option">
                            <label for="room">Phòng:</label>
                            <select id="room">
                                <option value="">1 Phòng</option>
                                <option value="">2 Phòng</option>
                            </select>
                        </div>
                        <button type="submit">Kiểm Tra Phòng Trống</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-slider owl-carousel">
        <div class="hs-item set-bg" data-setbg="/img/hero/hero-1.jpg"></div>
        <div class="hs-item set-bg" data-setbg="/img/hero/hero-2.jpg"></div>
        <div class="hs-item set-bg" data-setbg="/img/hero/hero-3.jpg"></div>
    </div>
</section>
<!-- Hero Section End -->

<!-- About Us Section Begin -->
<section class="aboutus-section spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="about-text">
                    <div class="section-title">
                        <span>Về Chúng Tôi</span>
                        <h2>Khu Nghỉ Dưỡng <br />Phúc Nguyên Resort</h2>
                    </div>
                    <p class="f-para">Phúc Nguyên Resort tự hào là điểm đến lý tưởng cho những ai yêu thích sự yên bình và sang trọng. Hàng ngày, chúng tôi mang đến những trải nghiệm tuyệt vời cho hàng ngàn du khách trong và ngoài nước.</p>
                    <p class="s-para">Bất kể bạn đang tìm kiếm một phòng nghỉ dưỡng hoàn hảo, một dịch vụ thư giãn hay một căn hộ tiện nghi, chúng tôi đều sẵn lòng phục vụ.</p>
                    <a href="#" class="primary-btn about-btn">Xem Thêm</a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about-pic">
                    <div class="row">
                        <div class="col-sm-6">
                            <img src="~/img/about/about-1.jpg" alt="">
                        </div>
                        <div class="col-sm-6">
                            <img src="~/img/about/about-2.jpg" alt="">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- About Us Section End -->

<!-- Services Section Begin -->
<section class="services-section spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <span>Dịch Vụ Của Chúng Tôi</span>
                    <h2>Khám Phá Dịch Vụ Nổi Bật</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-4 col-sm-6">
                <div class="service-item">
                    <i class="flaticon-036-parking"></i>
                    <h4>Kế Hoạch Du Lịch</h4>
                    <p>Lên kế hoạch hoàn hảo cho chuyến đi của bạn với các gói tour và hoạt động dã ngoại hấp dẫn.</p>
                </div>
            </div>
            <div class="col-lg-4 col-sm-6">
                <div class="service-item">
                    <i class="flaticon-033-dinner"></i>
                    <h4>Dịch Vụ Ăn Uống</h4>
                    <p>Trải nghiệm tinh hoa ẩm thực từ các đầu bếp hàng đầu với thực đơn phong phú và đa dạng.</p>
                </div>
            </div>
            <div class="col-lg-4 col-sm-6">
                <div class="service-item">
                    <i class="flaticon-026-bed"></i>
                    <h4>Trông Trẻ</h4>
                    <p>Dịch vụ trông trẻ an toàn và tận tâm giúp gia đình bạn có thời gian thư giãn tuyệt đối.</p>
                </div>
            </div>
            <div class="col-lg-4 col-sm-6">
                <div class="service-item">
                    <i class="flaticon-024-towel"></i>
                    <h4>Giặt Ủi</h4>
                    <p>Dịch vụ giặt ủi nhanh chóng, sạch sẽ và phẳng phiu như mới cho mọi trang phục của bạn.</p>
                </div>
            </div>
            <div class="col-lg-4 col-sm-6">
                <div class="service-item">
                    <i class="flaticon-044-clock-1"></i>
                    <h4>Thuê Tài Xế</h4>
                    <p>Cung cấp dịch vụ thuê tài xế chuyên nghiệp, đảm bảo chuyến đi an toàn và tiện lợi.</p>
                </div>
            </div>
            <div class="col-lg-4 col-sm-6">
                <div class="service-item">
                    <i class="flaticon-012-cocktail"></i>
                    <h4>Quầy Bar & Đồ Uống</h4>
                    <p>Thưởng thức các loại thức uống đa dạng và cocktail tuyệt hảo trong không gian lãng mạn.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Services Section End -->

<!-- Home Room Section Begin -->
<section class="hp-room-section spad" style="background-color: #f5ede6;">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <span>Phòng & Ưu Đãi</span>
                    <h2>Khám Phá Các Loại Phòng</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="home-room-slider owl-carousel pt-4">
                    @if (Model != null && Model.Any())
                    {
                        int imgIndex = 1;
                        foreach (var roomCategory in Model)
                        {
                            string bgImage = string.IsNullOrEmpty(roomCategory.ImageUrl) || roomCategory.ImageUrl.Contains("category-") 
                                             ? $"/img/room/room-b{imgIndex}.jpg" 
                                             : roomCategory.ImageUrl.Replace(" ", "%20");

                            imgIndex++;
                            if (imgIndex > 4) imgIndex = 1;

                            <div class="card border-0 shadow-sm mx-2" style="border-radius: 0; background: #fff;">
                                <div style="position: relative;">
                                    <img src="@bgImage" class="card-img-top" alt="@roomCategory.CategoryName" style="height: 250px; object-fit: cover; border-radius: 0;">
                                    <div style="position: absolute; top: 15px; right: 0; background: rgba(144, 75, 75, 0.9); color: white; padding: 8px 18px; font-size: 14px;">
                                        @(roomCategory.PricePerNight?.ToString("N0") ?? "0") VNĐ / Đêm
                                    </div>
                                </div>
                                <div class="card-body d-flex flex-column" style="padding: 30px;">
                                    <h4 class="card-title" style="font-family: 'Lora', serif; font-size: 22px; color: #333; margin-bottom: 15px; min-height: 52px;">@roomCategory.CategoryName</h4>
                                    <p class="card-text" style="color: #666; font-size: 15px; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;">
                                        Tận hưởng sự tiện nghi đẳng cấp và trải nghiệm không gian sang trọng cùng gia đình. Đặt trực tiếp để nhận ưu đãi tốt nhất.
                                    </p>
                                    <p style="color: #cca471; font-size: 14px; margin-bottom: 25px; font-weight: 500;">
                                        Tối đa @(roomCategory.Capacity ?? 2) người
                                    </p>
                                    <a asp-controller="Home" asp-action="RoomDetails" asp-route-id="@roomCategory.CategoryId" class="btn" style="background-color: #c09b63; color: white; border-radius: 0; padding: 14px; font-weight: 600; font-size: 14px; text-transform: uppercase; width: 100%; border: none;">XEM CHI TIẾT & ĐẶT PHÒNG</a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Home Room Section End -->

<!-- Testimonial Section Begin -->
<section class="testimonial-section spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <span>Đánh Giá Khách Hàng</span>
                    <h2>Khách Hàng Nói Gì?</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <div class="testimonial-slider owl-carousel">
                    <div class="ts-item">
                        <p>Kỳ nghỉ tại Phúc Nguyên Resort thực sự vượt ngoài mong đợi của tôi. Gia đình tôi đã có một quãng thời gian vô cùng tuyệt vời và thư giãn với các dịch vụ chu đáo. Chắc chắn tôi sẽ quay lại đây.</p>
                        <div class="ti-author">
                            <div class="rating">
                                <i class="icon_star"></i>
                                <i class="icon_star"></i>
                                <i class="icon_star"></i>
                                <i class="icon_star"></i>
                                <i class="icon_star-half_alt"></i>
                            </div>
                            <h5> - Alexander Vasquez</h5>
                        </div>
                        <img src="~/img/testimonial-logo.png" alt="">
                    </div>
                    <div class="ts-item">
                        <p>Không gian cực kỳ yên tĩnh và thoải mái, nhân viên nhiệt tình hỗ trợ. Thực sự là một nơi lý tưởng để trốn khỏi sự ồn ào của thành phố. Dịch vụ ăn uống ở đây cũng rất xuất sắc.</p>
                        <div class="ti-author">
                            <div class="rating">
                                <i class="icon_star"></i>
                                <i class="icon_star"></i>
                                <i class="icon_star"></i>
                                <i class="icon_star"></i>
                                <i class="icon_star"></i>
                            </div>
                            <h5> - Maria Tran</h5>
                        </div>
                        <img src="~/img/testimonial-logo.png" alt="">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Testimonial Section End -->

<!-- Blog Section Begin -->
