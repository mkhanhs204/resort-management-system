    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <span>Tin Tức Khách Sạn</span>
                    <h2>Blog & Sự Kiện Của Chúng Tôi</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-4">
                <div class="blog-item set-bg" data-setbg="/img/blog/blog-1.jpg">
                    <div class="bi-text">
                        <span class="b-tag">Du Lịch</span>
                        <h4><a href="#">Kinh nghiệm nghỉ dưỡng tại Resort</a></h4>
                        <div class="b-time"><i class="icon_clock_alt"></i> 15 Tháng 4, 2024</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="blog-item set-bg" data-setbg="/img/blog/blog-2.jpg">
                    <div class="bi-text">
                        <span class="b-tag">Cắm Trại</span>
                        <h4><a href="#">Cách chọn lều trại mùa hè</a></h4>
                        <div class="b-time"><i class="icon_clock_alt"></i> 18 Tháng 4, 2024</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="blog-item set-bg" data-setbg="/img/blog/blog-3.jpg">
                    <div class="bi-text">
                        <span class="b-tag">Sự Kiện</span>
                        <h4><a href="#">Tuần lễ ẩm thực mùa thu</a></h4>
                        <div class="b-time"><i class="icon_clock_alt"></i> 21 Tháng 4, 2024</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="blog-item small-size set-bg" data-setbg="/img/blog/blog-wide.jpg">
                    <div class="bi-text">
                        <span class="b-tag">Sự Kiện</span>
                        <h4><a href="#">Lễ hội ánh sáng chào mừng năm mới</a></h4>
                        <div class="b-time"><i class="icon_clock_alt"></i> 08 Tháng 5, 2024</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="blog-item small-size set-bg" data-setbg="/img/blog/blog-10.jpg">
                    <div class="bi-text">
                        <span class="b-tag">Du Lịch</span>
                        <h4><a href="#">Lịch trình vi vu Đà Lạt 3 ngày</a></h4>
                        <div class="b-time"><i class="icon_clock_alt"></i> 12 Tháng 5, 2024</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Blog Section End -->

@section Scripts {
    <script>
        $(document).ready(function() {
            $(".home-room-slider").owlCarousel({
                items: 3,
                dots: false,
                autoplay: true,
                loop: true,
                smartSpeed: 1200,
                nav: true,
                navText: ["<i class='arrow_left'></i>", "<i class='arrow_right'></i>"],
                margin: 0,
                responsive: {
                    0: { items: 1 },
                    768: { items: 2 },
                    992: { items: 3 },
                    1200: { items: 3 }
                }
            });
        });
    </script>
}
