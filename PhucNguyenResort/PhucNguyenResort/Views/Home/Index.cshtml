@model IEnumerable<PhucNguyenResort.Models.RoomCategory>
@{
    ViewData["Title"] = "Trang Chủ";
}

<!-- Google Fonts for Luxury Vibe -->
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

@section Styles {
    <link rel="stylesheet" href="~/css/home-premium.css" asp-append-version="true" />
}

<!-- Hero Section Begin -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="hero-text">
                    <h1>Phúc Nguyên<br/>Resort</h1>
                    <p>Trải nghiệm dịch vụ nghỉ dưỡng tuyệt vời hàng đầu, mang đến cho bạn không gian yên bình và những tiện nghi đẳng cấp nhất giữa thiên nhiên rực rỡ.</p>
                    <a href="#about-us" class="primary-btn">Khám Phá Ngay</a>
                </div>
            </div>
            <div class="col-xl-4 col-lg-5 offset-xl-2 offset-lg-1">
                <div class="booking-form">
                    <h3>Đặt Phòng Của Bạn</h3>
                    <form asp-controller="Home" asp-action="SearchRooms" method="get">
                        <div class="check-date">
                            <label for="date-in">Ngày Nhận Phòng</label>
                            <input type="text" class="date-input" id="date-in" name="checkIn" required autocomplete="off" placeholder="DD/MM/YYYY">
                            <i class="icon_calendar"></i>
                        </div>
                        <div class="check-date">
                            <label for="date-out">Ngày Trả Phòng</label>
                            <input type="text" class="date-input" id="date-out" name="checkOut" required autocomplete="off" placeholder="DD/MM/YYYY">
                            <i class="icon_calendar"></i>
                        </div>
                        <div class="row" style="margin: 0 -10px;">
                            <div class="col-6" style="padding: 0 10px;">
                                <div class="select-option">
                                    <label for="adults">Người Lớn</label>
                                    <select id="adults" name="adultsCount">
                                        <option value="1">1</option>
                                        <option value="2" selected>2</option>
                                        <option value="3">3</option>
                                        <option value="4">4</option>
                                        <option value="5">5+</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-6" style="padding: 0 10px;">
                                <div class="select-option">
                                    <label for="children">Trẻ Em</label>
                                    <select id="children" name="childrenCount">
                                        <option value="0" selected>0</option>
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="3">3</option>
                                        <option value="4">4+</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="select-option">
                            <label for="room">Số Lượng Phòng</label>
                            <select id="room" name="roomCount">
                                <option value="1" selected>1 Phòng</option>
                                <option value="2">2 Phòng</option>
                                <option value="3">3 Phòng</option>
                            </select>
                        </div>
                        <button type="submit" style="color: white; font-weight: 600;">Tìm Phòng Trống</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-slider owl-carousel">
        <div class="hs-item set-bg" data-setbg="/img/hero/hero-1.jpg"></div>
        <div class="hs-item set-bg" data-setbg="/img/hero/hero-2.jpg"></div>
        <div class="hs-item set-bg" data-setbg="/img/hero/hero-3.jpg"></div>
    </div>
</section>
<!-- Hero Section End -->

<!-- About Us Section Begin -->
<section id="about-us" class="aboutus-section spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="about-text">
                    <div class="section-title">
                        <span>Về Chúng Tôi</span>
                        <h2>Nghệ Thuật Nghỉ Dưỡng<br />Chuẩn 5 Sao</h2>
                    </div>
                    <p class="f-para">Phúc Nguyên Resort tự hào là điểm đến lý tưởng cho những ai yêu thích sự yên bình và sang trọng. Hàng ngày, chúng tôi mang đến những trải nghiệm tuyệt vời cho hàng ngàn du khách trong và ngoài nước.</p>
                    <p class="s-para">Với kiến trúc kết hợp hài hòa giữa thiên nhiên và phong cách hiện đại, mỗi góc nhỏ tại Phúc Nguyên đều được chăm chút tỉ mỉ, giúp bạn có những phút giây thư giãn tuyệt đối.</p>
                    <a href="#" class="primary-btn about-btn">Xem Chi Tiết</a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about-pic">
                    <div class="row">
                        <div class="col-sm-6">
                            <img src="~/img/about/about-1.jpg" alt="" style="border-radius: 20px; box-shadow: 0 15px 30px rgba(0,0,0,0.1);">
                        </div>
                        <div class="col-sm-6">
                            <img src="~/img/about/about-2.jpg" alt="" style="border-radius: 20px; box-shadow: 0 15px 30px rgba(0,0,0,0.1); margin-top: 30px;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- About Us Section End -->

<!-- Services Section Begin -->
<section class="services-section spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title text-center">
                    <span>Phục Vụ Tận Tâm</span>
                    <h2>Dịch Vụ Của Chúng Tôi</h2>
                </div>
            </div>
        </div>
        <div class="row justify-content-center align-items-stretch">
            <div class="col-lg-4 col-sm-6 mb-4">
                <div class="service-item text-center h-100" style="margin-bottom: 0;">
                    <i class="flaticon-033-dinner"></i>
                    <h4>Nhà Hàng & Ẩm Thực</h4>
                    <p>Trải nghiệm tinh hoa ẩm thực từ các đầu bếp hàng đầu, đặt bàn trước để thưởng thức các món ăn độc đáo của resort.</p>
                </div>
            </div>
            <div class="col-lg-4 col-sm-6 mb-4">
                <div class="service-item text-center h-100" style="margin-bottom: 0;">
                    <i class="flaticon-026-bed"></i>
                    <h4>Phục Vụ Tại Phòng</h4>
                    <p>Thoải mái tận hưởng các món ăn và đồ uống tuyệt hảo ngay tại không gian riêng tư với dịch vụ phục vụ tận phòng.</p>
                </div>
            </div>
            <div class="col-lg-4 col-sm-6 mb-4">
                <div class="service-item text-center h-100" style="margin-bottom: 0;">
                    <i class="fa fa-compass" style="font-size: 50px; color: #dfa974; margin-bottom: 22px; display: inline-block;"></i>
                    <h4>Tour & Khám Phá</h4>
                    <p>Khám phá văn hóa và thiên nhiên địa phương với các gói tour ngoại khóa hấp dẫn cùng hướng dẫn viên chuyên nghiệp.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Services Section End -->

<!-- Home Room Section Begin -->
<section class="hp-room-section spad" style="background-color: #ffffff;">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title text-center">
                    <span>Phòng & Villa</span>
                    <h2>Tuyệt Tác Nghỉ Dưỡng</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="home-room-slider owl-carousel pt-4">
                    @if (Model != null && Model.Any())
                    {
                        int imgIndex = 1;
                        foreach (var roomCategory in Model)
                        {
                            string bgImage = string.IsNullOrEmpty(roomCategory.ImageUrl) || roomCategory.ImageUrl.Contains("category-") 
                                             ? $"/img/room/room-b{imgIndex}.jpg" 
                                             : roomCategory.ImageUrl.Replace(" ", "%20");

                            imgIndex++;
                            if (imgIndex > 4) imgIndex = 1;

                            <div class="card h-100 border-0 luxury-card mx-2">
                                <div class="card-img-wrapper">
                                    <img src="@bgImage" class="card-img-top" alt="@roomCategory.CategoryName">
                                    <div class="price-pill">
                                        @(roomCategory.PricePerNight?.ToString("N0") ?? "0") VNĐ <span>/ Đêm</span>
                                    </div>
                                </div>
                                <div class="card-body d-flex flex-column" style="padding: 30px;">
                                    <h4 class="card-title" style="font-family: 'Playfair Display', serif; font-size: 24px; color: #1e293b; font-weight: 700; margin-bottom: 15px; min-height: 52px;">@roomCategory.CategoryName</h4>
                                    <p class="card-text text-muted" style="font-size: 15px; line-height: 1.7; margin-bottom: 25px; flex-grow: 1;">
                                        Tận hưởng sự tiện nghi đẳng cấp và trải nghiệm không gian sang trọng cùng gia đình. Đặt trực tiếp để nhận ưu đãi tốt nhất.
                                    </p>
                                    <div class="room-amenities mb-4">
                                        <span class="amenity-pill"><i class="fa fa-user"></i> Tối đa @(roomCategory.MaxAdults ?? 2) người lớn, @(roomCategory.MaxChildren ?? 1) trẻ em</span>
                                    </div>
                                    <a asp-controller="Home" asp-action="RoomDetails" asp-route-id="@roomCategory.CategoryId" 
                                       class="btn w-100 luxury-book-btn">
                                        Khám Phá Căn Phòng Này
                                    </a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Home Room Section End -->

<!-- Tour Section Begin -->
<section class="hp-room-section spad" style="background: #f8fafc;">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title text-center">
                    <span>Hoạt Động Ngoại Khóa</span>
                    <h2>Khám Phá Các Tour Sắp Tới</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="home-tour-slider owl-carousel pt-4">
                    @if (ViewBag.Tours != null && ((IEnumerable<PhucNguyenResort.Models.Tour>)ViewBag.Tours).Any())
                    {
                        foreach (var tour in (IEnumerable<PhucNguyenResort.Models.Tour>)ViewBag.Tours)
                        {
                            string bgImage = string.IsNullOrEmpty(tour.ImageUrl) 
                                             ? "/img/blog/blog-1.jpg" 
                                             : tour.ImageUrl;

                            <div class="card h-100 border-0 luxury-card mx-2">
                                <div class="card-img-wrapper">
                                    <img src="@bgImage" class="card-img-top" alt="@tour.TourName" style="height: 250px; object-fit: cover;">
                                    <div class="price-pill">
                                        @(tour.Price?.ToString("N0") ?? "0") VNĐ <span>/ Khách</span>
                                    </div>
                                </div>
                                <div class="card-body d-flex flex-column" style="padding: 30px;">
                                    <h4 class="card-title" style="font-family: 'Playfair Display', serif; font-size: 24px; color: #1e293b; font-weight: 700; margin-bottom: 15px; min-height: 52px;">@tour.TourName</h4>
                                    <p class="card-text text-muted" style="font-size: 15px; line-height: 1.7; margin-bottom: 25px; flex-grow: 1;">
                                        @(tour.Description?.Length > 100 ? tour.Description.Substring(0, 100) + "..." : tour.Description ?? "Trải nghiệm những hoạt động thú vị cùng hướng dẫn viên chuyên nghiệp.")
                                    </p>
                                    <div class="room-amenities mb-4">
                                        <span class="amenity-pill"><i class="fa fa-clock-o"></i> Thời gian: @(tour.DurationHours ?? 1) giờ</span>
                                        <span class="amenity-pill mt-2"><i class="fa fa-users"></i> Tối đa: @(tour.MaxCapacity ?? 10) khách</span>
                                    </div>
                                    <a asp-controller="CustomerTourBooking" asp-action="Details" asp-route-id="@tour.TourId" 
                                       class="btn w-100 luxury-book-btn">
                                        Xem Chi Tiết Tour
                                    </a>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center">
                            <p>Hiện tại chưa có tour nào sắp diễn ra. Vui lòng quay lại sau.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Tour Section End -->

@section Scripts {

    <script>
        $(document).ready(function() {
            $(".home-room-slider").owlCarousel({
                items: 3,
                dots: true,
                autoplay: true,
                loop: true,
                smartSpeed: 1200,
                nav: false,
                margin: 20,
                responsive: {
                    0: { items: 1 },
                    768: { items: 2 },
                    992: { items: 3 },
                    1200: { items: 3 }
                }
            });

            $(".home-tour-slider").owlCarousel({
                items: 3,
                dots: true,
                autoplay: true,
                loop: true,
                smartSpeed: 1200,
                nav: false,
                margin: 20,
                responsive: {
                    0: { items: 1 },
                    768: { items: 2 },
                    992: { items: 3 },
                    1200: { items: 3 }
                }
            });
        });
    </script>
}
