@model IEnumerable<PhucNguyenResort.Models.RoomCategory>
@{
    ViewData["Title"] = "Trang Chủ";
}

<!-- Hero Section -->
<section class="relative h-screen w-full flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <img alt="Hero background" class="w-full h-full object-cover" src="https://nhaxinhdesign.com/wp-content/uploads/2023/02/noi-that-re-sort-2.jpg"/>
        <div class="absolute inset-0 hero-overlay"></div>
    </div>
    
    <div class="relative z-10 px-margin-desktop max-w-container-max mx-auto w-full grid grid-cols-1 lg:grid-cols-2 gap-gutter">
        <div class="flex flex-col justify-center reveal">
            <h1 class="font-display-lg text-display-lg text-white mb-6 leading-tight">
                Phúc Nguyên Resort
            </h1>
            <p class="font-headline-sm text-headline-sm text-white/90 mb-10 max-w-lg italic">
                Nơi khởi nguồn những trải nghiệm nghỉ dưỡng xa hoa và đáng nhớ.
            </p>
            <div>
                <a href="#about-us" class="inline-block bg-primary-container text-on-primary-container px-8 py-4 rounded-xl font-bold text-[15px] shadow-ambient hover:bg-opacity-90 transition-all uppercase tracking-widest">
                    Khám Phá Ngay
                </a>
            </div>
        </div>
        
        <!-- Floating Booking Bar -->
        <div class="hidden lg:flex items-center justify-end reveal" style="transition-delay: 200ms;">
            <div class="glass-panel p-5 lg:p-6 rounded-2xl shadow-ambient w-full max-w-[340px] border border-white/30">
                <h3 class="font-headline-sm text-[20px] mb-4 text-on-surface text-center">Đặt Phòng Trực Tuyến</h3>
                <form asp-controller="Home" asp-action="SearchRooms" method="get">
                    <div class="space-y-3">
                        <div class="space-y-1">
                            <label class="font-label-sm uppercase tracking-wider text-outline text-[11px]" for="checkIn">Ngày Nhận Phòng</label>
                            <div class="flex items-center bg-surface-container-low px-3 py-1.5 rounded-lg border border-outline-variant/30">
                                <span class="material-symbols-outlined text-primary mr-2 text-[18px]">calendar_today</span>
                                <input name="checkIn" id="checkIn" class="bg-transparent border-none focus:ring-0 w-full text-body-md outline-none py-0.5" placeholder="DD/MM/YYYY" type="date" required/>
                            </div>
                        </div>
                        
                        <div class="space-y-1">
                            <label class="font-label-sm uppercase tracking-wider text-outline text-[11px]" for="checkOut">Ngày Trả Phòng</label>
                            <div class="flex items-center bg-surface-container-low px-3 py-1.5 rounded-lg border border-outline-variant/30">
                                <span class="material-symbols-outlined text-primary mr-2 text-[18px]">event</span>
                                <input name="checkOut" id="checkOut" class="bg-transparent border-none focus:ring-0 w-full text-body-md outline-none py-0.5" placeholder="DD/MM/YYYY" type="date" required/>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-2 gap-2">
                            <div class="space-y-1">
                                <label class="font-label-sm uppercase tracking-wider text-outline text-[11px]" for="adultsCount">Người lớn</label>
                                <div class="flex items-center bg-surface-container-low px-2.5 py-1.5 rounded-lg border border-outline-variant/30">
                                    <span class="material-symbols-outlined text-primary mr-1 text-[18px]">person</span>
                                    <select name="adultsCount" id="adultsCount" class="bg-transparent border-none focus:ring-0 w-full text-[14px] appearance-none outline-none py-0.5 pl-1">
                                        <option value="1">1</option>
                                        <option value="2" selected>2</option>
                                        <option value="3">3</option>
                                        <option value="4">4+</option>
                                    </select>
                                </div>
                            </div>
                            <div class="space-y-1">
                                <label class="font-label-sm uppercase tracking-wider text-outline text-[11px]" for="childrenCount">Trẻ em</label>
                                <div class="flex items-center bg-surface-container-low px-2.5 py-1.5 rounded-lg border border-outline-variant/30">
                                    <span class="material-symbols-outlined text-primary mr-1 text-[18px]">child_care</span>
                                    <select name="childrenCount" id="childrenCount" class="bg-transparent border-none focus:ring-0 w-full text-[14px] appearance-none outline-none py-0.5 pl-1">
                                        <option value="0" selected>0</option>
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="3">3+</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        
                        <div class="space-y-1">
                            <label class="font-label-sm uppercase tracking-wider text-outline text-[11px]" for="roomCount">Số phòng</label>
                            <div class="flex items-center bg-surface-container-low px-3 py-1.5 rounded-lg border border-outline-variant/30">
                                <span class="material-symbols-outlined text-primary mr-2 text-[18px]">meeting_room</span>
                                <select name="roomCount" id="roomCount" class="bg-transparent border-none focus:ring-0 w-full text-[14px] appearance-none outline-none py-0.5">
                                    <option value="1" selected>1 Phòng</option>
                                    <option value="2">2 Phòng</option>
                                    <option value="3">3 Phòng</option>
                                    <option value="4">4+ Phòng</option>
                                </select>
                            </div>
                        </div>
                        
                        <button type="submit" class="w-full bg-primary text-white py-2.5 rounded-xl font-bold uppercase tracking-widest hover:bg-primary/90 transition-colors mt-3 text-[14px]">
                            Tìm Kiếm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- About Us Section -->
<section id="about-us" class="py-section-gap-lg px-margin-desktop max-w-container-max mx-auto overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
        <div class="relative reveal">
            <div class="w-4/5 aspect-[4/5] rounded-2xl overflow-hidden shadow-ambient relative z-10">
                <img class="w-full h-full object-cover" src="/img/about/about-1.jpg" alt="About Us 1"/>
            </div>
            <div class="absolute -bottom-12 -right-4 w-2/3 aspect-square rounded-2xl overflow-hidden shadow-ambient z-20 border-8 border-background">
                <img class="w-full h-full object-cover" src="/img/about/about-2.jpg" alt="About Us 2"/>
            </div>
            <!-- Decorative element -->
            <div class="absolute -top-10 -left-10 w-32 h-32 bg-primary-container/10 rounded-full blur-3xl"></div>
        </div>
        
        <div class="reveal" style="transition-delay: 300ms;">
            <span class="font-label-lg text-label-lg text-primary uppercase tracking-[0.2em] mb-4 block">Về Chúng Tôi</span>
            <h2 class="font-headline-lg text-headline-lg mb-8 text-on-surface">Di sản của sự tĩnh lặng</h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant mb-6 leading-relaxed">
                Phúc Nguyên Resort không chỉ là một điểm đến, mà là một hành trình trở về với bản ngã. Tọa lạc tại vị trí đắc địa nơi đại dương vỗ về những vách đá hùng vĩ, chúng tôi kiến tạo một không gian nghỉ dưỡng mang đậm triết lý "Quiet Luxury".
            </p>
            <p class="font-body-md text-body-md text-on-surface-variant/80 mb-10">
                Mỗi ngóc ngách tại đây đều được thiết kế để tôn vinh sự riêng tư và vẻ đẹp nguyên sơ của thiên nhiên. Từ những vật liệu thủ công địa phương đến dịch vụ cá nhân hóa chuẩn quốc tế, mọi chi tiết đều được chăm chút tỉ mỉ để mang lại trải nghiệm vô song.
            </p>
            <a class="inline-flex items-center font-label-lg text-label-lg text-primary border-b-2 border-primary-container pb-1 hover:border-primary transition-all" asp-controller="Home" asp-action="AboutUs">
                Xem Thêm Câu Chuyện <span class="material-symbols-outlined ml-2">trending_flat</span>
            </a>
        </div>
    </div>
</section>

<!-- Our Services Bento Grid -->
<section class="bg-surface-container-low py-section-gap-lg">
    <div class="px-margin-desktop max-w-container-max mx-auto">
        <div class="text-center mb-16 reveal">
            <span class="font-label-lg text-label-lg text-primary uppercase tracking-[0.2em] mb-4 block">Dịch Vụ Đặc Quyền</span>
            <h2 class="font-headline-lg text-headline-lg text-on-surface">Trải Nghiệm Đẳng Cấp</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter reveal">
            <!-- Restaurant -->
            <a asp-controller="TableReservations" asp-action="Search" class="group relative overflow-hidden rounded-2xl aspect-[4/5] shadow-ambient bg-white border border-outline-variant/10 cursor-pointer block">
                <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA6B0oFTApZXnvb4fqZX_FNp1Un27X9wbDV9tyklkEkh-kw6La8B0ka9jylf4kingKOHYRX0I_j-N9-J5wqNJcPAGbodozc5O00qfaG3w2APAoxxeCQk_3nyYqQFAYqXTgIY6sCT2agz9zRv7rINUGTJL3qnNMgKQTDfMnvl7DVT2OLfuokOijaTysqoWP4eV00mnlm3iIxZCWjy3EFWgu9KA1hoRqi9IiCYNEx80IT7m8Rw7y3Dxdc257hJAbRf2AxY9Y3IQqb5yX_"/>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-8 text-white">
                    <h3 class="font-headline-sm text-headline-sm mb-2">Ẩm Thực Tinh Hoa</h3>
                    <p class="font-body-md opacity-80 mb-4">Hương vị bản địa hòa quyện cùng kỹ thuật chế biến phương Tây hiện đại.</p>
                    <span class="material-symbols-outlined self-end opacity-0 group-hover:opacity-100 transition-opacity">arrow_outward</span>
                </div>
            </a>
            
            <!-- Room Service -->
            <a asp-controller="FoodOrders" asp-action="RoomService" class="group relative overflow-hidden rounded-2xl aspect-[4/5] shadow-ambient bg-white border border-outline-variant/10 md:mt-12 cursor-pointer block">
                <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCZQsUfGCS1VNYRF8avG900wHP9tEPZKaWb3k0WscPE8dFcKsRjcyTZONgkxA6kaCojC4rzWC_FSevq4eMcITDlELgpr1Y2dW3BG_qNDgZmF18VEEYIJxP9VjcwBkJyMeoanDx-ByJhcjdgKO2P30YJZjcTib2Zq0czNHu0b5V9ccpkhH93FL4nhUJxdc9JXSbAIPaX7sJrjl-6Jr0Jxw26yN6jhvs_aTpso5oDjpCPK2smNposvdVCdznWwMITsrzPPkQOO6QCfHVX"/>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-8 text-white">
                    <h3 class="font-headline-sm text-headline-sm mb-2">Phục Vụ Tại Phòng</h3>
                    <p class="font-body-md opacity-80 mb-4">Thoải mái tận hưởng các món ăn và đồ uống ngay tại không gian riêng tư.</p>
                    <span class="material-symbols-outlined self-end opacity-0 group-hover:opacity-100 transition-opacity">arrow_outward</span>
                </div>
            </a>
            
            <!-- Tours -->
            <a asp-controller="CustomerTourBooking" asp-action="Index" class="group relative overflow-hidden rounded-2xl aspect-[4/5] shadow-ambient bg-white border border-outline-variant/10 cursor-pointer block">
                <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDGqc5-mIwjS3a1wLpAJ-9OrLS_-JB8hmu8XB_NYK4CS5hVpGL60fW9IfvB1HC98Iq03FHbDXbsHVrnHhHqiiNEW-UGGiWTSl-z3LB5rzoDGnUJBpzNiYU8BnlFpUrSoo9_HFzP9xMjItpLKa6U4ui-EmRkmPRtGs67AlnGNgyXOXY_e22AjUxfscigFYENY5w5jhr4WKCTgCUOWhJmuEGbxr4t2IXeDZBwZYIt9y0F5Sud3jRvbyDx793y5qqkDzdo6jXAxnN4AuKC"/>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-8 text-white">
                    <h3 class="font-headline-sm text-headline-sm mb-2">Khám Phá Địa Phương</h3>
                    <p class="font-body-md opacity-80 mb-4">Những hành trình riêng tư đưa bạn đến những thắng cảnh tuyệt mật.</p>
                    <span class="material-symbols-outlined self-end opacity-0 group-hover:opacity-100 transition-opacity">arrow_outward</span>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- Featured Rooms Carousel Section -->
<section class="py-section-gap-lg overflow-hidden bg-[#FAF8F5]">
    <div class="px-margin-desktop max-w-container-max mx-auto flex justify-between items-end mb-10 reveal">
        <div>
            <span class="font-label-lg text-label-lg text-primary uppercase tracking-[0.2em] mb-3 block font-bold">Phòng Nghỉ & Villa</span>
            <h2 class="font-headline-lg text-headline-lg text-on-surface">Không Gian Tuyệt Mật</h2>
        </div>
        <div class="flex space-x-4 mb-2">
            <button onclick="document.getElementById('room-slider').scrollBy({left: -424, behavior: 'smooth'})" class="w-12 h-12 rounded-full border border-outline-variant flex items-center justify-center hover:border-primary hover:text-primary transition-all text-outline bg-transparent">
                <span class="material-symbols-outlined font-light">west</span>
            </button>
            <button onclick="document.getElementById('room-slider').scrollBy({left: 424, behavior: 'smooth'})" class="w-12 h-12 rounded-full border border-outline-variant flex items-center justify-center hover:border-primary hover:text-primary transition-all text-outline bg-transparent">
                <span class="material-symbols-outlined font-light">east</span>
            </button>
        </div>
    </div>
    
    <style>
        .hide-scroll::-webkit-scrollbar { display: none; }
        .hide-scroll { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
    
    <!-- Room Cards Horizontal Flow -->
    <div class="max-w-container-max mx-auto px-margin-desktop">
        <div id="room-slider" class="flex space-x-6 overflow-x-auto pb-8 pt-4 snap-x hide-scroll reveal" style="scroll-snap-type: x mandatory; scroll-behavior: smooth;">
        @if (Model != null && Model.Any())
        {
            int imgIndex = 1;
            foreach (var roomCategory in Model)
            {
                string bgImage = string.IsNullOrEmpty(roomCategory.ImageUrl) || roomCategory.ImageUrl.Contains("category-") 
                                 ? $"/img/room/room-b{imgIndex}.jpg" 
                                 : roomCategory.ImageUrl.Replace(" ", "%20");

                imgIndex++;
                if (imgIndex > 4) imgIndex = 1;

                <div class="min-w-[320px] md:min-w-[400px] w-[400px] bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl border border-outline-variant/20 snap-start flex-shrink-0 group transition-shadow duration-300 flex flex-col">
                    <div class="h-[250px] overflow-hidden relative">
                        <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" src="@bgImage" alt="@roomCategory.CategoryName"/>
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                        <div class="flex justify-between items-end mb-4">
                            <h4 class="font-headline-sm text-[22px] text-on-surface flex-1 pr-2">@roomCategory.CategoryName</h4>
                            <div class="text-right whitespace-nowrap">
                                <span class="text-primary font-bold text-[20px]">@roomCategory.PricePerNight?.ToString("N0")</span><span class="text-[12px] font-normal text-outline ml-1">/đêm</span>
                            </div>
                        </div>
                        <p class="text-on-surface-variant mb-6 text-sm line-clamp-2">
                            @(roomCategory.Description?.Length > 100 ? roomCategory.Description.Substring(0, 100) + "..." : roomCategory.Description ?? "Tận hưởng không gian sang trọng và tiện nghi đẳng cấp tại Phúc Nguyên Resort.")
                        </p>
                        <div class="flex flex-wrap items-center gap-2 mb-6">
                            <span class="bg-black/5 px-3 py-1 rounded-full text-[11px] text-on-surface-variant font-medium tracking-wide">@(roomCategory.MaxAdults ?? 2) Người lớn</span>
                            <span class="bg-black/5 px-3 py-1 rounded-full text-[11px] text-on-surface-variant font-medium tracking-wide">@(roomCategory.MaxChildren ?? 1) Trẻ em</span>
                            <span class="bg-black/5 px-3 py-1 rounded-full text-[11px] text-on-surface-variant font-medium tracking-wide">Wifi Free</span>
                        </div>
                        <a asp-controller="Home" asp-action="RoomDetails" asp-route-id="@roomCategory.CategoryId" class="w-full py-2.5 rounded-lg border border-primary text-primary font-medium text-[14px] hover:bg-primary hover:text-white transition-colors text-center inline-block mt-auto uppercase tracking-wider">
                            Chi Tiết Phòng
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="w-full text-center text-on-surface-variant">Không có phòng trống nào.</div>
        }
        </div>
    </div>
</section>

<!-- Tours Slider -->
<section class="bg-surface-container-low py-section-gap-lg overflow-hidden">
    <div class="px-margin-desktop max-w-container-max mx-auto flex justify-between items-end mb-10 reveal">
        <div>
            <span class="font-label-lg text-label-lg text-primary uppercase tracking-[0.2em] mb-3 block font-bold">Hoạt Động Ngoại Khóa</span>
            <h2 class="font-headline-lg text-headline-lg text-on-surface">Khám Phá Tour Sắp Tới</h2>
        </div>
        <div class="flex space-x-4 mb-2">
            <button onclick="document.getElementById('tour-slider').scrollBy({left: -424, behavior: 'smooth'})" class="w-12 h-12 rounded-full border border-outline-variant flex items-center justify-center hover:border-primary hover:text-primary transition-all text-outline bg-transparent">
                <span class="material-symbols-outlined font-light">west</span>
            </button>
            <button onclick="document.getElementById('tour-slider').scrollBy({left: 424, behavior: 'smooth'})" class="w-12 h-12 rounded-full border border-outline-variant flex items-center justify-center hover:border-primary hover:text-primary transition-all text-outline bg-transparent">
                <span class="material-symbols-outlined font-light">east</span>
            </button>
        </div>
    </div>
    
    <div class="max-w-container-max mx-auto px-margin-desktop">
        <div id="tour-slider" class="flex space-x-6 overflow-x-auto pb-8 pt-4 snap-x hide-scroll reveal" style="scroll-snap-type: x mandatory; scroll-behavior: smooth;">
        @if (ViewBag.Tours != null && ((IEnumerable<PhucNguyenResort.Models.Tour>)ViewBag.Tours).Any())
        {
            foreach (var tour in (IEnumerable<PhucNguyenResort.Models.Tour>)ViewBag.Tours)
            {
                string bgImage = string.IsNullOrEmpty(tour.ImageUrl) 
                                 ? "/img/blog/blog-1.jpg" 
                                 : tour.ImageUrl;

                <div class="min-w-[320px] md:min-w-[400px] w-[400px] bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl border border-outline-variant/20 snap-start flex-shrink-0 group transition-shadow duration-300 flex flex-col">
                    <div class="h-[250px] overflow-hidden relative">
                        <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" src="@bgImage" alt="@tour.TourName"/>
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                        <div class="flex justify-between items-end mb-4">
                            <h4 class="font-headline-sm text-[22px] text-on-surface flex-1 pr-2">@tour.TourName</h4>
                            <div class="text-right whitespace-nowrap">
                                <span class="text-primary font-bold text-[20px]">@tour.Price?.ToString("N0")</span><span class="text-[12px] font-normal text-outline ml-1">/khách</span>
                            </div>
                        </div>
                        <p class="text-on-surface-variant mb-6 text-sm line-clamp-2">
                            @(tour.Description?.Length > 100 ? tour.Description.Substring(0, 100) + "..." : tour.Description ?? "Trải nghiệm những hoạt động thú vị cùng hướng dẫn viên chuyên nghiệp.")
                        </p>
                        <div class="flex flex-wrap items-center gap-2 mb-6">
                            <span class="bg-black/5 px-3 py-1 rounded-full text-[11px] text-on-surface-variant font-medium tracking-wide flex items-center"><span class="material-symbols-outlined text-[13px] mr-1">schedule</span> @(tour.DurationHours ?? 1) giờ</span>
                            <span class="bg-black/5 px-3 py-1 rounded-full text-[11px] text-on-surface-variant font-medium tracking-wide flex items-center"><span class="material-symbols-outlined text-[13px] mr-1">group</span> Max @(tour.MaxCapacity ?? 10)</span>
                        </div>
                        <a asp-controller="CustomerTourBooking" asp-action="Details" asp-route-id="@tour.TourId" class="w-full py-2.5 rounded-lg border border-primary text-primary font-medium text-[14px] hover:bg-primary hover:text-white transition-colors text-center inline-block mt-auto uppercase tracking-wider">
                            Chi Tiết Tour
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="w-full text-center text-on-surface-variant">Hiện tại chưa có tour nào sắp diễn ra. Vui lòng quay lại sau.</div>
        }
        </div>
    </div>
</section>

<!-- Customer Reviews Section -->
<section class="py-section-gap-lg overflow-hidden bg-white border-t border-outline-variant/10">
    <div class="px-margin-desktop max-w-container-max mx-auto flex justify-between items-end mb-10 reveal">
        <div>
            <span class="font-label-lg text-label-lg text-primary uppercase tracking-[0.2em] mb-3 block font-bold">Cảm Nhận</span>
            <h2 class="font-headline-lg text-headline-lg text-on-surface mb-2">Khách Hàng Nói Gì Về Chúng Tôi</h2>
            @{
                var reviews = ViewBag.Reviews as IEnumerable<PhucNguyenResort.ViewModels.Reviews.ReviewListVM>;
            }
            @if (reviews != null && reviews.Any())
            {
                var averageRating = reviews.Average(r => r.Rating ?? 5);
                <div class="flex items-center space-x-2">
                    <span class="text-2xl font-bold text-on-surface">@averageRating.ToString("0.0")</span>
                    <div class="flex text-primary">
                        @for (int i = 0; i < Math.Round(averageRating); i++)
                        {
                            <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">star</span>
                        }
                        @for (int i = (int)Math.Round(averageRating); i < 5; i++)
                        {
                            <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 0;">star</span>
                        }
                    </div>
                    <span class="text-on-surface-variant font-medium">(@reviews.Count() đánh giá)</span>
                </div>
            }
        </div>
        <div class="flex space-x-4 mb-2">
            <button onclick="document.getElementById('review-slider').scrollBy({left: -424, behavior: 'smooth'})" class="w-12 h-12 rounded-full border border-outline-variant flex items-center justify-center hover:border-primary hover:text-primary transition-all text-outline bg-transparent">
                <span class="material-symbols-outlined font-light">west</span>
            </button>
            <button onclick="document.getElementById('review-slider').scrollBy({left: 424, behavior: 'smooth'})" class="w-12 h-12 rounded-full border border-outline-variant flex items-center justify-center hover:border-primary hover:text-primary transition-all text-outline bg-transparent">
                <span class="material-symbols-outlined font-light">east</span>
            </button>
        </div>
    </div>
    
    <div class="max-w-container-max mx-auto px-margin-desktop">
        <div id="review-slider" class="flex space-x-6 overflow-x-auto pb-8 pt-4 snap-x hide-scroll reveal" style="scroll-snap-type: x mandatory; scroll-behavior: smooth;">
            @if (reviews != null && reviews.Any())
            {
                foreach (var review in reviews)
                {
                    <div class="min-w-[320px] md:min-w-[400px] w-[400px] bg-[#FAF8F5] rounded-2xl p-8 snap-start flex-shrink-0 group transition-shadow duration-300 flex flex-col border border-outline-variant/10">
                        <div class="flex text-primary mb-6">
                            @for (int i = 0; i < (review.Rating ?? 5); i++)
                            {
                                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                            }
                            @for (int i = (review.Rating ?? 5); i < 5; i++)
                            {
                                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">star</span>
                            }
                        </div>
                        <p class="font-body-lg text-on-surface-variant italic mb-8 flex-1">
                            "@review.Comment"
                        </p>
                        <div class="flex items-center">
                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(review.UserName ?? "User")&background=dfa974&color=fff" alt="User" class="w-12 h-12 rounded-full object-cover mr-4" />
                            <div>
                                <h4 class="font-headline-sm text-lg text-on-surface">@review.UserName</h4>
                                <span class="text-sm text-outline">@review.ServiceName</span>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="w-full text-center text-on-surface-variant">Chưa có đánh giá nào.</div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Set min date for checkIn and checkOut to today
        document.addEventListener('DOMContentLoaded', function() {
            var today = new Date().toISOString().split('T')[0];
            var checkInElem = document.getElementById('checkIn');
            var checkOutElem = document.getElementById('checkOut');
            if (checkInElem) checkInElem.setAttribute('min', today);
            if (checkOutElem) checkOutElem.setAttribute('min', today);
            
            if (checkInElem) {
                checkInElem.addEventListener('change', function() {
                    var checkInDate = this.value;
                    checkOutElem.setAttribute('min', checkInDate);
                });
            }
        });
    </script>
}
