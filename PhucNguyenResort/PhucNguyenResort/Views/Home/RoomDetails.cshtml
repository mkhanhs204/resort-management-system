@model PhucNguyenResort.Models.RoomCategory

@{
    ViewData["Title"] = Model.CategoryName;
    string mainImage = string.IsNullOrEmpty(Model.ImageUrl) || Model.ImageUrl.Contains("category-") 
                       ? "/img/room/room-details.jpg" 
                       : Model.ImageUrl.Replace(" ", "%20");
    // Get up to 4 gallery images
    var galleryImages = Model.Images?.Take(4).ToList() ?? new List<PhucNguyenResort.Models.RoomCategoryImage>();
}

<div class="pt-24 pb-section-gap-lg px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <!-- Gallery Grid (Bento Style) -->
    <section class="grid grid-cols-1 md:grid-cols-4 gap-4 h-[600px] mb-stack-lg">
        <div class="md:col-span-2 md:row-span-2 relative overflow-hidden rounded-xl shadow-md group">
            <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="@mainImage" alt="@Model.CategoryName" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-6">
                <span class="text-white font-label-lg">View Master Bedroom</span>
            </div>
        </div>
        
        @for (int i = 0; i < 4; i++)
        {
            string imgUrl = $"/img/room/room-b{i+1}.jpg"; // Default fallback images
            if (i < galleryImages.Count)
            {
                imgUrl = galleryImages[i].ImageUrl.Replace(" ", "%20");
            }
            <div class="relative overflow-hidden rounded-xl shadow-sm group">
                <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" src="@imgUrl" alt="Gallery @i" />
                @if (i == 3)
                {
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center transition-opacity cursor-pointer hover:bg-black/50">
                        <span class="text-white font-label-lg">+ Xem Tất Cả</span>
                    </div>
                }
            </div>
        }
    </section>

    <!-- Main Content Cluster -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter relative">
        <!-- Room Info (Left Column) -->
        <div class="lg:col-span-8 space-y-stack-lg">
            <header>
                <nav class="flex gap-2 text-on-surface-variant font-label-sm mb-4">
                    <a class="hover:text-primary transition-colors" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    <span>/</span>
                    <a class="hover:text-primary transition-colors" asp-controller="Home" asp-action="SearchRooms">Phòng Nghỉ</a>
                    <span>/</span>
                    <span class="text-primary">@Model.CategoryName</span>
                </nav>
                <h1 class="font-headline-lg text-headline-lg text-on-secondary-fixed mb-2">@Model.CategoryName</h1>
                <div class="flex items-center gap-4 text-primary">
                    @{
                        var heroReviews = ViewBag.Reviews as IEnumerable<PhucNguyenResort.ViewModels.Reviews.ReviewListVM>;
                    }
                    @if (heroReviews != null && heroReviews.Any())
                    {
                        var heroAvg = heroReviews.Average(r => r.Rating) ?? 0.0;
                        <div class="flex items-center gap-1">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(heroAvg))
                                {
                                    <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
                                }
                                else
                                {
                                    <span class="material-symbols-outlined text-sm">star</span>
                                }
                            }
                            <span class="ml-2 font-label-lg text-on-surface-variant">@heroAvg.ToString("0.0") / 5 (@heroReviews.Count() Đánh giá)</span>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-1">
                            <span class="font-label-lg text-on-surface-variant italic px-1">Chưa có đánh giá</span>
                        </div>
                    }
                </div>
            </header>

            <div class="prose max-w-none text-body-lg text-on-surface-variant">
                <p>@(string.IsNullOrEmpty(Model.Description) ? "Khởi đầu hành trình nghỉ dưỡng hoàn hảo với dịch vụ cá nhân hóa và tiện nghi đẳng cấp tại Phúc Nguyên Resort. Với tầm nhìn tuyệt đẹp và không gian yên tĩnh, phòng nghỉ của chúng tôi được thiết kế để mang đến sự thư giãn tuyệt đối cho bạn và người thân." : Model.Description)</p>
            </div>
            
            <!-- Features & Amenities -->
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-6 pb-2 border-b border-outline-variant/20">Tiện Nghi & Đặc Điểm</h3>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                    <div class="flex items-center gap-3 text-on-surface-variant">
                        <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary"><span class="material-symbols-outlined">group</span></div>
                        <span class="font-label-lg">Tối đa @(Model.MaxAdults ?? 2) Người lớn, @(Model.MaxChildren ?? 0) Trẻ em</span>
                    </div>
                    <div class="flex items-center gap-3 text-on-surface-variant">
                        <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary"><span class="material-symbols-outlined">aspect_ratio</span></div>
                        <span class="font-label-lg">Diện tích 45 m²</span>
                    </div>
                    <div class="flex items-center gap-3 text-on-surface-variant">
                        <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary"><span class="material-symbols-outlined">king_bed</span></div>
                        <span class="font-label-lg">1 Giường King</span>
                    </div>
                    <div class="flex items-center gap-3 text-on-surface-variant">
                        <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary"><span class="material-symbols-outlined">wifi</span></div>
                        <span class="font-label-lg">Wifi tốc độ cao</span>
                    </div>
                    <div class="flex items-center gap-3 text-on-surface-variant">
                        <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary"><span class="material-symbols-outlined">hot_tub</span></div>
                        <span class="font-label-lg">Bồn tắm & Vòi sen</span>
                    </div>
                    <div class="flex items-center gap-3 text-on-surface-variant">
                        <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary"><span class="material-symbols-outlined">local_bar</span></div>
                        <span class="font-label-lg">Mini Bar Miễn phí</span>
                    </div>
                    <div class="flex items-center gap-3 text-on-surface-variant">
                        <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary"><span class="material-symbols-outlined">balcony</span></div>
                        <span class="font-label-lg">Ban công hướng biển</span>
                    </div>
                    <div class="flex items-center gap-3 text-on-surface-variant">
                        <div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary"><span class="material-symbols-outlined">room_service</span></div>
                        <span class="font-label-lg">Dịch vụ phòng 24/7</span>
                    </div>
                </div>
            </div>

            <!-- Policies -->
            <div class="bg-surface-container-low p-8 rounded-xl border border-outline-variant/20 mt-8">
                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-6">Chính Sách Khách Sạn</h3>
                <div class="space-y-4">
                    <div class="flex gap-4">
                        <span class="material-symbols-outlined text-primary mt-1">check_circle</span>
                        <div>
                            <h4 class="font-label-lg text-on-surface mb-1">Thời gian nhận/trả phòng</h4>
                            <p class="text-body-md text-on-surface-variant">Nhận phòng từ 14:00. Trả phòng trước 12:00 trưa hôm sau.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <span class="material-symbols-outlined text-primary mt-1">check_circle</span>
                        <div>
                            <h4 class="font-label-lg text-on-surface mb-1">Hủy Đặt Phòng</h4>
                            <p class="text-body-md text-on-surface-variant">Miễn phí hủy phòng trước 3 ngày (72 giờ) so với ngày nhận phòng.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <span class="material-symbols-outlined text-primary mt-1">check_circle</span>
                        <div>
                            <h4 class="font-label-lg text-on-surface mb-1">Trẻ Em & Giường Phụ</h4>
                            <p class="text-body-md text-on-surface-variant">Miễn phí cho trẻ em dưới 6 tuổi dùng chung giường. Có hỗ trợ nôi em bé miễn phí (tùy thuộc tình trạng có sẵn).</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reviews Section -->
            @if (ViewBag.Reviews != null && ((IEnumerable<PhucNguyenResort.ViewModels.Reviews.ReviewListVM>)ViewBag.Reviews).Any())
            {
                var reviews = (IEnumerable<PhucNguyenResort.ViewModels.Reviews.ReviewListVM>)ViewBag.Reviews;
                var avgRating = reviews.Average(r => r.Rating) ?? 0.0;
                <div class="bg-surface-container-low p-8 rounded-xl border border-outline-variant/20 mt-8">
                    <h3 class="font-headline-sm text-headline-sm text-on-surface mb-6">Đánh Giá Từ Khách Hàng</h3>
                    <div class="flex items-center gap-4 mb-6 pb-6 border-b border-outline-variant/20">
                        <div class="text-4xl font-bold text-primary">@avgRating.ToString("0.0")</div>
                        <div>
                            <div class="flex text-primary">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(avgRating))
                                    {
                                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined">star</span>
                                    }
                                }
                            </div>
                            <div class="text-on-surface-variant font-label-md">Dựa trên @reviews.Count() đánh giá</div>
                        </div>
                    </div>
                    <div class="space-y-6">
                        @foreach (var review in reviews)
                        {
                            <div class="border-b border-outline-variant/10 pb-6 last:border-0 last:pb-0">
                                <div class="flex justify-between items-start mb-2">
                                    <div>
                                        <h4 class="font-label-lg text-on-surface">@review.UserName</h4>
                                        <div class="text-on-surface-variant text-body-sm">@review.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    </div>
                                    <div class="flex text-primary text-sm">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= (review.Rating ?? 0))
                                            {
                                                <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                            }
                                            else
                                            {
                                                <span class="material-symbols-outlined text-[16px]">star</span>
                                            }
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(review.Comment))
                                {
                                    <p class="text-body-md text-on-surface-variant">@review.Comment</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="bg-surface-container-low p-8 rounded-xl border border-outline-variant/20 mt-8">
                    <h3 class="font-headline-sm text-headline-sm text-on-surface mb-6">Đánh Giá Từ Khách Hàng</h3>
                    <p class="text-on-surface-variant font-label-md italic">Chưa có đánh giá nào cho phòng này.</p>
                </div>
            }
        </div>

        <!-- Sticky Booking Widget (Right Column) -->
        <div class="lg:col-span-4 relative mt-8 lg:mt-0">
            <div class="sticky top-28 bg-surface-container-lowest border border-outline-variant/20 rounded-2xl p-8 luxury-shadow z-10">
                <h3 class="font-headline-sm text-headline-sm text-on-surface text-center mb-6 pb-4 border-b border-outline-variant/20">Đặt Phòng Ngay</h3>
                
                <div class="bg-surface-container-low p-4 rounded-xl text-center mb-6 border border-dashed border-outline-variant/30">
                    <span class="text-on-surface-variant text-label-sm block mb-1">Giá ưu đãi trực tiếp từ</span>
                    <span class="text-headline-md font-bold text-primary">@Model.PricePerNight?.ToString("N0") VNĐ</span>
                </div>
                
                <form id="bookingWidgetForm" asp-controller="Bookings" asp-action="Create" method="get" class="space-y-6">
                    <input type="hidden" name="RoomSelections[0].CategoryId" value="@Model.CategoryId" />
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-2">Ngày Nhận Phòng</label>
                            <div class="flex items-center border border-outline-variant/30 rounded-lg px-4 py-3 bg-surface focus-within:border-primary-container transition-colors">
                                <span class="material-symbols-outlined text-outline mr-3">calendar_today</span>
                                <input type="text" id="checkInDate" name="checkIn" placeholder="Chọn ngày" min="@DateTime.Today.ToString("yyyy-MM-dd")" onfocus="(this.type='date')" onblur="(this.value=='' ? this.type='text' : this.type='date')" class="bg-transparent border-none outline-none text-body-md font-medium w-full" required>
                            </div>
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-2">Ngày Trả Phòng</label>
                            <div class="flex items-center border border-outline-variant/30 rounded-lg px-4 py-3 bg-surface focus-within:border-primary-container transition-colors">
                                <span class="material-symbols-outlined text-outline mr-3">calendar_today</span>
                                <input type="text" id="checkOutDate" name="checkOut" placeholder="Chọn ngày" min="@DateTime.Today.ToString("yyyy-MM-dd")" onfocus="(this.type='date')" onblur="(this.value=='' ? this.type='text' : this.type='date')" class="bg-transparent border-none outline-none text-body-md font-medium w-full" required>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Availability Alert Message -->
                    <div id="availabilityMsg" class="text-center font-bold text-[15px] py-1 hidden"></div>

                    <!-- Quantity Section -->
                    <div id="quantityContainer" class="hidden">
                        <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-2">Số lượng phòng muốn đặt</label>
                        <div class="flex items-center border border-outline-variant/30 rounded-lg px-4 py-3 bg-surface-container-low">
                            <span class="text-body-md font-medium text-on-surface-variant mr-4">Số phòng:</span>
                            <select id="roomQtySelect" name="RoomSelections[0].Quantity" class="bg-transparent border-none outline-none text-body-md font-bold text-on-surface flex-1">
                                <option value="1">1</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="space-y-3 pt-2">
                        <!-- Check availability button (Initially visible) -->
                        <button type="button" id="btnCheckAvailability" class="w-full bg-[#0d233a] text-white font-label-lg text-label-lg py-4 rounded-xl hover:opacity-90 transition-colors luxury-shadow uppercase tracking-widest">
                            Kiểm Tra Phòng Trống
                        </button>

                        <!-- Booking Actions (Initially hidden) -->
                        <div id="bookingActionsContainer" class="space-y-3 hidden">
                            <button type="submit" id="btnSubmitBooking" class="w-full bg-primary text-white font-label-lg text-label-lg py-4 rounded-xl hover:bg-on-primary-fixed-variant transition-colors luxury-shadow uppercase tracking-widest">
                                Tiến Hành Đặt Phòng
                            </button>
                            <button type="button" id="btnContinueShopping" class="w-full bg-white border border-primary text-primary font-label-lg text-label-lg py-4 rounded-xl hover:bg-primary/5 transition-colors uppercase tracking-widest">
                                Chọn Thêm Phòng Khác
                            </button>
                        </div>
                    </div>
                    
                    <div class="text-center mt-6 border-t border-outline-variant/10 pt-4">
                        <div class="flex items-center justify-center gap-2 text-on-surface-variant text-label-sm">
                            <span class="material-symbols-outlined text-[16px] text-primary">security</span>
                            Thanh toán an toàn, bảo mật thông tin.
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const checkInInput = document.getElementById('checkInDate');
            const checkOutInput = document.getElementById('checkOutDate');
            const availabilityMsg = document.getElementById('availabilityMsg');
            const quantityContainer = document.getElementById('quantityContainer');
            const roomQtySelect = document.getElementById('roomQtySelect');
            const btnCheckAvailability = document.getElementById('btnCheckAvailability');
            const bookingActionsContainer = document.getElementById('bookingActionsContainer');
            const btnSubmitBooking = document.getElementById('btnSubmitBooking');
            const btnContinueShopping = document.getElementById('btnContinueShopping');
            const categoryId = @Model.CategoryId;

            function formatDateToDdMmYyyy(dateStr) {
                if (!dateStr) return '';
                const parts = dateStr.split('-');
                if (parts.length === 3) {
                    return `${parts[2]}/${parts[1]}/${parts[0]}`;
                }
                return dateStr;
            }

            function resetWidgetState() {
                availabilityMsg.classList.add('hidden');
                quantityContainer.classList.add('hidden');
                btnCheckAvailability.classList.remove('hidden');
                bookingActionsContainer.classList.add('hidden');
            }

            // Reset state if user changes dates
            checkInInput.addEventListener('change', function () {
                checkOutInput.min = this.value;
                resetWidgetState();
            });
            checkOutInput.addEventListener('change', resetWidgetState);

            btnCheckAvailability.addEventListener('click', async function () {
                const checkIn = checkInInput.value;
                const checkOut = checkOutInput.value;

                if (!checkIn || !checkOut) {
                    showError("Vui lòng chọn đầy đủ ngày nhận và ngày trả phòng.");
                    return;
                }

                const d1 = new Date(checkIn);
                const d2 = new Date(checkOut);
                const today = new Date();
                today.setHours(0,0,0,0);

                if (d1 < today) {
                    showError("Không thể đặt phòng trong quá khứ.");
                    return;
                }

                if (d1 >= d2) {
                    showError("Ngày trả phòng phải sau ngày nhận phòng.");
                    return;
                }

                btnCheckAvailability.disabled = true;
                btnCheckAvailability.innerText = "Đang kiểm tra...";

                try {
                    const response = await fetch(`/Home/CheckRoomAvailability?categoryId=${categoryId}&checkIn=${checkIn}&checkOut=${checkOut}`);
                    const data = await response.json();

                    if (data.success && data.availableRooms > 0) {
                        showSuccess(data.message, data.availableRooms);
                    } else {
                        showError(data.message || "Loại phòng này đã hết phòng trong khoảng thời gian đã chọn.");
                    }
                } catch (error) {
                    console.error("Error checking availability:", error);
                    showError("Đã xảy ra lỗi khi kiểm tra tình trạng phòng.");
                } finally {
                    btnCheckAvailability.disabled = false;
                    btnCheckAvailability.innerText = "Kiểm Tra Phòng Trống";
                }
            });

            function showSuccess(msg, availableRooms) {
                availabilityMsg.innerText = msg;
                availabilityMsg.className = "text-center font-bold text-[15px] py-1 text-green-600";
                availabilityMsg.classList.remove('hidden');

                // Populate quantity select
                roomQtySelect.innerHTML = '';
                for (let i = 1; i <= availableRooms; i++) {
                    const opt = document.createElement('option');
                    opt.value = i;
                    opt.innerText = i;
                    roomQtySelect.appendChild(opt);
                }

                quantityContainer.classList.remove('hidden');
                btnCheckAvailability.classList.add('hidden');
                bookingActionsContainer.classList.remove('hidden');
            }

            function showError(msg) {
                availabilityMsg.innerText = msg;
                availabilityMsg.className = "text-center font-bold text-[15px] py-1 text-error";
                availabilityMsg.classList.remove('hidden');

                resetWidgetState();
            }

            // Handle Continue Shopping
            btnContinueShopping.addEventListener('click', function () {
                const checkInVal = checkInInput.value;
                const checkOutVal = checkOutInput.value;
                const qtyVal = roomQtySelect.value;
                
                const checkInFormatted = formatDateToDdMmYyyy(checkInVal);
                const checkOutFormatted = formatDateToDdMmYyyy(checkOutVal);

                window.location.href = `/Home/SearchRooms?checkIn=${checkInFormatted}&checkOut=${checkOutFormatted}&preselectId=${categoryId}&preselectQty=${qtyVal}`;
            });
        });
    </script>
}
