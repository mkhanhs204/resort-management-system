@model PhucNguyenResort.Models.RoomCategory

@{
    ViewData["Title"] = Model.CategoryName;
    string mainImage = string.IsNullOrEmpty(Model.ImageUrl) || Model.ImageUrl.Contains("category-") 
                       ? "/img/room/room-details.jpg" 
                       : Model.ImageUrl.Replace(" ", "%20");
    
    // Get up to 4 gallery images
    var galleryImages = Model.Images?.Take(4).ToList() ?? new List<PhucNguyenResort.Models.RoomCategoryImage>();
}

<link rel="stylesheet" href="~/css/room-details-premium.css" asp-append-version="true" />

<div class="container-fluid room-details-container">
    <!-- Breadcrumb Section Begin -->
    <div class="breadcrumb-section-custom">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <ul class="breadcrumb-custom">
                        <li><a asp-controller="Home" asp-action="Index"><i class="fa fa-home mr-1"></i> Trang Chủ</a></li>
                        <li class="separator">/</li>
                        <li><a href="#">Phúc Nguyễn Resort</a></li>
                        <li class="separator">/</li>
                        <li class="active">Chi Tiết Phòng</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <!-- Breadcrumb Section End -->

    <!-- Gallery Section Begin -->
    <section class="room-gallery-section" style="padding-bottom: 50px;">
        <div class="container">
            <div class="row">
                <!-- Main Image -->
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <div class="gallery-image-wrapper">
                        <a href="@mainImage" class="gallery-popup">
                            <img src="@mainImage" alt="@Model.CategoryName" style="height: 516px;">
                        </a>
                    </div>
                </div>
                <!-- Sub Images -->
                <div class="col-lg-6">
                    <div class="row">
                        @for (int i = 0; i < 4; i++)
                        {
                            string imgUrl = $"/img/room/room-b{i+1}.jpg"; // Default fallback images
                            if (i < galleryImages.Count)
                            {
                                imgUrl = galleryImages[i].ImageUrl.Replace(" ", "%20");
                            }
                            
                            <div class="col-6 mb-4">
                                <div class="gallery-image-wrapper">
                                    <a href="@imgUrl" class="gallery-popup" style="display: block; position: relative;">
                                        <img src="@imgUrl" alt="Gallery Image @i" style="height: 246px;">
                                        @if (i == 3)
                                        {
                                            <div class="gallery-overlay-all">
                                                + Xem Tất Cả
                                            </div>
                                        }
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Gallery Section End -->

    <!-- Room Info Section Begin -->
    <section class="room-info-section" style="padding-bottom: 80px;">
        <div class="container">
            <div class="row">
                <!-- Left Column: Description & Details -->
                <div class="col-lg-8 pr-lg-5 mb-5 mb-lg-0">
                    <h2 class="room-title-premium">@Model.CategoryName</h2>
                    
                    <div class="room-price-premium">
                        <span>Chỉ từ</span>
                        <strong class="room-price-val">@(Model.PricePerNight?.ToString("N0") ?? "0")</strong>
                        <span class="room-price-sub">VNĐ / Đêm</span>
                    </div>

                    <p class="room-description-premium">
                        @(string.IsNullOrEmpty(Model.Description) ? "Khởi đầu hành trình nghỉ dưỡng hoàn hảo với dịch vụ cá nhân hóa và tiện nghi đẳng cấp tại Phúc Nguyên Resort. Với tầm nhìn tuyệt đẹp và không gian yên tĩnh, phòng nghỉ của chúng tôi được thiết kế để mang đến sự thư giãn tuyệt đối cho bạn và người thân." : Model.Description)
                    </p>

                    <h4 class="section-subtitle-premium">
                        <i class="fa fa-th-large text-gold"></i> Tiện Nghi Nổi Bật
                    </h4>
                    
                    <!-- Amenities Grid -->
                    <div class="row amenities-grid">
                        <div class="col-md-6 mb-4">
                            <div class="amenity-card">
                                <div class="amenity-icon-wrapper">
                                    <i class="fa fa-arrows-alt"></i>
                                </div>
                                <div class="amenity-text-wrapper">
                                    <span class="amenity-label">Diện tích</span>
                                    <span class="amenity-value">Khoảng 30 - 45 m²</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="amenity-card">
                                <div class="amenity-icon-wrapper">
                                    <i class="fa fa-users"></i>
                                </div>
                                <div class="amenity-text-wrapper">
                                    <span class="amenity-label">Sức chứa</span>
                                    <span class="amenity-value">Tối đa @(Model.MaxAdults ?? 2) Người lớn, @(Model.MaxChildren ?? 1) Trẻ em</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="amenity-card">
                                <div class="amenity-icon-wrapper">
                                    <i class="fa fa-bed"></i>
                                </div>
                                <div class="amenity-text-wrapper">
                                    <span class="amenity-label">Giường</span>
                                    <span class="amenity-value">1 Giường Đôi (King)</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="amenity-card">
                                <div class="amenity-icon-wrapper">
                                    <i class="fa fa-wifi"></i>
                                </div>
                                <div class="amenity-text-wrapper">
                                    <span class="amenity-label">Kết nối</span>
                                    <span class="amenity-value">Wifi tốc độ cao miễn phí</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="amenity-card">
                                <div class="amenity-icon-wrapper">
                                    <i class="fa fa-television"></i>
                                </div>
                                <div class="amenity-text-wrapper">
                                    <span class="amenity-label">Giải trí</span>
                                    <span class="amenity-value">Smart TV màn hình phẳng</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="amenity-card">
                                <div class="amenity-icon-wrapper">
                                    <i class="fa fa-bath"></i>
                                </div>
                                <div class="amenity-text-wrapper">
                                    <span class="amenity-label">Phòng tắm</span>
                                    <span class="amenity-value">Bồn tắm & Vòi sen đứng</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Package Includes -->
                    <div class="promo-package-card">
                        <h5 class="promo-title">
                            <i class="fa fa-gift"></i> Gói Ưu Đãi Bao Gồm:
                        </h5>
                        <ul class="promo-list">
                            <li class="promo-item"><i class="fa fa-check-circle"></i> Miễn phí bữa sáng tự chọn tiêu chuẩn quốc tế hàng ngày.</li>
                            <li class="promo-item"><i class="fa fa-check-circle"></i> Tặng phiếu Spa trị giá 300,000 VNĐ cho mỗi lần lưu trú.</li>
                            <li class="promo-item"><i class="fa fa-check-circle"></i> Nước suối, trà và cà phê miễn phí trong phòng mỗi ngày.</li>
                            <li class="promo-item"><i class="fa fa-check-circle"></i> Miễn phí sử dụng hồ bơi vô cực và phòng Gym hiện đại.</li>
                        </ul>
                    </div>
                </div>

                <!-- Right Column: Booking Widget (Sticky) -->
                <div class="col-lg-4">
                    <div class="booking-widget-premium">
                        <h3 class="widget-title">Đặt Phòng Ngay</h3>
                        
                        <div class="widget-price-box">
                            <span class="widget-price-label">Giá ưu đãi trực tiếp từ</span>
                            <strong class="widget-price-amount">@(Model.PricePerNight?.ToString("N0") ?? "0") VNĐ</strong>
                        </div>

                        <form id="booking-form" method="get" action="/Bookings/Create">
                            <input type="hidden" name="RoomSelections[0].CategoryId" id="category-id" value="@Model.CategoryId" />
                            <input type="hidden" name="adults" value="@(Model.MaxAdults ?? 2)" />
                            <input type="hidden" name="children" value="@(Model.MaxChildren ?? 0)" />
                            
                            <div class="booking-input-group">
                                <label class="booking-input-label">Ngày Nhận Phòng</label>
                                <input type="text" name="checkIn" id="checkin-date" class="form-control-premium-input room-date-picker" placeholder="Chọn ngày" autocomplete="off" required>
                                <i class="fa fa-calendar input-icon-left"></i>
                            </div>
                            
                            <div class="booking-input-group">
                                <label class="booking-input-label">Ngày Trả Phòng</label>
                                <input type="text" name="checkOut" id="checkout-date" class="form-control-premium-input room-date-picker" placeholder="Chọn ngày" autocomplete="off" required>
                                <i class="fa fa-calendar input-icon-left"></i>
                            </div>

                            <div id="availability-msg" style="margin-bottom: 15px; font-weight: 600; text-align: center; display: none; font-size: 15px;"></div>

                            <div id="qty-selector" style="display: none; margin-bottom: 15px;">
                                <label class="booking-input-label">Số lượng phòng muốn đặt</label>
                                <div class="quantity-selector-box">
                                    <span style="font-size: 0.9rem; color: var(--text-muted);">Số phòng:</span>
                                    <input type="number" name="RoomSelections[0].Quantity" id="room-qty" class="qty-input-custom" value="1" min="1" max="1" />
                                </div>
                            </div>

                            <button type="button" id="check-availability-btn" class="btn-premium-check-availability">KIỂM TRA PHÒNG TRỐNG</button>
                            
                            <button type="submit" id="book-now-btn" class="btn-premium-book-now" style="display: none;">TIẾN HÀNH ĐẶT PHÒNG</button>
                            
                            <button type="button" id="book-more-btn" class="btn-premium-book-more mt-3" style="display: none;" onclick="goToSearchRooms()">CHỌN THÊM PHÒNG KHÁC</button>
                        </form>
                        
                        <p style="text-align: center; font-size: 12px; color: var(--text-muted); margin-top: 15px; margin-bottom: 0;">
                            <i class="fa fa-shield mr-1" style="color: var(--accent-color);"></i> Thanh toán an toàn, bảo mật thông tin.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
<!-- Room Info Section End -->

@section Scripts {
    <style>
        .ui-datepicker {
            z-index: 9999 !important;
        }
    </style>
    <script>
        $(document).ready(function() {
            // Initialize Magnific Popup for Gallery Images
            $('.gallery-popup').magnificPopup({
                type: 'image',
                gallery:{
                    enabled: true,
                    navigateByImgClick: true,
                    preload: [0,1]
                },
                image: {
                    tError: '<a href="%url%">Ảnh này</a> không thể tải được.'
                }
            });

            // Initialize explicitly for room-date-picker to avoid main.js conflicts
            $(".room-date-picker").datepicker({
                minDate: 0,
                dateFormat: 'dd/mm/yy'
            });

            // AJAX Check Availability
            $('#check-availability-btn').click(function() {
                var checkIn = $('#checkin-date').val();
                var checkOut = $('#checkout-date').val();
                var categoryId = $('#category-id').val();
                var msgDiv = $('#availability-msg');
                var btn = $(this);
                
                if (!checkIn || !checkOut) {
                    msgDiv.css('color', '#dc3545').text('Vui lòng chọn ngày nhận và trả phòng.').show();
                    return;
                }

                btn.text('ĐANG KIỂM TRA...');
                btn.prop('disabled', true);

                $.ajax({
                    url: '/Home/CheckRoomAvailability',
                    type: 'GET',
                    data: {
                        categoryId: categoryId,
                        checkIn: checkIn,
                        checkOut: checkOut
                    },
                    success: function(response) {
                        btn.text('KIỂM TRA PHÒNG TRỐNG');
                        btn.prop('disabled', false);

                        if (response.success) {
                            if (response.availableRooms > 0) {
                                msgDiv.css('color', '#28a745').text(response.message).show();
                                $('#check-availability-btn').hide();
                                
                                $('#room-qty').attr('max', response.availableRooms);
                                $('#room-qty').val(1);
                                $('#qty-selector').show();
                                
                                $('#book-now-btn').show();
                                $('#book-more-btn').show();
                            } else {
                                msgDiv.css('color', '#dc3545').text(response.message).show();
                                $('#check-availability-btn').show();
                                $('#qty-selector').hide();
                                $('#book-now-btn').hide();
                                $('#book-more-btn').hide();
                            }
                        } else {
                            msgDiv.css('color', '#dc3545').text(response.message).show();
                            $('#check-availability-btn').show();
                            $('#qty-selector').hide();
                            $('#book-now-btn').hide();
                            $('#book-more-btn').hide();
                        }
                    },
                    error: function() {
                        btn.text('KIỂM TRA PHÒNG TRỐNG');
                        btn.prop('disabled', false);
                        msgDiv.css('color', '#dc3545').text('Đã xảy ra lỗi máy chủ. Vui lòng thử lại sau.').show();
                    }
                });
            });

            // Reset buttons if dates change
            $('.room-date-picker').change(function() {
                $('#availability-msg').hide();
                $('#qty-selector').hide();
                $('#book-now-btn').hide();
                $('#book-more-btn').hide();
                $('#check-availability-btn').show();
            });
        });

        function goToSearchRooms() {
            var checkIn = $('#checkin-date').val();
            var checkOut = $('#checkout-date').val();
            var categoryId = $('#category-id').val();
            var qty = $('#room-qty').val() || 1;
            
            var url = '/Home/SearchRooms?checkIn=' + encodeURIComponent(checkIn) + 
                      '&checkOut=' + encodeURIComponent(checkOut) + 
                      '&preselectId=' + categoryId + 
                      '&preselectQty=' + qty;
            window.location.href = url;
        }
    </script>
}
