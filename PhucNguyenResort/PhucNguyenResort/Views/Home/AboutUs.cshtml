@{
    ViewData["Title"] = "Về Chúng Tôi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/aboutus-premium.css" asp-append-version="true" />
}

<!-- Hero Section Begin -->
<section class="about-hero" style="background-image: url('/img/room/room-b2.jpg');">
    <div class="about-hero-overlay"></div>
    <div class="container about-hero-content">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb-text">
                    <h2 class="about-hero-title">Câu Chuyện Của Chúng Tôi</h2>
                    <div class="about-hero-breadcrumb">
                        <a asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        <span>/ Về Chúng Tôi</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Hero Section End -->

<!-- Our Story Section Begin -->
<section class="aboutus-page-section about-section-padding">
    <div class="container">
        <div class="row align-items-center">
            <!-- Text Column -->
            <div class="col-lg-5 mb-5 mb-lg-0">
                <div class="ap-title">
                    <span class="about-subtitle">Chào Mừng Đến Với Phúc Nguyên</span>
                    <h2 class="about-title">
                        Nơi Giao Thoa Giữa <br /> <span class="about-title-highlight">Thiên Nhiên & Đẳng Cấp</span>
                    </h2>
                    <p class="about-text">
                        Nằm ẩn mình trên bờ biển thơ mộng với dải cát trắng mịn, Phúc Nguyên Resort là điểm đến lý tưởng cho những ai đang tìm kiếm sự bình yên. Được thiết kế với sự kết hợp hoàn hảo giữa kiến trúc truyền thống Indochine và nét hiện đại sang trọng, chúng tôi mang đến một không gian nghỉ dưỡng tuyệt vời.
                    </p>
                    <p class="about-text">
                        Được thành lập vào năm 2010, Phúc Nguyên Resort tự hào phục vụ hàng ngàn du khách trong và ngoài nước. Chúng tôi luôn cam kết mang lại trải nghiệm độc bản, từ các phòng nghỉ tiện nghi, hồ bơi vô cực nhìn ra đại dương, đến dịch vụ ẩm thực địa phương tinh tế.
                    </p>
                    <a asp-controller="Home" asp-action="Index" class="about-btn">KHÁM PHÁ PHÒNG NGAY</a>
                </div>
            </div>
            <!-- Image Column -->
            <div class="col-lg-6 offset-lg-1">
                <div class="story-img-wrapper">
                    <img src="/img/about/about-p1.jpg" alt="About Us" class="story-img">
                    <div class="story-badge">
                        <h4>15+ Năm</h4>
                        <p>Kinh nghiệm phục vụ &<br> kiến tạo kỳ nghỉ hoàn hảo.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Our Story Section End -->

<!-- Core Values Section Begin -->
<section class="core-values-section">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-12">
                <span class="about-subtitle">Giá Trị Cốt Lõi</span>
                <h2 class="about-title">Tại Sao Chọn Chúng Tôi?</h2>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="value-card">
                    <i class="fa fa-building-o value-icon"></i>
                    <h4 class="value-title">Kiến Trúc Độc Bản</h4>
                    <p class="value-text">Sự giao thoa hoàn mỹ giữa nét văn hóa truyền thống Indochine và phong cách sống hiện đại, mang lại không gian lưu trú kiệt tác.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="value-card">
                    <i class="fa fa-heart-o value-icon"></i>
                    <h4 class="value-title">Dịch Vụ Tận Tâm</h4>
                    <p class="value-text">Đội ngũ nhân viên chuyên nghiệp, thân thiện, luôn sẵn sàng đáp ứng mọi nhu cầu để kỳ nghỉ của bạn trở nên hoàn hảo nhất.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="value-card">
                    <i class="fa fa-leaf value-icon"></i>
                    <h4 class="value-title">Gần Gũi Thiên Nhiên</h4>
                    <p class="value-text">Bao quanh bởi biển xanh và những khu vườn nhiệt đới xanh mát, mang bạn đến gần hơn với sự tĩnh lặng của thiên nhiên.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Core Values Section End -->

<!-- Signature Experiences Section Begin -->
<section class="aboutus-page-section about-section-padding">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-12">
                <span class="about-subtitle">Trải Nghiệm</span>
                <h2 class="about-title">Dịch Vụ Đẳng Cấp</h2>
            </div>
        </div>
        <div class="about-page-services">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="experience-card" style="background-image: url('/img/about/about-p1.jpg');">
                        <div class="experience-overlay"></div>
                        <div class="experience-content">
                            <h3 class="experience-title">Nhà Hàng & Bar</h3>
                            <p class="experience-desc">Thưởng thức tinh hoa ẩm thực địa phương và quốc tế.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="experience-card" style="background-image: url('/img/about/about-p2.jpg');">
                        <div class="experience-overlay"></div>
                        <div class="experience-content">
                            <h3 class="experience-title">Hồ Bơi Vô Cực</h3>
                            <p class="experience-desc">Thư giãn tuyệt đối giữa làn nước trong xanh ngắm đại dương.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="experience-card" style="background-image: url('/img/about/about-p3.jpg');">
                        <div class="experience-overlay"></div>
                        <div class="experience-content">
                            <h3 class="experience-title">Spa & Trị Liệu</h3>
                            <p class="experience-desc">Đánh thức mọi giác quan với các liệu trình spa độc quyền.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Signature Experiences Section End -->

<!-- Video Section Begin -->
<section class="about-video-section" style="background-image: url('/img/video-bg.jpg');">
    <div class="about-hero-overlay"></div>
    <div class="container about-hero-content">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="about-video-text">
                    <h2>Khám Phá Khu Nghỉ Dưỡng Của Chúng Tôi</h2>
                    <p>Cảm nhận sự sang trọng, thiên nhiên tươi đẹp và dịch vụ hoàn hảo qua từng góc nhìn.</p>
                    <a href="https://www.youtube.com/watch?v=EzKkl64rRbM" class="about-play-btn video-popup">
                        <i class="fa fa-play"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Video Section End -->
