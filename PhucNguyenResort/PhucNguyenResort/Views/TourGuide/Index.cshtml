@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Lịch Trình Vận Hành Của Tôi";
    Layout = "_DashboardLayout";

    var totalTasks = Model?.Count() ?? 0;
    var upcomingCount = 0;
    var ongoingCount = 0;
    var completedCount = 0;

    if (Model != null)
    {
        foreach (var s in Model)
        {
            var status = ViewData[$"Status_{s.ScheduleId}"]?.ToString() ?? "Upcoming";
            if (status == "Upcoming") upcomingCount++;
            else if (status == "Ongoing") ongoingCount++;
            else if (status == "Completed") completedCount++;
        }
    }
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528;
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b;
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 24px;
            margin-bottom: 30px;
        }
        .luxury-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        .luxury-table thead th {
            background-color: #f6f3ef;
            color: #50453b;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 16px;
            border: none;
        }
        .luxury-table thead th:first-child {
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
        }
        .luxury-table thead th:last-child {
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }
        .luxury-table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-bottom: 1px solid #f0ede9;
            color: #1c1c1a;
            font-size: 14px;
        }
        .luxury-table tbody tr:last-child td {
            border-bottom: none;
        }
        .luxury-table tbody tr:hover {
            background-color: #fcf9f5;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .material-symbols-outlined.fill {
            font-variation-settings: 'FILL' 1;
        }
        .btn-luxury {
            background-color: #dfa974;
            color: #633d11;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 20px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-luxury:hover {
            background-color: #805528;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2);
            text-decoration: none;
        }
        .action-btn {
            background: transparent;
            border: 1px solid #dfa974;
            color: #805528;
            padding: 6px 12px;
            border-radius: 6px;
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .action-btn:hover {
            background: #fcf9f5;
            color: #633d11;
            text-decoration: none;
        }
        .luxury-badge {
            background-color: #f0ede9;
            color: #50453b;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 12px;
            display: inline-block;
        }
        .luxury-badge.blue {
            background-color: #d3e4fe;
            color: #0b1c30;
        }
        .luxury-badge.green {
            background-color: #e2f5ea;
            color: #0b5c2d;
        }
        .luxury-badge.red {
            background-color: #ffdad6;
            color: #ba1a1a;
        }
        .luxury-badge.yellow {
            background-color: #fff8e6;
            color: #946c00;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
    </style>
}

<div class="header-container">
    <div>
        <h2 class="page-title">
            Schedules & Attendance
        </h2>
        <p class="page-subtitle mb-0">
            Xem danh sách lịch trình tour được phân công, kiểm tra danh sách đoàn và tiến hành điểm danh
        </p>
    </div>
    <div style="font-family: 'Inter', sans-serif; color: #50453b; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined">calendar_today</span>
        <span>@DateTime.Now.ToString("dd MMMM, yyyy")</span>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4 col-12 mb-3">
        <div class="luxury-card" style="padding: 24px; margin-bottom: 0;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                <div style="width: 48px; height: 48px; border-radius: 12px; background: #fff8e6; color: #946c00; display: flex; align-items: center; justify-content: center;">
                    <span class="material-symbols-outlined fill" style="font-size: 24px;">schedule</span>
                </div>
            </div>
            <div style="font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 700; color: #1c1c1a; margin-bottom: 4px;">@upcomingCount</div>
            <div style="color: #827569; font-size: 13px; font-weight: 600; text-transform: uppercase;">Upcoming Tours</div>
        </div>
    </div>
    <div class="col-md-4 col-12 mb-3">
        <div class="luxury-card" style="padding: 24px; margin-bottom: 0;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                <div style="width: 48px; height: 48px; border-radius: 12px; background: #d3e4fe; color: #0b1c30; display: flex; align-items: center; justify-content: center;">
                    <span class="material-symbols-outlined fill" style="font-size: 24px;">autorenew</span>
                </div>
            </div>
            <div style="font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 700; color: #1c1c1a; margin-bottom: 4px;">@ongoingCount</div>
            <div style="color: #827569; font-size: 13px; font-weight: 600; text-transform: uppercase;">Ongoing Tours</div>
        </div>
    </div>
    <div class="col-md-4 col-12 mb-3">
        <div class="luxury-card" style="padding: 24px; margin-bottom: 0;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                <div style="width: 48px; height: 48px; border-radius: 12px; background: #e2f5ea; color: #0b5c2d; display: flex; align-items: center; justify-content: center;">
                    <span class="material-symbols-outlined fill" style="font-size: 24px;">check_circle</span>
                </div>
            </div>
            <div style="font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 700; color: #1c1c1a; margin-bottom: 4px;">@completedCount</div>
            <div style="color: #827569; font-size: 13px; font-weight: 600; text-transform: uppercase;">Completed Tours</div>
        </div>
    </div>
</div>

<div class="luxury-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <h5 style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 700; color: #805528; margin: 0;">
            Lịch Trình Tour Phân Công
        </h5>
        <div style="display: flex; gap: 12px; align-items: center;">
            <span class="luxury-badge" style="font-size: 13px; padding: 6px 16px;">Tổng cộng: @totalTasks</span>
        </div>
    </div>

    <div style="overflow-x: auto;">
        <table class="luxury-table">
            <thead>
                <tr>
                    <th style="width: 80px;">Mã số</th>
                    <th style="width: 250px;">Tên Tour</th>
                    <th>Ngày khởi hành</th>
                    <th>Thời gian</th>
                    <th>Chỗ trống</th>
                    <th>Trạng thái</th>
                    <th style="text-align: right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var currentStatus = ViewData[$"Status_{item.ScheduleId}"]?.ToString() ?? "Upcoming";
                        var endTimeStr = ViewData[$"EndTime_{item.ScheduleId}"]?.ToString() ?? "N/A";
                        var startHourStr = item.StartTime != null ? item.StartTime.ToString(@"hh\:mm") : "00:00";

                        <tr>
                            <td style="color: #827569; font-weight: 600;">#@item.ScheduleId.ToString("D2")</td>
                            <td>
                                <div style="font-weight: 600; color: #1c1c1a; font-size: 15px; margin-bottom: 4px;">@(item.Tour?.TourName ?? "N/A")</div>
                                <div style="color: #827569; font-size: 12px; display: flex; align-items: center; gap: 4px;">
                                    <span class="material-symbols-outlined" style="font-size: 14px;">schedule</span>
                                    Thời lượng: @(item.Tour?.DurationHours != null ? $"{item.Tour.DurationHours} tiếng" : "4 tiếng")
                                </div>
                            </td>
                            <td style="font-weight: 600;">@(item.TourDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 8px; background: #f6f3ef; padding: 4px 12px; border-radius: 8px; display: inline-flex; font-weight: 600; font-size: 13px;">
                                    <span>@startHourStr</span>
                                    <span class="material-symbols-outlined" style="font-size: 14px; color: #a4b5ce;">arrow_right_alt</span>
                                    <span style="color: #0b1c30;">@endTimeStr</span>
                                </div>
                            </td>
                            <td>
                                @if (item.AvailableSlots > 0)
                                {
                                    <span class="luxury-badge blue" style="font-size: 11px;">Còn @item.AvailableSlots chỗ</span>
                                }
                                else
                                {
                                    <span class="luxury-badge red" style="font-size: 11px;">Đã hết chỗ</span>
                                }
                            </td>
                            <td>
                                @if (currentStatus == "Upcoming")
                                {
                                    <span class="luxury-badge yellow">Sắp diễn ra</span>
                                }
                                else if (currentStatus == "Ongoing")
                                {
                                    <span class="luxury-badge blue">Đang diễn ra</span>
                                }
                                else
                                {
                                    <span class="luxury-badge green">Đã hoàn thành</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <a asp-controller="TourGuide" asp-action="Participants" asp-route-scheduleId="@item.ScheduleId" class="action-btn">
                                    <span class="material-symbols-outlined" style="font-size: 16px;">groups</span> Điểm danh
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 40px; color: #827569;">
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
                                <span class="material-symbols-outlined" style="font-size: 48px; color: #d4c3b6;">folder_open</span>
                                <div>Hiện chưa có lịch trình vận hành tour nào được phân công cho bạn hôm nay.</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>