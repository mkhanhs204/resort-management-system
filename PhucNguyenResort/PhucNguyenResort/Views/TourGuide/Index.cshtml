@model IEnumerable<dynamic>

@{
    // Gom nhóm tính toán trước trên tầng C# để tránh lỗi cú pháp Razor lồng trong HTML
    var totalTasks = Model?.Count() ?? 0;
    var upcomingCount = 0;
    var ongoingCount = 0;
    var completedCount = 0;
    var cancelledCount = 0;

    if (Model != null)
    {
        foreach (var s in Model)
        {
            var status = ViewData[$"Status_{s.ScheduleId}"]?.ToString() ?? "Upcoming";
            if (status == "Upcoming") upcomingCount++;
            else if (status == "Ongoing") ongoingCount++;
            else if (status == "Completed") completedCount++;
            else if (status == "Cancelled") cancelledCount++;
        }
    }
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
        <div class="card-body d-flex justify-content-between align-items-center p-4">
            <div>
                <h3 class="font-weight-bold text-dark mb-1" style="font-family: 'Playfair Display', serif;">
                    <i class="fa-solid fa-map-location-dot text-info me-2"></i> Lịch Trình Vận Hành Của Tôi
                </h3>
                <p class="text-muted small mb-0">Hệ thống tự động theo dõi, cập nhật trạng thái hoạt động theo mốc thời gian thực.</p>
            </div>
            <div>
                <span class="badge bg-light text-dark border p-2" style="border-radius: 8px;">
                    <i class="fa fa-calendar me-1 text-info"></i> @DateTime.Now.ToString("dd/MM/yyyy")
                </span>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center border-0 shadow-sm p-3" style="border-radius: 12px; border-top: 4px solid #0dcaf0 !important;">
                <h6 class="text-muted text-uppercase font-weight-bold small">Sắp diễn ra</h6>
                <h2 class="font-weight-bold text-dark my-2">@upcomingCount</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-0 shadow-sm p-3" style="border-radius: 12px; border-top: 4px solid #ffc107 !important;">
                <h6 class="text-muted text-uppercase font-weight-bold small">Đang chạy</h6>
                <h2 class="font-weight-bold text-dark my-2">@ongoingCount</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-0 shadow-sm p-3" style="border-radius: 12px; border-top: 4px solid #198754 !important;">
                <h6 class="text-muted text-uppercase font-weight-bold small">Đã hoàn thành</h6>
                <h2 class="font-weight-bold text-dark my-2">@completedCount</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-0 shadow-sm p-3" style="border-radius: 12px; border-top: 4px solid #dc3545 !important;">
                <h6 class="text-muted text-uppercase font-weight-bold small">Đã hủy bỏ</h6>
                <h2 class="font-weight-bold text-dark my-2">@cancelledCount</h2>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 12px;">
        <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
            <h5 class="font-weight-bold text-dark mb-0">
                <i class="fa fa-list-alt me-2 text-secondary"></i> Chi Tiết Phân Công Công Việc
            </h5>
            <span class="badge bg-secondary p-2 small">Tổng số tác vụ: @totalTasks</span>
        </div>

        <div class="card-body px-4 pb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle custom-table-resort">
                    <thead class="table-light text-uppercase text-secondary small font-weight-bold">
                        <tr>
                            <th style="width: 10%;">Mã số</th>
                            <th style="width: 25%;">Chương trình Tour</th>
                            <th style="width: 15%;">Ngày vận hành</th>
                            <th style="width: 20%;">Khung giờ chạy Tour</th>
                            <th style="width: 12%;">Trạng thái chỗ</th>
                            <th style="width: 18%;">Trạng thái thực tế</th>
                            <th style="width: 10%; text-align: center;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                var currentStatus = ViewData[$"Status_{item.ScheduleId}"]?.ToString() ?? "Upcoming";
                                var endTimeStr = ViewData[$"EndTime_{item.ScheduleId}"]?.ToString() ?? "N/A";
                                var startHourStr = item.StartTime != null ? item.StartTime.ToString(@"hh\:mm") : "00:00";

                                <tr class="tour-row" data-schedule-id="@item.ScheduleId">
                                    <td class="text-secondary font-weight-bold">#@item.ScheduleId.ToString("D2")</td>
                                    <td class="text-start">
                                        <span class="font-weight-bold text-dark d-block" style="font-size: 15px;">@(item.Tour?.TourName ?? "N/A")</span>
                                        <small class="text-muted">
                                            <i class="fa fa-hourglass-start me-1"></i> Thời lượng: @(item.Tour?.DurationHours != null ? $"{item.Tour.DurationHours} tiếng" : "4 tiếng")
                                        </small>
                                    </td>
                                    <td class="text-dark font-weight-bold target-date">
                                        @(item.TourDate?.ToString("dd/MM/yyyy") ?? "N/A")
                                    </td>
                                    <td>
                                        <div class="time-badge-box text-dark">
                                            <i class="fa fa-clock text-muted me-1"></i>
                                            <span class="start-time-text">@startHourStr</span>
                                            <i class="fa fa-long-arrow-right text-muted mx-2"></i>
                                            <span class="text-info font-weight-bold end-time-text">@endTimeStr</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.AvailableSlots > 0)
                                        {
                                            <span class="badge badge-pill p-2" style="font-size: 11px; background-color: rgba(8, 145, 178, 0.1); color: #0891b2; font-weight: 700; border-radius: 8px;">
                                                Còn @item.AvailableSlots chỗ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-pill p-2" style="font-size: 11px; background-color: rgba(239, 68, 68, 0.1); color: #ef4444; font-weight: 700; border-radius: 8px;">
                                                Full slots
                                            </span>
                                        }
                                    </td>
                                    <td class="status-container">
                                        @if (currentStatus == "Cancelled")
                                        {
                                            <span class="badge-status-custom b-cancelled" data-origin="Cancelled"><i class="fa fa-minus-circle"></i> Đã hủy bỏ</span>
                                        }
                                        else if (currentStatus == "Upcoming")
                                        {
                                            <span class="badge-status-custom b-upcoming" data-origin="Upcoming"><i class="fa fa-clock-o"></i> Sắp diễn ra</span>
                                        }
                                        else if (currentStatus == "Ongoing")
                                        {
                                            <span class="badge-status-custom b-ongoing" data-origin="Ongoing"><i class="fa fa-refresh fa-spin"></i> Đang diễn ra</span>
                                        }
                                        else
                                        {
                                            <span class="badge-status-custom b-completed" data-origin="Completed"><i class="fa fa-check-circle"></i> Đã hoàn thành</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="TourGuide" asp-action="Participants" asp-route-scheduleId="@item.ScheduleId" class="btn btn-sm btn-info text-white shadow-sm font-weight-bold px-3" style="border-radius: 6px;">
                                            <i class="fa fa-users me-1"></i> Guest List
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-folder-open fs-2 d-block mb-2 text-light"></i>
                                    Hiện chưa có lịch trình vận hành tour nào được phân công cho bạn.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>