@model IEnumerable<PhucNguyenResort.Models.TourBooking>
@using PhucNguyenResort.Enums

@{
    ViewData["Title"] = "Điều Hành & Điểm Danh Hành Khách";
    Layout = "_DashboardLayout";

    var schedule = ViewBag.Schedule;
    string tourScheduleStatus = ViewBag.TourScheduleStatus ?? "Upcoming";

    int totalBookings = Model?.Count() ?? 0;
    int totalTickets = Model?.Sum(b => b.Participants ?? 1) ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528;
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b;
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 24px;
            margin-bottom: 30px;
        }
        .luxury-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        .luxury-table thead th {
            background-color: #f6f3ef;
            color: #50453b;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 16px;
            border: none;
        }
        .luxury-table thead th:first-child {
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
        }
        .luxury-table thead th:last-child {
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }
        .luxury-table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-bottom: 1px solid #f0ede9;
            color: #1c1c1a;
            font-size: 14px;
        }
        .luxury-table tbody tr:last-child td {
            border-bottom: none;
        }
        .luxury-table tbody tr:hover {
            background-color: #fcf9f5;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .material-symbols-outlined.fill {
            font-variation-settings: 'FILL' 1;
        }
        .btn-luxury {
            background-color: #dfa974;
            color: #633d11;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 20px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-luxury:hover {
            background-color: #805528;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2);
            text-decoration: none;
        }
        .luxury-badge {
            background-color: #f0ede9;
            color: #50453b;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 12px;
            display: inline-block;
        }
        .luxury-badge.blue {
            background-color: #d3e4fe;
            color: #0b1c30;
        }
        .luxury-badge.green {
            background-color: #e2f5ea;
            color: #0b5c2d;
        }
        .luxury-badge.red {
            background-color: #ffdad6;
            color: #ba1a1a;
        }
        .luxury-badge.yellow {
            background-color: #fff8e6;
            color: #946c00;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        .avatar-circle {
            width: 40px;
            height: 40px;
            background-color: #f0ede9;
            color: #805528;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .tour-info-bar {
            display: flex;
            gap: 24px;
            background: #f6f3ef;
            padding: 12px 24px;
            border-radius: 12px;
            margin-bottom: 24px;
            align-items: center;
            font-family: 'Inter', sans-serif;
            color: #50453b;
            font-size: 14px;
            flex-wrap: wrap;
        }
    </style>
}

<div class="header-container">
    <div>
        <h2 class="page-title">
            Điều Hành & Điểm Danh
        </h2>
        <a asp-action="Index" style="color: #805528; font-family: 'Inter', sans-serif; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 4px; margin-top: 8px;">
            <span class="material-symbols-outlined" style="font-size: 20px;">arrow_back</span> Quay lại lịch trình
        </a>
    </div>
    <div style="font-family: 'Inter', sans-serif; color: #50453b; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined">calendar_today</span>
        <span>@DateTime.Now.ToString("dd MMMM, yyyy")</span>
    </div>
</div>

<div class="tour-info-bar">
    <div style="display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined fill" style="color: #805528;">tour</span>
        <strong style="color: #1c1c1a;">@(schedule?.Tour?.TourName ?? "N/A")</strong>
    </div>
    <div style="display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined" style="color: #805528;">schedule</span>
        <strong style="color: #1c1c1a;">@(schedule?.StartTime?.ToString("hh\\:mm") ?? "00:00") - @(((TimeSpan?)ViewBag.EndTime)?.ToString("hh\\:mm") ?? "00:00")</strong>
    </div>
    <div style="display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined" style="color: #805528;">event</span>
        <strong style="color: #1c1c1a;">@(schedule?.TourDate?.ToString("dd/MM/yyyy") ?? "N/A")</strong>
    </div>
    <div style="margin-left: auto;">
        @if (tourScheduleStatus == "Upcoming")
        {
            <span class="luxury-badge yellow">Sắp diễn ra</span>
        }
        else if (tourScheduleStatus == "Ongoing")
        {
            <span class="luxury-badge blue">Đang diễn ra</span>
        }
        else if (tourScheduleStatus == "Completed")
        {
            <span class="luxury-badge green">Đã hoàn thành</span>
        }
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3 col-6 mb-3">
        <div class="luxury-card" style="padding: 20px; margin-bottom: 0; text-align: center;">
            <div style="color: #827569; font-size: 12px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px;">Tổng số đoàn</div>
            <div style="font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: #1c1c1a;">@totalBookings</div>
        </div>
    </div>
    <div class="col-md-3 col-6 mb-3">
        <div class="luxury-card" style="padding: 20px; margin-bottom: 0; text-align: center;">
            <div style="color: #827569; font-size: 12px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px;">Tổng số vé (Khách)</div>
            <div style="font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: #805528;" id="stat-total-tickets">@totalTickets</div>
        </div>
    </div>
    <div class="col-md-3 col-6 mb-3">
        <div class="luxury-card" style="padding: 20px; margin-bottom: 0; text-align: center;">
            <div style="color: #827569; font-size: 12px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px;">Đã có mặt</div>
            <div style="font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: #0b5c2d;" id="stat-checked-in">0</div>
        </div>
    </div>
    <div class="col-md-3 col-6 mb-3">
        <div class="luxury-card" style="padding: 20px; margin-bottom: 0; text-align: center;">
            <div style="color: #827569; font-size: 12px; font-weight: 600; text-transform: uppercase; margin-bottom: 8px;">Vắng mặt</div>
            <div style="font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: #ba1a1a;" id="stat-no-show">0</div>
        </div>
    </div>
</div>

<div class="luxury-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; gap: 16px; flex-wrap: wrap; flex: 1;">
            <div style="display: flex; align-items: center; gap: 8px; background-color: #f6f3ef; border-radius: 8px; padding: 0 12px; min-width: 250px;">
                <span class="material-symbols-outlined" style="color: #50453b; font-size: 20px;">search</span>
                <input type="text" id="search-passenger" placeholder="Tìm tên khách, email..." style="background-color: transparent; border: none; outline: none; padding: 8px 0; width: 100%; font-family: 'Inter', sans-serif;">
            </div>
            
            <div style="min-width: 200px;">
                <select id="filter-passenger-status" style="background-color: #f6f3ef; border: 1px solid transparent; border-radius: 8px; padding: 8px 16px; width: 100%; font-family: 'Inter', sans-serif; color: #50453b; outline: none; cursor: pointer;">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Confirmed">Chờ khách đến</option>
                    <option value="CheckedIn">Khách đã có mặt</option>
                    <option value="NoShow">Khách vắng mặt</option>
                    <option value="Completed">Đã hoàn thành</option>
                </select>
            </div>
        </div>

        <button type="button" id="btn-checkin-all" class="btn-luxury" style="background: #e2f5ea; color: #0b5c2d; border: 1px solid #0b5c2d; white-space: nowrap;">
            <span class="material-symbols-outlined">checklist</span> Xác nhận Có mặt Tất cả
        </button>
    </div>
    
    <div style="overflow-x: auto;">
        <table class="luxury-table" id="passenger-table">
            <thead>
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Hành khách / Trưởng đoàn</th>
                    <th>Số lượng vé</th>
                    <th>Tổng tiền</th>
                    <th style="text-align: right;">Trạng thái & Điểm danh</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var booking in Model)
                    {
                        <tr id="row-@booking.TourBookingId" class="passenger-row">
                            <td style="color: #827569; font-weight: 600;">@index.ToString("D2")</td>
                            <td class="target-search">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div class="avatar-circle">
                                        <span class="material-symbols-outlined">person</span>
                                    </div>
                                    <div>
                                        <div style="font-weight: 600; color: #1c1c1a; font-size: 15px; margin-bottom: 2px;" class="name-field">@(booking.User?.FullName ?? $"Khách hàng #{booking.UserId}")</div>
                                        <div style="color: #827569; font-size: 13px; display: flex; flex-direction: column; gap: 2px;">
                                            <span style="display: flex; align-items: center; gap: 4px;"><span class="material-symbols-outlined" style="font-size: 14px;">mail</span>@(booking.User?.Email ?? "Chưa có email")</span>
                                            <a href="tel:@(booking.User?.PhoneNumber ?? "0901234567")" style="color: #805528; text-decoration: none; display: flex; align-items: center; gap: 4px; font-weight: 500;">
                                                <span class="material-symbols-outlined" style="font-size: 14px;">call</span>@(booking.User?.PhoneNumber ?? "0901 234 567")
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="luxury-badge blue" data-tickets="@(booking.Participants ?? 1)">
                                    @(booking.Participants ?? 1) Vé
                                </span>
                            </td>
                            <td>
                                <span style="font-weight: 600; color: #805528;">@(booking.TotalAmount?.ToString("N0") ?? "0") ₫</span>
                            </td>
                            <td style="text-align: right;">
                                <select class="form-control status-selector"
                                        data-id="@booking.TourBookingId"
                                        data-current="@booking.BookingStatus"
                                        style="display: inline-block; width: auto; background-color: #f6f3ef; border: 1px solid transparent; border-radius: 8px; padding: 8px 12px; font-family: 'Inter', sans-serif; font-weight: 600; color: #50453b; cursor: pointer;">
                                    <option value="Confirmed" selected="@(booking.BookingStatus == TourBookingStatus.Confirmed)">⚪ Chờ khách đến</option>
                                    <option value="CheckedIn" selected="@(booking.BookingStatus == TourBookingStatus.CheckedIn)">🚘 Khách đã có mặt</option>
                                    <option value="NoShow" selected="@(booking.BookingStatus == TourBookingStatus.NoShow)">⚠️ Khách vắng mặt</option>
                                    <option value="Completed" selected="@(booking.BookingStatus == TourBookingStatus.Completed)">✅ Đã hoàn thành</option>
                                </select>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align: center; padding: 40px; color: #827569;">
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
                                <span class="material-symbols-outlined" style="font-size: 48px; color: #d4c3b6;">info</span>
                                <div>Lịch trình tour này hiện tại chưa có hành khách đặt chỗ.</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model != null && Model.Any())
    {
        <div id="pagination-container" style="display: flex; justify-content: center; gap: 8px; margin-top: 24px;"></div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            // --- PAGINATION & SEARCH LOGIC ---
            const itemsPerPage = 5;
            let allItems = Array.from(document.querySelectorAll('.passenger-row'));
            let filteredItems = [...allItems];
            let currentPage = 1;
            const paginationContainer = document.getElementById('pagination-container');

            function renderPagination() {
                if (!paginationContainer) return;
                paginationContainer.innerHTML = '';
                const totalPages = Math.ceil(filteredItems.length / itemsPerPage);
                
                if (totalPages <= 1) return;
                
                // Prev Button
                const prevBtn = document.createElement('button');
                prevBtn.className = 'action-btn';
                prevBtn.style.padding = '6px 10px';
                if (currentPage === 1) {
                    prevBtn.style.opacity = '0.5';
                    prevBtn.style.cursor = 'not-allowed';
                }
                prevBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 20px;">chevron_left</span>';
                prevBtn.disabled = currentPage === 1;
                if (currentPage > 1) {
                    prevBtn.onclick = () => showPage(currentPage - 1);
                }
                paginationContainer.appendChild(prevBtn);
                
                // Page Buttons
                for (let i = 1; i <= totalPages; i++) {
                    const pageBtn = document.createElement('button');
                    pageBtn.className = 'action-btn';
                    pageBtn.style.padding = '6px 14px';
                    if (i === currentPage) {
                        pageBtn.style.backgroundColor = '#805528';
                        pageBtn.style.color = '#ffffff';
                    }
                    pageBtn.innerText = i;
                    pageBtn.onclick = () => showPage(i);
                    paginationContainer.appendChild(pageBtn);
                }
                
                // Next Button
                const nextBtn = document.createElement('button');
                nextBtn.className = 'action-btn';
                nextBtn.style.padding = '6px 10px';
                if (currentPage === totalPages) {
                    nextBtn.style.opacity = '0.5';
                    nextBtn.style.cursor = 'not-allowed';
                }
                nextBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 20px;">chevron_right</span>';
                nextBtn.disabled = currentPage === totalPages;
                if (currentPage < totalPages) {
                    nextBtn.onclick = () => showPage(currentPage + 1);
                }
                paginationContainer.appendChild(nextBtn);
            }
            
            function showPage(page) {
                currentPage = page;
                const totalPages = Math.ceil(filteredItems.length / itemsPerPage);
                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;
                
                allItems.forEach(item => {
                    item.style.display = 'none';
                });
                
                filteredItems.forEach((item, index) => {
                    if (index >= (currentPage - 1) * itemsPerPage && index < currentPage * itemsPerPage) {
                        item.style.display = '';
                    }
                });
                
                renderPagination();
            }
            
            if (allItems.length > 0) {
                showPage(1);
            }
            // ----------------------------------

            function calculateStats() {
                var checkedInTickets = 0;
                var noShowTickets = 0;

                $('.status-selector').each(function() {
                    var val = $(this).val();
                    var tickets = parseInt($(this).closest('tr').find('[data-tickets]').data('tickets')) || 1;

                    if (val === 'CheckedIn' || val === 'Completed') {
                        checkedInTickets += tickets;
                    } else if (val === 'NoShow') {
                        noShowTickets += tickets;
                    }
                });

                $('#stat-checked-in').text(checkedInTickets);
                $('#stat-no-show').text(noShowTickets);
            }

            $('.status-selector').each(function() {
                // Initial setup if needed
            });
            calculateStats();

            $('.status-selector').change(function () {
                var selectElement = $(this);
                var bookingId = selectElement.data('id');
                var oldStatus = selectElement.data('current');
                var newStatus = selectElement.val();

                $.ajax({
                    url: '@Url.Action("UpdateStatus", "TourGuide")',
                    type: 'POST',
                    data: { tourBookingId: bookingId, status: newStatus },
                    success: function (response) {
                        if (response.success) {
                            selectElement.data('current', newStatus);
                            calculateStats();

                            Swal.fire({
                                icon: 'success',
                                title: 'Đã cập nhật trạng thái!',
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 1500,
                                background: '#fcf9f5',
                                color: '#1c1c1a'
                            });
                            
                            // Re-apply filter if status changed and filter is active
                            applyPassengerFilters();
                        } else {
                            selectElement.val(oldStatus);
                            Swal.fire({
                                title: 'Hệ thống từ chối', 
                                text: response.message, 
                                icon: 'warning',
                                confirmButtonColor: '#805528'
                            });
                        }
                    },
                    error: function () {
                        selectElement.val(oldStatus);
                        Swal.fire({
                            title: 'Lỗi kết nối', 
                            text: 'Không thể đồng bộ dữ liệu trạng thái.', 
                            icon: 'error',
                            confirmButtonColor: '#805528'
                        });
                    }
                });
            });

            // --- FILTER LOGIC ---
            const searchPassengerInput = document.getElementById('search-passenger');
            const filterPassengerStatus = document.getElementById('filter-passenger-status');

            function applyPassengerFilters() {
                const nameVal = (searchPassengerInput.value || '').toLowerCase().trim();
                const statusVal = (filterPassengerStatus.value || '');

                filteredItems = allItems.filter(item => {
                    const matchName = !nameVal || $(item).find('.target-search').text().toLowerCase().indexOf(nameVal) > -1;
                    const itemStatus = $(item).find('.status-selector').val() || '';
                    const matchStatus = !statusVal || itemStatus === statusVal;

                    return matchName && matchStatus;
                });
                
                showPage(1);
            }

            if (searchPassengerInput) searchPassengerInput.addEventListener('input', applyPassengerFilters);
            if (filterPassengerStatus) filterPassengerStatus.addEventListener('change', applyPassengerFilters);
            // --------------------

            $('#btn-checkin-all').click(function() {
                var pendingSelectors = $('.status-selector').filter(function() {
                    return $(this).val() === 'Confirmed';
                });

                if(pendingSelectors.length === 0) {
                    Swal.fire({
                        title: 'Thông báo', 
                        text: 'Không còn hành khách nào ở trạng thái chờ đến.', 
                        icon: 'info',
                        confirmButtonColor: '#805528'
                    });
                    return;
                }

                Swal.fire({
                    title: 'Xác nhận có mặt hàng loạt?',
                    text: "Hệ thống sẽ chuyển tất cả hành khách đang chờ thành 'Khách đã có mặt'!",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0b5c2d',
                    cancelButtonColor: '#d4c3b6',
                    confirmButtonText: 'Xác nhận tất cả',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        let totalAjax = pendingSelectors.length;
                        let successCount = 0;

                        pendingSelectors.each(function() {
                            var selectElement = $(this);
                            var bookingId = selectElement.data('id');

                            $.ajax({
                                url: '@Url.Action("UpdateStatus", "TourGuide")',
                                type: 'POST',
                                data: { tourBookingId: bookingId, status: 'CheckedIn' },
                                success: function (response) {
                                    if (response.success) {
                                        selectElement.val('CheckedIn').data('current', 'CheckedIn');
                                    }
                                    completeCheck();
                                },
                                error: function() {
                                    completeCheck();
                                }
                            });
                        });

                        function completeCheck() {
                            successCount++;
                            if(successCount === totalAjax) {
                                calculateStats();
                                applyPassengerFilters();
                                Swal.fire({
                                    title: 'Thành công!', 
                                    text: 'Đã điểm danh toàn đoàn hoàn tất.', 
                                    icon: 'success',
                                    confirmButtonColor: '#805528'
                                });
                            }
                        }
                    }
                });
            });
        });
    </script>
}