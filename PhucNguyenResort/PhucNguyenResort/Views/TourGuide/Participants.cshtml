@model IEnumerable<PhucNguyenResort.Models.TourBooking>

@{
    var schedule = ViewBag.Schedule;
    string tourStatus = ViewBag.TourStatus ?? "cho-xu-ly";
    ViewData["Title"] = "Danh Sách Hành Khách Đi Tour";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
        <div class="card-body d-flex justify-content-between align-items-center p-4">
            <div class="d-flex align-items-center">
                <div class="p-3 bg-light text-info rounded-3 me-3">
                    <i class="fa fa-building fs-3"></i>
                </div>
                <div>
                    <h3 class="font-weight-bold text-dark mb-1" style="font-family: 'Playfair Display', serif;">Danh Sách Hành Khách Đi Tour</h3>
                    <p class="text-muted small mb-0">
                        <i class="fa fa-compass text-info me-1"></i> Tour: <span class="font-weight-bold text-dark">@(schedule?.Tour?.TourName ?? "N/A")</span>
                        <span class="mx-2">|</span>
                        <i class="fa fa-calendar text-info me-1"></i> Ngày khởi hành: <span class="font-weight-bold text-dark">@(schedule?.TourDate?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                    </p>
                </div>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 font-weight-bold" style="border-radius: 8px;">
                    <i class="fa fa-arrow-left me-1"></i> Trở Lại Lịch Trình
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 12px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 1000px;">
                    <thead class="table-light text-uppercase text-secondary small font-weight-bold">
                        <tr>
                            <th class="ps-4" style="width: 8%;">STT</th>
                            <th style="width: 25%;">Thành viên / Trưởng đoàn</th>
                            <th style="width: 15%;">Số lượng vé</th>
                            <th style="width: 15%;">Tổng thanh toán</th>
                            <th style="width: 18%;">Trạng thái vận hành</th>
                            <th class="pe-4" style="width: 19%;">Điểm danh đoàn</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            foreach (var booking in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-secondary font-weight-bold">#@index.ToString("D2")</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle-avatar me-2 bg-light text-secondary d-flex align-items-center justify-content-center rounded-circle" style="width: 35px; height: 35px;">
                                                <i class="fa fa-user"></i>
                                            </div>
                                            <div>
                                                <span class="font-weight-bold text-dark d-block">
                                                    @(booking.User != null ? booking.User.FullName : $"Khách hàng #{booking.UserId}")
                                                </span>
                                                <small class="text-muted">
                                                    <i class="fa fa-envelope me-1"></i>@(booking.User != null ? booking.User.Email : "Chưa cập nhật Email")
                                                </small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge text-info bg-light border-info border px-2 py-1" style="font-weight: 700; border-radius: 6px;">
                                            <i class="fa fa-ticket me-1"></i> @(booking.Participants ?? 1) Vé Đặt
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-danger font-weight-bold" style="font-size: 15px;">
                                            @(booking.TotalAmount.HasValue ? booking.TotalAmount.Value.ToString("N0") : "0") ₫
                                        </span>
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm border-secondary-subtle font-weight-bold p-1 text-dark" style="border-radius: 6px; width: 140px; font-size: 13px;">
                                            <!option value="cho-xu-ly" @(tourStatus == "cho-xu-ly" ? "selected" : "")>⏳ Chờ xử lý</!option>
                                            <!option value="dang-dien-ra" @(tourStatus == "dang-dien-ra" ? "selected" : "")>🚘 Đang diễn ra</!option>
                                            <!option value="hoan-thanh" @(tourStatus == "hoan-thanh" ? "selected" : "")>✅ Đã hoàn thành</!option>
                                            <!option value="huy" @(tourStatus == "huy" ? "selected" : "")>❌ Đã hủy hành trình</!option>
                                        </select>
                                    </td>
                                    <td class="pe-4">
                                        <div class="form-check form-switch d-flex align-items-center mb-0">
                                            <input class="form-check-input me-2" type="checkbox" role="switch" @(tourStatus == "hoan-thanh" || tourStatus == "dang-dien-ra" ? "checked" : "") style="cursor: pointer; width: 40px; height: 20px;">
                                            <span class="badge @(tourStatus == "hoan-thanh" || tourStatus == "dang-dien-ra" ? "bg-success-subtle text-success" : "bg-light text-secondary") border px-2 py-1" style="font-size: 12px; border-radius: 6px;">
                                                <i class="fa @(tourStatus == "hoan-thanh" || tourStatus == "dang-dien-ra" ? "fa-check-circle" : "fa-minus-circle") me-1"></i>
                                                @(tourStatus == "hoan-thanh" || tourStatus == "dang-dien-ra" ? "Có mặt" : "Chờ điểm danh")
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fa fa-info-circle me-1"></i> Không có hành khách nào thuộc danh sách xác nhận cho lịch trình này.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>