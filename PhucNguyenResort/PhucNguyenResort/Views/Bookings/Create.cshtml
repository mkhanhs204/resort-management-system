@model PhucNguyenResort.ViewModels.Bookings.CreateBookingViewModel

@{
    ViewData["Title"] = "Hoàn Tất Đặt Phòng - Phuc Nguyen Resort";
    var selectedCategories = ViewBag.SelectedCategories as List<PhucNguyenResort.Models.RoomCategory>;
    
    // For calculation display
    decimal totalPrice = 0;
    string mainImage = "https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80";
    string categoryName = "";
    int totalNights = (Model.CheckOutDate - Model.CheckInDate).Days;
    if (totalNights <= 0) totalNights = 1;

    if (selectedCategories != null && Model.RoomSelections != null && Model.RoomSelections.Count > 0)
    {
        var firstSelection = Model.RoomSelections.First();
        var category = selectedCategories.FirstOrDefault(c => c.CategoryId == firstSelection.CategoryId);
        if (category != null)
        {
            if (!string.IsNullOrEmpty(category.ImageUrl)) mainImage = category.ImageUrl;
            categoryName = category.CategoryName;
            
            foreach (var sel in Model.RoomSelections)
            {
                var cat = selectedCategories.FirstOrDefault(c => c.CategoryId == sel.CategoryId);
                if (cat != null)
                {
                    totalPrice += (cat.PricePerNight ?? 0) * sel.Quantity * totalNights;
                }
            }
        }
    }
    
    decimal tax = totalPrice * 0.1m;
    decimal grandTotal = totalPrice + tax;
}

<div class="pt-28 pb-section-gap-lg px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <!-- Progress Bar -->
    <div class="max-w-3xl mx-auto mb-12 hidden md:block">
        <div class="relative flex justify-between items-center w-full">
            <div class="absolute top-1/2 left-0 w-full h-[2px] bg-surface-variant -z-10 -translate-y-1/2"></div>
            <div class="absolute top-1/2 left-0 w-[66%] h-[2px] bg-primary -z-10 -translate-y-1/2 transition-all duration-700"></div>
            <div class="flex flex-col items-center gap-2 bg-background px-4">
                <div class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center text-label-sm">1</div>
                <span class="text-label-sm text-primary">Chọn Phòng</span>
            </div>
            <div class="flex flex-col items-center gap-2 bg-background px-4">
                <div class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center text-label-sm">2</div>
                <span class="text-label-sm text-primary">Thông Tin</span>
            </div>
            <div class="flex flex-col items-center gap-2 bg-background px-4">
                <div class="w-8 h-8 rounded-full bg-surface-variant text-on-surface-variant flex items-center justify-center text-label-sm border border-outline-variant">3</div>
                <span class="text-label-sm text-on-surface-variant">Thanh Toán</span>
            </div>
        </div>
    </div>
    
    <form asp-action="Create" method="post" id="bookingForm">
        <div asp-validation-summary="ModelOnly" class="bg-error-container text-on-error-container p-4 rounded-lg mb-6 text-label-sm"></div>
        
        @for (int i = 0; i < Model.RoomSelections.Count; i++)
        {
            <input type="hidden" name="RoomSelections[@i].CategoryId" value="@Model.RoomSelections[i].CategoryId" />
            <input type="hidden" name="RoomSelections[@i].Quantity" value="@Model.RoomSelections[i].Quantity" />
        }
        <input type="hidden" asp-for="CheckInDate" />
        <input type="hidden" asp-for="CheckOutDate" />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
            <!-- Left Column: Forms & Summary -->
            <div class="lg:col-span-8 space-y-stack-lg">
                <!-- Room Summary Card -->
                <div class="bg-surface-container-lowest border border-outline-variant/15 rounded-xl overflow-hidden luxury-shadow">
                    <div class="flex flex-col md:flex-row">
                        <div class="md:w-1/3">
                            <img class="h-full w-full object-cover min-h-[200px]" src="@mainImage" alt="Room Image" />
                        </div>
                        <div class="p-stack-md md:p-stack-lg flex-1">
                            <div class="flex justify-between items-start">
                                <div>
                                    <span class="text-label-sm text-primary uppercase tracking-widest mb-2 block">@categoryName</span>
                                    <h2 class="font-headline-sm text-headline-sm text-on-surface mb-2">Thông tin phòng đã chọn</h2>
                                </div>
                                <div class="flex items-center text-primary">
                                    <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                    <span class="font-label-lg ml-1">4.9</span>
                                </div>
                            </div>
                            <div class="flex flex-wrap gap-4 mt-4">
                                <div class="flex items-center gap-2 text-on-surface-variant">
                                    <span class="material-symbols-outlined text-[18px]">calendar_today</span>
                                    <span class="text-label-sm">@Model.CheckInDate.ToString("dd/MM") - @Model.CheckOutDate.ToString("dd/MM, yyyy")</span>
                                </div>
                                <div class="flex items-center gap-2 text-on-surface-variant">
                                    <span class="material-symbols-outlined text-[18px]">person</span>
                                    <span class="text-label-sm">@Model.NumberOfAdults Người Lớn, @Model.NumberOfChildren Trẻ Em</span>
                                </div>
                            </div>
                            <div class="mt-6 flex flex-wrap gap-2">
                                <span class="px-3 py-1 bg-secondary-container/30 text-on-secondary-container rounded-full text-label-sm">Bữa sáng miễn phí</span>
                                <span class="px-3 py-1 bg-secondary-container/30 text-on-secondary-container rounded-full text-label-sm">Đón sân bay</span>
                                <span class="px-3 py-1 bg-secondary-container/30 text-on-secondary-container rounded-full text-label-sm">Wifi tốc độ cao</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Guest Info Form (Updated with ViewModel requirements) -->
                <div class="bg-surface-container-lowest border border-outline-variant/15 rounded-xl p-stack-lg luxury-shadow">
                    <h3 class="font-headline-sm text-headline-sm mb-6 flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary">person_outline</span>
                        Thông Tin Khách Hàng (Khai báo lưu trú)
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-stack-md">
                        <div class="space-y-1">
                            <label class="text-label-sm text-on-surface-variant">Họ và Tên (như CCCD) <span class="text-error">*</span></label>
                            <input type="text" asp-for="PrimaryGuestName" class="w-full bg-surface-container-low border border-outline-variant/20 rounded-lg p-3 text-body-md focus:ring-1 focus:ring-primary-container" placeholder="Ví dụ: NGUYEN VAN A" />
                            <span asp-validation-for="PrimaryGuestName" class="text-error text-[12px]"></span>
                        </div>
                        
                        <div class="space-y-1">
                            <label class="text-label-sm text-on-surface-variant">Số CCCD/Hộ chiếu <span class="text-error">*</span></label>
                            <input type="text" asp-for="PrimaryGuestPassportNumber" class="w-full bg-surface-container-low border border-outline-variant/20 rounded-lg p-3 text-body-md focus:ring-1 focus:ring-primary-container" placeholder="Số định danh cá nhân" />
                            <span asp-validation-for="PrimaryGuestPassportNumber" class="text-error text-[12px]"></span>
                        </div>

                        <div class="space-y-1">
                            <label class="text-label-sm text-on-surface-variant">Ngày sinh <span class="text-error">*</span></label>
                            <input type="date" asp-for="PrimaryGuestDateOfBirth" class="w-full bg-surface-container-low border border-outline-variant/20 rounded-lg p-3 text-body-md focus:ring-1 focus:ring-primary-container" />
                            <span asp-validation-for="PrimaryGuestDateOfBirth" class="text-error text-[12px]"></span>
                        </div>

                        <div class="space-y-1">
                            <label class="text-label-sm text-on-surface-variant">Giới tính <span class="text-error">*</span></label>
                            <select asp-for="PrimaryGuestGender" class="w-full bg-surface-container-low border border-outline-variant/20 rounded-lg p-3 text-body-md focus:ring-1 focus:ring-primary-container">
                                <option value="">-- Chọn giới tính --</option>
                                <option value="Male">Nam</option>
                                <option value="Female">Nữ</option>
                                <option value="Other">Khác</option>
                            </select>
                            <span asp-validation-for="PrimaryGuestGender" class="text-error text-[12px]"></span>
                        </div>
                        
                        <div class="space-y-1">
                            <label class="text-label-sm text-on-surface-variant">Quốc tịch <span class="text-error">*</span></label>
                            <input type="text" asp-for="PrimaryGuestNationality" class="w-full bg-surface-container-low border border-outline-variant/20 rounded-lg p-3 text-body-md focus:ring-1 focus:ring-primary-container" value="Vietnam" />
                            <span asp-validation-for="PrimaryGuestNationality" class="text-error text-[12px]"></span>
                        </div>

                        <!-- Email/Phone mapping to dummy for visual match -->
                        <div class="space-y-1">
                            <label class="text-label-sm text-on-surface-variant">Email (Tài khoản hiện tại)</label>
                            <input type="email" class="w-full bg-surface-container-low border border-outline-variant/20 rounded-lg p-3 text-body-md focus:ring-1 focus:ring-primary-container opacity-70" value="@User.Identity.Name" readonly />
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4 md:col-span-2">
                            <div class="space-y-1">
                                <label class="text-label-sm text-on-surface-variant">Người Lớn</label>
                                <div class="flex items-center border border-outline-variant/20 rounded-lg bg-surface-container-low h-[48px]">
                                    <button class="px-3 text-primary" type="button" onclick="changeVal('NumberOfAdults', -1)"><span class="material-symbols-outlined">remove</span></button>
                                    <input asp-for="NumberOfAdults" id="NumberOfAdults" class="w-full border-none bg-transparent text-center focus:ring-0" readonly type="text" />
                                    <button class="px-3 text-primary" type="button" onclick="changeVal('NumberOfAdults', 1)"><span class="material-symbols-outlined">add</span></button>
                                </div>
                            </div>
                            <div class="space-y-1">
                                <label class="text-label-sm text-on-surface-variant">Trẻ Em</label>
                                <div class="flex items-center border border-outline-variant/20 rounded-lg bg-surface-container-low h-[48px]">
                                    <button class="px-3 text-primary" type="button" onclick="changeVal('NumberOfChildren', -1)"><span class="material-symbols-outlined">remove</span></button>
                                    <input asp-for="NumberOfChildren" id="NumberOfChildren" class="w-full border-none bg-transparent text-center focus:ring-0" readonly type="text" />
                                    <button class="px-3 text-primary" type="button" onclick="changeVal('NumberOfChildren', 1)"><span class="material-symbols-outlined">add</span></button>
                                </div>
                            </div>
                        </div>

                        <div class="md:col-span-2 mt-2">
                            <label class="flex items-start gap-3 cursor-pointer p-4 border border-outline-variant/20 rounded-lg bg-surface-container-lowest hover:bg-surface-container-low transition-colors">
                                <input type="checkbox" asp-for="PdpdConsentChecked" class="mt-1 text-primary focus:ring-primary border-outline-variant rounded" required />
                                <span class="text-label-sm text-on-surface-variant leading-relaxed">
                                    Tôi đồng ý cho phép Phúc Nguyên Resort thu thập và lưu trữ thông tin cá nhân nhạy cảm (số CCCD/Hộ chiếu và Ngày sinh) để khai báo tạm trú theo Nghị định 356/2025/NĐ-CP (PDPD).
                                </span>
                            </label>
                            <span asp-validation-for="PdpdConsentChecked" class="text-error text-[12px] block mt-1"></span>
                        </div>
                    </div>
                </div>

                <!-- Payment Methods -->
                <div class="bg-surface-container-lowest border border-outline-variant/15 rounded-xl p-stack-lg luxury-shadow">
                    <h3 class="font-headline-sm text-headline-sm mb-6 flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary">account_balance_wallet</span>
                        Phương Thức Thanh Toán
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-stack-md">
                        <label class="relative flex items-center p-4 border border-primary bg-primary-container/10 rounded-xl cursor-pointer group">
                            <input checked class="text-primary focus:ring-primary border-outline-variant" name="payment" type="radio" />
                            <div class="ml-4">
                                <span class="font-label-lg block text-on-surface">Thanh toán qua VNPay</span>
                                <span class="text-label-sm text-on-surface-variant">Hỗ trợ thẻ ATM, QR Code, Thẻ tín dụng</span>
                            </div>
                            <span class="material-symbols-outlined ml-auto text-primary" style="font-variation-settings: 'FILL' 1;">verified</span>
                        </label>
                        <label class="relative flex items-center p-4 border border-outline-variant/20 rounded-xl cursor-pointer hover:border-primary/50 transition-colors">
                            <input class="text-primary focus:ring-primary border-outline-variant" name="payment" type="radio" disabled />
                            <div class="ml-4 opacity-50">
                                <span class="font-label-lg block text-on-surface">Thanh toán tại quầy</span>
                                <span class="text-label-sm text-on-surface-variant">Chỉ dành cho khách vãng lai</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Trust Badges -->
                <div class="flex flex-wrap justify-center gap-stack-lg pt-4 pb-8 lg:pb-0">
                    <div class="flex items-center gap-2 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all cursor-default">
                        <span class="material-symbols-outlined text-primary">security</span>
                        <span class="text-label-sm font-semibold uppercase tracking-widest">SSL Secured</span>
                    </div>
                    <div class="flex items-center gap-2 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all cursor-default">
                        <span class="material-symbols-outlined text-primary">verified_user</span>
                        <span class="text-label-sm font-semibold uppercase tracking-widest">Verified Payment</span>
                    </div>
                    <div class="flex items-center gap-2 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all cursor-default">
                        <span class="material-symbols-outlined text-primary">lock</span>
                        <span class="text-label-sm font-semibold uppercase tracking-widest">Privacy Protected</span>
                    </div>
                </div>
            </div>

            <!-- Right Column: Order Summary (Sticky) -->
            <div class="lg:col-span-4 lg:sticky lg:top-28 space-y-gutter">
                <div class="bg-surface-container-lowest border border-outline-variant/15 rounded-xl p-stack-lg luxury-shadow">
                    <h3 class="font-headline-sm text-headline-sm mb-6 pb-4 border-b border-outline-variant/10">Chi Tiết Đặt Phòng</h3>
                    
                    <div class="space-y-4">
                        <div class="flex justify-between items-center text-body-md">
                            <span class="text-on-surface-variant">@categoryName (@totalNights đêm)</span>
                            <span class="font-semibold">@totalPrice.ToString("N0")đ</span>
                        </div>
                        <div class="flex justify-between items-center text-body-md">
                            <span class="text-on-surface-variant">Dịch vụ đưa đón</span>
                            <span class="text-primary font-medium">Miễn phí</span>
                        </div>
                        <div class="flex justify-between items-center text-body-md">
                            <span class="text-on-surface-variant">Thuế & Phí dịch vụ (10%)</span>
                            <span class="font-semibold">@tax.ToString("N0")đ</span>
                        </div>
                        <div class="pt-4 border-t border-outline-variant/10 mt-4">
                            <div class="flex justify-between items-end mb-2">
                                <span class="text-label-lg uppercase tracking-wider text-on-surface-variant">Tổng Thanh Toán</span>
                                <span class="text-primary font-bold text-[28px] leading-none">@grandTotal.ToString("N0")đ</span>
                            </div>
                            <span class="text-label-sm text-on-surface-variant text-right block italic">*Đã bao gồm tất cả các loại phí</span>
                        </div>
                    </div>
                    
                    <button type="submit" class="w-full bg-primary-container text-on-primary-container py-4 rounded-xl font-label-lg text-[16px] font-bold mt-8 hover:opacity-90 active:scale-[0.98] transition-all shadow-lg shadow-primary-container/20">
                        HOÀN TẤT ĐẶT PHÒNG
                    </button>
                    
                    <p class="text-center text-label-sm text-on-surface-variant mt-4 px-4">
                        Bằng cách nhấn hoàn tất, bạn đồng ý với <a class="text-primary underline" href="#">Điều khoản & Chính sách</a> của chúng tôi.
                    </p>
                </div>
                
                <!-- Mini Contact Support -->
                <div class="bg-surface-container p-6 rounded-xl border border-outline-variant/10 hidden md:block">
                    <h4 class="font-label-lg text-on-surface mb-3 uppercase tracking-widest">Cần hỗ trợ?</h4>
                    <div class="space-y-3">
                        <a href="tel:02581234567" class="flex items-center gap-3 text-on-surface-variant hover:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[20px]">phone_in_talk</span>
                            <span class="text-body-md">0258 123 4567 (24/7)</span>
                        </a>
                        <div class="flex items-center gap-3 text-on-surface-variant">
                            <span class="material-symbols-outlined text-[20px]">chat_bubble_outline</span>
                            <span class="text-body-md">Chat trực tuyến ngay</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function changeVal(id, amount) {
            let el = document.getElementById(id);
            let current = parseInt(el.value) || 0;
            let newVal = current + amount;
            if(newVal >= 0) {
                el.value = newVal;
            }
        }
    </script>
}
