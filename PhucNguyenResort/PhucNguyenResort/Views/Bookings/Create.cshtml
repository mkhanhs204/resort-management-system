@model PhucNguyenResort.ViewModels.Bookings.CreateBookingViewModel

@{
    ViewData["Title"] = "Đặt Phòng - Phuc Nguyen Resort";
    var room = ViewBag.Room as PhucNguyenResort.Models.Room;
    var tours = ViewBag.UpcomingTours as List<PhucNguyenResort.Models.TourSchedule>;
}

<style>
    /* Premium Resort UI Overhaul */
    :root {
        --primary-color: #0d233a; /* Deep Navy */
        --accent-color: #d4af37; /* Gold */
        --bg-color: #f8f9fa;
        --card-bg: #ffffff;
        --text-main: #2c3e50;
        --text-muted: #7f8c8d;
        --transition-fast: 0.2s ease;
        --transition-smooth: 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
        background-color: var(--bg-color);
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .premium-booking-section {
        padding: 60px 0 100px;
    }

    /* Page Header */
    .booking-header {
        text-align: center;
        margin-bottom: 50px;
        animation: fadeInDown 0.8s ease;
    }
    .booking-header h2 {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--primary-color);
        letter-spacing: -0.5px;
    }
    .booking-header p {
        color: var(--text-muted);
        font-size: 1.1rem;
    }

    /* Room Details Card */
    .room-showcase {
        background: var(--card-bg);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        transition: var(--transition-smooth);
        margin-bottom: 30px;
        border: 1px solid rgba(0,0,0,0.02);
    }
    .room-showcase:hover {
        transform: translateY(-5px);
        box-shadow: 0 25px 45px rgba(0,0,0,0.08);
    }
    .room-image-wrapper {
        position: relative;
        height: 380px;
        overflow: hidden;
    }
    .room-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }
    .room-showcase:hover .room-image-wrapper img {
        transform: scale(1.05);
    }
    .room-image-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 40px 30px 20px;
        background: linear-gradient(to top, rgba(13, 35, 58, 0.95), rgba(13, 35, 58, 0.5), transparent);
        color: white;
    }
    .room-image-overlay h3 {
        color: white;
        font-size: 2rem;
        font-weight: 600;
        margin-bottom: 5px;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }
    .room-info-content {
        padding: 30px;
    }
    .price-tag {
        font-size: 2rem;
        color: var(--accent-color);
        font-weight: 700;
        margin-bottom: 20px;
        display: flex;
        align-items: baseline;
    }
    .price-tag span {
        font-size: 1rem;
        color: var(--text-muted);
        font-weight: 400;
        margin-left: 5px;
    }
    .room-desc {
        color: var(--text-muted);
        line-height: 1.7;
        margin-bottom: 20px;
        font-size: 1.05rem;
    }
    .feature-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
    }
    .feature-list li {
        background: rgba(13, 35, 58, 0.04);
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 0.95rem;
        color: var(--primary-color);
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .feature-list li i {
        color: var(--accent-color);
    }

    /* Booking Widget Card */
    .booking-widget {
        background: var(--card-bg);
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.08);
        position: sticky;
        top: 30px;
        border: 1px solid rgba(0,0,0,0.03);
    }
    .booking-widget h4 {
        font-weight: 700;
        color: var(--primary-color);
        margin-bottom: 25px;
        font-size: 1.5rem;
        position: relative;
        padding-bottom: 15px;
    }
    .booking-widget h4::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 50px;
        height: 3px;
        background: var(--accent-color);
        border-radius: 2px;
    }

    /* Form Elements */
    .form-group-modern {
        margin-bottom: 20px;
    }
    .form-group-modern label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 8px;
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .form-control-modern {
        width: 100%;
        padding: 14px 18px;
        border-radius: 12px;
        border: 2px solid #e2e8f0;
        background-color: #f8fafc;
        font-size: 1rem;
        color: var(--primary-color);
        transition: var(--transition-fast);
    }
    .form-control-modern:focus {
        outline: none;
        border-color: var(--primary-color);
        background-color: #fff;
        box-shadow: 0 0 0 4px rgba(13, 35, 58, 0.1);
    }

    /* Tour Addons */
    .tour-addons-section {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px dashed #e2e8f0;
    }
    .tour-list-container {
        max-height: 280px;
        overflow-y: auto;
        padding-right: 5px;
    }
    /* Custom Scrollbar for tours */
    .tour-list-container::-webkit-scrollbar {
        width: 6px;
    }
    .tour-list-container::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 10px;
    }
    .tour-list-container::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }
    .tour-list-container::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }
    .tour-item-card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 12px;
        cursor: pointer;
        transition: var(--transition-fast);
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }
    .tour-item-card:hover {
        background-color: #f8fafc;
        border-color: var(--accent-color);
    }
    .tour-item-card input[type="checkbox"] {
        width: 20px;
        height: 20px;
        margin-top: 3px;
        cursor: pointer;
        accent-color: var(--primary-color);
    }
    .tour-info strong {
        display: block;
        color: var(--primary-color);
        font-size: 1.05rem;
        margin-bottom: 4px;
    }
    .tour-info span {
        color: var(--text-muted);
        font-size: 0.9rem;
        display: block;
    }
    .tour-price-badge {
        background: rgba(212, 175, 55, 0.1);
        color: #b8962e;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-top: 6px;
        display: inline-block;
    }

    /* Action Button */
    .btn-premium {
        background: linear-gradient(135deg, var(--primary-color), #1a365d);
        color: white;
        border: none;
        width: 100%;
        padding: 16px;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        cursor: pointer;
        transition: var(--transition-smooth);
        margin-top: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        box-shadow: 0 10px 20px rgba(13, 35, 58, 0.2);
    }
    .btn-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 25px rgba(13, 35, 58, 0.3);
        background: linear-gradient(135deg, #1a365d, var(--primary-color));
        color: white;
    }
    .btn-premium:active {
        transform: translateY(1px);
    }

    /* VNPAY Badge */
    .payment-badge {
        text-align: center;
        margin-top: 15px;
        font-size: 0.85rem;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    .payment-badge img {
        height: 20px;
    }

    /* Animations */
    @@keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<section class="premium-booking-section">
    <div class="container">
        <div class="booking-header">
            <h2>Hoàn Tất Đặt Phòng</h2>
            <p>Trải nghiệm kỳ nghỉ đẳng cấp tại Phuc Nguyen Resort</p>
        </div>

        <div class="row">
            <!-- Left Column: Room Info -->
            <div class="col-lg-7 col-md-12 mb-4">
                <div class="room-showcase">
                    <div class="room-image-wrapper">
                        @if (!string.IsNullOrEmpty(room?.Category?.ImageUrl))
                        {
                            <img src="@room.Category.ImageUrl" alt="@room.Category.CategoryName" />
                        }
                        else
                        {
                            <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="Resort Room" />
                        }
                        <div class="room-image-overlay">
                            <h3>@room?.Category?.CategoryName</h3>
                            <span><i class="fa fa-map-marker"></i> Tầm nhìn tuyệt đẹp, tiện nghi chuẩn 5 sao</span>
                        </div>
                    </div>
                    <div class="room-info-content">
                        <div class="price-tag">
                            @room?.Category?.PricePerNight?.ToString("N0") VNĐ <span>/ Đêm</span>
                        </div>
                        <p class="room-desc">@room?.Category?.Description</p>
                        
                        <ul class="feature-list">
                            <li><i class="fa fa-bed"></i> Phòng số: @room?.RoomNumber</li>
                            <li><i class="fa fa-users"></i> Tối đa: @room?.Category?.MaxAdults NL, @room?.Category?.MaxChildren TE</li>
                            <li><i class="fa fa-wifi"></i> Free Wifi</li>
                            <li><i class="fa fa-coffee"></i> Bữa sáng miễn phí</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Right Column: Booking Form -->
            <div class="col-lg-5 col-md-12">
                <div class="booking-widget">
                    <h4>Chi Tiết Đặt Phòng</h4>
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius: 12px; font-size: 0.9rem;"></div>
                        
                        <input type="hidden" asp-for="RoomId" />
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="CheckInDate">Ngày Nhận Phòng</label>
                                    <input type="date" asp-for="CheckInDate" class="form-control-modern" />
                                    <span asp-validation-for="CheckInDate" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="CheckOutDate">Ngày Trả Phòng</label>
                                    <input type="date" asp-for="CheckOutDate" class="form-control-modern" />
                                    <span asp-validation-for="CheckOutDate" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="NumberOfAdults">Người Lớn</label>
                                    <input type="number" asp-for="NumberOfAdults" class="form-control-modern" min="1" max="@(room?.Category?.MaxAdults ?? 10)" value="2" />
                                    <span asp-validation-for="NumberOfAdults" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="NumberOfChildren">Trẻ Em</label>
                                    <input type="number" asp-for="NumberOfChildren" class="form-control-modern" min="0" max="@(room?.Category?.MaxChildren ?? 10)" value="0" />
                                    <span asp-validation-for="NumberOfChildren" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                        
                        @if (tours != null && tours.Any())
                        {
                            <div class="tour-addons-section">
                                <label style="font-size: 0.85rem; font-weight: 600; color: var(--text-main); margin-bottom: 12px; display: block; text-transform: uppercase;">Trải Nghiệm Thêm (Add-ons)</label>
                                
                                <div class="tour-list-container">
                                    @foreach (var tour in tours)
                                    {
                                        <label class="tour-item-card" for="tour_@tour.ScheduleId">
                                            <input type="checkbox" name="SelectedTourScheduleIds" value="@tour.ScheduleId" id="tour_@tour.ScheduleId">
                                            <div class="tour-info">
                                                <strong>@tour.Tour?.TourName</strong>
                                                <span><i class="fa fa-calendar"></i> @tour.TourDate?.ToString("dd/MM/yyyy") - @tour.StartTime?.ToString(@"hh\:mm")</span>
                                                <div class="tour-price-badge">+ @tour.Tour?.Price?.ToString("N0") VNĐ</div>
                                            </div>
                                        </label>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Info Alert for Deposit -->
                        <div class="alert alert-info mt-4 mb-0" style="border-radius: 12px; font-size: 0.85rem; border: none; background: rgba(13, 35, 58, 0.05); color: var(--primary-color);">
                            <i class="fa fa-info-circle mr-1"></i> Bạn cần thanh toán trước <strong>50%</strong> tiền cọc phòng qua cổng thanh toán VNPAY.
                        </div>

                        <button type="submit" class="btn-premium">
                            Thanh Toán Cọc Qua VNPAY <i class="fa fa-arrow-right"></i>
                        </button>
                        
                        <div class="payment-badge">
                            An toàn & Bảo mật bởi <strong>VNPAY</strong> 
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Micro-interaction for Date validation
        document.addEventListener('DOMContentLoaded', function() {
            var checkInInput = document.querySelector('input[name="CheckInDate"]');
            var checkOutInput = document.querySelector('input[name="CheckOutDate"]');
            
            checkInInput.addEventListener('change', function() {
                var checkInDate = new Date(this.value);
                var minCheckOutDate = new Date(checkInDate);
                minCheckOutDate.setDate(minCheckOutDate.getDate() + 1);
                
                // Format to YYYY-MM-DD
                var dd = String(minCheckOutDate.getDate()).padStart(2, '0');
                var mm = String(minCheckOutDate.getMonth() + 1).padStart(2, '0');
                var yyyy = minCheckOutDate.getFullYear();
                
                checkOutInput.min = yyyy + '-' + mm + '-' + dd;
                
                if (new Date(checkOutInput.value) <= checkInDate) {
                    checkOutInput.value = yyyy + '-' + mm + '-' + dd;
                }
            });
        });
    </script>
}
