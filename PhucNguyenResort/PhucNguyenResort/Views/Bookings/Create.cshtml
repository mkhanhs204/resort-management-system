@model PhucNguyenResort.ViewModels.Bookings.CreateBookingViewModel

@{
    ViewData["Title"] = "Hoàn Tất Đặt Phòng - Phuc Nguyen Resort";
    var selectedCategories = ViewBag.SelectedCategories as List<PhucNguyenResort.Models.RoomCategory>;
    
    // For calculation display
    decimal totalPrice = 0;
    int totalMaxAdults = 0;
    int totalMaxChildren = 0;
    int totalNights = (Model.CheckOutDate - Model.CheckInDate).Days;
    if (totalNights <= 0) totalNights = 1;

    if (selectedCategories != null && Model.RoomSelections != null)
    {
        foreach (var sel in Model.RoomSelections)
        {
            var cat = selectedCategories.FirstOrDefault(c => c.CategoryId == sel.CategoryId);
            if (cat != null)
            {
                totalPrice += (cat.PricePerNight ?? 0) * sel.Quantity * totalNights;
                totalMaxAdults += (cat.MaxAdults ?? 2) * sel.Quantity;
                totalMaxChildren += (cat.MaxChildren ?? 0) * sel.Quantity;
            }
        }
    }
    
    if (totalMaxAdults == 0) totalMaxAdults = 6;
    if (totalMaxChildren == 0) totalMaxChildren = 3;
}

<div class="pt-28 pb-section-gap-lg px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <!-- Progress Bar -->
    <div class="max-w-3xl mx-auto mb-12 hidden md:block">
        <div class="relative flex justify-between items-center w-full">
            <div class="absolute top-1/2 left-0 w-full h-[2px] bg-surface-variant -z-10 -translate-y-1/2"></div>
            <div class="absolute top-1/2 left-0 w-[66%] h-[2px] bg-primary -z-10 -translate-y-1/2 transition-all duration-700"></div>
            <div class="flex flex-col items-center gap-2 bg-background px-4">
                <div class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center text-label-sm">1</div>
                <span class="text-label-sm text-primary">Chọn Phòng</span>
            </div>
            <div class="flex flex-col items-center gap-2 bg-background px-4">
                <div class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center text-label-sm">2</div>
                <span class="text-label-sm text-primary">Thông Tin</span>
            </div>
            <div class="flex flex-col items-center gap-2 bg-background px-4">
                <div class="w-8 h-8 rounded-full bg-surface-variant text-on-surface-variant flex items-center justify-center text-label-sm border border-outline-variant">3</div>
                <span class="text-label-sm text-on-surface-variant">Thanh Toán</span>
            </div>
        </div>
    </div>
    
    <form asp-action="Create" method="post" id="bookingForm">
        <div asp-validation-summary="ModelOnly" class="bg-error-container text-on-error-container p-4 rounded-lg mb-6 text-label-sm"></div>
        
        @for (int i = 0; i < Model.RoomSelections.Count; i++)
        {
            <input type="hidden" name="RoomSelections[@i].CategoryId" value="@Model.RoomSelections[i].CategoryId" />
            <input type="hidden" name="RoomSelections[@i].Quantity" value="@Model.RoomSelections[i].Quantity" />
        }

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
            <!-- Left Column: Forms & Summary -->
            <div class="lg:col-span-8 space-y-6">
                
                <!-- Selected Rooms List -->
                @if (selectedCategories != null && Model.RoomSelections != null)
                {
                    foreach (var selection in Model.RoomSelections)
                    {
                        var category = selectedCategories.FirstOrDefault(c => c.CategoryId == selection.CategoryId);
                        if (category != null)
                        {
                            string bgImage = string.IsNullOrEmpty(category.ImageUrl) 
                                             ? "https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" 
                                             : category.ImageUrl;
                            <div class="bg-surface-container-lowest border border-outline-variant/15 rounded-xl overflow-hidden luxury-shadow">
                                <div class="flex flex-col md:flex-row">
                                    <div class="md:w-1/3 relative h-48 md:h-auto">
                                        <img class="h-full w-full object-cover min-h-[160px]" src="@bgImage" alt="Room Image" />
                                        <div class="absolute top-4 left-4 bg-primary text-white font-bold px-3 py-1 rounded-lg text-label-sm shadow-md">
                                            x @selection.Quantity
                                        </div>
                                    </div>
                                    <div class="p-6 flex-1 flex flex-col justify-between">
                                        <div>
                                            <div class="flex justify-between items-start">
                                                <h3 class="font-headline-sm text-headline-sm text-on-surface">@category.CategoryName</h3>
                                                <span class="text-primary font-bold text-lg">@category.PricePerNight?.ToString("N0") VNĐ / Đêm</span>
                                            </div>
                                            <p class="text-on-surface-variant text-body-md mt-2 line-clamp-2">
                                                @(string.IsNullOrEmpty(category.Description) ? "Trải nghiệm không gian nghỉ dưỡng sang trọng bậc nhất giữa lòng thiên nhiên." : category.Description)
                                            </p>
                                        </div>
                                        <div class="flex flex-wrap gap-4 mt-4">
                                            <div class="flex items-center gap-1.5 text-on-surface-variant text-label-sm">
                                                <span class="material-symbols-outlined text-[18px]">group</span> Tối đa: @(category.MaxAdults ?? 2) NL, @(category.MaxChildren ?? 0) TE
                                            </div>
                                            <div class="flex items-center gap-1.5 text-on-surface-variant text-label-sm">
                                                <span class="material-symbols-outlined text-[18px]">wifi</span> Free Wifi
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }

                <!-- 1. THỜI GIAN & SỐ KHÁCH -->
                <div class="bg-surface-container-lowest border border-outline-variant/15 rounded-xl p-6 luxury-shadow">
                    <h3 class="font-headline-sm text-headline-sm mb-6 flex items-center gap-3 text-on-surface">
                        <span class="material-symbols-outlined text-primary">calendar_month</span>
                        1. THỜI GIAN & SỐ KHÁCH
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-2">Ngày Nhận Phòng</label>
                            <div class="flex items-center border border-outline-variant/30 rounded-lg px-4 py-3 bg-surface focus-within:border-primary-container transition-colors">
                                <span class="material-symbols-outlined text-outline mr-3">calendar_today</span>
                                <input type="date" id="checkInDate" name="CheckInDate" class="bg-transparent border-none outline-none text-body-md font-medium w-full text-on-surface" value="@Model.CheckInDate.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                            </div>
                        </div>
                        <div>
                            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-2">Ngày Trả Phòng</label>
                            <div class="flex items-center border border-outline-variant/30 rounded-lg px-4 py-3 bg-surface focus-within:border-primary-container transition-colors">
                                <span class="material-symbols-outlined text-outline mr-3">calendar_today</span>
                                <input type="date" id="checkOutDate" name="CheckOutDate" class="bg-transparent border-none outline-none text-body-md font-medium w-full text-on-surface" value="@Model.CheckOutDate.ToString("yyyy-MM-dd")" min="@Model.CheckInDate.ToString("yyyy-MM-dd")" required>
                            </div>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="text-label-sm text-on-surface-variant">Người Lớn (Tối đa @totalMaxAdults)</label>
                            <div class="flex items-center border border-outline-variant/20 rounded-lg bg-surface-container-low h-[48px]">
                                <button class="px-3 text-primary" type="button" onclick="changeVal('NumberOfAdults', -1, @totalMaxAdults)"><span class="material-symbols-outlined">remove</span></button>
                                <input asp-for="NumberOfAdults" id="NumberOfAdults" class="w-full border-none bg-transparent text-center focus:ring-0 text-on-surface font-bold" readonly type="text" />
                                <button class="px-3 text-primary" type="button" onclick="changeVal('NumberOfAdults', 1, @totalMaxAdults)"><span class="material-symbols-outlined">add</span></button>
                            </div>
                        </div>
                        <div class="space-y-1">
                            <label class="text-label-sm text-on-surface-variant">Trẻ Em (Tối đa @totalMaxChildren)</label>
                            <div class="flex items-center border border-outline-variant/20 rounded-lg bg-surface-container-low h-[48px]">
                                <button class="px-3 text-primary" type="button" onclick="changeVal('NumberOfChildren', -1, @totalMaxChildren)"><span class="material-symbols-outlined">remove</span></button>
                                <input asp-for="NumberOfChildren" id="NumberOfChildren" class="w-full border-none bg-transparent text-center focus:ring-0 text-on-surface font-bold" readonly type="text" />
                                <button class="px-3 text-primary" type="button" onclick="changeVal('NumberOfChildren', 1, @totalMaxChildren)"><span class="material-symbols-outlined">add</span></button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. TRẢI NGHIỆM THÊM (Tour Add-ons) -->
                <div class="bg-surface-container-lowest border border-outline-variant/15 rounded-xl p-6 luxury-shadow">
                    <h3 class="font-headline-sm text-headline-sm mb-6 flex items-center gap-3 text-on-surface">
                        <span class="material-symbols-outlined text-primary">explore</span>
                        2. TRẢI NGHIỆM THÊM
                    </h3>
                    
                    <div class="space-y-4 pr-2" style="max-height: 400px; overflow-y: auto;">
                        @if (ViewBag.UpcomingTours != null && ((IEnumerable<PhucNguyenResort.Models.TourSchedule>)ViewBag.UpcomingTours).Any())
                        {
                            var tours = (IEnumerable<PhucNguyenResort.Models.TourSchedule>)ViewBag.UpcomingTours;
                            int index = 0;
                            foreach (var schedule in tours)
                            {
                                if (schedule.Tour != null)
                                {
                                    string tourDateStr = schedule.TourDate?.ToString("dd/MM/yyyy") ?? "";
                                    string tourTimeStr = schedule.StartTime?.ToString(@"hh\:mm") ?? "";
                                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-4 border border-outline-variant/20 rounded-xl bg-surface-container-low hover:bg-surface-container-high transition-colors gap-4">
                                        <div class="flex-1">
                                            <h4 class="font-bold text-on-surface text-label-lg">@schedule.Tour.TourName</h4>
                                            <div class="flex flex-wrap gap-x-4 gap-y-1 mt-1 text-label-sm text-on-surface-variant">
                                                <span class="flex items-center"><span class="material-symbols-outlined text-[14px] mr-1">schedule</span> @tourDateStr @tourTimeStr</span>
                                                <span class="flex items-center text-error"><span class="material-symbols-outlined text-[14px] mr-1">group</span> Còn @(schedule.AvailableSlots ?? 0) chỗ trống</span>
                                            </div>
                                        </div>
                                        
                                        <div class="flex items-center gap-4 w-full sm:w-auto justify-between sm:justify-end">
                                            <span class="text-primary font-bold text-lg whitespace-nowrap">+ @schedule.Tour.Price?.ToString("N0") VNĐ / slot</span>
                                            
                                            <div class="flex items-center border border-outline-variant/20 rounded-lg bg-surface h-[40px]">
                                                <button class="px-2.5 text-on-surface" type="button" onclick="changeTourVal(@index, -1, @(schedule.AvailableSlots ?? 0))"><span class="material-symbols-outlined text-[18px]">remove</span></button>
                                                
                                                <input type="hidden" name="SelectedTours[@index].ScheduleId" value="@schedule.ScheduleId" />
                                                <input id="tourQty_@index" name="SelectedTours[@index].Participants" class="w-12 border-none bg-transparent text-center focus:ring-0 text-on-surface font-bold" value="0" readonly type="text" data-price="@(schedule.Tour.Price ?? 0)" />
                                                
                                                <button class="px-2.5 text-on-surface" type="button" onclick="changeTourVal(@index, 1, @(schedule.AvailableSlots ?? 0))"><span class="material-symbols-outlined text-[18px]">add</span></button>
                                            </div>
                                        </div>
                                    </div>
                                    index++;
                                }
                            }
                        }
                        else
                        {
                            <div class="text-center py-6 text-on-surface-variant italic">Hiện tại chưa có tour trải nghiệm nào khả dụng.</div>
                        }
                    </div>
                </div>

                <!-- 3. KHAI BÁO TẠM TRÚ NGƯỜI ĐẶT CHÍNH -->
                <div class="bg-surface-container-lowest border border-outline-variant/15 rounded-xl p-6 luxury-shadow">
                    <h3 class="font-headline-sm text-headline-sm mb-6 flex items-center gap-3 text-on-surface">
                        <span class="material-symbols-outlined text-primary">person_outline</span>
                        3. KHAI BÁO TẠM TRÚ NGƯỜI ĐẶT CHÍNH
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="text-label-sm text-on-surface-variant">Họ và Tên (như CCCD) <span class="text-error">*</span></label>
                            <input type="text" asp-for="PrimaryGuestName" class="w-full bg-surface-container-low border border-outline-variant/20 rounded-lg p-3 text-body-md focus:ring-1 focus:ring-primary-container text-on-surface" placeholder="Ví dụ: NGUYEN VAN A" />
                            <span asp-validation-for="PrimaryGuestName" class="text-error text-[12px]"></span>
                        </div>
                        
                        <div class="space-y-1">
                            <label class="text-label-sm text-on-surface-variant">Số CCCD/Hộ chiếu <span class="text-error">*</span></label>
                            <input type="text" asp-for="PrimaryGuestPassportNumber" class="w-full bg-surface-container-low border border-outline-variant/20 rounded-lg p-3 text-body-md focus:ring-1 focus:ring-primary-container text-on-surface" placeholder="Số định danh cá nhân" />
                            <span asp-validation-for="PrimaryGuestPassportNumber" class="text-error text-[12px]"></span>
                        </div>

                        <div class="space-y-1">
                            <label class="text-label-sm text-on-surface-variant">Ngày sinh <span class="text-error">*</span></label>
                            <input type="date" asp-for="PrimaryGuestDateOfBirth" class="w-full bg-surface-container-low border border-outline-variant/20 rounded-lg p-3 text-body-md focus:ring-1 focus:ring-primary-container text-on-surface" />
                            <span asp-validation-for="PrimaryGuestDateOfBirth" class="text-error text-[12px]"></span>
                        </div>

                        <div class="space-y-1">
                            <label class="text-label-sm text-on-surface-variant">Giới tính <span class="text-error">*</span></label>
                            <select asp-for="PrimaryGuestGender" class="w-full bg-surface-container-low border border-outline-variant/20 rounded-lg p-3 text-body-md focus:ring-1 focus:ring-primary-container text-on-surface">
                                <option value="">-- Chọn giới tính --</option>
                                <option value="Male">Nam</option>
                                <option value="Female">Nữ</option>
                                <option value="Other">Khác</option>
                            </select>
                            <span asp-validation-for="PrimaryGuestGender" class="text-error text-[12px]"></span>
                        </div>
                        
                        <div class="space-y-1">
                            <label class="text-label-sm text-on-surface-variant">Quốc tịch <span class="text-error">*</span></label>
                            <input type="text" asp-for="PrimaryGuestNationality" class="w-full bg-surface-container-low border border-outline-variant/20 rounded-lg p-3 text-body-md focus:ring-1 focus:ring-primary-container text-on-surface" value="Vietnam" />
                            <span asp-validation-for="PrimaryGuestNationality" class="text-error text-[12px]"></span>
                        </div>



                        <div class="md:col-span-2 mt-2">
                            <label class="flex items-start gap-3 cursor-pointer p-4 border border-outline-variant/20 rounded-lg bg-surface-container-lowest hover:bg-surface-container-low transition-colors">
                                <input type="checkbox" asp-for="PdpdConsentChecked" class="mt-1 text-primary focus:ring-primary border-outline-variant rounded" required />
                                <span class="text-label-sm text-on-surface-variant leading-relaxed">
                                    Tôi đồng ý cho phép Phúc Nguyên Resort thu thập và lưu trữ thông tin cá nhân nhạy cảm (số CCCD/Hộ chiếu và Ngày sinh) để khai báo tạm trú theo Nghị định 356/2025/NĐ-CP (PDPD).
                                </span>
                            </label>
                            <span asp-validation-for="PdpdConsentChecked" class="text-error text-[12px] block mt-1"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Order Summary (Sticky) -->
            <div class="lg:col-span-4 lg:sticky lg:top-[80px] max-h-[calc(100vh-100px)] overflow-y-auto pr-2 space-y-4">
                <div class="bg-surface-container-lowest border border-outline-variant/15 rounded-xl p-4 luxury-shadow">
                    <h3 class="font-headline-sm text-[18px] mb-3 pb-2 border-b border-outline-variant/10 text-on-surface">TÓM TẮT ĐẶT PHÒNG</h3>
                    
                    <div class="space-y-1.5 font-body-md text-on-surface-variant text-[13px]">
                        <div class="flex justify-between border-b border-outline-variant/10 pb-1.5">
                            <span>Phòng đặt:</span>
                            <span class="font-bold text-on-surface">Đã chọn @(Model.RoomSelections?.Sum(s => s.Quantity) ?? 0) phòng</span>
                        </div>
                        <div class="flex justify-between border-b border-outline-variant/10 pb-1.5">
                            <span>Nhận phòng:</span>
                            <span id="summaryCheckIn" class="font-semibold text-on-surface">@Model.CheckInDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="flex justify-between border-b border-outline-variant/10 pb-1.5">
                            <span>Trả phòng:</span>
                            <span id="summaryCheckOut" class="font-semibold text-on-surface">@Model.CheckOutDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="flex justify-between border-b border-outline-variant/10 pb-1.5">
                            <span>Số đêm nghỉ:</span>
                            <span class="font-semibold text-on-surface"><span id="summaryNights">@totalNights</span> đêm</span>
                        </div>
                        <div class="flex justify-between border-b border-outline-variant/10 pb-1.5">
                            <span>Số khách lưu trú:</span>
                            <span id="summaryGuests" class="font-semibold text-on-surface">@Model.NumberOfAdults Người lớn, @Model.NumberOfChildren Trẻ em</span>
                        </div>
                        <div class="flex justify-between border-b border-outline-variant/10 pb-1.5">
                            <span>Tiền phòng (<span id="summaryNightsLabel">@totalNights</span> đêm):</span>
                            <span id="summaryRoomPrice" class="font-bold text-on-surface">@totalPrice.ToString("N0") VNĐ</span>
                        </div>
                        <div id="summaryTourRow" class="flex justify-between border-b border-outline-variant/10 pb-1.5 hidden">
                            <span>Tiền tour:</span>
                            <span id="summaryTourPrice" class="font-bold text-on-surface">0 VNĐ</span>
                        </div>
                        <div class="flex justify-between border-b border-outline-variant/10 pb-1.5">
                            <span class="font-bold text-on-surface text-[14px]">Tổng cộng:</span>
                            <span id="summaryGrandTotal" class="font-bold text-[16px] text-primary">@totalPrice.ToString("N0") VNĐ</span>
                        </div>
                        <div class="flex justify-between border-b border-outline-variant/10 pb-1.5 pt-1.5 text-primary bg-primary/5 p-2 rounded-lg">
                            <span class="font-bold text-[14px]">Tiền đặt cọc (40%):</span>
                            <span id="summaryDeposit" class="font-bold text-[16px]">@((totalPrice * 0.4m).ToString("N0")) VNĐ</span>
                        </div>
                    </div>
                    
                    <div class="bg-blue-50 dark:bg-blue-900/20 text-blue-800 dark:text-blue-200 p-3 rounded-xl text-[11px] border border-blue-200/50 mt-4 leading-relaxed">
                        <span class="flex items-center gap-1 font-bold mb-0.5">
                            <span class="material-symbols-outlined text-[14px]">info</span> Lưu ý đặt cọc
                        </span>
                        Quý khách cần đặt cọc trước 40% tổng giá trị đơn phòng thông qua cổng VNPAY để giữ phòng.
                    </div>
                    
                    <button type="submit" class="w-full bg-[#0d233a] hover:bg-slate-800 text-white py-2.5 rounded-xl text-[13px] font-bold mt-4 active:scale-[0.98] transition-all shadow-lg uppercase tracking-wider flex items-center justify-center gap-2">
                        Thanh toán cọc qua VNPAY
                        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                    </button>
                    
                    <div class="text-center mt-2 text-[11px] text-on-surface-variant flex items-center justify-center gap-1">
                        <span class="material-symbols-outlined text-[13px] text-primary">verified_user</span>
                        An toàn & Bảo mật bởi VNPAY
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const roomSelections = [
            @if (selectedCategories != null && Model.RoomSelections != null)
            {
                foreach (var sel in Model.RoomSelections)
                {
                    var cat = selectedCategories.FirstOrDefault(c => c.CategoryId == sel.CategoryId);
                    if (cat != null)
                    {
                        <text>{ categoryId: @sel.CategoryId, quantity: @sel.Quantity, pricePerNight: @(cat.PricePerNight ?? 0) },</text>
                    }
                }
            }
        ];

        function changeVal(id, amount, maxLimit) {
            let el = document.getElementById(id);
            let current = parseInt(el.value) || 0;
            let newVal = current + amount;
            
            // Limit values
            if (id === 'NumberOfAdults') {
                if (newVal < 1 || newVal > maxLimit) return;
            } else if (id === 'NumberOfChildren') {
                if (newVal < 0 || newVal > maxLimit) return;
            }
            
            if (newVal >= 0) {
                el.value = newVal;
                recalculateTotals();
            }
        }

        function changeTourVal(index, amount, maxSlots) {
            let el = document.getElementById('tourQty_' + index);
            let current = parseInt(el.value) || 0;
            let newVal = current + amount;
            if (newVal >= 0 && newVal <= maxSlots) {
                el.value = newVal;
                recalculateTotals();
            }
        }

        function recalculateTotals() {
            // Dates
            const checkInStr = document.getElementById('checkInDate').value;
            const checkOutStr = document.getElementById('checkOutDate').value;
            
            if (!checkInStr || !checkOutStr) return;

            const dIn = new Date(checkInStr);
            const dOut = new Date(checkOutStr);

            let diffTime = dOut - dIn;
            let totalNights = Math.max(1, Math.ceil(diffTime / (1000 * 60 * 60 * 24)));
            
            // Format check-in / check-out for summary
            const formatShortDate = (date) => {
                const day = String(date.getDate()).padStart(2, '0');
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const year = date.getFullYear();
                return `${day}/${month}/${year}`;
            };
            
            document.getElementById('summaryCheckIn').innerText = formatShortDate(dIn);
            document.getElementById('summaryCheckOut').innerText = formatShortDate(dOut);
            document.getElementById('summaryNights').innerText = totalNights;
            document.getElementById('summaryNightsLabel').innerText = totalNights;

            // Guests
            const adults = document.getElementById('NumberOfAdults').value;
            const children = document.getElementById('NumberOfChildren').value;
            document.getElementById('summaryGuests').innerText = `${adults} Người lớn, ${children} Trẻ em`;

            // Room Price
            let roomTotal = 0;
            roomSelections.forEach(item => {
                roomTotal += item.pricePerNight * item.quantity * totalNights;
            });
            document.getElementById('summaryRoomPrice').innerText = roomTotal.toLocaleString('vi-VN') + ' VNĐ';

            // Tour Price
            let tourTotal = 0;
            document.querySelectorAll('input[id^="tourQty_"]').forEach(el => {
                const qty = parseInt(el.value) || 0;
                const price = parseFloat(el.getAttribute('data-price')) || 0;
                tourTotal += qty * price;
            });

            const tourRow = document.getElementById('summaryTourRow');
            if (tourTotal > 0) {
                document.getElementById('summaryTourPrice').innerText = tourTotal.toLocaleString('vi-VN') + ' VNĐ';
                tourRow.classList.remove('hidden');
            } else {
                tourRow.classList.add('hidden');
            }

            // Totals
            const grandTotal = roomTotal + tourTotal;
            const deposit = Math.round(grandTotal * 0.4);

            document.getElementById('summaryGrandTotal').innerText = grandTotal.toLocaleString('vi-VN') + ' VNĐ';
            document.getElementById('summaryDeposit').innerText = deposit.toLocaleString('vi-VN') + ' VNĐ';
        }

        // Date pickers restriction
        document.getElementById('checkInDate').addEventListener('change', function() {
            document.getElementById('checkOutDate').min = this.value;
            
            const dIn = new Date(this.value);
            const dOut = new Date(document.getElementById('checkOutDate').value);
            if (dOut <= dIn) {
                const nextDay = new Date(dIn);
                nextDay.setDate(dIn.getDate() + 1);
                
                const formatDate = (date) => {
                    const y = date.getFullYear();
                    const m = String(date.getMonth() + 1).padStart(2, '0');
                    const d = String(date.getDate()).padStart(2, '0');
                    return `${y}-${m}-${d}`;
                };
                document.getElementById('checkOutDate').value = formatDate(nextDay);
            }
            recalculateTotals();
        });
        document.getElementById('checkOutDate').addEventListener('change', recalculateTotals);
        
        // Initial run
        recalculateTotals();
    </script>
}
