@model PhucNguyenResort.ViewModels.Bookings.CreateBookingViewModel

@{
    ViewData["Title"] = "Đặt Phòng - Phuc Nguyen Resort";
    var room = ViewBag.Room as PhucNguyenResort.Models.Room;
    var tours = ViewBag.UpcomingTours as List<PhucNguyenResort.Models.TourSchedule>;
}

@section Styles {
    <link rel="stylesheet" href="~/css/booking-create.css" />
}

<!-- Breadcrumb Section Begin -->
<div class="breadcrumb-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb-text">
                    <h2>Hoàn Tất Đặt Phòng</h2>
                    <div class="bt-option">
                        <a asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        <span>Đặt Phòng</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Breadcrumb Section End -->

<section class="premium-booking-section spad pt-0">
    <div class="container">

        <form asp-action="Create" method="post" id="bookingForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius: 12px; font-size: 0.9rem;"></div>
            <input type="hidden" asp-for="RoomId" />

            <div class="row">
                <!-- Left Column: Input Forms -->
                <div class="col-lg-7 col-md-12">
                    
                    <!-- Room Showcase -->
                    <div class="room-showcase-horizontal">
                        <div class="room-showcase-img">
                            @if (!string.IsNullOrEmpty(room?.Category?.ImageUrl))
                            {
                                <img src="@room.Category.ImageUrl" alt="@room.Category.CategoryName" />
                            }
                            else
                            {
                                <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="Resort Room" />
                            }
                        </div>
                        <div class="room-showcase-details">
                            <h3>@room?.Category?.CategoryName</h3>
                            <div class="price">
                                @room?.Category?.PricePerNight?.ToString("N0") VNĐ <span>/ Đêm</span>
                            </div>
                            <div class="features-container">
                                <span class="feature-badge"><i class="fa fa-bed"></i> Phòng số: @room?.RoomNumber</span>
                                <span class="feature-badge"><i class="fa fa-users"></i> Tối đa: @room?.Category?.MaxAdults NL, @room?.Category?.MaxChildren TE</span>
                                <span class="feature-badge"><i class="fa fa-wifi"></i> Free Wifi</span>
                            </div>
                        </div>
                    </div>

                    <!-- Section 1: Dates & Guests -->
                    <div class="premium-card">
                        <h5><i class="fa fa-calendar-check-o"></i> 1. Thời Gian & Số Khách</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="CheckInDate">Ngày Nhận Phòng</label>
                                    <input type="date" asp-for="CheckInDate" class="form-control-modern" />
                                    <span asp-validation-for="CheckInDate" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="CheckOutDate">Ngày Trả Phòng</label>
                                    <input type="date" asp-for="CheckOutDate" class="form-control-modern" />
                                    <span asp-validation-for="CheckOutDate" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="NumberOfAdults">Người Lớn</label>
                                    <input type="number" asp-for="NumberOfAdults" class="form-control-modern" min="1" max="@(room?.Category?.MaxAdults ?? 10)" value="2" />
                                    <span asp-validation-for="NumberOfAdults" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="NumberOfChildren">Trẻ Em</label>
                                    <input type="number" asp-for="NumberOfChildren" class="form-control-modern" min="0" max="@(room?.Category?.MaxChildren ?? 10)" value="0" />
                                    <span asp-validation-for="NumberOfChildren" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Tour Addons -->
                    @if (tours != null && tours.Any())
                    {
                        <div class="premium-card">
                            <h5><i class="fa fa-compass"></i> 2. Trải Nghiệm Thêm</h5>
                            <div class="tour-list-modern">
                                @foreach (var tour in tours)
                                {
                                    <div class="tour-card-modern" data-schedule-id="@tour.ScheduleId">
                                        <input type="checkbox" name="SelectedTourScheduleIds" value="@tour.ScheduleId" id="tour_@tour.ScheduleId" data-price="@(tour.Tour?.Price ?? 0)">
                                        <div class="tour-details-modern">
                                            <strong>@tour.Tour?.TourName</strong>
                                            <span class="time"><i class="fa fa-calendar"></i> @tour.TourDate?.ToString("dd/MM/yyyy") @(tour.StartTime != null ? " - " + tour.StartTime?.ToString(@"hh\:mm") : "")</span>
                                        </div>
                                        <div class="tour-card-price">
                                            + @tour.Tour?.Price?.ToString("N0") VNĐ
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Section 3: Stay Registration -->
                    <div class="premium-card">
                        <h5><i class="fa fa-id-card-o"></i> @(tours != null && tours.Any() ? "3" : "2"). Khai Báo Tạm Trú Người Đặt Chính</h5>
                        
                        <div class="form-group-modern">
                            <label asp-for="PrimaryGuestName">Họ và tên (như trên CCCD)</label>
                            <input type="text" asp-for="PrimaryGuestName" class="form-control-modern" placeholder="Ví dụ: NGUYEN VAN A" />
                            <span asp-validation-for="PrimaryGuestName" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="PrimaryGuestDateOfBirth">Ngày sinh</label>
                                    <input type="date" asp-for="PrimaryGuestDateOfBirth" class="form-control-modern" />
                                    <span asp-validation-for="PrimaryGuestDateOfBirth" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="PrimaryGuestGender">Giới tính</label>
                                    <select asp-for="PrimaryGuestGender" class="form-control-modern">
                                        <option value="">-- Chọn giới tính --</option>
                                        <option value="Male">Nam</option>
                                        <option value="Female">Nữ</option>
                                        <option value="Other">Khác</option>
                                    </select>
                                    <span asp-validation-for="PrimaryGuestGender" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="PrimaryGuestPassportNumber">Số CCCD / Hộ chiếu</label>
                                    <input type="text" asp-for="PrimaryGuestPassportNumber" class="form-control-modern" placeholder="Số định danh cá nhân" />
                                    <span asp-validation-for="PrimaryGuestPassportNumber" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group-modern">
                                    <label asp-for="PrimaryGuestNationality">Quốc tịch</label>
                                    <input type="text" asp-for="PrimaryGuestNationality" class="form-control-modern" placeholder="Ví dụ: Vietnam" value="Vietnam" />
                                    <span asp-validation-for="PrimaryGuestNationality" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- PDPD Consent Checkbox -->
                        <div class="mt-3 d-flex align-items-start">
                            <input type="checkbox" id="pdpdConsent" name="PdpdConsentChecked" value="true" required="required" data-val="true" data-val-required="Bạn phải đồng ý với điều khoản bảo vệ dữ liệu cá nhân (PDPD)." style="cursor: pointer; width: 18px; height: 18px; margin-top: 3px; accent-color: var(--accent-color);">
                            <label class="ml-2" for="pdpdConsent" style="font-size: 11.5px; color: var(--text-muted); cursor: pointer; line-height: 1.45;">
                                Tôi đồng ý cho phép Phúc Nguyên Resort thu thập và lưu trữ thông tin cá nhân nhạy cảm (số CCCD/Hộ chiếu và Ngày sinh) của các thành viên trong đoàn để khai báo tạm trú theo Nghị định 356/2025/NĐ-CP (PDPD).
                            </label>
                        </div>
                        <span asp-validation-for="PdpdConsentChecked" class="text-danger small d-block mb-1"></span>
                    </div>

                </div>

                <!-- Right Column: Sticky Summary Widget -->
                <div class="col-lg-5 col-md-12">
                    <div class="payment-summary-widget">
                        <h4>Tóm Tắt Đặt Phòng</h4>
                        
                        <ul class="summary-info-list">
                            <li>
                                <span>Phòng đặt:</span>
                                <span>@room?.Category?.CategoryName (P.@room?.RoomNumber)</span>
                            </li>
                            <li>
                                <span>Nhận phòng:</span>
                                <span id="summary-checkin">--/--/----</span>
                            </li>
                            <li>
                                <span>Trả phòng:</span>
                                <span id="summary-checkout">--/--/----</span>
                            </li>
                            <li>
                                <span>Số đêm nghỉ:</span>
                                <span id="summary-nights">0 đêm</span>
                            </li>
                            <li>
                                <span>Số khách lưu trú:</span>
                                <span id="summary-guests">--</span>
                            </li>
                        </ul>

                        <div class="price-breakdown">
                            <div class="price-breakdown-row">
                                <span id="room-subtotal-label">Tiền phòng (0 đêm)</span>
                                <span id="room-subtotal-val">0 VNĐ</span>
                            </div>
                            <div class="price-breakdown-row" id="tour-subtotal-row" style="display: none;">
                                <span>Trải nghiệm dịch vụ:</span>
                                <span id="tour-subtotal-val">0 VNĐ</span>
                            </div>
                            <div class="price-breakdown-row total">
                                <span>Tổng cộng:</span>
                                <span id="total-amount-val">0 VNĐ</span>
                            </div>
                            <div class="price-breakdown-row deposit">
                                <span>Tiền đặt cọc (40%):</span>
                                <span id="deposit-amount-val">0 VNĐ</span>
                            </div>
                        </div>

                        <div class="alert-premium-info">
                            <i class="fa fa-info-circle"></i>
                            <div>
                                Quý khách cần đặt cọc trước <strong>40%</strong> tổng giá trị đơn phòng thông qua cổng VNPAY để giữ phòng.
                            </div>
                        </div>

                        <button type="submit" class="btn-premium-vnpay">
                            Thanh Toán Cọc Qua VNPAY <i class="fa fa-arrow-right"></i>
                        </button>

                        <div class="payment-badge">
                            <i class="fa fa-shield" style="color: #10b981;"></i> An toàn & Bảo mật bởi <strong>VNPAY</strong>
                        </div>
                    </div>
                </div>

            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var checkInInput = document.querySelector('input[name="CheckInDate"]');
            var checkOutInput = document.querySelector('input[name="CheckOutDate"]');
            var adultsInput = document.querySelector('input[name="NumberOfAdults"]');
            var childrenInput = document.querySelector('input[name="NumberOfChildren"]');
            var tourCheckboxes = document.querySelectorAll('input[name="SelectedTourScheduleIds"]');
            
            // Dynamic display elements
            var summaryCheckIn = document.getElementById('summary-checkin');
            var summaryCheckOut = document.getElementById('summary-checkout');
            var summaryNights = document.getElementById('summary-nights');
            var summaryGuests = document.getElementById('summary-guests');
            
            var roomSubtotalLabel = document.getElementById('room-subtotal-label');
            var roomSubtotalVal = document.getElementById('room-subtotal-val');
            var tourSubtotalVal = document.getElementById('tour-subtotal-val');
            var tourSubtotalRow = document.getElementById('tour-subtotal-row');
            var totalAmountVal = document.getElementById('total-amount-val');
            var depositAmountVal = document.getElementById('deposit-amount-val');
            
            var pricePerNight = parseFloat('@(room?.Category?.PricePerNight ?? 0)');
            
            // Format number helper (e.g. 1,000,000)
            function formatVnd(amount) {
                return amount.toLocaleString('vi-VN') + ' VNĐ';
            }
            
            // Format date helper (e.g. 14/06/2026)
            function formatDate(dateStr) {
                if (!dateStr) return '--/--/----';
                var d = new Date(dateStr);
                if (isNaN(d.getTime())) return dateStr;
                var dd = String(d.getDate()).padStart(2, '0');
                var mm = String(d.getMonth() + 1).padStart(2, '0');
                var yyyy = d.getFullYear();
                return dd + '/' + mm + '/' + yyyy;
            }
            
            function calculatePrices() {
                var checkInDate = new Date(checkInInput.value);
                var checkOutDate = new Date(checkOutInput.value);
                
                var nights = 0;
                if (!isNaN(checkInDate.getTime()) && !isNaN(checkOutDate.getTime()) && checkOutDate > checkInDate) {
                    nights = Math.round((checkOutDate - checkInDate) / (1000 * 60 * 60 * 24));
                }
                
                // Update summary text
                summaryCheckIn.textContent = formatDate(checkInInput.value);
                summaryCheckOut.textContent = formatDate(checkOutInput.value);
                summaryNights.textContent = nights + ' đêm';
                
                var adults = parseInt(adultsInput.value) || 0;
                var children = parseInt(childrenInput.value) || 0;
                var totalGuests = adults + children;
                summaryGuests.textContent = adults + ' Người lớn, ' + children + ' Trẻ em';
                
                // Calculate room total
                var roomTotal = nights * pricePerNight;
                roomSubtotalLabel.textContent = 'Tiền phòng (' + nights + ' đêm)';
                roomSubtotalVal.textContent = formatVnd(roomTotal);
                
                // Calculate tours total
                var tourTotal = 0;
                var selectedToursCount = 0;
                
                tourCheckboxes.forEach(function(cb) {
                    var card = cb.closest('.tour-card-modern');
                    if (cb.checked) {
                        card.classList.add('selected');
                        // Retrieve tour price from data attribute
                        var price = parseFloat(cb.getAttribute('data-price')) || 0;
                        tourTotal += price * totalGuests;
                        selectedToursCount++;
                    } else {
                        card.classList.remove('selected');
                    }
                });
                
                // Show/hide tour row in summary
                if (selectedToursCount > 0) {
                    tourSubtotalRow.style.display = 'flex';
                    tourSubtotalVal.textContent = formatVnd(tourTotal);
                } else {
                    tourSubtotalRow.style.display = 'none';
                }
                
                // Calculate grand total and deposit
                var grandTotal = roomTotal + tourTotal;
                var deposit = grandTotal * 0.4;
                
                totalAmountVal.textContent = formatVnd(grandTotal);
                depositAmountVal.textContent = formatVnd(deposit);
            }
            
            // Set up date constraints
            checkInInput.addEventListener('change', function() {
                var checkInDate = new Date(this.value);
                var minCheckOutDate = new Date(checkInDate);
                minCheckOutDate.setDate(minCheckOutDate.getDate() + 1);
                
                var dd = String(minCheckOutDate.getDate()).padStart(2, '0');
                var mm = String(minCheckOutDate.getMonth() + 1).padStart(2, '0');
                var yyyy = minCheckOutDate.getFullYear();
                
                checkOutInput.min = yyyy + '-' + mm + '-' + dd;
                
                if (new Date(checkOutInput.value) <= checkInDate) {
                    checkOutInput.value = yyyy + '-' + mm + '-' + dd;
                }
                calculatePrices();
            });
            
            // Add listeners
            checkOutInput.addEventListener('change', calculatePrices);
            adultsInput.addEventListener('input', calculatePrices);
            childrenInput.addEventListener('input', calculatePrices);
            
            tourCheckboxes.forEach(function(cb) {
                cb.addEventListener('change', calculatePrices);
                // Also listen to clicking the card to toggle checkbox
                var card = cb.closest('.tour-card-modern');
                card.addEventListener('click', function(e) {
                    if (e.target !== cb && !e.target.closest('input')) {
                        cb.checked = !cb.checked;
                        cb.dispatchEvent(new Event('change'));
                    }
                });
            });
            
            // Initial run
            calculatePrices();
        });
    </script>
}
