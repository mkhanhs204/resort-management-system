@model IEnumerable<PhucNguyenResort.Models.Booking>
@using PhucNguyenResort.Enums

@{
    ViewData["Title"] = "Lịch Sử Đặt Phòng | Phúc Nguyên Resort";
}

<div class="pt-24 pb-section-gap-lg max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop min-h-screen">
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-primary-container/20 border border-primary/30 text-primary p-4 rounded-xl mb-6">
            @TempData["SuccessMessage"]
        </div>
    }
    
    @if (TempData["Error"] != null)
    {
        <div class="bg-error-container text-on-error-container p-4 rounded-xl mb-6">
            @TempData["Error"]
        </div>
    }

    <!-- Page Title & Intro -->
    <div class="mb-stack-lg text-center md:text-left mt-8">
        <h1 class="font-headline-lg text-headline-lg text-on-surface mb-2">Lịch Sử Đặt Phòng</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant opacity-80">Quản lý các kỳ nghỉ của bạn tại digital sanctuary của chúng tôi.</p>
    </div>

    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="py-section-gap-lg text-center flex flex-col items-center">
            <div class="w-32 h-32 bg-surface-container flex items-center justify-center rounded-full mb-8">
                <span class="material-symbols-outlined text-[64px] text-outline" style="font-variation-settings: 'FILL' 0;">book_online</span>
            </div>
            <h2 class="font-headline-md text-headline-md text-on-surface mb-4">Bạn chưa có đơn đặt phòng nào</h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant max-w-md mx-auto mb-10">Khám phá bộ sưu tập phòng nghỉ sang trọng và bắt đầu hành trình của bạn tại Phúc Nguyên ngay hôm nay.</p>
            <a asp-controller="Home" asp-action="SearchRooms" class="bg-primary text-on-primary px-10 py-4 rounded-xl font-label-lg luxury-shadow hover:scale-105 transition-all inline-block uppercase tracking-widest">Tìm kiếm phòng ngay</a>
        </div>
    }
    else
    {
        <!-- Filter Tabs -->
        <div class="flex flex-wrap gap-8 border-b border-outline-variant/20 mb-section-gap-md overflow-x-auto whitespace-nowrap">
            <button class="pb-4 font-label-lg text-label-lg filter-tab tab-active" data-filter="all">Tất cả đơn đặt</button>
            <button class="pb-4 font-label-lg text-label-lg filter-tab text-on-surface-variant hover:text-primary transition-colors" data-filter="Reserved">Sắp diễn ra</button>
            <button class="pb-4 font-label-lg text-label-lg filter-tab text-on-surface-variant hover:text-primary transition-colors" data-filter="CheckedIn">Đang lưu trú</button>
            <button class="pb-4 font-label-lg text-label-lg filter-tab text-on-surface-variant hover:text-primary transition-colors" data-filter="CheckedOut">Đã hoàn thành</button>
            <button class="pb-4 font-label-lg text-label-lg filter-tab text-on-surface-variant hover:text-primary transition-colors" data-filter="Cancelled">Đã hủy</button>
        </div>

        <!-- Bookings List -->
        <div class="space-y-gutter" id="bookings-container">
            @foreach (var booking in Model.OrderByDescending(b => b.CreatedAt))
            {
                var tokens = ViewBag.PreCheckinTokens as Dictionary<int, string>;
                var token = (tokens != null && tokens.ContainsKey(booking.BookingId)) ? tokens[booking.BookingId] : string.Empty;
                var shareLink = Url.Action("PreCheckin", "Bookings", new { id = booking.BookingId, token = token }, Context.Request.Scheme);
                
                var groupedRooms = booking.BookingDetails
                    .GroupBy(bd => bd.RoomCategory?.CategoryName)
                    .Select(g => $"{g.Count()}x {g.Key}")
                    .ToList();
                string roomsDisplay = groupedRooms.Any() ? string.Join(", ", groupedRooms) : "Phòng Resort";
                
                var firstDetail = booking.BookingDetails.FirstOrDefault();
                string imgUrl = firstDetail?.RoomCategory?.ImageUrl ?? "https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80";

                string statusClass = "";
                string statusText = "";
                string statusBadgeClass = "";
                string cardOpacityClass = "";
                string imageFilterClass = "";

                switch (booking.BookingStatus)
                {
                    case BookingStatus.Reserved:
                        statusClass = "Reserved";
                        statusText = "Đã đặt";
                        statusBadgeClass = "bg-blue-50 text-blue-700 border-blue-100";
                        break;
                    case BookingStatus.CheckedIn:
                        statusClass = "CheckedIn";
                        statusText = "Đang lưu trú";
                        statusBadgeClass = "bg-emerald-50 text-emerald-700 border-emerald-100";
                        break;
                    case BookingStatus.CheckedOut:
                        statusClass = "CheckedOut";
                        statusText = "Hoàn thành";
                        statusBadgeClass = "bg-surface-container-highest text-on-surface-variant border-outline-variant/30";
                        cardOpacityClass = "opacity-80 hover:opacity-100";
                        imageFilterClass = "grayscale-[30%] group-hover:grayscale-0";
                        break;
                    case BookingStatus.Cancelled:
                        statusClass = "Cancelled";
                        statusText = "Đã hủy";
                        statusBadgeClass = "bg-red-50 text-red-700 border-red-100";
                        cardOpacityClass = "opacity-60";
                        break;
                    case BookingStatus.NoShow:
                        statusClass = "Cancelled";
                        statusText = "Không đến";
                        statusBadgeClass = "bg-red-50 text-red-700 border-red-100";
                        cardOpacityClass = "opacity-60";
                        break;
                }

                <div class="booking-card bg-surface-container-lowest luxury-shadow border border-outline-variant/20 rounded-xl overflow-hidden group hover:border-primary/30 transition-all duration-500 @cardOpacityClass" data-status="@statusClass">
                    <div class="flex flex-col md:flex-row">
                        <!-- Image section -->
                        <div class="w-full md:w-80 h-48 md:h-auto overflow-hidden relative">
                            @if (booking.BookingStatus == BookingStatus.Cancelled || booking.BookingStatus == BookingStatus.NoShow)
                            {
                                <div class="w-full h-full bg-surface-container-highest flex items-center justify-center min-h-[200px]">
                                    <span class="material-symbols-outlined text-[64px] text-outline-variant">event_busy</span>
                                </div>
                            }
                            else
                            {
                                <img src="@imgUrl" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 min-h-[200px] @imageFilterClass" alt="Room Image" />
                            }
                            <div class="absolute top-4 left-4">
                                <span class="@statusBadgeClass text-label-sm font-semibold px-3 py-1 rounded-full border uppercase tracking-wider shadow-sm">
                                    @statusText
                                </span>
                            </div>
                        </div>

                        <!-- Content section -->
                        <div class="flex-1 p-6 md:p-8 flex flex-col justify-between">
                            <div class="flex flex-col md:flex-row justify-between items-start gap-4">
                                <div>
                                    <div class="text-label-sm text-primary font-bold mb-1 tracking-widest uppercase">PNR-@booking.BookingId.ToString("D5")</div>
                                    <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2">@roomsDisplay</h3>
                                    <div class="flex flex-wrap items-center gap-4 text-on-surface-variant text-label-lg mt-2">
                                        <div class="flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[18px]">calendar_today</span>
                                            <span>@booking.CheckInDate.ToString("dd/MM/yyyy") - @booking.CheckOutDate.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        <div class="flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[18px]">person</span>
                                            <span>@booking.NumberOfAdults NL, @booking.NumberOfChildren TE</span>
                                        </div>
                                        @if (booking.ActualCheckInTime.HasValue || booking.ActualCheckOutTime.HasValue)
                                        {
                                            <div class="flex items-center gap-1 text-primary text-label-sm font-bold border border-primary/20 bg-primary/5 px-2 py-0.5 rounded">
                                                <span class="material-symbols-outlined text-[16px]">schedule</span>
                                                <span>
                                                    Thực tế: @(booking.ActualCheckInTime?.ToString("HH:mm dd/MM/yy") ?? "...") - @(booking.ActualCheckOutTime?.ToString("HH:mm dd/MM/yy") ?? "...")
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="text-right mt-4 md:mt-0">
                                    <div class="text-label-sm text-on-surface-variant mb-1">Tổng cộng</div>
                                    <div class="text-headline-sm text-primary font-bold">@(booking.TotalAmount?.ToString("N0") ?? "0") VNĐ</div>
                                </div>
                            </div>
                            
                            <div class="mt-8 flex flex-wrap gap-stack-md justify-end border-t border-outline-variant/20 pt-6">
                                <a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.BookingId" class="px-6 py-2.5 rounded-lg border border-outline-variant/50 text-on-surface-variant font-label-lg hover:bg-surface-container transition-colors text-center inline-block">Chi tiết</a>
                                
                                @if (booking.BookingStatus == BookingStatus.Reserved)
                                {
                                    <a href="@shareLink" class="px-6 py-2.5 rounded-lg bg-primary-container text-on-primary-container font-label-lg luxury-shadow hover:opacity-90 transition-all flex items-center justify-center gap-2">
                                        <span class="material-symbols-outlined text-[20px]">how_to_reg</span>
                                        Pre-Checkin
                                    </a>
                                }

                                else if (booking.BookingStatus == BookingStatus.CheckedOut)
                                {
                                    <a href="#" class="px-6 py-2.5 rounded-lg border border-primary text-primary font-label-lg hover:bg-primary/5 transition-all flex items-center justify-center gap-2">
                                        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                        Đánh giá
                                    </a>
                                }
                                else if (booking.BookingStatus == BookingStatus.Cancelled || booking.BookingStatus == BookingStatus.NoShow)
                                {
                                    <button disabled class="px-6 py-2.5 rounded-lg border border-outline-variant/30 text-on-surface-variant font-label-lg cursor-not-allowed opacity-70">
                                        Đã xử lý
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const tabs = document.querySelectorAll('.filter-tab');
            const cards = document.querySelectorAll('.booking-card');

            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    // Remove active class from all tabs
                    tabs.forEach(t => {
                        t.classList.remove('tab-active', 'font-bold', 'text-primary', 'border-b-2', 'border-primary');
                        t.classList.add('text-on-surface-variant');
                    });
                    
                    // Add active class to clicked tab
                    tab.classList.add('tab-active', 'font-bold', 'text-primary', 'border-b-2', 'border-primary');
                    tab.classList.remove('text-on-surface-variant');

                    const filter = tab.getAttribute('data-filter');

                    // Filter cards
                    cards.forEach(card => {
                        if (filter === 'all' || card.getAttribute('data-status') === filter) {
                            card.style.display = 'block';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });

            // Atmosphere interaction: Subtle parallax on scroll for luxury cards
            window.addEventListener('scroll', () => {
                const scrolled = window.scrollY;
                cards.forEach((card, index) => {
                    if(card.style.display !== 'none') {
                        const speed = 0.02 + (index * 0.01);
                        // Limit parallax effect to prevent bugs
                        const translateY = Math.min(scrolled * speed * -1, 0); 
                        if(translateY > -50) {
                            // Disabled transform for safer cross-browser layout
                            // card.style.transform = `translateY(${translateY}px)`;
                        }
                    }
                });
            });
        });
    </script>
}
