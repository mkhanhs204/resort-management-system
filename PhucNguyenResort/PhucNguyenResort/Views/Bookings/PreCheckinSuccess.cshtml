@model PhucNguyenResort.Models.Booking

@{
    ViewData["Title"] = "Khai Báo Thành Công - Phuc Nguyen Resort";
}

<style>
    :root {
        --primary: #0f172a;
        --accent: #d4af37;
        --bg: #f8fafc;
    }

    body {
        background-color: var(--bg);
        font-family: 'Inter', sans-serif;
    }

    .success-container {
        padding: 100px 0;
        text-align: center;
    }

    .success-card {
        background: white;
        border-radius: 24px;
        padding: 50px 40px;
        box-shadow: 0 15px 50px rgba(0,0,0,0.05);
        max-width: 600px;
        margin: 0 auto;
        border: 1px solid rgba(0,0,0,0.02);
    }

    .success-icon {
        width: 80px;
        height: 80px;
        background: rgba(34, 197, 94, 0.1);
        color: #22c55e;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        margin: 0 auto 30px;
    }

    .success-card h2 {
        color: var(--primary);
        font-weight: 700;
        margin-bottom: 15px;
    }

    .success-card p {
        color: #64748b;
        font-size: 1.05rem;
        line-height: 1.6;
        margin-bottom: 35px;
    }

    .booking-details-box {
        background: #f8fafc;
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 35px;
        border: 1px solid #e2e8f0;
        text-align: left;
    }

    .booking-details-box h5 {
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 15px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 10px;
    }

    .details-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 0.95rem;
    }

    .details-row span:first-child {
        color: #64748b;
    }

    .details-row span:last-child {
        font-weight: 600;
        color: var(--primary);
    }

    .btn-home {
        background: linear-gradient(135deg, var(--primary), #1e293b);
        color: white;
        border: none;
        padding: 14px 30px;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.15);
    }

    .btn-home:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 20px rgba(15, 23, 42, 0.2);
        color: white;
    }
</style>

<div class="success-container">
    <div class="container">
        <div class="success-card">
            <div class="success-icon">
                <i class="fa fa-check"></i>
            </div>
            <h2>Khai Báo Thành Công!</h2>
            <p>Thông tin lưu trú của quý khách đã được ghi nhận và mã hóa bảo mật trên hệ thống. Lễ tân sẽ xác thực nhanh khi quý khách đến làm thủ tục check-in.</p>

            <div class="booking-details-box">
                <h5>Chi Tiết Đặt Phòng #@Model.BookingId</h5>
                <div class="details-row">
                    <span>Loại phòng</span>
                    <span>@Model.Room?.Category?.CategoryName</span>
                </div>
                <div class="details-row">
                    <span>Số phòng</span>
                    <span>@Model.Room?.RoomNumber</span>
                </div>
                <div class="details-row">
                    <span>Ngày Check-in</span>
                    <span>@Model.CheckInDate.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="details-row">
                    <span>Ngày Check-out</span>
                    <span>@Model.CheckOutDate.ToString("dd/MM/yyyy")</span>
                </div>
            </div>

            <a asp-controller="Home" asp-action="Index" class="btn-home">Quay Lại Trang Chủ</a>
        </div>
    </div>
</div>
