@model PhucNguyenResort.ViewModels.Bookings.PreCheckinViewModel
@using PhucNguyenResort.Enums

@{
    ViewData["Title"] = "Khai Báo Tạm Trú - Phuc Nguyen Resort";
}

<style>
    :root {
        --primary: #0f172a;
        --primary-light: #1e293b;
        --accent: #d4af37;
        --accent-hover: #b8962e;
        --bg: #f8fafc;
        --card-bg: rgba(255, 255, 255, 0.9);
        --text: #334155;
        --text-muted: #64748b;
        --border: #e2e8f0;
    }

    body {
        background-color: var(--bg);
        font-family: 'Inter', sans-serif;
    }

    .precheckin-container {
        padding: 50px 0 100px;
    }

    .header-card {
        background: linear-gradient(135deg, var(--primary), #1e293b);
        color: white;
        border-radius: 20px;
        padding: 40px;
        margin-bottom: 40px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.15);
        position: relative;
        overflow: hidden;
    }

    .header-card::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
        pointer-events: none;
    }

    .header-card h2 {
        color: white;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .header-card p {
        color: rgba(255, 255, 255, 0.8);
        font-size: 1.05rem;
    }

    .booking-summary-badge {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 8px 16px;
        border-radius: 12px;
        font-size: 0.9rem;
        display: inline-block;
        margin-top: 15px;
    }

    .premium-card {
        background: var(--card-bg);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.03);
        margin-bottom: 30px;
    }

    .guest-card {
        border-left: 4px solid var(--accent);
        background: #ffffff;
        padding: 25px;
        border-radius: 15px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        transition: transform 0.2s ease;
    }

    .guest-card:hover {
        transform: translateY(-2px);
    }

    .guest-title {
        font-weight: 600;
        color: var(--primary);
        font-size: 1.15rem;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .guest-title span {
        background: rgba(212, 175, 55, 0.1);
        color: var(--accent-hover);
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8rem;
    }

    .form-group-modern {
        margin-bottom: 20px;
    }

    .form-group-modern label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--primary-light);
        margin-bottom: 8px;
        display: block;
    }

    .form-control-modern {
        width: 100%;
        padding: 12px 16px;
        border-radius: 10px;
        border: 2px solid #e2e8f0;
        background-color: #f8fafc;
        font-size: 0.95rem;
        color: var(--primary);
        transition: all 0.2s ease;
    }

    .form-control-modern:focus {
        outline: none;
        border-color: var(--accent);
        background-color: #fff;
        box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
    }

    .btn-submit-premium {
        background: linear-gradient(135deg, var(--primary), #1e293b);
        color: white;
        border: none;
        padding: 16px 30px;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
        transition: all 0.3s ease;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.15);
    }

    .btn-submit-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(15, 23, 42, 0.25);
    }

    .share-link-box {
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        padding: 15px;
        margin-top: 15px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .share-link-input {
        background: transparent;
        border: none;
        color: var(--primary);
        font-family: monospace;
        font-size: 0.85rem;
        width: 80%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .copy-btn {
        background: var(--accent);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .copy-btn:hover {
        background: var(--accent-hover);
    }
</style>

<div class="breadcrumb-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb-text">
                    <h2>Khai Báo Tạm Trú (Pre-Checkin)</h2>
                    <div class="bt-option">
                        <a asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        <span>Khai Báo Tạm Trú</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="precheckin-container">
    <div class="container">
        <div class="header-card">
            <h2>Đăng Ký Khai Báo Tạm Trú Trực Tuyến</h2>
            <p>Tiết kiệm 90% thời gian làm thủ tục Check-in khi đến Resort bằng cách điền thông tin của các thành viên trong đoàn dưới đây.</p>
            <div class="booking-summary-badge">
                <i class="fa fa-home"></i> Loại phòng: <strong>@Model.CategoryName</strong> &nbsp;|&nbsp; 
                <i class="fa fa-bed"></i> Phòng số: <strong>@Model.RoomNumber</strong> &nbsp;|&nbsp;
                <i class="fa fa-calendar"></i> Lưu trú: <strong>@Model.CheckInDate.ToString("dd/MM/yyyy") - @Model.CheckOutDate.ToString("dd/MM/yyyy")</strong>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 12px;">
                @Html.Raw(TempData["SuccessMessage"])
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="row">
            <div class="col-lg-8">
                <form asp-action="PreCheckin" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius: 12px; font-size: 0.9rem;"></div>
                    <input type="hidden" asp-for="BookingId" />
                    <input type="hidden" name="token" value="@ViewBag.Token" />

                    @for (int i = 0; i < Model.Guests.Count; i++)
                    {
                        var isPrimary = Model.Guests[i].IsPrimaryBooker;
                        <div class="guest-card">
                            <div class="guest-title">
                                <span>Khách #@(i + 1) @(isPrimary ? "(Người đặt phòng chính)" : string.Empty)</span>
                                <input type="hidden" asp-for="Guests[i].IsPrimaryBooker" />
                            </div>

                            <div class="row">
                                <div class="col-md-8">
                                    <div class="form-group-modern">
                                        <label asp-for="Guests[i].FullName">Họ và tên @(isPrimary ? "(Bắt buộc)" : string.Empty)</label>
                                        <input type="text" asp-for="Guests[i].FullName" class="form-control-modern" placeholder="Ví dụ: NGUYEN VAN A" />
                                        <span asp-validation-for="Guests[i].FullName" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group-modern">
                                        <label asp-for="Guests[i].Gender">Giới tính @(isPrimary ? "(Bắt buộc)" : string.Empty)</label>
                                        <select asp-for="Guests[i].Gender" class="form-control-modern">
                                            <option value="">-- Chọn --</option>
                                            <option value="Male">Nam</option>
                                            <option value="Female">Nữ</option>
                                            <option value="Other">Khác</option>
                                        </select>
                                        <span asp-validation-for="Guests[i].Gender" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group-modern">
                                        <label asp-for="Guests[i].DateOfBirth">Ngày sinh @(isPrimary ? "(Bắt buộc)" : string.Empty)</label>
                                        <input type="date" asp-for="Guests[i].DateOfBirth" class="form-control-modern" />
                                        <span asp-validation-for="Guests[i].DateOfBirth" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group-modern">
                                        <label asp-for="Guests[i].PassportNumber">Số CCCD / Hộ chiếu @(isPrimary ? "(Bắt buộc)" : "(Không bắt buộc với TE)")</label>
                                        <input type="text" asp-for="Guests[i].PassportNumber" class="form-control-modern" placeholder="Số định danh" />
                                        <span asp-validation-for="Guests[i].PassportNumber" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group-modern">
                                        <label asp-for="Guests[i].Nationality">Quốc tịch @(isPrimary ? "(Bắt buộc)" : string.Empty)</label>
                                        <input type="text" asp-for="Guests[i].Nationality" class="form-control-modern" placeholder="Ví dụ: Vietnam" />
                                        <span asp-validation-for="Guests[i].Nationality" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="premium-card">
                        <h5 class="mb-3" style="font-weight: 700; color: var(--primary);"><i class="fa fa-shield text-success mr-2"></i> Cam Kết Bảo Vệ Dữ Liệu Cá Nhân</h5>
                        <p style="font-size: 0.9rem; line-height: 1.6; color: var(--text-muted);">
                            Hệ thống tự động mã hóa thông tin CCCD/Hộ chiếu bằng thuật toán bảo mật cao. Số định danh và Ngày sinh sẽ được tự động xóa vĩnh viễn khỏi cơ sở dữ liệu sau <strong>7 ngày</strong> kể từ thời điểm Check-out để đảm bảo tối đa quyền riêng tư của quý khách theo Nghị định 356/2025/NĐ-CP.
                        </p>

                        <div class="d-flex align-items-start mt-3">
                            <input type="checkbox" id="pdpdConsent" name="PdpdConsentChecked" value="true" required="required" data-val="true" data-val-required="Bạn phải đồng ý với điều khoản bảo vệ dữ liệu cá nhân (PDPD)." style="cursor: pointer; width: 20px; height: 20px; margin-top: 3px; accent-color: var(--primary);">
                            <label class="ml-2" for="pdpdConsent" style="font-size: 0.9rem; color: var(--primary-light); cursor: pointer; font-weight: 500;">
                                Tôi xác nhận và đồng ý cho phép Phúc Nguyên Resort lưu trữ & xử lý thông tin cá nhân của các thành viên phục vụ khai báo tạm trú bắt buộc theo Luật Cư trú 2020.
                            </label>
                        </div>
                        <span asp-validation-for="PdpdConsentChecked" class="text-danger small d-block mt-2"></span>
                    </div>

                    <button type="submit" class="btn-submit-premium">Xác Nhận Khai Báo Lưu Trú</button>
                </form>
            </div>

            <div class="col-lg-4">
                <div class="premium-card sticky-top" style="top: 30px;">
                    <h5 style="font-weight: 700; color: var(--primary); margin-bottom: 15px;"><i class="fa fa-share-alt mr-2 text-warning"></i> Gửi Link Cho Người Đi Cùng</h5>
                    <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5;">
                        Bạn có thể copy link bảo mật dưới đây gửi cho các thành viên trong đoàn để họ tự khai báo thông tin cá nhân mà không cần đăng nhập.
                    </p>
                    <div class="share-link-box">
                        <span class="share-link-input">@ViewBag.ShareableLink</span>
                        <button class="copy-btn" onclick="copyLink()">Copy</button>
                    </div>
                    
                    <div class="mt-4 pt-3" style="border-top: 1px solid var(--border);">
                        <h6 style="font-weight: 700; color: var(--primary);"><i class="fa fa-info-circle mr-2 text-info"></i> Lưu ý khi nhận phòng:</h6>
                        <ul class="pl-3 mt-2 small text-muted" style="list-style-type: square; line-height: 1.6;">
                            <li>Mang theo Giấy tờ tùy thân bản gốc (CCCD hoặc Hộ chiếu) để lễ tân đối chiếu nhanh.</li>
                            <li>Thông tin khai báo trực tuyến phải trùng khớp hoàn toàn với giấy tờ tùy thân thực tế.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function copyLink() {
            var linkText = "@Html.Raw(ViewBag.ShareableLink)";
            navigator.clipboard.writeText(linkText).then(function() {
                var btn = document.querySelector('.copy-btn');
                btn.textContent = 'Copied!';
                btn.style.backgroundColor = '#22c55e';
                setTimeout(function() {
                    btn.textContent = 'Copy';
                    btn.style.backgroundColor = 'var(--accent)';
                }, 2000);
            }, function(err) {
                console.error('Could not copy text: ', err);
            });
        }
    </script>
}
