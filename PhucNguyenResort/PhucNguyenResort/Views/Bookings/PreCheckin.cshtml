@model PhucNguyenResort.ViewModels.Bookings.PreCheckinViewModel
@using PhucNguyenResort.Enums

@{
    ViewData["Title"] = "Khai Báo Tạm Trú (Pre-Checkin) | Phúc Nguyên Resort";
    var token = Context.Request.Query["token"].ToString();
    var adults = Model.Guests.Count(g => g.IsPrimaryBooker); // Just guessing how to display
}

<div class="pt-32 pb-section-gap-lg min-h-screen bg-background">
    <div class="max-w-[800px] mx-auto px-margin-mobile md:px-0">
        <!-- Progress Bar -->
        <div class="mb-stack-lg">
            <div class="flex justify-between items-center mb-4">
                <span class="font-label-lg text-label-lg text-primary uppercase tracking-widest">Tiến Độ Pre-Checkin</span>
                <span class="font-label-lg text-label-lg text-outline">Bước 2 / 3</span>
            </div>
            <div class="w-full h-1 bg-surface-container-highest rounded-full overflow-hidden">
                <div class="h-full bg-primary w-[66%] transition-all duration-700 ease-in-out"></div>
            </div>
            <div class="grid grid-cols-3 mt-4 text-center">
                <div class="text-label-sm font-label-sm text-primary">Xác thực</div>
                <div class="text-label-sm font-label-sm text-primary font-bold">Thông tin khách</div>
                <div class="text-label-sm font-label-sm text-outline">Hoàn tất</div>
            </div>
        </div>

        <!-- Header Content -->
        <div class="text-center mb-stack-lg">
            <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-stack-sm">Thông Tin Lưu Trú</h1>
            <p class="text-on-surface-variant max-w-lg mx-auto">Vui lòng cung cấp thông tin để chúng tôi chuẩn bị đón tiếp bạn một cách chu đáo nhất tại khu nghỉ dưỡng.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-error-container text-on-error-container p-4 rounded-xl mb-6">
                <div asp-validation-summary="All" class="text-sm"></div>
            </div>
        }

        <!-- Booking Summary Card -->
        <div class="bg-surface-container-lowest border border-outline-variant/20 p-gutter rounded-xl shadow-sm mb-gutter flex flex-col md:flex-row gap-gutter items-center">
            <div class="w-32 h-32 rounded-lg overflow-hidden shrink-0 bg-surface-container">
                <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Room Category Image" />
            </div>
            <div class="flex-1 text-center md:text-left">
                <h3 class="font-headline-sm text-headline-sm text-on-surface">@Model.CategoryName</h3>
                <div class="flex flex-wrap justify-center md:justify-start gap-4 mt-2">
                    <div class="flex items-center gap-2 text-on-surface-variant">
                        <span class="material-symbols-outlined text-[20px]">calendar_today</span>
                        <span class="text-label-lg">@Model.CheckInDate.ToString("dd MMM") - @Model.CheckOutDate.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="flex items-center gap-2 text-on-surface-variant">
                        <span class="material-symbols-outlined text-[20px]">group</span>
                        <span class="text-label-lg">@Model.Guests.Count Khách</span>
                    </div>
                    <div class="flex items-center gap-2 text-on-surface-variant">
                        <span class="material-symbols-outlined text-[20px]">confirmation_number</span>
                        <span class="text-label-lg font-bold">#PNR-@Model.BookingId.ToString("D5")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Form Section -->
        <form asp-action="PreCheckin" method="post" class="space-y-4" id="preCheckinForm">
            <input type="hidden" asp-for="BookingId" />
            <input type="hidden" name="token" value="@token" />
            <input type="hidden" asp-for="CheckInDate" />
            <input type="hidden" asp-for="CheckOutDate" />
            <input type="hidden" asp-for="CategoryName" />
            <input type="hidden" asp-for="RoomNumber" />

            @for (int i = 0; i < Model.Guests.Count; i++)
            {
                bool isPrimary = Model.Guests[i].IsPrimaryBooker;
                string accordionId = $"guest-{i}";
                string bgClass = isPrimary ? "bg-primary/10 text-primary" : "bg-outline/10 text-outline";
                string titleText = isPrimary ? "Thông Tin Khách Chính" : $"Thông Tin Khách #{i + 1}";
                
                <input type="hidden" asp-for="Guests[i].IsPrimaryBooker" />

                <div class="guest-accordion overflow-hidden border border-outline-variant/20 rounded-xl bg-surface-container-lowest luxury-shadow">
                    <button class="w-full flex items-center justify-between p-gutter hover:bg-surface-container transition-colors" onclick="toggleAccordion('@accordionId')" type="button">
                        <div class="flex items-center gap-4">
                            <span class="@bgClass w-8 h-8 rounded-full flex items-center justify-center font-bold">@(i + 1)</span>
                            <span class="font-headline-sm text-[20px] text-on-surface">@titleText</span>
                        </div>
                        <span class="material-symbols-outlined transition-transform duration-300 @(i == 0 ? "rotate-180" : "")" id="icon-@accordionId">expand_more</span>
                    </button>
                    
                    <div class="@(i == 0 ? "" : "hidden") p-gutter border-t border-outline-variant/20 transition-all duration-300" id="content-@accordionId">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
                            <div class="space-y-1">
                                <label class="text-label-lg text-on-surface-variant">Họ & Tên (Theo giấy tờ)</label>
                                <input asp-for="Guests[i].FullName" class="w-full bg-surface-container-low border-outline-variant/50 rounded-lg p-3 focus:ring-1 focus:ring-primary focus:border-primary outline-none transition-all" placeholder="NGUYEN VAN A" />
                                <span asp-validation-for="Guests[i].FullName" class="text-error text-sm"></span>
                            </div>
                            
                            <div class="space-y-1">
                                <label class="text-label-lg text-on-surface-variant">Giới tính</label>
                                <select asp-for="Guests[i].Gender" asp-items="Html.GetEnumSelectList<GenderType>()" class="w-full bg-surface-container-low border-outline-variant/50 rounded-lg p-3 focus:ring-1 focus:ring-primary focus:border-primary outline-none">
                                    <option value="">Chọn giới tính</option>
                                </select>
                            </div>
                            
                            <div class="space-y-1">
                                <label class="text-label-lg text-on-surface-variant">Ngày Sinh</label>
                                <input asp-for="Guests[i].DateOfBirth" type="date" class="w-full bg-surface-container-low border-outline-variant/50 rounded-lg p-3 focus:ring-1 focus:ring-primary focus:border-primary outline-none" />
                            </div>
                            
                            <div class="space-y-1">
                                <label class="text-label-lg text-on-surface-variant">Quốc Tịch</label>
                                <input asp-for="Guests[i].Nationality" class="w-full bg-surface-container-low border-outline-variant/50 rounded-lg p-3 focus:ring-1 focus:ring-primary focus:border-primary outline-none" placeholder="Việt Nam" />
                            </div>
                            
                            <div class="md:col-span-2 space-y-1">
                                <label class="text-label-lg text-on-surface-variant">Số Hộ Chiếu / CCCD</label>
                                <input asp-for="Guests[i].PassportNumber" class="w-full bg-surface-container-low border-outline-variant/50 rounded-lg p-3 focus:ring-1 focus:ring-primary focus:border-primary outline-none" placeholder="CCCD: 12 số | Hộ chiếu: P1234567" pattern="^(\d{12}|[A-Z]\d{7})$" title="Số CCCD gồm 12 chữ số hoặc Hộ chiếu gồm 1 chữ cái in hoa + 7 chữ số" />
                                <span asp-validation-for="Guests[i].PassportNumber" class="text-error text-sm"></span>
                            </div>
                            
                            @if (!isPrimary)
                            {
                                <p class="md:col-span-2 text-label-sm text-outline italic">Vui lòng điền đầy đủ thông tin bắt buộc tương tự như khách chính.</p>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/20 mt-6 luxury-shadow">
                <label class="flex items-start gap-3 cursor-pointer">
                    <input asp-for="PdpdConsentChecked" type="checkbox" class="mt-1 w-5 h-5 rounded border-outline-variant text-primary focus:ring-primary">
                    <span class="text-body-md text-on-surface-variant">Tôi đồng ý với các điều khoản bảo mật và chính sách khai báo lưu trú của Phúc Nguyên Resort. Vui lòng cho phép chúng tôi lưu trữ thông tin này để đẩy nhanh tiến độ làm thủ tục tại quầy.</span>
                </label>
                <span asp-validation-for="PdpdConsentChecked" class="text-error text-sm block mt-2"></span>
            </div>

            <!-- CTA -->
            <div class="pt-stack-lg flex flex-col md:flex-row gap-gutter">
                <a href="@Url.Action("MyBookings", "Bookings")" class="flex-1 py-4 border border-outline-variant/50 rounded-lg text-on-surface font-label-lg text-label-lg hover:bg-surface-container transition-all text-center">
                    Lưu tạm
                </a>
                <button type="submit" class="flex-[2] py-4 bg-primary-container text-on-primary-container rounded-lg font-headline-sm text-[18px] font-bold shadow-lg shadow-primary-container/20 hover:scale-[1.02] active:scale-95 transition-all flex justify-center items-center gap-2">
                    <span class="material-symbols-outlined">how_to_reg</span>
                    Xác Nhận Pre-Checkin
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleAccordion(id) {
            const content = document.getElementById(`content-${id}`);
            const icon = document.getElementById(`icon-${id}`);
            
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                icon.classList.add('rotate-180');
            } else {
                content.classList.add('hidden');
                icon.classList.remove('rotate-180');
            }
        }

    </script>
}
