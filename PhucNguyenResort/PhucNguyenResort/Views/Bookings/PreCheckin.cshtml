@model PhucNguyenResort.ViewModels.Bookings.PreCheckinViewModel
@using PhucNguyenResort.Enums

@{
    ViewData["Title"] = "Khai Báo Tạm Trú - Phuc Nguyen Resort";
}

@section Styles {
    <link rel="stylesheet" href="~/css/booking-precheckin.css" />
}

<div class="breadcrumb-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb-text">
                    <h2>Khai Báo Tạm Trú (Pre-Checkin)</h2>
                    <div class="bt-option">
                        <a asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        <span>Khai Báo Tạm Trú</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="precheckin-container">
    <div class="container">
        <div class="header-card">
            <h2>Đăng Ký Khai Báo Tạm Trú Trực Tuyến</h2>
            <p>Tiết kiệm 90% thời gian làm thủ tục Check-in khi đến Resort bằng cách điền thông tin của các thành viên trong đoàn dưới đây.</p>
            <div class="booking-summary-badge">
                <i class="fa fa-home"></i> Loại phòng: <strong>@Model.CategoryName</strong> &nbsp;|&nbsp; 
                <i class="fa fa-bed"></i> Phòng số: <strong>@Model.RoomNumber</strong> &nbsp;|&nbsp;
                <i class="fa fa-calendar"></i> Lưu trú: <strong>@Model.CheckInDate.ToString("dd/MM/yyyy") - @Model.CheckOutDate.ToString("dd/MM/yyyy")</strong>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 12px;">
                @Html.Raw(TempData["SuccessMessage"])
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="row">
            <div class="col-lg-8">
                <form asp-action="PreCheckin" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius: 12px; font-size: 0.9rem;"></div>
                    <input type="hidden" asp-for="BookingId" />
                                     <div class="accordion" id="guestAccordion">
                        @for (int i = 0; i < Model.Guests.Count; i++)
                        {
                            var isPrimary = Model.Guests[i].IsPrimaryBooker;
                            <div class="guest-card @(isPrimary ? "primary-guest" : "")">
                                <div class="guest-card-header @(i == 0 ? "" : "collapsed")" data-toggle="collapse" data-target="#collapseGuest-@i" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="collapseGuest-@i" style="cursor: pointer;">
                                    <div class="guest-title">
                                        <span class="guest-number-circle mr-2">@(i + 1)</span>
                                        <span id="guest-name-summary-@i" class="guest-name-text">
                                            @(string.IsNullOrWhiteSpace(Model.Guests[i].FullName) ? $"Khách #{i + 1}" : Model.Guests[i].FullName)
                                        </span>
                                        @if (isPrimary)
                                        {
                                            <span class="guest-badge primary ml-2">Trưởng đoàn</span>
                                        }
                                        else
                                        {
                                            <span class="guest-badge ml-2">Thành viên</span>
                                        }
                                    </div>
                                    <input type="hidden" asp-for="Guests[i].IsPrimaryBooker" />
                                    <div class="d-flex align-items-center">
                                        <span class="guest-summary-info mr-3 d-none d-sm-inline-block text-muted small" id="guest-info-summary-@i" style="font-size: 0.85rem; font-weight: 500;">
                                            @(Model.Guests[i].Gender.HasValue ? (Model.Guests[i].Gender.Value == GenderType.Male ? "Nam" : (Model.Guests[i].Gender.Value == GenderType.Female ? "Nữ" : "Khác")) : "")
                                            @(!string.IsNullOrWhiteSpace(Model.Guests[i].PassportNumber) ? $" - CCCD/HC: {Model.Guests[i].PassportNumber}" : "")
                                        </span>
                                        <i class="fa fa-chevron-down accordion-arrow"></i>
                                    </div>
                                </div>

                                <div id="collapseGuest-@i" class="collapse @(i == 0 ? "show" : "")" aria-labelledby="guestHeading-@i" data-parent="#guestAccordion">
                                    <div class="guest-card-body pt-3">
                                        <div class="row">
                                            <div class="col-md-8">
                                                <div class="form-group-modern">
                                                    <label asp-for="Guests[i].FullName">Họ và tên @(isPrimary ? "(Bắt buộc)" : string.Empty)</label>
                                                    <input type="text" asp-for="Guests[i].FullName" class="form-control-modern" placeholder="Ví dụ: NGUYEN VAN A" />
                                                    <span asp-validation-for="Guests[i].FullName" class="text-danger small"></span>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group-modern">
                                                    <label asp-for="Guests[i].Gender">Giới tính @(isPrimary ? "(Bắt buộc)" : string.Empty)</label>
                                                    <select asp-for="Guests[i].Gender" class="form-control-modern">
                                                        <option value="">-- Chọn --</option>
                                                        <option value="Male">Nam</option>
                                                        <option value="Female">Nữ</option>
                                                        <option value="Other">Khác</option>
                                                    </select>
                                                    <span asp-validation-for="Guests[i].Gender" class="text-danger small"></span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-group-modern">
                                                    <label asp-for="Guests[i].DateOfBirth">Ngày sinh @(isPrimary ? "(Bắt buộc)" : string.Empty)</label>
                                                    <input type="date" asp-for="Guests[i].DateOfBirth" class="form-control-modern" />
                                                    <span asp-validation-for="Guests[i].DateOfBirth" class="text-danger small"></span>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group-modern">
                                                    <label asp-for="Guests[i].PassportNumber">Số CCCD / Hộ chiếu @(isPrimary ? "(Bắt buộc)" : "(Không bắt buộc với TE)")</label>
                                                    <input type="text" asp-for="Guests[i].PassportNumber" class="form-control-modern" placeholder="Số định danh" />
                                                    <span asp-validation-for="Guests[i].PassportNumber" class="text-danger small"></span>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group-modern">
                                                    <label asp-for="Guests[i].Nationality">Quốc tịch @(isPrimary ? "(Bắt buộc)" : string.Empty)</label>
                                                    <input type="text" asp-for="Guests[i].Nationality" class="form-control-modern" placeholder="Ví dụ: Vietnam" />
                                                    <span asp-validation-for="Guests[i].Nationality" class="text-danger small"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="premium-card">
                        <h5 class="mb-3" style="font-weight: 700; color: var(--primary);"><i class="fa fa-shield text-success mr-2"></i> Cam Kết Bảo Vệ Dữ Liệu Cá Nhân</h5>
                        <p style="font-size: 0.9rem; line-height: 1.6; color: var(--text-muted);">
                            Hệ thống tự động mã hóa thông tin CCCD/Hộ chiếu bằng thuật toán bảo mật cao. Số định danh và Ngày sinh sẽ được tự động xóa vĩnh viễn khỏi cơ sở dữ liệu sau <strong>7 ngày</strong> kể từ thời điểm Check-out để đảm bảo tối đa quyền riêng tư của quý khách theo Nghị định 356/2025/NĐ-CP.
                        </p>

                        <div class="d-flex align-items-start mt-3">
                            <input type="checkbox" id="pdpdConsent" name="PdpdConsentChecked" value="true" required="required" data-val="true" data-val-required="Bạn phải đồng ý với điều khoản bảo vệ dữ liệu cá nhân (PDPD)." data-msg-required="Bạn phải đồng ý với điều khoản bảo vệ dữ liệu cá nhân (PDPD)." style="cursor: pointer; width: 20px; height: 20px; margin-top: 3px; accent-color: var(--primary);">
                            <label class="ml-2" for="pdpdConsent" style="font-size: 0.9rem; color: var(--primary-light); cursor: pointer; font-weight: 500;">
                                Tôi xác nhận và đồng ý cho phép Phúc Nguyên Resort lưu trữ & xử lý thông tin cá nhân của các thành viên phục vụ khai báo tạm trú bắt buộc theo Luật Cư trú 2020.
                            </label>
                        </div>
                        <span asp-validation-for="PdpdConsentChecked" class="text-danger small d-block mt-2"></span>
                    </div>

                    <button type="submit" class="btn-submit-premium">Xác Nhận Khai Báo Lưu Trú</button>
                </form>
            </div>

            <div class="col-lg-4">
                <div class="premium-card sticky-top" style="top: 30px;">
                        <h6 style="font-weight: 700; color: var(--primary);"><i class="fa fa-info-circle mr-2 text-info"></i> Lưu ý khi nhận phòng:</h6>
                        <ul class="pl-3 mt-2 small text-muted" style="list-style-type: square; line-height: 1.6;">
                            <li>Mang theo Giấy tờ tùy thân bản gốc (CCCD hoặc Hộ chiếu) để lễ tân đối chiếu nhanh.</li>
                            <li>Thông tin khai báo trực tuyến phải trùng khớp hoàn toàn với giấy tờ tùy thân thực tế.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Live update guest name in accordion header
            $('input[id^="Guests_"][id$="__FullName"]').on('input', function () {
                var id = $(this).attr('id');
                var index = id.split('_')[1];
                var val = $(this).val().trim();
                $('#guest-name-summary-' + index).text(val ? val : 'Khách #' + (parseInt(index) + 1));
            });

            // Live update guest gender and passport number in accordion header
            $('select[id^="Guests_"][id$="__Gender"], input[id^="Guests_"][id$="__PassportNumber"]').on('change input', function () {
                var id = $(this).attr('id');
                var index = id.split('_')[1];
                
                var genderVal = $('#Guests_' + index + '__Gender').val();
                var genderText = "";
                if (genderVal === "Male") genderText = "Nam";
                else if (genderVal === "Female") genderText = "Nữ";
                else if (genderVal === "Other") genderText = "Khác";

                var passportVal = $('#Guests_' + index + '__PassportNumber').val().trim();
                var passportText = passportVal ? " - CCCD/HC: " + passportVal : "";

                $('#guest-info-summary-' + index).text(genderText + passportText);
            });
        });
    </script>
}
