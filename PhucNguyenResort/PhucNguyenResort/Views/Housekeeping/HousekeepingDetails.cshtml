@using PhucNguyenResort.Enums
@model List<PhucNguyenResort.ViewModels.Housekeeping.DirtyRoomViewModel>
@{
    ViewData["Title"] = "Housekeeping Queue";
    Layout = "_DashboardLayout";
    
    string currentStaff = User.Identity?.Name ?? "Unknown Staff";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528; /* primary */
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b; /* on-surface-variant */
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 24px;
            margin-bottom: 30px;
        }
        .luxury-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        .luxury-table thead th {
            background-color: #f6f3ef; /* surface-container-low */
            color: #50453b;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 16px;
            border: none;
        }
        .luxury-table thead th:first-child { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
        .luxury-table thead th:last-child { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
        .luxury-table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-bottom: 1px solid #f0ede9;
            color: #1c1c1a;
            font-size: 14px;
        }
        .luxury-table tbody tr:last-child td { border-bottom: none; }
        .luxury-table tbody tr:hover { background-color: #fcf9f5; }
        
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        .stat-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            height: 100%;
            border-top: 4px solid transparent;
            padding: 24px;
        }
        .stat-card-red { border-top-color: #ba1a1a; }
        .stat-card-yellow { border-top-color: #dfa974; }
        .stat-card-green { border-top-color: #0b5c2d; }
        
        .stat-icon {
            font-size: 32px;
            margin-bottom: 8px;
        }
        .stat-card-red .stat-icon { color: #ba1a1a; }
        .stat-card-yellow .stat-icon { color: #dfa974; }
        .stat-card-green .stat-icon { color: #0b5c2d; }
        
        .stat-value {
            font-family: 'Playfair Display', serif;
            font-size: 32px;
            font-weight: 700;
            color: #1c1c1a;
            margin: 8px 0;
        }
        .stat-label {
            font-family: 'Inter', sans-serif;
            font-size: 16px;
            font-weight: 600;
            color: #50453b;
        }
        
        .btn-luxury {
            background-color: #dfa974;
            color: #633d11;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 8px 16px;
            border: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
            cursor: pointer;
        }
        .btn-luxury:hover {
            background-color: #805528;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2);
            text-decoration: none;
        }
        
        .btn-luxury-success { background-color: #e2f5ea; color: #0b5c2d; }
        .btn-luxury-success:hover { background-color: #0b5c2d; color: #ffffff; }
        .btn-luxury-outline { background-color: transparent; border: 1px solid #d4c3b6; color: #50453b; }
        .btn-luxury-outline:hover { background-color: #f6f3ef; color: #ba1a1a; border-color: #ba1a1a; }
        
        .luxury-badge {
            background-color: #f0ede9;
            color: #50453b;
            font-weight: 600;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .luxury-badge.yellow { background-color: #fef5e7; color: #805528; border: 1px solid #f6e3c5; }
        .luxury-badge.red { background-color: #ffdad6; color: #ba1a1a; border: 1px solid #ffb4ab; }
        
        .form-control-luxury {
            background-color: #f6f3ef;
            border: 1px solid transparent;
            border-radius: 8px;
            padding: 10px 16px;
            font-family: 'Inter', sans-serif;
            color: #1c1c1a;
            width: 100%;
        }
        .form-control-luxury:focus {
            border-color: #805528;
            box-shadow: 0 0 0 2px rgba(128, 85, 40, 0.2);
            background-color: #ffffff;
            outline: none;
        }
        .luxury-alert {
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: 'Inter', sans-serif;
            border: none;
        }
        .luxury-alert.success { background-color: #e2f5ea; color: #0b5c2d; }
        .luxury-alert.error { background-color: #ffdad6; color: #93000a; }
    </style>
}

@if (ViewBag.LocalSuccessMessage != null)
{
    <div class="luxury-alert success alert-dismissible fade show" role="alert" id="alert-success">
        <span class="material-symbols-outlined fill">check_circle</span>
        <div>@ViewBag.LocalSuccessMessage</div>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close" style="background: none; border: none; margin-left: auto; color: inherit; cursor: pointer;">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
}
@if (ViewBag.LocalErrorMessage != null)
{
    <div class="luxury-alert error alert-dismissible fade show" role="alert" id="alert-error">
        <span class="material-symbols-outlined fill">error</span>
        <div>@ViewBag.LocalErrorMessage</div>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close" style="background: none; border: none; margin-left: auto; color: inherit; cursor: pointer;">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
}

<div class="header-container">
    <div>
        <h2 class="page-title">
            <span class="material-symbols-outlined" style="font-size: 36px; color: #805528; margin-right: 8px;">cleaning_services</span> 
            Hàng chờ làm vệ sinh
        </h2>
        <div class="page-subtitle">Danh sách phòng bẩn khẩn cấp cần dọn dẹp và xử lý sự cố thiết bị.</div>
    </div>
    <div style="font-family: 'Inter', sans-serif; color: #50453b; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined">calendar_today</span>
        <span>@DateTime.Now.ToString("dd MMMM, yyyy")</span>
    </div>
</div>


<div class="luxury-card">
    <div class="row mb-4 align-items-center">
        <div class="col-md-5 mb-2 mb-md-0">
            <div style="display: flex; align-items: center; gap: 10px; background-color: #f6f3ef; border-radius: 8px; padding: 0 16px;">
                <span class="material-symbols-outlined" style="color: #827569;">search</span>
                <input type="text" id="searchRoomInput" style="border: none; background: transparent; padding: 10px 0; width: 100%; outline: none; font-family: 'Inter', sans-serif; color: #1c1c1a;" placeholder="Nhập số phòng cần tìm... (Ví dụ: 101)">
            </div>
        </div>
        <div class="col-md-3 mb-2 mb-md-0">
            <select id="filterFloorSelect" class="form-control-luxury">
                <option value="">-- Tất cả các tầng --</option>
                @foreach (var floor in Model.Select(m => m.FloorNumber).Distinct().OrderBy(f => f))
                {
                    <option value="Tầng @floor">Tầng @floor</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <select id="filterStatusSelect" class="form-control-luxury">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Needs Cleaning">Chờ tiếp nhận</option>
                <option value="In Progress">Đang dọn dẹp</option>
            </select>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 600; color: #1c1c1a; margin: 0; display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined" style="color: #805528;">list_alt</span> Danh sách phòng chờ xử lý
        </h5>
        <span style="font-family: 'Inter', sans-serif; font-size: 13px; color: #827569;">
            Nhân viên bấm "Bắt đầu dọn" trước khi vào dọn phòng và "Hoàn tất" khi hoàn thành.
        </span>
    </div>

    <div style="overflow-x: auto;">
        <table class="luxury-table">
            <thead>
                <tr>
                    <th>Số Phòng</th>
                    <th>Hạng Phòng</th>
                    <th>Lý Do / Chi Tiết</th>
                    <th>Trạng Thái</th>
                    <th style="text-align: center; width: 290px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var room in Model)
                    {
                        bool isAssigned = !string.IsNullOrEmpty(room.AssignedStaffName);
                        bool isMyJob = isAssigned && room.AssignedStaffName == currentStaff;

                        <tr class="dirty-room-row" data-room-number="@room.RoomNumber" data-floor="Tầng @room.FloorNumber" data-status="@(room.Status == RoomStatus.CleaningInProgress ? "In Progress" : "Needs Cleaning")">
                            <td><strong style="color: #1c1c1a; font-size: 15px;">Phòng @room.RoomNumber</strong></td>
                            <td>@room.RoomType</td>
                            <td>
                                <span style="display: block; color: #1c1c1a; font-weight: 500;">@room.DirtyReason</span>
                                @if (room.LastCheckedOutTime.HasValue)
                                {
                                    <small style="color: #827569; display: flex; align-items: center; gap: 4px; margin-top: 4px;">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">logout</span>
                                        Trả phòng: @room.LastCheckedOutTime.Value.ToString("g")
                                    </small>
                                }
                            </td>
                            
                            <td>
                                @if (room.Status == RoomStatus.CleaningInProgress)
                                {
                                    <span class="luxury-badge yellow">
                                        <span class="material-symbols-outlined" style="font-size: 16px; animation: spin 2s linear infinite;">sync</span> 
                                        Đang dọn (@(room.AssignedStaffName ?? "Ẩn danh"))
                                    </span>
                                }
                                else
                                {
                                    <span class="luxury-badge red">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">schedule</span> 
                                        Chờ tiếp nhận
                                    </span>
                                }
                            </td>
                            
                            <td style="text-align: center;">
                                <div style="display: flex; justify-content: center; align-items: center; gap: 8px;">
                                    @if (!isAssigned)
                                    {
                                        <form asp-controller="Housekeeping" asp-action="StartCleaning" method="post" style="margin: 0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="roomId" value="@room.RoomId" />
                                            <button type="submit" class="btn-luxury">
                                                <span class="material-symbols-outlined" style="font-size: 18px;">play_arrow</span> Bắt đầu dọn
                                            </button>
                                        </form>

                                        <button type="button" class="btn-luxury btn-luxury-outline" data-toggle="modal" data-target="#maintenanceModal-@room.RoomId">
                                            <span class="material-symbols-outlined" style="font-size: 18px;">build</span> Báo lỗi
                                        </button>
                                    }
                                    else if (isMyJob)
                                    {
                                        <form asp-controller="Housekeeping" asp-action="MarkCleaned" method="post" style="margin: 0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="roomId" value="@room.RoomId" />
                                            <button type="submit" class="btn-luxury btn-luxury-success">
                                                <span class="material-symbols-outlined" style="font-size: 18px;">check</span> Hoàn tất
                                            </button>
                                        </form>

                                        <button type="button" class="btn-luxury btn-luxury-outline" data-toggle="modal" data-target="#maintenanceModal-@room.RoomId">
                                            <span class="material-symbols-outlined" style="font-size: 18px;">build</span> Báo lỗi
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-luxury" disabled style="background-color: #f0ede9; color: #a4b5ce; border: none; cursor: not-allowed; width: 100%;">
                                            <span class="material-symbols-outlined" style="font-size: 18px;">lock</span> Đang dọn bởi @room.AssignedStaffName
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>

                        if (!isAssigned || isMyJob)
                        {
                            <div class="modal fade" id="maintenanceModal-@room.RoomId" tabindex="-1" role="dialog" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered" role="document">
                                    <div class="modal-content" style="font-family: 'Inter', sans-serif; border-radius: 12px; border: none; overflow: hidden;">
                                        <div class="modal-header" style="background-color: #ffdad6; border-bottom: none;">
                                            <h5 class="modal-title" style="font-family: 'Playfair Display', serif; font-weight: 700; color: #93000a; display: flex; align-items: center; gap: 8px;">
                                                <span class="material-symbols-outlined">build</span> Báo Sự Cố — Phòng @room.RoomNumber
                                            </h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: #93000a;">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <form asp-controller="Housekeeping" asp-action="ReportMaintenance" method="post" class="mb-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="roomId" value="@room.RoomId" />
                                            <div class="modal-body text-left" style="padding: 24px;">
                                                <p style="font-size: 14px; color: #50453b; margin-bottom: 16px;">Hãy mô tả chi tiết sự cố hỏng hóc hoặc thiết bị lỗi tại phòng này để gửi lệnh sửa chữa đến tổ kỹ thuật Bảo trì.</p>
                                                <div class="form-group mb-0">
                                                    <label style="font-weight: 600; color: #1c1c1a; margin-bottom: 8px;">Mô tả sự cố / Hỏng hóc:</label>
                                                    <textarea name="description" class="form-control-luxury" rows="4" required 
                                                              placeholder="Ví dụ: Điều hòa chảy nước, vòi sen tắm gãy vòi, hỏng ổ cắm điện đầu giường..."></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer" style="border-top: 1px solid #f0ede9; padding: 16px 24px;">
                                                <button type="button" class="btn-luxury btn-luxury-outline" style="border: none;" data-dismiss="modal">Hủy</button>
                                                <button type="submit" class="btn-luxury" style="background-color: #ba1a1a; color: #ffffff;">Gửi yêu cầu</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align: center; padding: 60px 20px; color: #827569;">
                            <span class="material-symbols-outlined" style="font-size: 48px; color: #0b5c2d; margin-bottom: 16px; display: block;">check_circle</span>
                            <h5 style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 600; color: #1c1c1a; margin-bottom: 8px;">Tất cả các phòng đã sạch sẽ!</h5>
                            <p style="font-size: 15px; margin: 0;">Hiện tại không có phòng nào nằm trong hàng chờ làm vệ sinh.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <style>
        @@keyframes spin { 
            100% { transform: rotate(360deg); } 
        }
    </style>
    <script>
        $(document).ready(function () {
            function filterRooms() {
                var searchText = $("#searchRoomInput").val().toLowerCase().trim();
                var selectedFloor = $("#filterFloorSelect").val();
                var selectedStatus = $("#filterStatusSelect").val();

                $(".dirty-room-row").each(function () {
                    var roomNumber = $(this).data("room-number").toString().toLowerCase();
                    var roomFloor = $(this).data("floor");
                    var roomStatus = $(this).data("status");

                    var matchesSearch = roomNumber.indexOf(searchText) > -1;
                    var matchesFloor = selectedFloor === "" || roomFloor === selectedFloor;
                    var matchesStatus = selectedStatus === "" || roomStatus === selectedStatus;

                    if (matchesSearch && matchesFloor && matchesStatus) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            $("#searchRoomInput").on("keyup", filterRooms);
            $("#filterFloorSelect").on("change", filterRooms);
            $("#filterStatusSelect").on("change", filterRooms);
            
            // Auto dismiss alerts
            setTimeout(function () {
                var alerts = document.querySelectorAll('#alert-success, #alert-error');
                alerts.forEach(function (el) {
                    if (el) {
                        el.style.transition = "opacity 0.5s ease";
                        el.style.opacity = "0";
                        setTimeout(() => el.remove(), 500);
                    }
                });
            }, 4000);
            
            document.querySelectorAll('.luxury-alert .close').forEach(btn => {
                btn.addEventListener('click', function() {
                    var alert = this.closest('.luxury-alert');
                    alert.style.transition = "opacity 0.3s ease";
                    alert.style.opacity = "0";
                    setTimeout(() => alert.remove(), 300);
                });
            });
        });
    </script>
}