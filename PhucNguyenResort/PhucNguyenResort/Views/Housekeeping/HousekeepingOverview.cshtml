@model List<PhucNguyenResort.ViewModels.Housekeeping.DirtyRoomViewModel>
@using PhucNguyenResort.Enums
@{
    ViewData["Title"] = "Housekeeping Overview";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title { font-family: 'Playfair Display', serif; font-size: 36px; font-weight: 700; color: #805528; margin-bottom: 4px; }
        .page-subtitle { font-family: 'Inter', sans-serif; color: #50453b; font-size: 16px; margin-bottom: 32px; }
        
        /* KPI Cards */
        .kpi-card { background: #ffffff; border-radius: 16px; padding: 24px; box-shadow: 0 12px 24px -8px rgba(30, 41, 59, 0.05); border: 1px solid rgba(212, 195, 182, 0.3); font-family: 'Inter', sans-serif; height: 100%; display: flex; align-items: center; transition: all 0.3s ease; }
        .kpi-card:hover { transform: translateY(-4px); box-shadow: 0 20px 32px -8px rgba(30, 41, 59, 0.1); }
        .kpi-icon-wrapper { width: 56px; height: 56px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-right: 20px; flex-shrink: 0; }
        .kpi-icon-wrapper.primary { background-color: #f6f3ef; color: #805528; }
        .kpi-icon-wrapper.success { background-color: #e2f5ea; color: #0b5c2d; }
        .kpi-icon-wrapper.warning { background-color: #fff8e6; color: #946c00; }
        .kpi-icon-wrapper.danger { background-color: #ffdad6; color: #ba1a1a; }
        .kpi-details h3 { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 700; color: #1c1c1a; margin-bottom: 4px; }
        .kpi-details p { color: #50453b; font-size: 14px; font-weight: 500; margin-bottom: 0; }
        
        /* Section styling */
        .section-header { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: #805528; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
        .action-card { background: #ffffff; border-radius: 16px; padding: 24px; box-shadow: 0 12px 24px -8px rgba(30, 41, 59, 0.05); border: 1px solid rgba(212, 195, 182, 0.3); font-family: 'Inter', sans-serif; height: 100%; }
        
        /* Table */
        .table-luxury { background: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid rgba(212, 195, 182, 0.3); font-family: 'Inter', sans-serif; margin-bottom: 16px; }
        .table-luxury table { width: 100%; border-collapse: collapse; margin-bottom: 0; }
        .table-luxury th { background-color: #fcf9f5; color: #805528; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; padding: 16px; border-bottom: 2px solid rgba(212, 195, 182, 0.3); text-align: left; }
        .table-luxury td { padding: 16px; border-bottom: 1px solid #f0ede9; color: #1c1c1a; font-size: 14px; vertical-align: middle; }
        .table-luxury tbody tr:hover { background-color: #faf8f5; }
        .table-luxury tbody tr:last-child td { border-bottom: none; }
        
        .btn-outline-luxury { background-color: transparent; color: #805528; border: 1.5px solid #dfa974; font-family: 'Inter', sans-serif; font-weight: 600; border-radius: 8px; padding: 6px 16px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.3s ease; text-decoration: none; font-size: 14px; }
        .btn-outline-luxury:hover { background-color: #f6f3ef; color: #633d11; text-decoration: none; }
        .btn-luxury { background-color: #dfa974; color: #633d11; font-family: 'Inter', sans-serif; font-weight: 600; border-radius: 8px; padding: 10px 24px; border: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.3s ease; text-decoration: none; width: 100%; }
        .btn-luxury:hover:not(:disabled) { background-color: #805528; color: #ffffff; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2); text-decoration: none; }
        
        .status-badge { display: inline-flex; align-items: center; padding: 6px 12px; border-radius: 20px; font-size: 13px; font-weight: 600; }
        .status-badge.primary { background-color: #f6f3ef; color: #805528; }
        .status-badge.danger { background-color: #ffdad6; color: #ba1a1a; }
        .status-badge.warning { background-color: #fff8e6; color: #946c00; }
        .status-badge.success { background-color: #e2f5ea; color: #0b5c2d; }
        
        .material-symbols-outlined { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; font-size: 24px; vertical-align: middle; }
    </style>
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h2 class="page-title">Buồng Phòng — Tổng Quan</h2>
        <p class="page-subtitle">Tổng quan hiệu suất công việc và thông báo vận hành trong ngày.</p>
    </div>
    <div class="page-subtitle" style="margin-bottom: 8px;">
        <span class="material-symbols-outlined" style="font-size: 18px; margin-right: 4px;">calendar_today</span>
        @DateTime.Now.ToString("dd MMMM, yyyy")
    </div>
</div>

<!-- KPI Cards -->
<div class="row mb-5">
    <div class="col-lg-4 col-md-6 mb-3 mb-lg-0">
        <div class="kpi-card">
            <div class="kpi-icon-wrapper danger">
                <span class="material-symbols-outlined">warning</span>
            </div>
            <div class="kpi-details">
                <h3>@ViewData["RoomsNeedCleaningCount"]</h3>
                <p>Phòng Cần Dọn</p>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6 mb-3 mb-lg-0">
        <div class="kpi-card">
            <div class="kpi-icon-wrapper primary">
                <span class="material-symbols-outlined">sync</span>
            </div>
            <div class="kpi-details">
                <h3>@ViewData["CurrentlyCleaningCount"]</h3>
                <p>Đang Dọn Dẹp</p>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6 mb-3 mb-lg-0">
        <div class="kpi-card">
            <div class="kpi-icon-wrapper success">
                <span class="material-symbols-outlined">check_circle</span>
            </div>
            <div class="kpi-details">
                <h3>@ViewData["CleanedTodayCount"]</h3>
                <p>Đã Dọn Hôm Nay</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="action-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="section-header mb-0">
                    <span class="material-symbols-outlined">cleaning_services</span> Các Phòng Cần Dọn Dẹp
                </h5>
                <div style="font-family: 'Inter', sans-serif;">
                    <span class="status-badge danger" style="margin-right: 8px;">@(Model?.Count(t => t.Status == RoomStatus.NeedsCleaning) ?? 0) Cần Dọn Ngay</span>
                    <span class="status-badge warning">@(Model?.Count(t => t.Status == RoomStatus.CleaningInProgress) ?? 0) Đang Dọn Dẹp</span>
                </div>
            </div>
            
            <div class="table-luxury">
                <table>
                    <thead>
                        <tr>
                            <th>Số Phòng</th>
                            <th>Lý Do Dọn Dẹp</th>
                            <th>Trạng Thái</th>
                            <th>Nhân Viên</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 24px; color: #a4b5ce;">
                                    Hiện tại không có phòng nào cần dọn dẹp.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var room in Model.OrderBy(r => r.Status == RoomStatus.NeedsCleaning ? 0 : 1).Take(5))
                            {
                                <tr>
                                    <td style="font-weight: 600;">
                                        Phòng @room.RoomNumber
                                        <div style="font-size: 13px; color: #827569; font-weight: 400;">@room.RoomType</div>
                                    </td>
                                    <td>
                                        <div style="font-weight: 500; color: #1c1c1a;">@room.DirtyReason</div>
                                        @if (room.LastCheckedOutTime.HasValue)
                                        {
                                            <div style="font-size: 13px; color: #827569;">Lúc @room.LastCheckedOutTime.Value.ToString(@"HH\:mm")</div>
                                        }
                                    </td>
                                    <td>
                                        @if (room.Status == RoomStatus.NeedsCleaning)
                                        {
                                            <span class="status-badge danger">Cần Dọn</span>
                                        }
                                        else if (room.Status == RoomStatus.CleaningInProgress)
                                        {
                                            <span class="status-badge warning">Đang Dọn</span>
                                        }
                                    </td>
                                    <td>
                                        @if (string.IsNullOrEmpty(room.AssignedStaffName))
                                        {
                                            <span style="color: #827569; font-size: 14px;">Chưa phân công</span>
                                        }
                                        else
                                        {
                                            <span style="font-weight: 500; color: #50453b;">@room.AssignedStaffName</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="text-right mt-3" style="text-align: right;">
                <a asp-controller="Housekeeping" asp-action="Details" class="btn-outline-luxury">
                    Xem tất cả <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="action-card">
            <h5 class="section-header mb-4">
                <span class="material-symbols-outlined">campaign</span> Lưu Ý Vận Hành Hôm Nay
            </h5>
            
            <div class="list-group list-group-flush" style="font-family: 'Inter', sans-serif;">
                <div class="list-group-item px-0 py-3" style="border-bottom: 1px solid #f0ede9;">
                    <span class="status-badge warning mb-2">Lễ tân thông báo</span>
                    <p class="mb-1" style="font-size: 15px; font-weight: 600; color: #1c1c1a; margin-top: 8px;">Hôm nay có đoàn khách VIP 15 phòng trả phòng sớm lúc 10:00 AM.</p>
                    <div style="font-size: 14px; color: #50453b;">Yêu cầu tổ buồng phòng tập trung dọn gấp tầng 3 và tầng 4 ngay khi khách trả phòng để kịp chuẩn bị set-up đón đoàn tiếp theo.</div>
                </div>
                <div class="list-group-item px-0 py-3" style="border-bottom: none;">
                    <span class="status-badge danger mb-2">Khẩn cấp</span>
                    <p class="mb-1" style="font-size: 15px; font-weight: 600; color: #1c1c1a; margin-top: 8px;">Kiểm tra kỹ hệ thống mini-bar tại các phòng Khu biệt thự Villa.</p>
                    <div style="font-size: 14px; color: #50453b;">Ghi nhận chính xác số lượng nước ngọt/rượu sử dụng để bàn giao dữ liệu cho bộ phận thu ngân tính tiền folio khi khách trả phòng.</div>
                </div>
            </div>
            
        </div>
    </div>
</div>