@using PhucNguyenResort.Enums
@model IReadOnlyList<PhucNguyenResort.ViewModels.TableReservations.TableReservationListViewModel>

@{
    ViewData["Title"] = "Lịch sử đặt bàn";
}

@section Styles {
    <style>
        body { background-color: #fcf9f5 !important; }
        .tap-highlight-transparent { -webkit-tap-highlight-color: transparent; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .active-tab {
            color: #805528;
            border-bottom: 2px solid #805528;
        }
    </style>
}

<div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-stack-lg min-h-screen">
    <!-- Page Title -->
    <div class="mb-stack-lg text-center md:text-left">
        <nav class="flex items-center justify-center md:justify-start gap-2 mb-4 text-on-surface-variant font-label-sm uppercase tracking-widest">
            <a asp-action="Search" class="hover:text-primary transition-colors">Nhà hàng</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-primary">Lịch sử đặt bàn</span>
        </nav>
        <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-2">Lịch sử đặt bàn</h1>
        <p class="font-body-md text-on-surface-variant opacity-80">Xem lại các yêu cầu đặt bàn và trải nghiệm ẩm thực của quý khách.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-primary-container/20 border border-primary text-primary px-4 py-3 rounded-lg mb-6 flex items-center gap-2">
            <span class="material-symbols-outlined">check_circle</span>
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-error-container/20 border border-error text-error px-4 py-3 rounded-lg mb-6 flex items-center gap-2">
            <span class="material-symbols-outlined">error</span>
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Status Tabs -->
    <div class="flex border-b border-outline-variant/20 mb-stack-lg overflow-x-auto no-scrollbar" id="status-tabs">
        <button class="px-6 py-4 font-label-lg text-label-lg active-tab whitespace-nowrap" data-filter="all">Tất cả</button>
        <button class="px-6 py-4 font-label-lg text-label-lg text-on-surface-variant hover:text-primary transition-colors whitespace-nowrap" data-filter="upcoming">Sắp diễn ra</button>
        <button class="px-6 py-4 font-label-lg text-label-lg text-on-surface-variant hover:text-primary transition-colors whitespace-nowrap" data-filter="completed">Đã hoàn thành</button>
        <button class="px-6 py-4 font-label-lg text-label-lg text-on-surface-variant hover:text-primary transition-colors whitespace-nowrap" data-filter="cancelled">Đã hủy</button>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="bg-surface-container-lowest border border-outline-variant/15 rounded-xl p-12 text-center shadow-sm">
            <span class="material-symbols-outlined text-6xl text-on-surface-variant/50 mb-4">event_busy</span>
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2">Chưa có lịch sử đặt bàn</h3>
            <p class="font-body-md text-on-surface-variant mb-6">Bạn chưa có lịch sử đặt bàn nào tại nhà hàng của chúng tôi.</p>
            <a asp-action="Search" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-lg font-label-lg hover:opacity-90 transition-opacity">
                <span class="material-symbols-outlined text-[20px]">restaurant</span>
                Đặt Bàn Ngay
            </a>
        </div>
    }
    else
    {
        <!-- Reservation List -->
        <div class="flex flex-col gap-6" id="reservation-list">
            @foreach (var reservation in Model)
            {
                var isUpcoming = reservation.Status == TableReservationStatus.Pending || reservation.Status == TableReservationStatus.Confirmed || reservation.Status == TableReservationStatus.Seated;
                var isCompleted = reservation.Status == TableReservationStatus.Completed;
                var isCancelled = reservation.Status == TableReservationStatus.Cancelled || reservation.Status == TableReservationStatus.NoShow;

                var filterCategory = isUpcoming ? "upcoming" : (isCompleted ? "completed" : "cancelled");
                
                var statusText = reservation.Status switch {
                    TableReservationStatus.Pending => "Chờ duyệt",
                    TableReservationStatus.Confirmed => "Đã xác nhận",
                    TableReservationStatus.Seated => "Đang dùng bữa",
                    TableReservationStatus.Completed => "Đã hoàn thành",
                    TableReservationStatus.Cancelled => "Đã hủy",
                    TableReservationStatus.NoShow => "Không đến",
                    _ => "Không rõ"
                };

                var statusBg = isUpcoming ? "bg-primary-container/20 text-on-primary-container" : (isCompleted ? "bg-secondary-container/30 text-on-secondary-container" : "bg-surface-variant text-on-surface-variant");
                var opacityClass = isCancelled ? "opacity-75" : "";
                var grayscaleClass = isCancelled ? "grayscale" : "";
                var imageUrl = isCompleted ? "https://lh3.googleusercontent.com/aida-public/AB6AXuDbTVIW1ekkeGH60EfN8gp6IN8UkeTYy8LCgOzTR3XPauwIL6fgmYsURRrhacvEBXiExmPthKe05Ue3fSgo_REDNBMCPAOPjUM5RJ7--flgNc60CQ1Y3i8A0W-dfyhVo0VHMW3hH9uMlADSH41RBEwjhmV1y9-V3UyzVrF1wVtQAzDiz03Tc63ulePTgmZewmPEQgpK6pDtNVF0TN-TpjrHU9ipR92hN1huGF21_xDn1jiF6ex-Km0nVg" :
                              (isCancelled ? "https://lh3.googleusercontent.com/aida-public/AB6AXuD2FnxLN4qeK8nFxsryj5kGVWaRakNCRj5pzqYytzZeRBUFQueUTeoUrtORzSwLDKPfFPbCmLcLoGUM5VxHoE7gQ9oIC8Dmxy2iu-pDon4bi8IMYWWxdIzFbiSgH2TpCeWVDL8-GIhyzJ9tqgnNMiP49FJDPsION3W3tyyeSMgnawvGf1bNPchSMSujOcN7xju9yh6TJs62nIEu4qsO202SR0mN4m_5bnkOu5Fw3E1wd9aaeNJ0ONEYEw" : "https://lh3.googleusercontent.com/aida-public/AB6AXuCr8vap6Mp9K--t27FO6IXoo08F7uSG-L0MjuUXuTUh6LH0YgZQVaXwWgOezAp2pxaTAA6VUQ5W2QQJlhM0VMVJZhxfMH6gS_bhzqG71MsftSc8z4orcW_SrTQlE9JjIfTOWVYpMRWGIcesVA-3jUQyP2f9lqXWrZClKyjYWM52hL5Uzwrz82IhAjakx4lsuNabAc4tSLsbQDxVCi7NzEQkkIrn7h25bByM08I_fGibV39e_Cur6Xx4Wg");

                <div class="reservation-card bg-surface-container-lowest border border-outline-variant/15 rounded-xl overflow-hidden shadow-[0_4px_24px_rgba(30,41,59,0.04)] flex flex-col md:flex-row group transition-all hover:shadow-lg @opacityClass" data-category="@filterCategory">
                    <div class="md:w-72 h-48 md:h-auto overflow-hidden @grayscaleClass shrink-0">
                        <div class="w-full h-full bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image: url('@imageUrl')"></div>
                    </div>
                    <div class="p-6 flex flex-col flex-1 justify-between">
                        <div>
                            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-2 gap-2">
                                <h3 class="font-headline-sm text-headline-sm text-primary">@reservation.TableName</h3>
                                <span class="@statusBg px-3 py-1 rounded-full font-label-sm text-label-sm whitespace-nowrap">@statusText</span>
                            </div>
                            
                            <!-- Additional info exactly as requested -->
                            <div class="flex flex-wrap gap-2 mb-4">
                                @if (!string.IsNullOrWhiteSpace(reservation.Area))
                                {
                                    <span class="inline-flex items-center gap-1 text-label-sm text-on-surface-variant bg-surface-container px-2 py-1 rounded-md">
                                        <span class="material-symbols-outlined text-[14px]">map</span> @reservation.Area
                                    </span>
                                }
                                <span class="inline-flex items-center gap-1 text-label-sm text-on-surface-variant bg-surface-container px-2 py-1 rounded-md">
                                    <span class="material-symbols-outlined text-[14px]">table_restaurant</span> Bàn @reservation.TableNumber
                                </span>
                                @if (!string.IsNullOrWhiteSpace(reservation.TableType))
                                {
                                    <span class="inline-flex items-center gap-1 text-label-sm text-on-surface-variant bg-surface-container px-2 py-1 rounded-md">
                                        <span class="material-symbols-outlined text-[14px]">sell</span> @reservation.TableType
                                    </span>
                                }
                            </div>

                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                <div>
                                    <p class="font-label-sm text-on-surface-variant uppercase opacity-60">Ngày đặt</p>
                                    <p class="font-body-md font-semibold">@reservation.ReservationDate.ToString("dd/MM/yyyy")</p>
                                </div>
                                <div>
                                    <p class="font-label-sm text-on-surface-variant uppercase opacity-60">Giờ</p>
                                    <p class="font-body-md font-semibold">@reservation.ReservationTime.ToString(@"hh\:mm")</p>
                                </div>
                                <div>
                                    <p class="font-label-sm text-on-surface-variant uppercase opacity-60">Số khách</p>
                                    <p class="font-body-md font-semibold">@reservation.PartySize người</p>
                                </div>
                                <div>
                                    <p class="font-label-sm text-on-surface-variant uppercase opacity-60">Mã đặt chỗ</p>
                                    <p class="font-body-md font-semibold text-primary">@reservation.ReservationCode</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="flex flex-wrap gap-4 mt-6">
                            <a asp-action="Details" asp-route-id="@reservation.ReservationId" class="px-6 py-2 @(isCancelled ? "bg-surface-variant text-on-surface-variant" : "bg-primary-container text-on-primary-container") font-label-lg text-label-lg rounded-xl hover:opacity-90 transition-all shadow-sm flex items-center justify-center">
                                Xem chi tiết
                            </a>
                            @if (reservation.CanCancel)
                            {
                                <form asp-action="Cancel" asp-route-id="@reservation.ReservationId" method="post" class="inline-flex">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="reason" value="Cancelled by customer from history." />
                                    <button type="submit" class="px-6 py-2 border border-error/30 text-error font-label-lg text-label-lg rounded-xl hover:bg-error/5 transition-all" onclick="return confirm('Bạn có chắc chắn muốn hủy đặt bàn này không?');">
                                        Hủy bàn
                                    </button>
                                </form>
                            }
                            @if (isCompleted)
                            {
                                <a href="#" class="px-6 py-2 border border-primary/30 text-primary font-label-lg text-label-lg rounded-xl hover:bg-primary/5 transition-all flex items-center gap-2 justify-center">
                                    <span class="material-symbols-outlined text-[18px]">star</span>
                                    Đánh giá
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tabs = document.querySelectorAll('#status-tabs button');
            const cards = document.querySelectorAll('.reservation-card');

            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    // Update active tab styling
                    tabs.forEach(t => {
                        t.classList.remove('active-tab', 'text-primary');
                        t.classList.add('text-on-surface-variant');
                    });
                    tab.classList.add('active-tab');
                    tab.classList.remove('text-on-surface-variant');

                    // Filter cards
                    const filter = tab.getAttribute('data-filter');
                    cards.forEach(card => {
                        if (filter === 'all' || card.getAttribute('data-category') === filter) {
                            card.style.display = 'flex';
                            // Add a slight fade-in
                            card.style.opacity = '0';
                            setTimeout(() => {
                                const isCancelled = card.classList.contains('grayscale');
                                card.style.opacity = isCancelled ? '0.75' : '1';
                            }, 50);
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });
        });
    </script>
}
