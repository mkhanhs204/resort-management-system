@model PhucNguyenResort.ViewModels.TableReservations.TableReservationCreateViewModel

@{
    ViewData["Title"] = "Hoàn tất đặt bàn";
    var userEmail = User.Identity?.Name ?? "";
}

@section Styles {
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        body {
            background-color: #fcf9f5 !important;
            color: #1c1c1a;
            -webkit-font-smoothing: antialiased;
        }
        .luxury-shadow {
            box-shadow: 0 24px 40px -10px rgba(30, 41, 59, 0.06);
        }
        .input-inset {
            background-color: #fcf9f5;
            transition: all 0.3s ease;
        }
        .input-inset:focus {
            outline: none;
            border-color: #dfa974 !important;
            box-shadow: 0 0 0 1px #dfa974;
        }
        .step-active {
            color: #805528;
            border-bottom: 2px solid #805528;
        }
    </style>
}

<div class="-mt-[40px] md:-mt-[80px]">
    <div class="pt-32 pb-section-gap-lg px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
        <!-- Header Section -->
        <div class="mb-stack-lg text-center md:text-left">
            <nav class="flex items-center justify-center md:justify-start gap-2 mb-4 text-on-surface-variant font-label-sm uppercase tracking-widest">
                <a asp-action="Search" class="hover:text-primary transition-colors">Nhà hàng</a>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-primary">Đặt bàn</span>
            </nav>
            <h1 class="font-headline-lg text-headline-lg mb-2">Hoàn tất đặt bàn</h1>
            <p class="text-on-surface-variant font-body-lg">Vui lòng cung cấp thông tin để chúng tôi chuẩn bị đón tiếp bạn chu đáo nhất.</p>
        </div>

        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="TableId" />
            <input type="hidden" asp-for="TableNumber" />
            <input type="hidden" asp-for="TableName" />
            <input type="hidden" asp-for="ImageUrl" />
            <input type="hidden" asp-for="Description" />
            <input type="hidden" asp-for="Area" />
            <input type="hidden" asp-for="TableType" />
            <input type="hidden" asp-for="LocationNote" />
            <input type="hidden" asp-for="Capacity" />
            <input type="hidden" asp-for="ReservationDate" />
            <input type="hidden" asp-for="ReservationTime" />
            <input type="hidden" asp-for="DurationMinutes" />
            <input type="hidden" asp-for="PartySize" />

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
                <!-- Left Column: Forms and Menu -->
                <div class="lg:col-span-8 space-y-stack-lg">
                    <!-- Summary Card Mobile Only -->
                    <div class="lg:hidden bg-surface-container-lowest border border-outline-variant/20 p-stack-md rounded-xl luxury-shadow mb-stack-md">
                        <div class="flex items-center gap-stack-md">
                            <div class="w-20 h-20 rounded-lg overflow-hidden flex-shrink-0">
                                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                                {
                                    <img class="w-full h-full object-cover" src="@Model.ImageUrl" alt="@Model.TableName" onerror="this.src='/images/placeholder.jpg'" />
                                }
                                else
                                {
                                    <div class="w-full h-full bg-surface-variant flex items-center justify-center">
                                        <span class="material-symbols-outlined text-4xl text-on-surface-variant/50">restaurant</span>
                                    </div>
                                }
                            </div>
                            <div>
                                <h3 class="font-headline-sm text-headline-sm text-on-surface">@Model.TableName</h3>
                                <p class="text-on-surface-variant font-label-lg">@Model.Area • @Model.ReservationTime.ToString(@"hh\:mm"), @Model.ReservationDate.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>
                    </div>

                    <!-- Guest Info Form -->
                    <section class="bg-surface-container-lowest border border-outline-variant/20 p-stack-lg md:p-10 rounded-xl luxury-shadow">
                        <h2 class="font-headline-sm text-headline-sm mb-stack-lg flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">person</span>
                            Thông tin khách hàng
                        </h2>
                        
                        <div asp-validation-summary="ModelOnly" class="text-error mb-4"></div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-stack-md">
                            <div class="flex flex-col gap-2">
                                <label class="font-label-lg text-on-surface-variant">Họ và tên *</label>
                                <input class="input-inset border border-outline-variant/30 px-4 py-3 rounded-lg text-on-surface" value="Người dùng" readonly type="text"/>
                            </div>
                            <div class="flex flex-col gap-2">
                                <label class="font-label-lg text-on-surface-variant">Số điện thoại *</label>
                                <input class="input-inset border border-outline-variant/30 px-4 py-3 rounded-lg text-on-surface" placeholder="Đã liên kết tài khoản" readonly type="tel"/>
                            </div>
                            <div class="flex flex-col gap-2 md:col-span-2">
                                <label class="font-label-lg text-on-surface-variant">Địa chỉ Email *</label>
                                <input class="input-inset border border-outline-variant/30 px-4 py-3 rounded-lg text-on-surface" value="@userEmail" readonly type="email"/>
                            </div>
                            <div class="flex flex-col gap-2 md:col-span-2">
                                <label class="font-label-lg text-on-surface-variant">Ghi chú đặc biệt (Dị ứng, Kỷ niệm...)</label>
                                <textarea asp-for="SpecialRequests" class="input-inset border border-outline-variant/30 px-4 py-3 rounded-lg text-on-surface resize-none" placeholder="VD: Chúng tôi kỷ niệm 10 năm ngày cưới, vui lòng sắp xếp vị trí lãng mạn..." rows="4"></textarea>
                                <span asp-validation-for="SpecialRequests" class="text-error text-sm"></span>
                            </div>
                        </div>
                    </section>

                    <!-- Pre-order Menu Section -->
                    <section class="bg-surface-container-lowest border border-outline-variant/20 p-stack-lg md:p-10 rounded-xl luxury-shadow">
                        <div class="flex justify-between items-end mb-stack-lg">
                            <div>
                                <h2 class="font-headline-sm text-headline-sm mb-1 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary">restaurant_menu</span>
