                                <span class="material-symbols-outlined text-[18px]">verified_user</span>
                                <span class="text-label-sm">Đảm bảo bảo mật &amp; riêng tư</span>
                            </div>
                        </div>
                    </div>

                    <!-- Assistance Card -->
                    <div class="mt-gutter p-6 bg-secondary-container/30 border border-secondary-container rounded-xl flex items-center gap-4">
                        <span class="material-symbols-outlined text-secondary text-4xl">support_agent</span>
                        <div>
                            <p class="font-label-lg text-secondary font-bold">Cần hỗ trợ gấp?</p>
                            <p class="text-label-sm text-on-secondary-container">Gọi ngay: 1900 8888 (24/7)</p>
                        </div>
                    </div>
                </aside>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Micro-interactions
        document.querySelectorAll('input, textarea').forEach(el => {
            el.addEventListener('focus', () => {
                el.parentElement.querySelector('label')?.classList.add('text-primary');
            });
            el.addEventListener('blur', () => {
                el.parentElement.querySelector('label')?.classList.remove('text-primary');
            });
        });

        let totalItems = 0;
        let totalPrice = 0;

        function formatPrice(price) {
            return price.toLocaleString('vi-VN') + 'đ';
        }

        // Toggle pre-order buttons
        document.querySelectorAll('button[type="button"]').forEach(btn => {
            if(btn.innerText === "Thêm vào yêu cầu" || btn.innerText === "Đã chọn") {
                btn.addEventListener('click', function() {
                    const priceText = this.parentElement.querySelector('.text-primary.font-bold').innerText;
                    // Extract price, assume format "1.250k" = 1250000
                    const priceMatch = priceText.match(/[\d\.]+/);
                    let priceVal = 0;
                    if (priceMatch) {
                        priceVal = parseInt(priceMatch[0].replace(/\./g, '')) * 1000;
                    }

                    const isActive = this.classList.contains('bg-primary-container');
                    if(isActive) {
                        this.innerText = "Thêm vào yêu cầu";
                        this.classList.remove('bg-primary-container', 'text-white');
                        this.classList.add('border-primary', 'text-primary');
                        totalItems--;
                        totalPrice -= priceVal;
                    } else {
                        this.innerText = "Đã chọn";
                        this.classList.add('bg-primary-container', 'text-white');
                        this.classList.remove('border-primary', 'text-primary');
                        totalItems++;
                        totalPrice += priceVal;
                    }

                    document.getElementById('selected-menu-count').innerText = totalItems;
                    document.getElementById('total-price-text').innerText = formatPrice(totalPrice);
                });
            }
        });
        
        // Add A-la-carte buttons
        document.querySelectorAll('.add-alacarte-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const container = this.parentElement.parentElement;
                const priceText = this.parentElement.querySelector('.font-bold.text-primary').innerText;
                
                const priceMatch = priceText.match(/[\d\.]+/);
                let priceVal = 0;
                if (priceMatch) {
                    priceVal = parseInt(priceMatch[0].replace(/\./g, '')) * 1000;
                }

                const isAdded = container.classList.contains('border-primary');
                if (isAdded) {
                    container.classList.remove('border-primary');
                    container.classList.add('border-transparent');
                    this.innerText = 'add_circle';
                    totalItems--;
                    totalPrice -= priceVal;
                } else {
                    container.classList.add('border-primary');
                    container.classList.remove('border-transparent');
                    this.innerText = 'check_circle';
                    totalItems++;
                    totalPrice += priceVal;
                }
                
                document.getElementById('selected-menu-count').innerText = totalItems;
                document.getElementById('total-price-text').innerText = formatPrice(totalPrice);
            });
        });
    </script>
}
