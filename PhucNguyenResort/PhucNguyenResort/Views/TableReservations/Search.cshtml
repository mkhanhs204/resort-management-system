@using PhucNguyenResort.Enums
@model PhucNguyenResort.ViewModels.TableReservations.TableReservationSearchViewModel

@{
    ViewData["Title"] = "Tìm Bàn Nhà Hàng";
    var dateValue = Model.ReservationDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd");
    var timeValue = Model.ReservationTime?.ToString(@"hh\:mm") ?? "18:00";
}

@section Styles {
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .luxury-shadow {
            box-shadow: 0 24px 48px -12px rgba(30, 41, 59, 0.08);
        }
        .hero-gradient {
            background: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.2) 50%, rgba(252, 249, 245, 1) 100%);
        }
        body {
            background-color: #fcf9f5 !important; /* Ivory White */
        }
    </style>
}

<div class="-mt-[80px]"> <!-- Compensate for Layout navbar if any, to allow hero to hit top -->
    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0 z-0">
            <div class="w-full h-full bg-cover bg-center transition-transform duration-[10000ms] scale-105 hover:scale-100" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuC63g5M8INll2C0uwKmn91cqrQCdyCpc2I8-ylcgwbNrLskZOeGcBCblF3HtXpVs_z6V8FyRtsxtHkW5KWI9Y49P9-rOfl0ZvZjp3wX9umNar9w3DllQX6nCNjcx-YnWx_4mLz_5LHKP7ohuILfULWn5r-zKabWeYWUHQnmEDzxEMG0GJyJ33WrkgNF9Y_iDNDW1eobQ7_sPsmJS6LDfLLI2MKg1zNI6UX5637ankaE_i8yJ27MuRtnvzkIxsueSulIlMRnfRnobfOl')">
            </div>
            <div class="absolute inset-0 hero-gradient"></div>
        </div>
        <div class="relative z-10 text-center px-4 max-w-4xl">
            <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-stack-md leading-tight text-white">
                Trải Nghiệm <br /> Ẩm Thực Tinh Hoa
            </h1>
            <p class="font-body-lg text-body-lg text-white/90 max-w-2xl mx-auto mb-stack-lg">
                Đắm chìm trong không gian sang trọng, nơi hương vị bản địa gặp gỡ nghệ thuật ẩm thực quốc tế dưới bàn tay tài hoa của các đầu bếp hàng đầu.
            </p>
        </div>
    </section>

    <!-- Search Bar Section -->
    <section class="relative z-20 -mt-16 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
        <div class="bg-surface-container-lowest luxury-shadow rounded-xl border border-outline-variant/20 p-stack-lg">
            <form asp-action="Search" method="post" class="grid grid-cols-1 md:grid-cols-4 gap-gutter items-end">
                <!-- Date -->
                <div class="space-y-2">
                    <label class="font-label-lg text-label-lg text-on-surface-variant flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">calendar_today</span>
                        Chọn Ngày
                    </label>
                    <div class="relative">
                        <input asp-for="ReservationDate" value="@dateValue" class="w-full bg-surface-container-low border border-outline-variant/30 rounded-lg py-3 px-4 text-on-surface focus:ring-1 focus:ring-primary-container focus:border-primary-container outline-none transition-all" type="date" required />
                    </div>
                </div>
                <!-- Time -->
                <div class="space-y-2">
                    <label class="font-label-lg text-label-lg text-on-surface-variant flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">schedule</span>
                        Giờ Đặt
                    </label>
                    <div class="relative">
                        <select asp-for="ReservationTime" class="w-full bg-surface-container-low border border-outline-variant/30 rounded-lg py-3 px-4 text-on-surface focus:ring-1 focus:ring-primary-container focus:border-primary-container outline-none appearance-none">
                            @{
                                var times = new[] { "17:00", "17:30", "18:00", "18:30", "19:00", "19:30", "20:00", "20:30", "21:00" };
                                foreach (var t in times)
                                {
                                    if (t == timeValue)
                                    {
                                        <option value="@t" selected>@t</option>
                                    }
                                    else
                                    {
                                        <option value="@t">@t</option>
                                    }
                                }
                            }
                        </select>
                        <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none">expand_more</span>
                    </div>
                </div>
                <!-- Party Size -->
                <div class="space-y-2">
                    <label class="font-label-lg text-label-lg text-on-surface-variant flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">group</span>
                        Số Khách
                    </label>
                    <div class="relative">
                        <select asp-for="PartySize" class="w-full bg-surface-container-low border border-outline-variant/30 rounded-lg py-3 px-4 text-on-surface focus:ring-1 focus:ring-primary-container focus:border-primary-container outline-none appearance-none">
                            <option value="2">2 Người</option>
                            <option value="4">4 Người</option>
                            <option value="6">6 Người</option>
                            <option value="8">8 Người</option>
                            <option value="10">10+ Người</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none">expand_more</span>
                    </div>
                </div>
                <!-- CTA -->
                <div>
                    <button type="submit" class="w-full bg-primary-container text-on-primary-container h-[50px] rounded-lg font-label-lg text-label-lg hover:bg-primary hover:text-white transition-all duration-300 shadow-sm flex items-center justify-center gap-2">
                        Tìm Bàn
                        <span class="material-symbols-outlined">search</span>
                    </button>
                </div>
            </form>
        </div>
    </section>

    <!-- Available Tables Results -->
    @if (Context.Request.Method.Equals("POST", StringComparison.OrdinalIgnoreCase))
    {
        <section class="py-section-gap-md px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto" id="results-section">
            <div class="text-center mb-stack-lg">
                <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-2">Kết Quả Tìm Kiếm</h2>
                <p class="font-body-lg text-body-lg text-on-surface-variant">Tìm thấy @Model.AvailableTables.Count bàn trống phù hợp.</p>
            </div>
            
            @if (Model.AvailableTables.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter" id="table-grid">
                    @foreach (var table in Model.AvailableTables)
                    {
                        <div class="table-item bg-surface-container-lowest rounded-xl border border-outline-variant/20 overflow-hidden luxury-shadow group transition-all duration-300 hover:-translate-y-1">
                            <div class="relative h-64 overflow-hidden">
                                @if (!string.IsNullOrWhiteSpace(table.ImageUrl))
                                {
                                    <img src="@table.ImageUrl" alt="@table.TableName" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" onerror="this.onerror=null;this.src='https://placehold.co/400x300?text=No+Image'" />
                                }
                                else
                                {
                                    <div class="w-full h-full bg-surface-variant flex items-center justify-center">
                                        <span class="material-symbols-outlined text-6xl text-on-surface-variant/50">restaurant</span>
                                    </div>
                                }
                                <div class="absolute top-4 right-4 bg-primary text-white px-4 py-1 rounded-full text-label-sm font-label-sm font-bold shadow-md uppercase tracking-widest">
                                    Bàn @table.TableNumber
                                </div>
                            </div>
                            <div class="p-6">
                                <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2">@table.TableName</h3>
                                @if (!string.IsNullOrWhiteSpace(table.Description))
                                {
                                    <p class="text-body-md text-on-surface-variant line-clamp-2 mb-4">@table.Description</p>
                                }
                                
                                <div class="flex flex-wrap gap-2 mb-6">
                                    <span class="bg-surface-container px-3 py-1 rounded-md text-label-sm flex items-center gap-1 text-on-surface-variant">
                                        <span class="material-symbols-outlined text-[16px]">group</span> Tối đa @table.Capacity
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(table.Area))
                                    {
                                        <span class="bg-surface-container px-3 py-1 rounded-md text-label-sm flex items-center gap-1 text-on-surface-variant">
                                            <span class="material-symbols-outlined text-[16px]">map</span> @table.Area
                                        </span>
                                    }
                                </div>
                                
                                <a asp-action="Create"
                                   asp-route-tableId="@table.TableId"
                                   asp-route-reservationDate="@table.ReservationDate.ToString("yyyy-MM-dd")"
                                   asp-route-reservationTime="@table.ReservationTime.ToString(@"hh\:mm")"
                                   asp-route-partySize="@Model.PartySize"
                                   asp-route-durationMinutes="@table.DurationMinutes"
                                   class="block w-full text-center border border-primary text-primary py-3 rounded-lg font-label-lg text-label-lg hover:bg-primary hover:text-white transition-all duration-300">
                                    Đặt Bàn Này
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination Controls -->
                <div class="flex justify-center items-center gap-2 mt-section-gap-md" id="pagination-controls">
                </div>
            }
            else
            {
                <div class="bg-error-container/20 border border-error/20 rounded-xl p-8 text-center max-w-2xl mx-auto mt-stack-lg">
                    <span class="material-symbols-outlined text-error text-4xl mb-2">sentiment_dissatisfied</span>
                    <h3 class="font-headline-sm text-headline-sm text-error mb-2">Không Có Bàn Trống</h3>
                    <p class="text-on-surface-variant">Rất tiếc, không có bàn nào phù hợp với yêu cầu của bạn. Vui lòng thử lại với thời gian hoặc số lượng khách khác.</p>
                </div>
            }
        </section>
    }

