@model PhucNguyenResort.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<div class="container mt-4">
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Are you sure you want to delete this room?</h4>
        <p>This action cannot be undone. Associated bookings might be affected.</p>
    </div>

    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Deleting: Room @Model.RoomNumber</h5>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Room ID</dt>
                <dd class="col-sm-8">@Model.RoomId</dd>
                
                <dt class="col-sm-4">Category</dt>
                <dd class="col-sm-8">@(Model.Category?.CategoryName ?? "None")</dd>
                
                <dt class="col-sm-4">Floor</dt>
                <dd class="col-sm-8">@Model.FloorNumber</dd>
            </dl>

            <form asp-action="Delete" class="mt-4 border-top pt-3 d-flex justify-content-between">
                <input type="hidden" asp-for="RoomId" />
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel and Back to List</a>
                <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
            </form>
        </div>
    </div>
</div>
