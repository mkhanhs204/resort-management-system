@model PhucNguyenResort.Models.Room

@{
    ViewData["Title"] = "Xóa Phòng";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528; /* primary */
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b; /* on-surface-variant */
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 32px;
            margin-bottom: 30px;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        .btn-danger-luxury {
            background-color: #ffebee;
            color: #c62828;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: 1px solid #ffcdd2;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-danger-luxury:hover {
            background-color: #ef5350;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(239, 83, 80, 0.2);
            text-decoration: none;
        }
        .btn-secondary-luxury {
            background-color: #f0ede9;
            color: #50453b;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-secondary-luxury:hover {
            background-color: #e5e2de;
            color: #1c1c1a;
            text-decoration: none;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .detail-row {
            display: flex;
            padding: 16px 0;
            border-bottom: 1px solid #f0ede9;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            width: 30%;
            color: #50453b;
            font-weight: 600;
            font-size: 14px;
        }
        .detail-value {
            width: 70%;
            color: #1c1c1a;
            font-weight: 500;
            font-size: 15px;
        }
        .alert-luxury {
            background-color: #fff4e5;
            border: 1px solid #ffcc80;
            border-radius: 12px;
            padding: 16px 20px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 24px;
        }
        .alert-luxury .material-symbols-outlined {
            color: #e65100;
            font-size: 24px;
        }
        .alert-luxury-content h4 {
            color: #e65100;
            font-size: 16px;
            font-weight: 700;
            margin-top: 2px;
            margin-bottom: 4px;
        }
        .alert-luxury-content p {
            color: #50453b;
            font-size: 14px;
            margin: 0;
        }
    </style>
}

<div class="header-container">
    <div>
        <h2 class="page-title">
            Xóa Phòng
        </h2>
        <p class="page-subtitle">Xóa phòng số @Model.RoomNumber khỏi hệ thống.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-secondary-luxury">
            <span class="material-symbols-outlined">arrow_back</span> Quay lại danh sách
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-luxury" style="background-color: #ffebee; border-color: #ffcdd2;">
        <span class="material-symbols-outlined" style="color: #c62828;">error</span>
        <div class="alert-luxury-content">
            <h4 style="color: #c62828;">Không thể xóa</h4>
            <p style="color: #c62828;">@TempData["ErrorMessage"]</p>
        </div>
    </div>
}

<div class="alert-luxury">
    <span class="material-symbols-outlined">warning</span>
    <div class="alert-luxury-content">
        <h4>Bạn có chắc chắn muốn xóa phòng này?</h4>
        <p>Hành động này không thể hoàn tác. Các thông tin đặt phòng liên quan có thể bị ảnh hưởng.</p>
    </div>
</div>

<div class="luxury-card">
    <div style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 600; color: #c62828; margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined">delete_forever</span> Xóa Phòng @Model.RoomNumber
    </div>
    
    <div class="detail-row">
        <div class="detail-label">Mã Phòng (ID)</div>
        <div class="detail-value">@Model.RoomId</div>
    </div>
    <div class="detail-row">
        <div class="detail-label">Loại Phòng</div>
        <div class="detail-value">@(Model.Category?.CategoryName ?? "Chưa phân loại")</div>
    </div>
    <div class="detail-row">
        <div class="detail-label">Tầng</div>
        <div class="detail-value">@Model.FloorNumber</div>
    </div>
    
    <form asp-action="Delete" class="mt-4 pt-3" style="border-top: 1px solid #f0ede9;">
        <input type="hidden" asp-for="RoomId" />
        <div style="display: flex; gap: 16px;">
            <button type="submit" class="btn-danger-luxury">
                <span class="material-symbols-outlined">delete</span> Xác nhận Xóa
            </button>
            <a asp-action="Index" class="btn-secondary-luxury">
                Hủy bỏ
            </a>
        </div>
    </form>
</div>
