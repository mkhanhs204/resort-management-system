@model IEnumerable<PhucNguyenResort.Models.Room>

@{
    ViewData["Title"] = "Manage Rooms";
}

<div class="container-fluid refund-container py-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 page-title">@ViewData["Title"]</h1>
        @if (User.IsInRole("Business Manager"))
        {
            <a asp-action="Create" class="btn btn-premium-action btn-primary shadow-sm">
                <i class="fa fa-plus-circle"></i> Create New
            </a>
        }
    </div>

    <!-- Filter Form -->
    <div class="card premium-card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-4">
                    <input type="text" name="searchString" class="form-control" placeholder="Search by Room or Floor..." value="@ViewBag.SearchString">
                </div>
                <div class="col-md-3">
                    <select name="categoryId" class="form-control" asp-items="ViewBag.Categories">
                        <option value="">-- All Categories --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="statusFilter" class="form-control" asp-items="Html.GetEnumSelectList<PhucNguyenResort.Enums.RoomStatus>()">
                        <option value="">-- All Statuses --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fa fa-filter"></i> Filter</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card premium-card mb-4">
        <div class="premium-card-header d-flex align-items-center">
            <div class="icon-circle bg-primary text-white mr-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;">
                <i class="fa fa-bed"></i>
            </div>
            <h6 class="m-0 font-weight-bold text-dark" style="font-size: 1.1rem;">Danh sách Phòng (Rooms)</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table premium-table mb-0" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th class="pl-4">@Html.DisplayNameFor(model => model.RoomNumber)</th>
                            <th>Category</th>
                            <th>@Html.DisplayNameFor(model => model.FloorNumber)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th class="pr-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td class="pl-4 fw-bold">@Html.DisplayFor(modelItem => item.RoomNumber)</td>
                                <td><span class="badge badge-light border p-2">@(item.Category?.CategoryName ?? "None")</span></td>
                                <td>Tầng @Html.DisplayFor(modelItem => item.FloorNumber)</td>
                                <td>
                                    @{
                                        var badgeClass = item.Status switch
                                        {
                                            PhucNguyenResort.Enums.RoomStatus.Available => "badge-pastel-success",
                                            PhucNguyenResort.Enums.RoomStatus.Occupied => "badge-pastel-danger",
                                            PhucNguyenResort.Enums.RoomStatus.Maintenance => "badge-pastel-warning",
                                            PhucNguyenResort.Enums.RoomStatus.NeedsCleaning => "badge-pastel-secondary",
                                            _ => "badge-pastel-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@item.Status</span>
                                </td>
                                <td class="pr-4 text-end">
                                    <a asp-action="Edit" asp-route-id="@item.RoomId" class="btn-action-icon edit" title="Sửa"><i class="fa fa-pencil"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.RoomId" class="btn-action-icon view" title="Xem chi tiết"><i class="fa fa-eye"></i></a>
                                    @if (User.IsInRole("Business Manager"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.RoomId" class="btn-action-icon delete" title="Xóa"><i class="fa fa-trash"></i></a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- Pagination -->
        @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top-0 d-flex justify-content-center pb-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination mb-0">
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, searchString = ViewBag.SearchString, statusFilter = ViewBag.StatusFilter, categoryId = ViewBag.CurrentCategory })" aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                        
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, searchString = ViewBag.SearchString, statusFilter = ViewBag.StatusFilter, categoryId = ViewBag.CurrentCategory })">@i</a>
                            </li>
                        }
                        
                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, searchString = ViewBag.SearchString, statusFilter = ViewBag.StatusFilter, categoryId = ViewBag.CurrentCategory })" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
