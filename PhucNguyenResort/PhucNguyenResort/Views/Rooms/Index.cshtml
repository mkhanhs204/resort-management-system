@model IEnumerable<PhucNguyenResort.Models.Room>

@{
    ViewData["Title"] = "Manage Rooms";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.RoomNumber)</th>
                            <th>Category</th>
                            <th>@Html.DisplayNameFor(model => model.FloorNumber)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td class="fw-bold">@Html.DisplayFor(modelItem => item.RoomNumber)</td>
                                <td>@(item.Category?.CategoryName ?? "None")</td>
                                <td>@Html.DisplayFor(modelItem => item.FloorNumber)</td>
                                <td>
                                    @{
                                        var badgeClass = item.Status switch
                                        {
                                            PhucNguyenResort.Enums.RoomStatus.Available => "bg-success",
                                            PhucNguyenResort.Enums.RoomStatus.Occupied => "bg-danger",
                                            PhucNguyenResort.Enums.RoomStatus.Maintenance => "bg-warning text-dark",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@item.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.RoomId" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i> Edit</a>
                                        <a asp-action="Details" asp-route-id="@item.RoomId" class="btn btn-sm btn-outline-info" title="Details"><i class="bi bi-eye"></i> Details</a>
                                        <a asp-action="Delete" asp-route-id="@item.RoomId" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i> Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
