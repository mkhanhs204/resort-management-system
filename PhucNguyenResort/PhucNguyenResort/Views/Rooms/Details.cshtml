@model PhucNguyenResort.Models.Room

@{
    ViewData["Title"] = "Chi Tiết Phòng";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528; /* primary */
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b; /* on-surface-variant */
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 32px;
            margin-bottom: 30px;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        .btn-luxury {
            background-color: #dfa974;
            color: #633d11;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-luxury:hover {
            background-color: #805528;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2);
            text-decoration: none;
        }
        .btn-secondary-luxury {
            background-color: #f0ede9;
            color: #50453b;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-secondary-luxury:hover {
            background-color: #e5e2de;
            color: #1c1c1a;
            text-decoration: none;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .detail-row {
            display: flex;
            padding: 16px 0;
            border-bottom: 1px solid #f0ede9;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            width: 30%;
            color: #50453b;
            font-weight: 600;
            font-size: 14px;
        }
        .detail-value {
            width: 70%;
            color: #1c1c1a;
            font-weight: 500;
            font-size: 15px;
        }
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        .status-success { background: #e8f5e9; color: #2e7d32; }
        .status-danger { background: #ffebee; color: #c62828; }
        .status-warning { background: #fff8e1; color: #f57f17; }
        .status-secondary { background: #f0ede9; color: #50453b; }
    </style>
}

<div class="header-container">
    <div>
        <h2 class="page-title">
            Chi Tiết Phòng
        </h2>
        <p class="page-subtitle">Thông tin chi tiết của phòng số @Model.RoomNumber.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-secondary-luxury">
            <span class="material-symbols-outlined">arrow_back</span> Quay lại danh sách
        </a>
    </div>
</div>

<div class="luxury-card">
    <div style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 600; color: #1c1c1a; margin-bottom: 24px;">
        Phòng @Model.RoomNumber
    </div>
    
    <div class="detail-row">
        <div class="detail-label">Số Phòng</div>
        <div class="detail-value fw-bold fs-5">@Html.DisplayFor(model => model.RoomNumber)</div>
    </div>
    <div class="detail-row">
        <div class="detail-label">Loại Phòng</div>
        <div class="detail-value">@(Model.Category?.CategoryName ?? "Chưa phân loại")</div>
    </div>
    <div class="detail-row">
        <div class="detail-label">Tầng</div>
        <div class="detail-value">@Html.DisplayFor(model => model.FloorNumber)</div>
    </div>
    <div class="detail-row">
        <div class="detail-label">Trạng Thái</div>
        <div class="detail-value">
            @{
                var (badgeClass, icon, label) = Model.Status switch
                {
                    PhucNguyenResort.Enums.RoomStatus.Available => ("status-success", "check_circle", "Trống"),
                    PhucNguyenResort.Enums.RoomStatus.Occupied => ("status-danger", "meeting_room", "Đang có khách"),
                    PhucNguyenResort.Enums.RoomStatus.Maintenance => ("status-warning", "build", "Bảo trì"),
                    _ => ("status-secondary", "help_outline", "Không xác định")
                };
            }
            <span class="status-badge @badgeClass">
                <span class="material-symbols-outlined" style="font-size: 16px;">@icon</span> @label
            </span>
        </div>
    </div>
    
    <hr style="border-color: #e5e2de; margin: 32px 0;" />
    <div style="display: flex; gap: 16px;">
        <a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn-luxury">
            <span class="material-symbols-outlined">edit</span> Chỉnh Sửa
        </a>
    </div>
</div>
