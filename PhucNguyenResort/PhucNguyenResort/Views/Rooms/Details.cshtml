@model PhucNguyenResort.Models.Room

@{
    ViewData["Title"] = "Room Details";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Room @Model.RoomNumber</h4>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn btn-primary">Edit</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.RoomNumber)</dt>
                <dd class="col-sm-9 fw-bold fs-5">@Html.DisplayFor(model => model.RoomNumber)</dd>

                <dt class="col-sm-3 text-muted">Category</dt>
                <dd class="col-sm-9">@(Model.Category?.CategoryName ?? "None")</dd>

                <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.FloorNumber)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.FloorNumber)</dd>

                <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.Status)</dt>
                <dd class="col-sm-9">
                    @{
                        var badgeClass = Model.Status switch
                        {
                            PhucNguyenResort.Enums.RoomStatus.Available => "bg-success",
                            PhucNguyenResort.Enums.RoomStatus.Occupied => "bg-danger",
                            PhucNguyenResort.Enums.RoomStatus.Maintenance => "bg-warning text-dark",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @badgeClass fs-6">@Model.Status</span>
                </dd>
            </dl>
        </div>
    </div>
</div>
