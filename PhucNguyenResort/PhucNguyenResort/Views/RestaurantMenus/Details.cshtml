@model PhucNguyenResort.ViewModels.RestaurantMenus.MenuItemDetailViewModel

@{
    ViewData["Title"] = "Menu Item Details";
}

<h1 class="h3 mb-3">@Model.ItemName</h1>

<dl class="row">
    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.CategoryName</dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@Model.Price.ToString("N0")</dd>

    <dt class="col-sm-3">Selling status</dt>
    <dd class="col-sm-9">@(Model.IsAvailable ? "Selling" : "Out of stock")</dd>

    <dt class="col-sm-3">Image URL</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "No image" : Model.ImageUrl)</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description" : Model.Description)</dd>
</dl>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.MenuItemId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>
