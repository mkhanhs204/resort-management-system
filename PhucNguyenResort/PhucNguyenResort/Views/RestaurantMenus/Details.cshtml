@model PhucNguyenResort.ViewModels.RestaurantMenus.MenuItemDetailViewModel

@{
    ViewData["Title"] = "Menu Item Details";
}

<div class="container-fluid refund-container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card premium-card shadow-sm mb-4">
                <div class="premium-card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 text-white"><i class="fa fa-info-circle mr-2"></i> @Model.ItemName</h4>
                    <a asp-action="Index" class="btn btn-sm btn-light text-primary fw-bold"><i class="fa fa-arrow-left"></i> Back to List</a>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Category</dt>
                        <dd class="col-sm-8 fw-bold">@(string.IsNullOrEmpty(Model.CategoryName) ? "Uncategorized" : Model.CategoryName)</dd>

                        <dt class="col-sm-4 text-muted">Price</dt>
                        <dd class="col-sm-8 fw-bold text-success">@Model.Price.ToString("N0") VND</dd>

                        <dt class="col-sm-4 text-muted">Selling status</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsAvailable)
                            {
                                <span class="badge badge-pastel-success">Selling</span>
                            }
                            else
                            {
                                <span class="badge badge-pastel-warning">Out of stock</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Image URL</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                            {
                                <a href="@Model.ImageUrl" target="_blank" class="text-primary">@Model.ImageUrl</a>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No image</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Description</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description" : Model.Description)</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light p-3">
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Edit" asp-route-id="@Model.MenuItemId" class="btn btn-primary"><i class="fa fa-pencil"></i> Edit</a>
                        <a asp-action="Discontinue" asp-route-id="@Model.MenuItemId" class="btn btn-danger"><i class="fa fa-ban"></i> Discontinue</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
