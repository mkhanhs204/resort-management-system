@model PhucNguyenResort.ViewModels.RestaurantMenus.MenuItemDetailViewModel

@{
    ViewData["Title"] = "Chi Tiết Món Ăn";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528; /* primary */
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b; /* on-surface-variant */
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 32px;
            margin-bottom: 30px;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        .btn-luxury {
            background-color: #dfa974;
            color: #633d11;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-luxury:hover {
            background-color: #805528;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2);
            text-decoration: none;
        }
        .btn-secondary-luxury {
            background-color: #f0ede9;
            color: #50453b;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-secondary-luxury:hover {
            background-color: #e5e2de;
            color: #1c1c1a;
            text-decoration: none;
        }
        .btn-luxury-danger {
            background-color: #fff0f0;
            color: #d32f2f;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: 1px solid #ffcdd2;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-luxury-danger:hover {
            background-color: #d32f2f;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(211, 47, 47, 0.2);
            text-decoration: none;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .detail-row {
            display: flex;
            padding: 16px 0;
            border-bottom: 1px solid #f0ede9;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            width: 35%;
            color: #50453b;
            font-weight: 600;
            font-size: 14px;
        }
        .detail-value {
            width: 65%;
            color: #1c1c1a;
            font-weight: 500;
            font-size: 15px;
        }
        .luxury-badge {
            background-color: #f0ede9;
            color: #50453b;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            border: 1px solid #d4c3b6;
        }
        .luxury-badge.green {
            background-color: #e2f5ea;
            color: #0b5c2d;
            border: 1px solid #c6ead6;
        }
        .luxury-badge.orange {
            background-color: #ffe8d6;
            color: #9c4221;
            border: 1px solid #f7cbb1;
        }
        .item-image {
            width: 100%;
            height: auto;
            max-height: 300px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid #d4c3b6;
            box-shadow: 0 4px 12px rgba(30, 41, 59, 0.05);
        }
        .no-image-placeholder {
            width: 100%;
            height: 250px;
            background-color: #f6f3ef;
            border-radius: 12px;
            border: 1px dashed #d4c3b6;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #a09386;
        }
    </style>
}

<div class="header-container">
    <div>
        <h2 class="page-title">
            Chi Tiết Món Ăn
        </h2>
        <p class="page-subtitle">Xem thông tin chi tiết của món ăn.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-secondary-luxury">
            <span class="material-symbols-outlined">arrow_back</span> Quay lại danh sách
        </a>
    </div>
</div>

<div class="luxury-card">
    <div style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 600; color: #1c1c1a; margin-bottom: 32px; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined" style="color: #dfa974; font-size: 28px;">restaurant</span>
        @Model.ItemName
    </div>
    
    <div class="row g-4">
        <div class="col-md-7">
            <div class="detail-row" style="padding-top: 0;">
                <div class="detail-label">Tên Món Ăn</div>
                <div class="detail-value fw-bold fs-5">@Model.ItemName</div>
            </div>
            
            <div class="detail-row">
                <div class="detail-label">Danh Mục</div>
                <div class="detail-value">
                    <span class="luxury-badge">
                        <span class="material-symbols-outlined" style="font-size: 16px;">category</span>
                        @(string.IsNullOrEmpty(Model.CategoryName) ? "Chưa phân loại" : Model.CategoryName)
                    </span>
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Giá Bán</div>
                <div class="detail-value text-success fw-bold" style="font-size: 18px; color: #805528 !important;">
                    @Model.Price.ToString("N0") VND
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Trạng Thái Bán</div>
                <div class="detail-value">
                    @if (Model.IsAvailable)
                    {
                        <span class="luxury-badge green">
                            <span class="material-symbols-outlined fill" style="font-size: 16px;">check_circle</span> Đang bán
                        </span>
                    }
                    else
                    {
                        <span class="luxury-badge orange">
                            <span class="material-symbols-outlined" style="font-size: 16px;">remove_shopping_cart</span> Hết hàng
                        </span>
                    }
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Mô Tả / Thành Phần</div>
                <div class="detail-value" style="line-height: 1.6; color: #50453b;">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Không có mô tả" : Model.Description)
                </div>
            </div>
        </div>

        <div class="col-md-5">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.ItemName" class="item-image" onerror="this.onerror=null; this.src=''; this.style.display='none'; document.getElementById('noImage').style.display='flex';" />
                <div id="noImage" class="no-image-placeholder" style="display: none;">
                    <span class="material-symbols-outlined" style="font-size: 48px; color: #d4c3b6;">broken_image</span>
                    <span style="margin-top: 8px;">Lỗi tải ảnh</span>
                </div>
            }
            else
            {
                <div class="no-image-placeholder">
                    <span class="material-symbols-outlined" style="font-size: 48px; color: #d4c3b6;">image_not_supported</span>
                    <span style="margin-top: 8px;">Không có hình ảnh</span>
                </div>
            }
        </div>
    </div>
    
    <hr style="border-color: #e5e2de; margin: 32px 0;" />
    <div style="display: flex; gap: 16px;">
        <a asp-action="Edit" asp-route-id="@Model.MenuItemId" class="btn-luxury">
            <span class="material-symbols-outlined">edit</span> Chỉnh Sửa
        </a>
        <a asp-action="Discontinue" asp-route-id="@Model.MenuItemId" class="btn-luxury-danger">
            <span class="material-symbols-outlined">block</span> Ngừng Bán
        </a>
    </div>
</div>
