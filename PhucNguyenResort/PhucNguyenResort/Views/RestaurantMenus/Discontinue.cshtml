@model PhucNguyenResort.ViewModels.RestaurantMenus.MenuItemDetailViewModel

@{
    ViewData["Title"] = "Discontinue Menu Item";
}

<div class="container-fluid refund-container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="alert alert-danger shadow-sm mb-4" role="alert">
                <h4 class="alert-heading"><i class="fa fa-exclamation-triangle"></i> Are you sure?</h4>
                <p>Are you sure you want to discontinue the menu item <strong>@Model.ItemName</strong>?</p>
                <hr>
                <p class="mb-0 text-muted small">This action will mark the item as 'Out of stock' and it won't be available for new orders.</p>
            </div>

            <div class="card premium-card shadow-sm mb-4 border-danger">
                <div class="premium-card-header bg-danger text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 text-white"><i class="fa fa-ban mr-2"></i> Discontinue Menu Item</h4>
                    <a asp-action="Index" class="btn btn-sm btn-light text-danger fw-bold"><i class="fa fa-arrow-left"></i> Back to List</a>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Item Name</dt>
                        <dd class="col-sm-8 fw-bold">@Model.ItemName</dd>

                        <dt class="col-sm-4 text-muted">Category</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.CategoryName) ? "Uncategorized" : Model.CategoryName)</dd>

                        <dt class="col-sm-4 text-muted">Price</dt>
                        <dd class="col-sm-8 text-success fw-bold">@Model.Price.ToString("N0") VND</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light p-3">
                    <form asp-action="Discontinue" class="d-flex gap-2 justify-content-end">
                        <input type="hidden" asp-for="MenuItemId" />
                        <button type="submit" class="btn btn-danger"><i class="fa fa-ban"></i> Confirm Discontinue</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
