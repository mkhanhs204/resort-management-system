@model PhucNguyenResort.ViewModels.RestaurantMenus.MenuItemDetailViewModel

@{
    ViewData["Title"] = "Ngừng Bán Món Ăn";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528; /* primary */
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b; /* on-surface-variant */
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 32px;
            margin-bottom: 30px;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        .btn-luxury-danger {
            background-color: #fff0f0;
            color: #d32f2f;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: 1px solid #ffcdd2;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-luxury-danger:hover {
            background-color: #d32f2f;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(211, 47, 47, 0.2);
            text-decoration: none;
        }
        .btn-secondary-luxury {
            background-color: #f0ede9;
            color: #50453b;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-secondary-luxury:hover {
            background-color: #e5e2de;
            color: #1c1c1a;
            text-decoration: none;
        }
        .alert-luxury {
            background-color: #fff8e1;
            border: 1px solid #ffecb3;
            border-radius: 12px;
            padding: 20px;
            display: flex;
            align-items: flex-start;
            gap: 16px;
            margin-bottom: 24px;
        }
        .alert-luxury .material-symbols-outlined {
            color: #f57f17;
            font-size: 32px;
        }
        .alert-luxury-content h4 {
            color: #f57f17;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 8px;
        }
        .alert-luxury-content p {
            color: #50453b;
            margin: 0;
            font-size: 14px;
        }
        .detail-row {
            display: flex;
            padding: 12px 0;
            border-bottom: 1px solid #f0ede9;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            width: 30%;
            color: #50453b;
            font-weight: 600;
            font-size: 14px;
        }
        .detail-value {
            width: 70%;
            color: #1c1c1a;
            font-weight: 500;
            font-size: 15px;
        }
    </style>
}

<div class="header-container">
    <div>
        <h2 class="page-title">Ngừng Bán Món Ăn</h2>
        <p class="page-subtitle">Xác nhận chuyển trạng thái món ăn sang hết hàng/ngừng bán.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-secondary-luxury">
            <span class="material-symbols-outlined">arrow_back</span> Quay lại danh sách
        </a>
    </div>
</div>

<div class="alert-luxury">
    <span class="material-symbols-outlined">warning</span>
    <div class="alert-luxury-content">
        <h4>Bạn có chắc chắn muốn ngừng bán món ăn này?</h4>
        <p>Hành động này sẽ cập nhật trạng thái món ăn thành <strong>"Hết hàng"</strong> và khách hàng sẽ không thể đặt món này nữa.</p>
    </div>
</div>

<div class="luxury-card">
    <div style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 600; color: #1c1c1a; margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined" style="color: #d32f2f;">block</span> Đang xử lý: @Model.ItemName
    </div>
    
    <div class="row">
        <div class="col-md-8">
            <div class="detail-row">
                <div class="detail-label">Tên Món Ăn</div>
                <div class="detail-value fw-bold fs-5">@Model.ItemName</div>
            </div>
            
            <div class="detail-row">
                <div class="detail-label">Danh Mục</div>
                <div class="detail-value">@(string.IsNullOrEmpty(Model.CategoryName) ? "Chưa phân loại" : Model.CategoryName)</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Giá Bán</div>
                <div class="detail-value text-success fw-bold">@Model.Price.ToString("N0") VND</div>
            </div>
        </div>
    </div>
    
    <form asp-action="Discontinue" method="post" class="mt-4 pt-4 border-top" style="display: flex; gap: 16px; border-color: #e5e2de !important;">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MenuItemId" />
        <button type="submit" class="btn-luxury-danger">
            <span class="material-symbols-outlined">block</span> Xác Nhận Ngừng Bán
        </button>
        <a asp-action="Index" class="btn-secondary-luxury">
            Hủy bỏ
        </a>
    </form>
</div>
