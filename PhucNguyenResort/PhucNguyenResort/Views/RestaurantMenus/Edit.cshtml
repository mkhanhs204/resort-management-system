@model PhucNguyenResort.ViewModels.RestaurantMenus.MenuItemFormViewModel

@{
    ViewData["Title"] = "Edit Menu Item";
}

<div class="container-fluid refund-container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card premium-card shadow-sm">
                <div class="premium-card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 text-white"><i class="fa fa-pencil mr-2"></i> @ViewData["Title"]</h4>
                    <a asp-action="Index" class="btn btn-sm btn-light text-primary fw-bold"><i class="fa fa-arrow-left"></i> Back to List</a>
                </div>
                <div class="card-body p-4">
                    <partial name="_MenuItemForm" model="Model" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
