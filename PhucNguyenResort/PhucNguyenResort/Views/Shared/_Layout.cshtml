    <script>
        // Simple Intersection Observer for scroll reveal animations
        const observerOptions = {
            threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, observerOptions);

        // Run once DOM is fully loaded
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
            
            // Smooth scroll for anchors
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if(target) {
                        target.scrollIntoView({ behavior: 'smooth' });
                    }
                });
            });

            // Floating Header effect
            window.addEventListener('scroll', () => {
                const header = document.getElementById('main-header');
                const nav = document.getElementById('main-nav');
                const hasBanner = header.getAttribute('data-has-banner') === 'true';

                if (window.scrollY > 50) {
                    if (hasBanner) {
                        header.classList.remove('text-white', 'header-transparent');
                        header.classList.add('text-on-surface');
                    } else {
                        header.classList.add('bg-surface/95');
                    }
                    nav.classList.remove('h-20');
                    nav.classList.add('h-16');
                } else {
                    if (hasBanner) {
                        header.classList.add('text-white', 'header-transparent');
                        header.classList.remove('text-on-surface');
                    } else {
                        header.classList.remove('bg-surface/95');
                    }
                    nav.classList.add('h-20');
                    nav.classList.remove('h-16');
                }
            });

            // Mobile Menu Toggle
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            if (mobileMenuBtn && mobileMenu) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenu.classList.toggle('hidden');
                });
            }
        });
    </script>
    
