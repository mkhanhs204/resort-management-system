                                <a href="#"><i class="fa fa-tripadvisor"></i></a>
                                <a href="#"><i class="fa fa-instagram"></i></a>
                            </div>

                            @if (User.Identity == null || !User.Identity.IsAuthenticated)
                            {
                                <a href="#" class="bk-btn">Đặt Phòng Ngay</a>
                            }

                            <div class="language-option">
                                <img src="https://flagcdn.com/w20/vn.png" alt="VN Flag">
                                <span>VN <i class="fa fa-angle-down"></i></span>
                                <div class="flag-dropdown">
                                    <ul>
                                        <li><a href="#">EN</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Desktop Menu -->
        <div class="menu-item">
            <div class="container">
                <div class="row">
                    <div class="col-lg-2">
                        <div class="logo">
                            <a asp-area="" asp-controller="Home" asp-action="Index" style="text-decoration: none;">
                                <h4 style="color: #19191a; font-family: 'Lora', serif; font-weight: 700; margin: 0; line-height: 1.2;">Phúc Nguyễn<br><span style="color: #dfa974;">Resort</span></h4>
                            </a>
                        </div>
                    </div>

                    <div class="col-lg-10">
                        <div class="nav-menu">
                            <nav class="mainmenu">
                                <ul>
                                    <li class="@IsActive("Home", "Index")">
                                        <a asp-area="" asp-controller="Home" asp-action="Index">
                                            Trang Chủ
                                        </a>
                                    </li>

                                    <li class="@IsActive("Home", "SearchRooms") @IsActive("Bookings", "Create") @IsActive("Home", "RoomDetails")">
                                        <a asp-controller="Home" asp-action="SearchRooms">
                                            Phòng Ngủ
                                        </a>
                                    </li>

                                    <li class="@IsActive("Home", "AboutUs")">
                                        <a asp-area="" asp-controller="Home" asp-action="AboutUs">
                                            Về Chúng Tôi
                                        </a>
                                    </li>


                                    <li class="@IsActive("Home", "Contact")"><a asp-area="" asp-controller="Home" asp-action="Contact">Liên Hệ</a></li>

                                    @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Customer"))
                                    {
                                        <li class="@IsActive("Dashboard")"><a asp-controller="Dashboard" asp-action="Index">Quản Trị</a></li>
                                    }

                                     @if (User.Identity != null && User.Identity.IsAuthenticated)
                                     {
                                         <li style="margin-left: 30px;">
                                             <a href="#">Xin chào, @User.Identity.Name <i class="fa fa-angle-down"></i></a>
                                             <ul class="dropdown">
                                                 <li><a asp-controller="Profile" asp-action="Index">My Profile</a></li>
                                                 <li><a asp-controller="Bookings" asp-action="MyBookings">Lịch sử đặt phòng</a></li>
                                                 <li><a asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
                                             </ul>
                                         </li>
                                     }
                                     else
                                     {
                                         <li class="@IsActive("Account", "Login")"><a asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                                         <li class="@IsActive("Account", "Register")"><a asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                                     }
                                </ul>
                            </nav>

                            <div class="nav-right search-switch">
                                <i class="icon_search"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <!-- Header End -->
    <!-- Main Body Area -->
    @RenderBody()
    <!-- Main Body Area End -->
    <!-- Footer Section Begin -->
