                    <a asp-area="" asp-controller="Home" asp-action="Index">
                        Trang Chủ
                    </a>
                </li>

                <li class="@IsActive("Home", "SearchRooms") @IsActive("Bookings", "Create") @IsActive("Home", "RoomDetails")">
                    <a asp-controller="Home" asp-action="SearchRooms">
                        Phòng Ngủ
                    </a>
                </li>

                <li class="@IsActive("Home", "AboutUs")">
                    <a asp-area="" asp-controller="Home" asp-action="AboutUs">
                        Về Chúng Tôi
                    </a>
                </li>

                <li class="@IsActive("Home", "Blog")"><a href="./blog.html">Tin Tức</a></li>
                <li class="@IsActive("Home", "Contact")"><a asp-area="" asp-controller="Home" asp-action="Contact">Liên Hệ</a></li>
                <li class="@IsActive("Dashboard")"><a asp-controller="Dashboard" asp-action="Index">Quản Trị</a></li>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <li>
                        <a href="#">Xin chào, @User.Identity.Name <i class="fa fa-angle-down"></i></a>
                        <ul class="dropdown">
                            <li><a asp-controller="Profile" asp-action="Index">My Profile</a></li>
                            <li><a asp-controller="Bookings" asp-action="MyBookings">Lịch sử đặt phòng</a></li>
                            <li><a asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
                        </ul>
                    </li>
                }
                else
                {
                    <li><a asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                    <li><a asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                }
            </ul>
        </nav>

        <div id="mobile-menu-wrap"></div>

        <div class="top-social">
            <a href="#"><i class="fa fa-facebook"></i></a>
            <a href="#"><i class="fa fa-twitter"></i></a>
            <a href="#"><i class="fa fa-tripadvisor"></i></a>
            <a href="#"><i class="fa fa-instagram"></i></a>
        </div>

