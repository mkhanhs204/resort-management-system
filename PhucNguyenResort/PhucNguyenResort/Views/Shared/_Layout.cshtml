@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    
    string IsActive(string controller, string action = "")
    {
        bool isControllerMatch = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(action))
        {
            return isControllerMatch ? "flex items-center text-primary border-b-2 border-primary font-semibold pt-1.5 pb-1 whitespace-nowrap" : "flex items-center text-on-secondary-container hover:text-primary transition-colors duration-300 border-b-2 border-transparent pt-1.5 pb-1 whitespace-nowrap";
        }
        bool isActionMatch = string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return isControllerMatch && isActionMatch ? "flex items-center text-primary border-b-2 border-primary font-semibold pt-1.5 pb-1 whitespace-nowrap" : "flex items-center text-on-secondary-container hover:text-primary transition-colors duration-300 border-b-2 border-transparent pt-1.5 pb-1 whitespace-nowrap";
    }
}
<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>@ViewData["Title"] - Phúc Nguyên Resort</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "inverse-on-surface": "#f3f0ec",
                        "error": "#ba1a1a",
                        "tertiary": "#505f76",
                        "on-tertiary-fixed-variant": "#38485d",
                        "on-tertiary-fixed": "#0b1c30",
                        "on-secondary-fixed": "#111c2d",
                        "error-container": "#ffdad6",
                        "secondary-container": "#d5e0f8",
                        "on-secondary-container": "#586377",
                        "on-error-container": "#93000a",
                        "primary-container": "#dfa974",
                        "on-surface": "#1c1c1a",
                        "secondary": "#545f73",
                        "on-primary": "#ffffff",
                        "on-primary-fixed-variant": "#643e13",
                        "surface-container-lowest": "#ffffff",
                        "surface-dim": "#dcdad6",
                        "secondary-fixed-dim": "#bcc7de",
                        "on-tertiary-container": "#37475c",
                        "surface-container": "#f0ede9",
                        "on-secondary-fixed-variant": "#3c475a",
                        "secondary-fixed": "#d8e3fb",
                        "surface-container-low": "#f6f3ef",
                        "outline-variant": "#d4c3b6",
                        "outline": "#827569",
                        "tertiary-fixed-dim": "#b7c8e1",
                        "on-background": "#1c1c1a",
                        "primary-fixed": "#ffdcbe",
                        "inverse-primary": "#f4bc85",
                        "surface-tint": "#805528",
                        "on-error": "#ffffff",
                        "tertiary-fixed": "#d3e4fe",
                        "on-primary-container": "#633d11",
                        "inverse-surface": "#31302e",
                        "surface-variant": "#e5e2de",
                        "on-surface-variant": "#50453b",
                        "tertiary-container": "#a4b5ce",
                        "primary-fixed-dim": "#f4bc85",
                        "background": "#fcf9f5",
                        "surface-container-highest": "#e5e2de",
                        "surface-bright": "#fcf9f5",
                        "on-tertiary": "#ffffff",
                        "on-primary-fixed": "#2c1600",
                        "primary": "#805528",
                        "on-secondary": "#ffffff",
                        "surface-container-high": "#eae8e4",
                        "surface": "#fcf9f5"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "32px",
                        "container-max": "1280px",
                        "section-gap-md": "80px",
                        "stack-sm": "8px",
                        "gutter": "24px",
                        "stack-md": "16px",
                        "section-gap-lg": "120px",
                        "margin-desktop": "64px",
                        "margin-mobile": "20px"
                    },
                    "fontFamily": {
                        "body-lg": ["Inter"],
                        "label-lg": ["Inter"],
                        "headline-sm": ["Playfair Display"],
                        "headline-lg-mobile": ["Playfair Display"],
                        "headline-lg": ["Playfair Display"],
                        "headline-md": ["Playfair Display"],
                        "body-md": ["Inter"],
                        "display-lg-mobile": ["Playfair Display"],
                        "label-sm": ["Inter"],
                        "display-lg": ["Playfair Display"]
                    },
                    "fontSize": {
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                        "label-lg": ["14px", {"lineHeight": "20px", "letterSpacing": "0.05em", "fontWeight": "600"}],
                        "headline-sm": ["24px", {"lineHeight": "32px", "fontWeight": "500"}],
                        "headline-lg-mobile": ["32px", {"lineHeight": "40px", "fontWeight": "600"}],
                        "headline-lg": ["48px", {"lineHeight": "56px", "fontWeight": "600"}],
                        "headline-md": ["32px", {"lineHeight": "40px", "fontWeight": "500"}],
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "display-lg-mobile": ["40px", {"lineHeight": "48px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "label-sm": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                        "display-lg": ["64px", {"lineHeight": "72px", "letterSpacing": "-0.02em", "fontWeight": "700"}]
                    }
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .shadow-ambient {
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
        }
        .hero-overlay {
            background: linear-gradient(to right, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.1) 100%);
        }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #dfa974; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-background text-on-surface font-body-md overflow-x-hidden">
    <!-- TopNavBar -->
    <header class="sticky top-0 w-full z-50 bg-surface backdrop-blur-md border-b border-outline-variant/10 shadow-sm transition-all duration-300" id="main-header">
        <nav class="flex justify-between items-center h-20 px-margin-desktop max-w-container-max mx-auto transition-all duration-300" id="main-nav">
            <a asp-controller="Home" asp-action="Index" class="font-headline-md text-headline-md font-bold text-on-surface hover:text-primary transition-colors whitespace-nowrap mr-8">Phúc Nguyên Resort</a>
            
            <!-- Desktop Nav -->
            <ul class="hidden xl:flex items-center space-x-4 flex-1 justify-center">
                <li><a class="@IsActive("Home", "Index") font-label-lg text-label-lg" asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
                <li><a class="@IsActive("Home", "SearchRooms") font-label-lg text-label-lg" asp-controller="Home" asp-action="SearchRooms">Phòng Ngủ</a></li>
                <li><a class="@IsActive("CustomerTourBooking") font-label-lg text-label-lg" asp-controller="CustomerTourBooking" asp-action="Index">Tour</a></li>
                
                @{
                    bool isServiceActive = currentController.Equals("FoodOrders", StringComparison.OrdinalIgnoreCase) || currentController.Equals("TableReservations", StringComparison.OrdinalIgnoreCase);
                    string serviceActiveStr = isServiceActive ? "flex items-center text-primary border-b-2 border-primary font-semibold pt-1.5 pb-1 whitespace-nowrap" : "flex items-center text-on-secondary-container hover:text-primary transition-colors duration-300 border-b-2 border-transparent pt-1.5 pb-1 whitespace-nowrap";
                }
                <li class="relative group cursor-pointer">
                    <a class="@serviceActiveStr font-label-lg text-label-lg">
                        Dịch Vụ <span class="material-symbols-outlined ml-1 text-[18px]">expand_more</span>
                    </a>
                    <div class="absolute left-0 mt-2 w-52 bg-surface rounded-xl shadow-ambient border border-outline-variant/20 opacity-0 group-hover:opacity-100 invisible group-hover:visible transition-all duration-300 z-50">
                        <ul class="py-2">
                            <li><a class="block px-4 py-2 text-on-surface hover:bg-surface-container hover:text-primary transition-colors" asp-controller="FoodOrders" asp-action="RoomService">Gọi đồ ăn lên phòng</a></li>
                            <li><a class="block px-4 py-2 text-on-surface hover:bg-surface-container hover:text-primary transition-colors" asp-controller="TableReservations" asp-action="Search">Đặt bàn tiệc</a></li>
                        </ul>
                    </div>
                </li>

                <li><a class="@IsActive("Review") font-label-lg text-label-lg" asp-controller="Review" asp-action="PublicList">Đánh Giá</a></li>
                <li><a class="@IsActive("Home", "AboutUs") font-label-lg text-label-lg" asp-controller="Home" asp-action="AboutUs">Về Chúng Tôi</a></li>

                @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Customer"))
                {
                    <li><a class="@IsActive("Dashboard") font-label-lg text-label-lg text-error hover:text-error-container" asp-controller="Dashboard" asp-action="Index">Quản Trị</a></li>
                }
            </ul>

            <div class="hidden xl:flex items-center space-x-4">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="relative group cursor-pointer">
                        <div class="text-on-secondary-container hover:text-primary transition-colors duration-300 font-label-lg text-label-lg flex items-center border-b-2 border-transparent pt-1.5 pb-1 whitespace-nowrap">
                            @User.Identity.Name <span class="material-symbols-outlined ml-1">expand_more</span>
                        </div>
                        <div class="absolute right-0 mt-2 w-56 bg-surface rounded-xl shadow-ambient border border-outline-variant/20 opacity-0 group-hover:opacity-100 invisible group-hover:visible transition-all duration-300 z-50">
                            <ul class="py-2">
                                <li><a class="block px-4 py-2 text-on-surface hover:bg-surface-container hover:text-primary transition-colors" asp-controller="Profile" asp-action="Index">Hồ sơ cá nhân</a></li>
                                <li><a class="block px-4 py-2 text-on-surface hover:bg-surface-container hover:text-primary transition-colors" asp-controller="TableReservations" asp-action="MyReservations">Lịch sử đặt bàn</a></li>
                                <li><a class="block px-4 py-2 text-on-surface hover:bg-surface-container hover:text-primary transition-colors" asp-controller="Bookings" asp-action="MyBookings">Lịch sử đặt phòng</a></li>
                                <li><a class="block px-4 py-2 text-on-surface hover:bg-surface-container hover:text-primary transition-colors" asp-controller="CustomerTourBooking" asp-action="MyTourBookings">Lịch sử đặt tour</a></li>
                                <li class="border-t border-outline-variant/20 mt-1 pt-1"><a class="block px-4 py-2 text-error hover:bg-error-container hover:text-on-error-container transition-colors" asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
                            </ul>
                        </div>
                    </div>
                }
                else
                {
                    <a class="@IsActive("Account", "Login") font-label-lg text-label-lg" asp-controller="Account" asp-action="Login">Đăng Nhập</a>
                }
                
                <a asp-controller="Home" asp-action="SearchRooms" class="bg-primary-container text-on-primary-container px-6 py-2.5 rounded-xl font-label-lg text-label-lg shadow-ambient hover:scale-105 transition-all duration-300 whitespace-nowrap">
                    Đặt Ngay
                </a>
            </div>
            
            <!-- Mobile Menu Button -->
            <button class="xl:hidden text-on-surface hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-3xl">menu</span>
            </button>
        </nav>
    </header>

    <!-- Content -->
    <main class="min-h-screen">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-surface-container-low border-t border-outline-variant/20 w-full py-section-gap-md">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter px-margin-desktop max-w-container-max mx-auto">
            <div class="space-y-6">
                <div class="font-headline-sm text-headline-sm text-primary font-bold">Phúc Nguyên Resort</div>
                <p class="font-body-md text-on-surface-variant/80">
                    Nơi sự tĩnh lặng lên ngôi. Trải nghiệm kỳ nghỉ xa hoa tại một trong những điểm đến đẹp nhất Việt Nam.
                </p>
                <div class="flex space-x-4">
                    <a class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all" href="#">
                        <span class="material-symbols-outlined !text-[20px]">public</span>
                    </a>
                    <a class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all" href="#">
                        <span class="material-symbols-outlined !text-[20px]">photo_camera</span>
                    </a>
                    <a class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all" href="#">
                        <span class="material-symbols-outlined !text-[20px]">play_circle</span>
                    </a>
                </div>
            </div>
            
            <div>
                <h4 class="font-label-lg text-label-lg text-on-surface mb-8 uppercase tracking-widest">Liên Kết</h4>
                <ul class="space-y-4">
                    <li><a class="font-label-sm text-label-sm text-on-tertiary-fixed-variant hover:text-primary transition-colors" asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
                    <li><a class="font-label-sm text-label-sm text-on-tertiary-fixed-variant hover:text-primary transition-colors" asp-controller="Home" asp-action="SearchRooms">Phòng Ngủ</a></li>
                    <li><a class="font-label-sm text-label-sm text-on-tertiary-fixed-variant hover:text-primary transition-colors" asp-controller="CustomerTourBooking" asp-action="Index">Tour</a></li>
                    <li><a class="font-label-sm text-label-sm text-on-tertiary-fixed-variant hover:text-primary transition-colors" asp-controller="Home" asp-action="AboutUs">Về Chúng Tôi</a></li>
                    <li><a class="font-label-sm text-label-sm text-on-tertiary-fixed-variant hover:text-primary transition-colors" asp-controller="Home" asp-action="Contact">Liên Hệ</a></li>
                </ul>
            </div>
            
            <div>
                <h4 class="font-label-lg text-label-lg text-on-surface mb-8 uppercase tracking-widest">Hỗ Trợ</h4>
                <ul class="space-y-4">
                    <li><a class="font-label-sm text-label-sm text-on-tertiary-fixed-variant hover:text-primary transition-colors" href="#">FAQ</a></li>
                    <li><a class="font-label-sm text-label-sm text-on-tertiary-fixed-variant hover:text-primary transition-colors" href="#">Chính Sách Hủy Phòng</a></li>
                    <li><a class="font-label-sm text-label-sm text-on-tertiary-fixed-variant hover:text-primary transition-colors" href="#">Vận Chuyển Sân Bay</a></li>
                    <li><a class="font-label-sm text-label-sm text-on-tertiary-fixed-variant hover:text-primary transition-colors" href="#">Membership</a></li>
                </ul>
            </div>
            
            <div>
                <h4 class="font-label-lg text-label-lg text-on-surface mb-8 uppercase tracking-widest">Nhận Thông Tin</h4>
                <p class="font-body-md text-on-surface-variant/80 mb-6">Đăng ký để nhận ưu đãi bí mật và tin tức từ chúng tôi.</p>
                <div class="flex">
                    <input class="flex-1 bg-surface-container px-4 py-3 rounded-l-lg border-none focus:ring-1 focus:ring-primary text-body-md outline-none" placeholder="Email của bạn" type="email"/>
                    <button class="bg-primary text-white px-4 rounded-r-lg hover:bg-primary/90 transition-colors">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </button>
                </div>
            </div>
        </div>
        
        <div class="max-w-container-max mx-auto px-margin-desktop mt-20 pt-8 border-t border-outline-variant/10 flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
            <span class="font-label-sm text-label-sm text-on-surface-variant/60">&copy; @DateTime.Now.Year Phúc Nguyên Resort. All Rights Reserved.</span>
            <div class="flex space-x-6">
                <span class="font-label-sm text-label-sm text-on-surface-variant/60 hover:text-primary cursor-pointer">English</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant/60 hover:text-primary cursor-pointer">Tiếng Việt</span>
            </div>
        </div>
    </footer>

    <script>
        // Simple Intersection Observer for scroll reveal animations
        const observerOptions = {
            threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, observerOptions);

        // Run once DOM is fully loaded
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
            
            // Smooth scroll for anchors
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if(target) {
                        target.scrollIntoView({ behavior: 'smooth' });
                    }
                });
            });

            // Floating Header effect
            window.addEventListener('scroll', () => {
                const header = document.getElementById('main-header');
                const nav = document.getElementById('main-nav');
                if (window.scrollY > 50) {
                    header.classList.add('bg-surface/95');
                    nav.classList.remove('h-20');
                    nav.classList.add('h-16');
                } else {
                    header.classList.remove('bg-surface/95');
                    nav.classList.add('h-20');
                    nav.classList.remove('h-16');
                }
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
