                            <li><i class="fa fa-phone"></i> +84 901 234 567</li>
                            <li><i class="fa fa-envelope"></i> info@phucnguyenresort.com</li>
                        </ul>
                    </div>

                    <div class="col-lg-6">
                        <div class="tn-right">
                            <div class="top-social">
