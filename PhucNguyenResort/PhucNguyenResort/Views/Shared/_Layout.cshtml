@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    
    bool hasBanner = (currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase)) ||
                     (currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("SearchRooms", StringComparison.OrdinalIgnoreCase)) ||
                     (currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("AboutUs", StringComparison.OrdinalIgnoreCase)) ||
                     (currentController.Equals("CustomerTourBooking", StringComparison.OrdinalIgnoreCase) && (currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase) || currentAction.Equals("Details", StringComparison.OrdinalIgnoreCase))) ||
                     (currentController.Equals("Review", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("PublicList", StringComparison.OrdinalIgnoreCase)) ||
                     (currentController.Equals("FoodOrders", StringComparison.OrdinalIgnoreCase) && !currentAction.Equals("MyOrders", StringComparison.OrdinalIgnoreCase)) ||
                     (currentController.Equals("TableReservations", StringComparison.OrdinalIgnoreCase) && !currentAction.Equals("MyReservations", StringComparison.OrdinalIgnoreCase));

    string IsActive(string controller, string action = "")
    {
        bool isControllerMatch = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        bool isActionMatch = string.IsNullOrEmpty(action) || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

        if (isControllerMatch && isActionMatch)
        {
            return "flex items-center text-primary border-b-2 border-primary font-semibold pt-1.5 pb-1 whitespace-nowrap nav-item active-item";
        }
        return "flex items-center text-on-secondary-container hover:text-primary transition-colors duration-300 border-b-2 border-transparent pt-1.5 pb-1 whitespace-nowrap nav-item";
    }
}
<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>@ViewData["Title"] - Phúc Nguyên Resort</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
