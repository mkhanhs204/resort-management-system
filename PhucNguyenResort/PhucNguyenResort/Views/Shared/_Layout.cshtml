                        "error-container": "#ffdad6",
                        "secondary-container": "#d5e0f8",
                        "on-secondary-container": "#586377",
                        "on-error-container": "#93000a",
                        "primary-container": "#dfa974",
                        "on-surface": "#1c1c1a",
                        "secondary": "#545f73",
                        "on-primary": "#ffffff",
                        "on-primary-fixed-variant": "#643e13",
                        "surface-container-lowest": "#ffffff",
                        "surface-dim": "#dcdad6",
                        "secondary-fixed-dim": "#bcc7de",
                        "on-tertiary-container": "#37475c",
                        "surface-container": "#f0ede9",
                        "on-secondary-fixed-variant": "#3c475a",
                        "secondary-fixed": "#d8e3fb",
                        "surface-container-low": "#f6f3ef",
                        "outline-variant": "#d4c3b6",
                        "outline": "#827569",
                        "tertiary-fixed-dim": "#b7c8e1",
                        "on-background": "#1c1c1a",
                        "primary-fixed": "#ffdcbe",
                        "inverse-primary": "#f4bc85",
                        "surface-tint": "#805528",
                        "on-error": "#ffffff",
                        "tertiary-fixed": "#d3e4fe",
                        "on-primary-container": "#633d11",
                        "inverse-surface": "#31302e",
                        "surface-variant": "#e5e2de",
                        "on-surface-variant": "#50453b",
                        "tertiary-container": "#a4b5ce",
                        "primary-fixed-dim": "#f4bc85",
                        "background": "#fcf9f5",
                        "surface-container-highest": "#e5e2de",
                        "surface-bright": "#fcf9f5",
                        "on-tertiary": "#ffffff",
                        "on-primary-fixed": "#2c1600",
                        "primary": "#805528",
                        "on-secondary": "#ffffff",
                        "surface-container-high": "#eae8e4",
                        "surface": "#fcf9f5"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "32px",
                        "container-max": "1280px",
                        "section-gap-md": "80px",
                        "stack-sm": "8px",
                        "gutter": "24px",
                        "stack-md": "16px",
                        "section-gap-lg": "120px",
                        "margin-desktop": "64px",
                        "margin-mobile": "20px"
                    },
                    "fontFamily": {
                        "body-lg": ["Inter"],
                        "label-lg": ["Inter"],
                        "headline-sm": ["Playfair Display"],
                        "headline-lg-mobile": ["Playfair Display"],
                        "headline-lg": ["Playfair Display"],
                        "headline-md": ["Playfair Display"],
                        "body-md": ["Inter"],
                        "display-lg-mobile": ["Playfair Display"],
                        "label-sm": ["Inter"],
                        "display-lg": ["Playfair Display"]
                    },
                    "fontSize": {
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                        "label-lg": ["14px", {"lineHeight": "20px", "letterSpacing": "0.05em", "fontWeight": "600"}],
                        "headline-sm": ["24px", {"lineHeight": "32px", "fontWeight": "500"}],
                        "headline-lg-mobile": ["32px", {"lineHeight": "40px", "fontWeight": "600"}],
                        "headline-lg": ["48px", {"lineHeight": "56px", "fontWeight": "600"}],
                        "headline-md": ["32px", {"lineHeight": "40px", "fontWeight": "500"}],
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "display-lg-mobile": ["40px", {"lineHeight": "48px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "label-sm": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                        "display-lg": ["64px", {"lineHeight": "72px", "letterSpacing": "-0.02em", "fontWeight": "700"}]
                    }
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .shadow-ambient {
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
        }
        .hero-overlay {
            background: linear-gradient(to right, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.1) 100%);
        }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #dfa974; }
        
        .header-transparent {
            background-color: transparent !important;
            border-color: transparent !important;
            box-shadow: none !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }
        .header-transparent .nav-item {
            color: #ffffff !important;
        }
        .header-transparent .nav-item:hover {
            color: #ffffff !important;
            opacity: 0.8;
        }
        .header-transparent .nav-item.active-item {
            color: #ffffff !important;
            border-bottom-color: #ffffff !important;
        }
        .header-transparent .brand-text {
            color: #ffffff !important;
        }
        .header-transparent .brand-text:hover {
            opacity: 0.8;
        }
        .header-transparent #mobile-menu-btn {
            color: #ffffff !important;
        }
        .header-transparent .btn-book-now {
            background-color: #ffffff !important;
            color: #805528 !important; /* primary color */
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-background text-on-surface font-body-md overflow-x-hidden">
    <!-- TopNavBar -->
    <header class="@(hasBanner ? "fixed top-0 w-full z-50 bg-surface backdrop-blur-md border-b border-outline-variant/10 shadow-sm transition-all duration-300 text-white header-transparent" : "sticky top-0 w-full z-50 bg-surface backdrop-blur-md border-b border-outline-variant/10 shadow-sm transition-all duration-300 text-on-surface")" id="main-header" data-has-banner="@hasBanner.ToString().ToLower()">
        <nav class="flex justify-between items-center h-20 px-margin-desktop max-w-container-max mx-auto transition-all duration-300 gap-8" id="main-nav">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[32px]">spa</span>
                <a asp-controller="Home" asp-action="Index" class="font-headline-md text-headline-md font-bold text-on-surface hover:text-primary transition-colors whitespace-nowrap mr-8 brand-text">Phúc Nguyên Resort</a>
            </div>
            
            <!-- Desktop Nav -->
            <ul class="hidden xl:flex items-center space-x-4 flex-1 justify-center">
                <li><a class="@IsActive("Home", "Index") font-label-lg text-label-lg" asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
                <li><a class="@IsActive("Home", "SearchRooms") font-label-lg text-label-lg" asp-controller="Home" asp-action="SearchRooms">Phòng Ngủ</a></li>
                <li><a class="@IsActive("CustomerTourBooking") font-label-lg text-label-lg" asp-controller="CustomerTourBooking" asp-action="Index">Tour</a></li>
                
                @{
                    bool isServiceActive = currentController.Equals("FoodOrders", StringComparison.OrdinalIgnoreCase) || currentController.Equals("TableReservations", StringComparison.OrdinalIgnoreCase);
                    string serviceActiveStr = isServiceActive ? "flex items-center text-primary border-b-2 border-primary font-semibold pt-1.5 pb-1 whitespace-nowrap nav-item active-item" : "flex items-center text-on-secondary-container hover:text-primary transition-colors duration-300 border-b-2 border-transparent pt-1.5 pb-1 whitespace-nowrap nav-item";
                }
                <li class="relative group cursor-pointer">
                    <a class="@serviceActiveStr font-label-lg text-label-lg">
                        Dịch Vụ <span class="material-symbols-outlined ml-1 text-[18px]">expand_more</span>
                    </a>
                    <div class="absolute left-0 mt-2 w-52 bg-surface rounded-xl shadow-ambient border border-outline-variant/20 opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all duration-300 z-50 before:absolute before:-top-4 before:left-0 before:w-full before:h-4 before:content-['']">
                        <ul class="py-2">
                            <li><a class="block px-4 py-2 text-on-surface hover:bg-surface-container hover:text-primary transition-colors" asp-controller="FoodOrders" asp-action="RoomService">Gọi đồ ăn lên phòng</a></li>
                            <li><a class="block px-4 py-2 text-on-surface hover:bg-surface-container hover:text-primary transition-colors" asp-controller="TableReservations" asp-action="Search">Đặt bàn tiệc</a></li>
                        </ul>
                    </div>
                </li>

                <li><a class="@IsActive("Review") font-label-lg text-label-lg" asp-controller="Review" asp-action="PublicList">Đánh Giá</a></li>
                <li><a class="@IsActive("Home", "AboutUs") font-label-lg text-label-lg" asp-controller="Home" asp-action="AboutUs">Về Chúng Tôi</a></li>

                @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Customer"))
                {
                    <li><a class="@IsActive("Dashboard") font-label-lg text-label-lg text-error hover:text-error-container" asp-controller="Dashboard" asp-action="Index">Quản Trị</a></li>
                }
            </ul>

            <div class="hidden xl:flex items-center space-x-4">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <!-- Notification Bell -->
                    <div class="relative">
                        <button id="notification-bell" class="relative text-on-secondary-container hover:text-primary transition-colors duration-300 p-1 nav-item" title="Thông báo">
                            <span class="material-symbols-outlined text-[24px]">notifications</span>
                            <span id="notification-badge" class="hidden absolute -top-1 -right-1 min-w-[18px] h-[18px] bg-error text-on-error text-[10px] font-bold rounded-full flex items-center justify-center px-1 leading-none">0</span>
                        </button>
                        <!-- Notification Dropdown -->
                        <div id="notification-dropdown" class="hidden opacity-0 scale-95 absolute right-[-240px] mt-3 w-96 bg-surface rounded-xl shadow-ambient border border-outline-variant/20 transition-all duration-200 z-50 overflow-hidden">
                            <div class="px-4 py-3 border-b border-outline-variant/20 flex justify-between items-center bg-surface-container-low">
                                <h4 class="font-label-lg text-on-surface font-bold">Thông báo</h4>
                                <button id="notification-mark-all" class="text-primary text-[12px] font-semibold hover:underline">Đọc tất cả</button>
                            </div>
                            <div id="notification-list" class="max-h-[400px] overflow-y-auto"></div>
                            <div id="notification-empty" class="hidden px-4 py-10 text-center">
                                <span class="material-symbols-outlined text-4xl text-on-surface-variant/30 mb-2">notifications_off</span>
                                <p class="text-on-surface-variant text-[13px]">Chưa có thông báo nào</p>
                            </div>
                        </div>
                    </div>
                    <div class="relative group cursor-pointer">
                        <div class="text-on-secondary-container hover:text-primary transition-colors duration-300 font-label-lg text-label-lg flex items-center border-b-2 border-transparent pt-1.5 pb-1 whitespace-nowrap nav-item">
                            @User.Identity.Name <span class="material-symbols-outlined ml-1">expand_more</span>
                        </div>
                        <div class="absolute right-0 mt-2 w-56 bg-surface rounded-xl shadow-ambient border border-outline-variant/20 opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all duration-300 z-50 before:absolute before:-top-4 before:left-0 before:w-full before:h-4 before:content-['']">
                            <ul class="py-2">
                                <li><a class="block px-4 py-2 text-on-surface hover:bg-surface-container hover:text-primary transition-colors" asp-controller="Profile" asp-action="Index">Hồ sơ cá nhân</a></li>
                                <li><a class="block px-4 py-2 text-on-surface hover:bg-surface-container hover:text-primary transition-colors" asp-controller="TableReservations" asp-action="MyReservations">Lịch sử đặt bàn</a></li>
                                <li><a class="block px-4 py-2 text-on-surface hover:bg-surface-container hover:text-primary transition-colors" asp-controller="FoodOrders" asp-action="MyOrders">Lịch sử đặt đồ ăn</a></li>
                                <li><a class="block px-4 py-2 text-on-surface hover:bg-surface-container hover:text-primary transition-colors" asp-controller="Bookings" asp-action="MyBookings">Lịch sử đặt phòng</a></li>
                                <li><a class="block px-4 py-2 text-on-surface hover:bg-surface-container hover:text-primary transition-colors" asp-controller="CustomerTourBooking" asp-action="MyTourBookings">Lịch sử đặt tour</a></li>
                                <li class="border-t border-outline-variant/20 mt-1 pt-1"><a class="block px-4 py-2 text-error hover:bg-error-container hover:text-on-error-container transition-colors" asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
                            </ul>
                        </div>
                    </div>
                }
                else
                {
                    <a class="@IsActive("Account", "Login") font-label-lg text-label-lg" asp-controller="Account" asp-action="Login">Đăng Nhập</a>
                }
                
                <a asp-controller="Home" asp-action="SearchRooms" class="bg-primary-container text-on-primary-container px-6 py-2.5 rounded-xl font-label-lg text-label-lg shadow-ambient hover:scale-105 transition-all duration-300 whitespace-nowrap btn-book-now">
                    Đặt Ngay
                </a>
            </div>
            
            <!-- Mobile Menu Button -->
            <button id="mobile-menu-btn" class="xl:hidden text-on-surface hover:text-primary transition-colors">
                <span class="material-symbols-outlined text-3xl">menu</span>
            </button>
        </nav>

        <!-- Mobile Menu Dropdown -->
        <div id="mobile-menu" class="hidden xl:hidden bg-surface border-t border-outline-variant/10 absolute top-full left-0 w-full shadow-ambient max-h-[80vh] overflow-y-auto">
            <ul class="flex flex-col py-4 px-margin-mobile space-y-2">
                <li><a class="block font-label-lg text-label-lg text-on-surface hover:text-primary" asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
                <li><a class="block font-label-lg text-label-lg text-on-surface hover:text-primary" asp-controller="Home" asp-action="SearchRooms">Phòng Ngủ</a></li>
                <li><a class="block font-label-lg text-label-lg text-on-surface hover:text-primary" asp-controller="CustomerTourBooking" asp-action="Index">Tour</a></li>
                <li>
                    <div class="font-label-lg text-label-lg text-on-surface mb-2 font-bold">Dịch Vụ</div>
                    <ul class="pl-4 space-y-2 border-l-2 border-primary/20">
                        <li><a class="block font-label-sm text-on-surface hover:text-primary" asp-controller="FoodOrders" asp-action="RoomService">Gọi đồ ăn lên phòng</a></li>
                        <li><a class="block font-label-sm text-on-surface hover:text-primary" asp-controller="TableReservations" asp-action="Search">Đặt bàn tiệc</a></li>
                    </ul>
                </li>
                <li><a class="block font-label-lg text-label-lg text-on-surface hover:text-primary" asp-controller="Review" asp-action="PublicList">Đánh Giá</a></li>
                <li><a class="block font-label-lg text-label-lg text-on-surface hover:text-primary" asp-controller="Home" asp-action="AboutUs">Về Chúng Tôi</a></li>

                @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Customer"))
                {
                    <li><a class="block font-label-lg text-label-lg text-error hover:text-error-container" asp-controller="Dashboard" asp-action="Index">Quản Trị</a></li>
                }
                
                <li class="border-t border-outline-variant/20 pt-4 mt-2">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="font-label-lg text-label-lg text-on-surface mb-2 font-bold">@User.Identity.Name</div>
                    <ul class="pl-4 space-y-2 border-l-2 border-primary/20">
                        <li><a class="block font-label-sm text-on-surface hover:text-primary" asp-controller="Profile" asp-action="Index">Hồ sơ cá nhân</a></li>
                        <li><a class="block font-label-sm text-on-surface hover:text-primary" asp-controller="TableReservations" asp-action="MyReservations">Lịch sử đặt bàn</a></li>
                        <li><a class="block font-label-sm text-on-surface hover:text-primary" asp-controller="FoodOrders" asp-action="MyOrders">Lịch sử đặt đồ ăn</a></li>
                        <li><a class="block font-label-sm text-on-surface hover:text-primary" asp-controller="Bookings" asp-action="MyBookings">Lịch sử đặt phòng</a></li>
                        <li><a class="block font-label-sm text-on-surface hover:text-primary" asp-controller="CustomerTourBooking" asp-action="MyTourBookings">Lịch sử đặt tour</a></li>
                        <li><a class="block font-label-sm text-error hover:text-error" asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
                    </ul>
                }
                else
                {
                    <a class="block font-label-lg text-label-lg text-primary" asp-controller="Account" asp-action="Login">Đăng Nhập</a>
                }
                </li>
                <li class="pt-2">
                    <a asp-controller="Home" asp-action="SearchRooms" class="block text-center bg-primary-container text-on-primary-container px-6 py-2.5 rounded-xl font-label-lg text-label-lg">
                        Đặt Ngay
                    </a>
                </li>
            </ul>
        </div>
    </header>

    <!-- Content -->
    <main class="min-h-screen">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-surface-container-low border-t border-outline-variant/20 w-full pt-section-gap-md pb-8">
        <div class="px-margin-desktop max-w-container-max mx-auto">
            

            <!-- Main Footer Content -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-y-10 lg:gap-x-8 mb-12">
                
                <!-- Brand & Description (Col span 4) -->
                <div class="lg:col-span-4 space-y-6">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[32px]">spa</span>
                        <span class="font-headline-sm text-headline-sm text-primary font-bold tracking-wide">Phúc Nguyên Resort</span>
                    </div>
                    <p class="font-body-md text-on-surface-variant/80 leading-relaxed pr-4">
                        Nơi sự tĩnh lặng lên ngôi. Trải nghiệm kỳ nghỉ xa hoa tại một trong những điểm đến nghỉ dưỡng sinh thái hàng đầu Việt Nam. Khám phá vẻ đẹp thiên nhiên hùng vĩ và dịch vụ đẳng cấp quốc tế.
                    </p>
                    <div class="flex space-x-3 pt-2">
                        <a class="w-10 h-10 rounded-full bg-surface border border-outline-variant/30 flex items-center justify-center text-on-surface-variant hover:bg-primary hover:text-white hover:border-primary transition-all shadow-sm" href="#" title="Facebook">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
