    <!-- Chatbox Script -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("chatboxToggleBtn");
            const chatWindow = document.getElementById("chatboxWindow");
            const closeBtn = document.getElementById("chatboxCloseBtn");
            const sendBtn = document.getElementById("chatboxSendBtn");
            const inputField = document.getElementById("chatboxInput");
            const messagesContainer = document.getElementById("chatboxMessages");

            // Restore chat history from sessionStorage
            let chatHistory = JSON.parse(sessionStorage.getItem("chatHistory")) || [];

            // Toggle chatbox window
            toggleBtn.addEventListener("click", () => {
                chatWindow.classList.add("active");
                toggleBtn.style.display = "none";
                inputField.focus();
            });

            closeBtn.addEventListener("click", () => {
                chatWindow.classList.remove("active");
                setTimeout(() => {
                    toggleBtn.style.display = "flex";
                }, 300);
            });

            // Initialize Chat Box
            if (chatHistory.length > 0) {
                chatHistory.forEach(msg => {
                    appendMessage(msg.role === "model" ? "bot" : "user", msg.text);
                });
                setTimeout(scrollToBottom, 100);
            } else {
                appendMessage("bot", "Xin kính chào Quý khách! Tôi là Trợ lý ảo của Phúc Nguyễn Resort. Quý khách cần hỗ trợ thêm thông tin về giá phòng ngủ, các chương trình tour du lịch hay thực đơn nhà hàng thế nào ạ?");
            }

            // Send message handler
            function handleSend() {
                const text = inputField.value.trim();
                if (!text) return;

                appendMessage("user", text);
                inputField.value = "";

                const loadingId = appendTypingIndicator();

                fetch("/api/chat/message", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        message: text,
                        history: chatHistory
                    })
                })
                .then(res => res.json())
                .then(data => {
                    removeTypingIndicator(loadingId);

                    const botResponse = data.response || "Rất tiếc, đã có sự cố kết nối. Quý khách vui lòng thử lại.";
                    appendMessage("bot", botResponse);

                    chatHistory.push({ role: "user", text: text });
                    chatHistory.push({ role: "model", text: botResponse });

                    if (chatHistory.length > 12) {
                        chatHistory.shift();
                        chatHistory.shift();
                    }

                    sessionStorage.setItem("chatHistory", JSON.stringify(chatHistory));
                })
                .catch(err => {
                    console.error(err);
                    removeTypingIndicator(loadingId);
                    appendMessage("bot", "Hệ thống kết nối bận, xin vui lòng kiểm tra đường truyền và thử lại.");
                });
            }

            sendBtn.addEventListener("click", handleSend);
            inputField.addEventListener("keypress", (e) => {
                if (e.key === "Enter") {
                    handleSend();
                }
            });

            function appendMessage(sender, text) {
                const msgDiv = document.createElement("div");
                msgDiv.classList.add("message", sender);

                if (sender === "bot") {
                    msgDiv.innerHTML = formatMarkdown(text);
                } else {
                    msgDiv.textContent = text;
                }

                messagesContainer.appendChild(msgDiv);
                scrollToBottom();
            }

            function appendTypingIndicator() {
                const id = "loading_" + Date.now();
                const loadingDiv = document.createElement("div");
                loadingDiv.id = id;
                loadingDiv.classList.add("typing-indicator");
                loadingDiv.innerHTML = `
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                `;
                messagesContainer.appendChild(loadingDiv);
                scrollToBottom();
                return id;
            }

            function removeTypingIndicator(id) {
                const loadingDiv = document.getElementById(id);
                if (loadingDiv) {
                    loadingDiv.remove();
                }
            }

            function scrollToBottom() {
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            }

            function formatMarkdown(text) {
                let html = text;
                // Line breaks
                html = html.replace(/\n/g, "<br>");
                // Bold **text**
                html = html.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
                
                // Clean markdown lists
                const lines = text.split('\n');
                let inList = false;
                let result = [];
              
                for (let i = 0; i < lines.length; i++) {
                    let line = lines[i].trim();
                    if (line.startsWith('* ') || line.startsWith('- ')) {
                        if (!inList) {
                            result.push('<ul>');
                            inList = true;
                        }
                        result.push('<li>' + line.substring(2).replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>") + '</li>');
                    } else {
                        if (inList) {
                            result.push('</ul>');
                            inList = false;
                        }
                        if (line) {
                            result.push('<p>' + line.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>") + '</p>');
                        }
                    }
                }
                if (inList) {
                    result.push('</ul>');
                }
                
                // Regex match markdown links like [Text](Url) and turn them into styled buttons/links
                let output = result.join('');
                output = output.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
                
                return output;
            }
        });
    </script>
    
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" integrity="sha512-7SRCYIJtR6F3j6gL65UMR2r97xCkSIR0sP/1mQzHIZCy0rQiONAiCWIjIFFlYHEudGLaO+/bU4v7hvBsCjUDw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
        <script src="~/js/notifications.js"></script>
    }
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
