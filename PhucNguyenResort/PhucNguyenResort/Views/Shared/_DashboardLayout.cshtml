<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dashboard</title>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css?family=Lora:400,700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Cabin:400,500,600,700&display=swap" rel="stylesheet">

    <!-- Css Styles from template to maintain consistent UI components -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css" type="text/css">
    <link rel="stylesheet" href="~/css/font-awesome.min.css" type="text/css">
    <link rel="stylesheet" href="~/css/elegant-icons.css" type="text/css">
    <link rel="stylesheet" href="~/css/flaticon.css" type="text/css">
    <link rel="stylesheet" href="~/css/nice-select.css" type="text/css">
    <link rel="stylesheet" href="~/css/style.css" type="text/css">
    
    <!-- Dashboard specific styles -->
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" type="text/css">
</head>
<body>

    <div id="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <a href="/" style="text-decoration: none; display: block;">
                    <h3>PhucNguyen</h3>
                    <span style="color: #aaa; font-size: 13px; display: block; margin-top: 3px; font-weight: normal; letter-spacing: 0.5px;">Resort Management</span>
                </a>
            </div>

            <ul class="list-unstyled components">
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <a href="/Dashboard"><i class="fa fa-dashboard"></i> Overview</a>
                </li>
                
                <!-- Admin & Business Manager Section -->
                @if (User.IsInRole("System Admin") || User.IsInRole("Business Manager"))
                {
                    <li>
                        <p>MANAGEMENT</p>
                    </li>
                    @if (User.IsInRole("System Admin"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "StaffAccounts" ? "active" : "")">
                            <a asp-controller="StaffAccounts" asp-action="Index"><i class="fa fa-users"></i> Staff Accounts</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Roles" ? "active" : "")">
                            <a href="#"><i class="fa fa-shield"></i> System Roles</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Settings" ? "active" : "")">
                            <a href="#"><i class="fa fa-cogs"></i> System Management</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Backup" ? "active" : "")">
                            <a href="#"><i class="fa fa-database"></i> Backup & Restore</a>
                        </li>
                    }
                    @if (User.IsInRole("Business Manager"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active" : "")">
                            <a href="#"><i class="fa fa-bar-chart"></i> Business Reports</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Review" ? "active" : "")">
                            <a asp-controller="Review" asp-action="Manage"><i class="fa fa-star"></i> Customer Reviews</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Refunds" ? "active" : "")">
                            <a asp-controller="Refunds" asp-action="Index"><i class="fa fa-money"></i> Refunds</a>
                        </li>
                    }
                }

                @if (User.IsInRole("Receptionist") || User.IsInRole("Business Manager") || User.IsInRole("Housekeeping Staff"))
                {
                    <!-- Room Management -->
                    <li>
                        <p>ROOMS</p>
                    </li>
                    @if (User.IsInRole("Receptionist") || User.IsInRole("Business Manager"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reception" ? "active" : "")">
                            <a asp-controller="Reception" asp-action="Index"><i class="fa fa-calendar-check-o"></i> Manage Bookings</a>
                        </li>
                    }
                    @if (User.IsInRole("Receptionist") || User.IsInRole("Housekeeping Staff") || User.IsInRole("Business Manager"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Rooms" ? "active" : "")">
                            <a asp-controller="Rooms" asp-action="Index"><i class="fa fa-bed"></i> Manage Rooms</a>
                        </li>
                    }
                    @if (User.IsInRole("Business Manager"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "RoomCategories" ? "active" : "")">
                            <a asp-controller="RoomCategories" asp-action="Index"><i class="fa fa-tags"></i> Room Categories</a>
                        </li>
                    }
                    @if (User.IsInRole("Housekeeping Staff"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Housekeeping" ? "active" : "")">
                            <a href="#"><i class="fa fa-paint-brush"></i> Housekeeping</a>
                        </li>
                    }
                }

                @if (User.IsInRole("Maintenance Staff"))
                {
                    <!-- Maintenance Section -->
                    <li>
                        <p>MAINTENANCE</p>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Maintenance" ? "active" : "")">
                        <a href="#"><i class="fa fa-wrench"></i> Service Requests</a>
                    </li>
                }

                @if (User.IsInRole("Business Manager") || User.IsInRole("F&B Staff") || User.IsInRole("Kitchen Staff"))
                {
                    <!-- F&B and Kitchen Section -->
                    <li>
                        <p>FOOD & BEVERAGE</p>
                    </li>
                    @if (User.IsInRole("Business Manager") || User.IsInRole("F&B Staff"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "MenuCategories" ? "active" : "")">
                            <a asp-controller="MenuCategories" asp-action="Index"><i class="fa fa-list"></i> Menu Categories</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "RestaurantMenus" ? "active" : "")">
                            <a asp-controller="RestaurantMenus" asp-action="Index"><i class="fa fa-coffee"></i> Restaurant Menus</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Tables" ? "active" : "")">
                            <a asp-controller="Tables" asp-action="Index"><i class="fa fa-table"></i> Manage Tables</a>
                        </li>
                    }
                    @if (User.IsInRole("F&B Staff") || User.IsInRole("Kitchen Staff"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "FoodOrders" ? "active" : "")">
                            <a asp-controller="Dashboard" asp-action="FoodOrders"><i class="fa fa-cutlery"></i> Orders</a>
                        </li>
                    }
                    @if (User.IsInRole("Kitchen Staff"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Inventory" ? "active" : "")">
                            <a href="#"><i class="fa fa-archive"></i> Kitchen Inventory</a>
                        </li>
                    }
                }

                @if (User.IsInRole("Business Manager") || User.IsInRole("Tour Guide"))
                {
                    <!-- Services & Tours -->
                    <li>
                        <p>SERVICES & TOURS</p>
                    </li>
                    @if (User.IsInRole("Business Manager"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Tours" ? "active" : "")">
                            <a asp-controller="Tours" asp-action="Index"><i class="fa fa-map-o"></i> Manage Tours</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "TourSchedules" ? "active" : "")">
                            <a asp-controller="TourSchedules" asp-action="Index"><i class="fa fa-calendar"></i> Tour Schedules</a>
                        </li>
                    }
                    else if (User.IsInRole("Tour Guide"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Tours" ? "active" : "")">
                            <a asp-controller="Tours" asp-action="Index"><i class="fa fa-map-o"></i> Tour Catalog</a>
                        </li>
                    }
                }
            </ul>
        </nav>

        <!-- Page Content -->
        <div id="content">
            
            <!-- Top Navbar -->
            <nav class="dashboard-nav">
                <div class="nav-left">
                    <button type="button" id="sidebarCollapse" class="btn btn-outline-dark d-md-none">
                        <i class="fa fa-bars"></i>
                    </button>
                    <span class="ml-3" style="font-family: 'Lora', serif; font-size: 20px; font-weight: bold;">Dashboard</span>
                </div>
                <div class="nav-right">
                    <div class="user-profile dropdown">
                        <img src="~/img/blog/blog-1.jpg" alt="User">
                        <span>@(User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : "Staff Member") <i class="fa fa-angle-down"></i></span>
                    </div>
                    <a href="/" class="btn btn-sm btn-outline-secondary" title="View Website"><i class="fa fa-globe"></i></a>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-sm btn-danger" title="Logout"><i class="fa fa-sign-out"></i></a>
                </div>
            </nav>

            <!-- Main Body -->
            <div class="main-body">
                @RenderBody()
            </div>

        </div>
    </div>

    <!-- Js Plugins -->
    <script src="~/js/jquery-3.3.1.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/jquery.nice-select.min.js"></script>
    <script src="~/js/main.js"></script>

    <script>
        $(document).ready(function () {
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('active');
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
