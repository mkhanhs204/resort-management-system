<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dashboard</title>

    <link href="https://fonts.googleapis.com/css?family=Lora:400,700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Cabin:400,500,600,700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>

    <link rel="stylesheet" href="~/css/bootstrap.min.css" type="text/css">
    <link rel="stylesheet" href="~/css/font-awesome.min.css" type="text/css">
    <link rel="stylesheet" href="~/css/elegant-icons.css" type="text/css">
    <link rel="stylesheet" href="~/css/flaticon.css" type="text/css">
    <link rel="stylesheet" href="~/css/nice-select.css" type="text/css">
    <link rel="stylesheet" href="~/css/style.css" type="text/css">
    
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" type="text/css">
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div id="wrapper">
        <nav id="sidebar">
            <div class="sidebar-header" style="text-align: center; padding: 20px 10px;">
                <a href="/" style="text-decoration: none; display: block;">
                    <h3 style="font-family: 'Playfair Display', serif; font-weight: 700; color: #dfa974; margin-bottom: 0;">Phúc Nguyên</h3>
                    <span style="color: #bcc7de; font-size: 13px; display: block; margin-top: 4px; font-family: 'Inter', sans-serif; letter-spacing: 0.5px;">Resort Management</span>
                </a>
            </div>

            <ul class="list-unstyled components">
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" && ViewContext.RouteData.Values["Action"]?.ToString() != "FinancialReport" && ViewContext.RouteData.Values["Action"]?.ToString() != "TableReservations" && ViewContext.RouteData.Values["Action"]?.ToString() != "FoodOrders" ? "active" : "")">
                    <a href="/Dashboard"><i class="fa fa-dashboard"></i> Overview</a>
                </li>
                
                @if (User.IsInRole("System Admin") || User.IsInRole("Business Manager"))
                {
                    <li>
                        <p>QUẢN LÝ CHUNG</p>
                    </li>
                    @if (User.IsInRole("System Admin"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "StaffAccounts" ? "active" : "")">
                            <a asp-controller="StaffAccounts" asp-action="Index"><i class="fa fa-users"></i> Tài Khoản Nhân Viên</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Roles" ? "active" : "")">
                            <a href="#"><i class="fa fa-shield"></i> Vai Trò Hệ Thống</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Settings" ? "active" : "")">
                            <a href="#"><i class="fa fa-cogs"></i> Cài Đặt Hệ Thống</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Backup" ? "active" : "")">
                            <a href="#"><i class="fa fa-database"></i> Sao Lưu & Phục Hồi</a>
                        </li>
                    }
                    @if (User.IsInRole("Business Manager"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "FinancialReport" ? "active" : "")">
                            <a asp-controller="Dashboard" asp-action="FinancialReport"><i class="fa fa-bar-chart"></i> Business Reports</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Review" ? "active" : "")">
                            <a asp-controller="Review" asp-action="Manage"><i class="fa fa-star"></i> Đánh Giá Của Khách</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Refunds" ? "active" : "")">
                            <a asp-controller="Refunds" asp-action="Index"><i class="fa fa-money"></i> Quản Lý Hoàn Tiền</a>
                        </li>
                    }
                }

                @if (User.IsInRole("Receptionist") || User.IsInRole("Business Manager") || User.IsInRole("Housekeeping Staff"))
                {
                    <li>
                        <p>PHÒNG NGHỈ</p>
                    </li>
                    @if (User.IsInRole("Receptionist") || User.IsInRole("Business Manager"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reception" ? "active" : "")">
                            <a asp-controller="Reception" asp-action="Index"><i class="fa fa-calendar-check-o"></i> Quản Lý Đặt Phòng</a>
                        </li>
                    }
                    @if (User.IsInRole("Receptionist") || User.IsInRole("Housekeeping Staff") || User.IsInRole("Business Manager"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Rooms" ? "active" : "")">
                            <a asp-controller="Rooms" asp-action="Index"><i class="fa fa-bed"></i> Quản Lý Phòng</a>
                        </li>
                    }
                    @if (User.IsInRole("Business Manager"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "RoomCategories" ? "active" : "")">
                            <a asp-controller="RoomCategories" asp-action="Index"><i class="fa fa-tags"></i> Hạng Phòng</a>
                        </li>
                    }
                    @if (User.IsInRole("Housekeeping Staff"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Housekeeping" ? "active" : "")">
                            <a href="#"><i class="fa fa-paint-brush"></i> Dọn Phòng</a>
                        </li>
                    }
                }

                @if (User.IsInRole("Maintenance Staff"))
                {
                    <li>
                        <p>BẢO TRÌ</p>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Maintenance" ? "active" : "")">
                        <a href="#"><i class="fa fa-wrench"></i> Yêu Cầu Sửa Chữa</a>
                    </li>
                }

                @if (User.IsInRole("Business Manager") || User.IsInRole("F&B Staff") || User.IsInRole("Kitchen Staff"))
                {
                    <li>
                        <p>NHÀ HÀNG & ẨM THỰC</p>
                    </li>
                    @if (User.IsInRole("Business Manager") || User.IsInRole("F&B Staff"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "MenuCategories" ? "active" : "")">
                            <a asp-controller="MenuCategories" asp-action="Index"><i class="fa fa-list"></i> Danh Mục Món Ăn</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "RestaurantMenus" ? "active" : "")">
                            <a asp-controller="RestaurantMenus" asp-action="Index"><i class="fa fa-coffee"></i> Quản Lý Món Ăn</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Tables" ? "active" : "")">
                            <a asp-controller="Tables" asp-action="Index"><i class="fa fa-table"></i> Quản Lý Bàn Ăn</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "TableReservations" ? "active" : "")">
                            <a asp-controller="Dashboard" asp-action="TableReservations"><i class="fa fa-calendar-check-o"></i> Quản Lý Đặt Bàn</a>
                        </li>
                    }
                    @if (User.IsInRole("F&B Staff") || User.IsInRole("Kitchen Staff"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "FoodOrders" ? "active" : "")">
                            <a asp-controller="Dashboard" asp-action="FoodOrders"><i class="fa fa-cutlery"></i> Đơn Gọi Món</a>
                        </li>
                    }
                    @if (User.IsInRole("Kitchen Staff"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Inventory" ? "active" : "")">
                            <a href="#"><i class="fa fa-archive"></i> Kho Bếp</a>
                        </li>
                    }
                }

                @if (User.IsInRole("Business Manager") || User.IsInRole("Tour Guide") || User.IsInRole("Hướng Dẫn Viên"))
                {
                    <li>
                        <p>DỊCH VỤ & TOUR</p>
                    </li>
                    
                    @if (User.IsInRole("Business Manager"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Tours" ? "active" : "")">
                            <a asp-controller="Tours" asp-action="Index"><i class="fa fa-map-o"></i> Quản Lý Tour</a>
                        </li>
                    }

                    @if (User.IsInRole("Business Manager"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "TourSchedules" ? "active" : "")">
                            <a asp-controller="TourSchedules" asp-action="Index"><i class="fa fa-calendar"></i> Lịch Trình Tour</a>
                        </li>
                    }

                    @if (User.IsInRole("Tour Guide") || User.IsInRole("Hướng Dẫn Viên"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "TourGuide" ? "active" : "")">
                            <a asp-controller="TourGuide" asp-action="Index"><i class="fa fa-clock-o"></i> Lịch Trình Của Tôi</a>
                        </li>
                    }
                }
            </ul>
        </nav>

        <div id="content">
            
            <!-- Top Navbar -->
            <nav class="dashboard-nav" style="border-bottom: 1px solid rgba(212, 195, 182, 0.3); background-color: #ffffff; padding: 12px 24px;">
                <div class="nav-left" style="display: flex; align-items: center;">
                    <button type="button" id="sidebarCollapse" class="btn btn-outline-dark d-md-none" style="border-color: #dfa974; color: #dfa974;">
                        <i class="fa fa-bars"></i>
                    </button>
                    <span class="ml-3" style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 700; color: #805528; letter-spacing: 0.5px;">Bảng Điều Khiển</span>
                </div>
                <div class="nav-right" style="display: flex; align-items: center; gap: 12px; font-family: 'Inter', sans-serif;">
                    <div class="user-profile" style="display: flex; align-items: center;">
                        <img src="~/img/blog/blog-1.jpg" alt="User" style="width: 36px; height: 36px; border-radius: 50%; border: 2px solid #dfa974; margin-right: 8px; object-fit: cover;">
                        <span style="font-weight: 600; color: #1c1c1a; font-size: 14px;">@(User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : "Nhân Viên")</span>
                    </div>
                    <div style="width: 1px; height: 24px; background-color: #e5e2de; margin: 0 4px;"></div>
                    <a href="/" class="btn btn-sm" style="background-color: #fcf9f5; color: #805528; border: 1px solid #dfa974; border-radius: 8px; padding: 6px 12px; transition: all 0.2s;" title="Xem Website" onmouseover="this.style.backgroundColor='#dfa974'; this.style.color='#ffffff';" onmouseout="this.style.backgroundColor='#fcf9f5'; this.style.color='#805528';"><i class="fa fa-globe"></i></a>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-sm" style="background-color: #ffdad6; color: #ba1a1a; border: 1px solid #ffdad6; border-radius: 8px; padding: 6px 12px; transition: all 0.2s;" title="Đăng Xuất" onmouseover="this.style.backgroundColor='#ba1a1a'; this.style.color='#ffffff';" onmouseout="this.style.backgroundColor='#ffdad6'; this.style.color='#ba1a1a';"><i class="fa fa-sign-out"></i></a>
                </div>
            </nav>

            <div class="main-body">
                @RenderBody()
            </div>

        </div>
    </div>

    <script src="~/js/jquery-3.3.1.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/jquery.nice-select.min.js"></script>
    <script src="~/js/main.js"></script>

    <script>
        $(document).ready(function () {
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('active');
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>