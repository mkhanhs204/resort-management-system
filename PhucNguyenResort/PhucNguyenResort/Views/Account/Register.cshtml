@model PhucNguyenResort.ViewModels.Auth.RegisterViewModel

@{
    ViewData["Title"] = "Đăng Ký - Phúc Nguyên Resort";
}

@section Styles {
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
        }
        .luxury-shadow {
            box-shadow: 0 24px 40px -10px rgba(30, 41, 59, 0.06);
        }
        body {
            background-color: #fcf9f5;
        }
    </style>
}

<div class="flex-grow grid grid-cols-1 md:grid-cols-2 min-h-[calc(100vh-80px)] overflow-hidden">
    <!-- Left Column: Visual Sanctuary -->
    <div class="hidden md:block relative overflow-hidden bg-surface-dim">
        <div class="absolute inset-0 w-full h-full bg-cover bg-center" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuC0_vqsJ8pAG6xXQw3j8q2Dmd7UC143Hi8j897v8H0EEuOFxe3ajAAYkWKbo6siJAeygcgxUiI8XZoYesYZLG__9eq47OBmRErjal3P5jNnd0qCA7SAg3GiRgZJHq5IabJsmiC0kYWhB2WIhMYv4Ndi5XcsquNmFY4g9a6hD8FQlxRTMKft-jX0UB3BwhGdAfrIzXE1-ajQ8kwcEmy1d7eMWPigPnRrljcVlkFmvzGIOcrt9OWwsq8yh4WMxYO-32-YjcZpOUAYIFAv')"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-primary/40 to-transparent"></div>
        <div class="absolute bottom-margin-desktop left-margin-desktop right-margin-desktop text-white">
            <h2 class="font-display-lg text-display-lg mb-4">Tìm lại sự tĩnh lặng</h2>
            <p class="font-body-lg text-body-lg max-w-md opacity-90">Gia nhập cộng đồng thượng lưu và tận hưởng những đặc quyền riêng biệt chỉ dành cho thành viên của Phúc Nguyên Resort.</p>
        </div>
    </div>

    <!-- Right Column: Register Form Canvas -->
    <div class="flex items-center justify-center p-margin-mobile md:p-margin-desktop bg-surface py-12">
        <div class="w-full max-w-md space-y-stack-lg">
            <div class="text-center md:text-left">
                <h1 class="font-headline-lg text-headline-lg text-primary mb-2">Tạo tài khoản</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">Khởi đầu hành trình nghỉ dưỡng cao cấp của bạn</p>
            </div>

            <form asp-action="Register" method="post" class="space-y-stack-md">
                <div asp-validation-summary="ModelOnly" class="text-error text-sm mb-4"></div>

                <!-- Full Name -->
                <div class="space-y-1">
                    <label asp-for="FullName" class="font-label-lg text-label-lg text-on-surface-variant ml-1">Họ và tên</label>
                    <div class="relative group">
                        <input asp-for="FullName" class="w-full bg-surface-container-low border border-outline/10 focus:border-primary-container focus:ring-0 rounded-xl px-4 py-3.5 font-body-md text-body-md transition-all placeholder:text-outline-variant/60" placeholder="Nguyễn Văn A" />
                    </div>
                    <span asp-validation-for="FullName" class="text-error text-sm"></span>
                </div>

                <!-- Email -->
                <div class="space-y-1">
                    <label asp-for="Email" class="font-label-lg text-label-lg text-on-surface-variant ml-1">Email</label>
                    <div class="relative group">
                        <input asp-for="Email" class="w-full bg-surface-container-low border border-outline/10 focus:border-primary-container focus:ring-0 rounded-xl px-4 py-3.5 font-body-md text-body-md transition-all placeholder:text-outline-variant/60" placeholder="example@email.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-error text-sm"></span>
                </div>

                <!-- Phone Number -->
                <div class="space-y-1">
                    <label asp-for="PhoneNumber" class="font-label-lg text-label-lg text-on-surface-variant ml-1">Số điện thoại</label>
                    <div class="relative group">
                        <input asp-for="PhoneNumber" class="w-full bg-surface-container-low border border-outline/10 focus:border-primary-container focus:ring-0 rounded-xl px-4 py-3.5 font-body-md text-body-md transition-all placeholder:text-outline-variant/60" placeholder="0123 456 789" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-error text-sm"></span>
                </div>

                <!-- Password Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-stack-md">
                    <div class="space-y-1">
                        <label asp-for="Password" class="font-label-lg text-label-lg text-on-surface-variant ml-1">Mật khẩu</label>
                        <input asp-for="Password" class="w-full bg-surface-container-low border border-outline/10 focus:border-primary-container focus:ring-0 rounded-xl px-4 py-3.5 font-body-md text-body-md transition-all placeholder:text-outline-variant/60" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-error text-sm block mt-1"></span>
                    </div>
                    <div class="space-y-1">
                        <label asp-for="ConfirmPassword" class="font-label-lg text-label-lg text-on-surface-variant ml-1">Xác nhận</label>
                        <input asp-for="ConfirmPassword" class="w-full bg-surface-container-low border border-outline/10 focus:border-primary-container focus:ring-0 rounded-xl px-4 py-3.5 font-body-md text-body-md transition-all placeholder:text-outline-variant/60" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-error text-sm block mt-1"></span>
                    </div>
                </div>

                <!-- Terms & Privacy -->
                <div class="flex items-start gap-3 pt-2">
                    <input type="checkbox" id="terms" required class="mt-1 rounded-sm border-outline/20 text-primary focus:ring-primary h-4 w-4 cursor-pointer" />
                    <label for="terms" class="font-body-md text-body-md text-on-surface-variant leading-tight cursor-pointer select-none">
                        Tôi đồng ý với <a href="#" class="text-primary hover:underline">Điều khoản dịch vụ</a> và <a href="#" class="text-primary hover:underline">Chính sách bảo mật</a>.
                    </label>
                </div>

                <!-- Primary Action -->
                <button type="submit" class="w-full bg-primary-container text-on-primary-container font-label-lg text-label-lg py-4 rounded-xl shadow-sm hover:brightness-105 transition-all active:scale-[0.98] mt-2">
                    Đăng Ký
                </button>
            </form>

            <!-- Divider -->
            <div class="relative flex items-center py-2">
                <div class="flex-grow border-t border-outline/10"></div>
                <span class="flex-shrink mx-4 font-label-lg text-label-lg text-outline">HOẶC</span>
                <div class="flex-grow border-t border-outline/10"></div>
            </div>

            <!-- Social Auth -->
            <a asp-action="GoogleLogin" asp-controller="Account" class="w-full bg-surface border border-outline/20 py-3.5 rounded-xl flex items-center justify-center gap-3 font-label-lg text-label-lg text-on-surface-variant hover:bg-surface-container-low transition-colors">
                <svg class="w-5 h-5" viewBox="0 0 24 24">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
                </svg>
                Tiếp tục với Google
            </a>

            <p class="text-center font-body-md text-body-md text-on-surface-variant">
                Đã có tài khoản? <a asp-action="Login" class="text-primary font-semibold hover:underline">Đăng nhập</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('input').forEach(input => {
            input.addEventListener('focus', () => {
                input.parentElement.classList.add('luxury-shadow');
            });
            input.addEventListener('blur', () => {
                input.parentElement.classList.remove('luxury-shadow');
            });
        });
    </script>
}