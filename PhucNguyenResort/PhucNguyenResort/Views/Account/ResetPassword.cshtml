@model PhucNguyenResort.ViewModels.Auth.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu | Phúc Nguyên Resort";
}

@section Styles {
    <style>
        .luxury-blur-bg {
            backdrop-filter: blur(8px);
            background: rgba(255, 255, 255, 0.7);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .custom-shadow {
            box-shadow: 0 24px 40px rgba(30, 41, 59, 0.06);
        }
        .input-focus-gold:focus {
            border-color: #dfa974;
            outline: none;
            box-shadow: 0 0 0 2px rgba(223, 169, 116, 0.2);
        }
    </style>
}

<div class="flex items-center justify-center relative py-section-gap-md overflow-hidden min-h-[85vh]">
    <div class="absolute inset-0 z-0">
        <div class="w-full h-full bg-cover bg-center opacity-40 scale-105 transform transition-transform duration-[10s] login-bg-image" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAuYBt8CIxzN8hqDekIfwBi1dMK536pQGApkEKzWXvsIILQtM0GLC98QJUJMtSjO0MIJ-X9egJaLWVpS52dnEhUSKtWb5m66IW5ySz2sG9D_F_oev5S-t1qD0Yi9zdfst42M9-GkuwjxfjQ3jTcnRqOHFdKXo3i0dhbtJ2Lfid-EyR5jK_N8cEeCWVgCBgXCarYwM65JbRx9vYm_fVedFp3QCaNqiy-A62TLp7t6WKQvyI8MX6jaGK-ff9rjxF5LXLIF4y8RhCQv0GL')">
        </div>
        <div class="absolute inset-0 bg-gradient-to-b from-background via-transparent to-background"></div>
    </div>

    <div class="relative z-10 w-full max-w-[480px] px-margin-mobile md:px-0">
        <div class="bg-surface-container-lowest border border-outline/10 rounded-xl custom-shadow p-8 md:p-12 luxury-blur-bg">
            <div class="text-center mb-8">
                <span class="material-symbols-outlined text-[48px] text-primary mb-2">password</span>
                <h1 class="font-headline-lg text-headline-lg text-on-surface mb-2">Mật Khẩu Mới</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">Vui lòng thiết lập mật khẩu mới cho tài khoản của bạn.</p>
            </div>
            
            <form asp-action="ResetPassword" method="post" class="flex flex-col gap-4">
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                
                <div asp-validation-summary="ModelOnly" class="text-error text-sm text-center"></div>

                <div class="flex flex-col gap-2">
                    <label asp-for="NewPassword" class="font-label-lg text-label-lg text-on-surface">Mật khẩu mới</label>
                    <div class="relative">
                        <input asp-for="NewPassword" id="passwordInput1" class="w-full h-12 px-4 rounded-lg border border-outline/20 bg-surface-container-low text-on-surface font-body-md input-focus-gold transition-all" placeholder="Nhập mật khẩu mới" />
                        <button type="button" onclick="togglePassword('passwordInput1', 'toggleIcon1')" class="absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-primary">
                            <span class="material-symbols-outlined text-[20px]" id="toggleIcon1">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-error text-sm"></span>
                </div>

                <div class="flex flex-col gap-2">
                    <label asp-for="ConfirmPassword" class="font-label-lg text-label-lg text-on-surface">Xác nhận mật khẩu</label>
                    <div class="relative">
                        <input asp-for="ConfirmPassword" id="passwordInput2" class="w-full h-12 px-4 rounded-lg border border-outline/20 bg-surface-container-low text-on-surface font-body-md input-focus-gold transition-all" placeholder="Nhập lại mật khẩu mới" />
                        <button type="button" onclick="togglePassword('passwordInput2', 'toggleIcon2')" class="absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-primary">
                            <span class="material-symbols-outlined text-[20px]" id="toggleIcon2">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-error text-sm"></span>
                </div>

                <button type="submit" class="w-full h-14 bg-primary-container text-on-primary-container rounded-lg font-label-lg text-[16px] shadow-sm hover:opacity-90 active:scale-[0.98] transition-all mt-6">
                    Xác Nhận Thay Đổi
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('mousemove', (e) => {
            const bg = document.querySelector('.login-bg-image');
            if (bg) {
                const x = (e.clientX / window.innerWidth) - 0.5;
                const y = (e.clientY / window.innerHeight) - 0.5;
                bg.style.transform = `scale(1.05) translate(${x * 20}px, ${y * 20}px)`;
            }
        });

        function togglePassword(inputId, iconId) {
            var pwdInput = document.getElementById(inputId);
            var toggleIcon = document.getElementById(iconId);
            if (pwdInput.type === "password") {
                pwdInput.type = "text";
                toggleIcon.innerText = "visibility_off";
            } else {
                pwdInput.type = "password";
                toggleIcon.innerText = "visibility";
            }
        }
    </script>
}
