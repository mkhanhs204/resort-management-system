@{
    ViewData["Title"] = "Xác nhận gửi email | Phúc Nguyên Resort";
}

@section Styles {
    <style>
        .luxury-blur-bg {
            backdrop-filter: blur(8px);
            background: rgba(255, 255, 255, 0.7);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .custom-shadow {
            box-shadow: 0 24px 40px rgba(30, 41, 59, 0.06);
        }
    </style>
}

<div class="flex items-center justify-center relative py-section-gap-md overflow-hidden min-h-[85vh]">
    <div class="absolute inset-0 z-0">
        <div class="w-full h-full bg-cover bg-center opacity-40 scale-105 transform transition-transform duration-[10s] login-bg-image" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAuYBt8CIxzN8hqDekIfwBi1dMK536pQGApkEKzWXvsIILQtM0GLC98QJUJMtSjO0MIJ-X9egJaLWVpS52dnEhUSKtWb5m66IW5ySz2sG9D_F_oev5S-t1qD0Yi9zdfst42M9-GkuwjxfjQ3jTcnRqOHFdKXo3i0dhbtJ2Lfid-EyR5jK_N8cEeCWVgCBgXCarYwM65JbRx9vYm_fVedFp3QCaNqiy-A62TLp7t6WKQvyI8MX6jaGK-ff9rjxF5LXLIF4y8RhCQv0GL')">
        </div>
        <div class="absolute inset-0 bg-gradient-to-b from-background via-transparent to-background"></div>
    </div>

    <div class="relative z-10 w-full max-w-[480px] px-margin-mobile md:px-0">
        <div class="bg-surface-container-lowest border border-outline/10 rounded-xl custom-shadow p-8 md:p-12 luxury-blur-bg text-center">
            
            <div class="w-20 h-20 mx-auto bg-primary/10 rounded-full flex items-center justify-center mb-6">
                <span class="material-symbols-outlined text-[40px] text-primary">mark_email_read</span>
            </div>
            
            <h1 class="font-headline-lg text-headline-lg text-on-surface mb-4">Kiểm Tra Hộp Thư</h1>
            
            <p class="font-body-md text-body-md text-on-surface-variant mb-8 leading-relaxed">
                Chúng tôi đã gửi một email hướng dẫn khôi phục mật khẩu. Vui lòng kiểm tra hộp thư đến (và hộp thư rác) của bạn.
            </p>
            
            <a asp-action="Login" class="w-full inline-flex justify-center items-center h-14 bg-primary-container text-on-primary-container rounded-lg font-label-lg text-[16px] shadow-sm hover:opacity-90 active:scale-[0.98] transition-all">
                Trở Về Trang Đăng Nhập
            </a>
            
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('mousemove', (e) => {
            const bg = document.querySelector('.login-bg-image');
            if (bg) {
                const x = (e.clientX / window.innerWidth) - 0.5;
                const y = (e.clientY / window.innerHeight) - 0.5;
                bg.style.transform = `scale(1.05) translate(${x * 20}px, ${y * 20}px)`;
            }
        });
    </script>
}
