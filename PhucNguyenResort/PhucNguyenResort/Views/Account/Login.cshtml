@model PhucNguyenResort.ViewModels.Auth.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập | Phúc Nguyên Resort";
}

@section Styles {
    <style>
        .luxury-blur-bg {
            backdrop-filter: blur(8px);
            background: rgba(255, 255, 255, 0.7);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .custom-shadow {
            box-shadow: 0 24px 40px rgba(30, 41, 59, 0.06);
        }
        .input-focus-gold:focus {
            border-color: #dfa974;
            outline: none;
            box-shadow: 0 0 0 2px rgba(223, 169, 116, 0.2);
        }
    </style>
}

<div class="flex items-center justify-center relative py-section-gap-md overflow-hidden min-h-[85vh]">
    <!-- Background Imagery -->
    <div class="absolute inset-0 z-0">
        <div class="w-full h-full bg-cover bg-center opacity-40 scale-105 transform transition-transform duration-[10s] login-bg-image" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAuYBt8CIxzN8hqDekIfwBi1dMK536pQGApkEKzWXvsIILQtM0GLC98QJUJMtSjO0MIJ-X9egJaLWVpS52dnEhUSKtWb5m66IW5ySz2sG9D_F_oev5S-t1qD0Yi9zdfst42M9-GkuwjxfjQ3jTcnRqOHFdKXo3i0dhbtJ2Lfid-EyR5jK_N8cEeCWVgCBgXCarYwM65JbRx9vYm_fVedFp3QCaNqiy-A62TLp7t6WKQvyI8MX6jaGK-ff9rjxF5LXLIF4y8RhCQv0GL')">
        </div>
        <div class="absolute inset-0 bg-gradient-to-b from-background via-transparent to-background"></div>
    </div>

    <!-- Login Card Container -->
    <div class="relative z-10 w-full max-w-[480px] px-margin-mobile md:px-0">
        <div class="bg-surface-container-lowest border border-outline/10 rounded-xl custom-shadow p-8 md:p-12 luxury-blur-bg">
            <div class="text-center mb-10">
                <h1 class="font-headline-lg text-headline-lg text-on-surface mb-2">Welcome!!</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">Vui lòng đăng nhập để tiếp tục hành trình nghỉ dưỡng</p>
            </div>
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="bg-primary-container/20 text-on-primary-container p-4 rounded-xl border border-primary-container/30 mb-6 text-center text-sm">
                    @TempData["SuccessMessage"]
                </div>
            }

            <!-- Login Form -->
            <form asp-action="Login" method="post" class="flex flex-col gap-stack-md">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-error text-sm text-center"></div>

                <div class="flex flex-col gap-2">
                    <label asp-for="Email" class="font-label-lg text-label-lg text-on-surface">Email</label>
                    <input asp-for="Email" class="w-full h-12 px-4 rounded-lg border border-outline/20 bg-surface-container-low text-on-surface font-body-md input-focus-gold transition-all" placeholder="yourname@email.com" />
                    <span asp-validation-for="Email" class="text-error text-sm"></span>
                </div>

                <div class="flex flex-col gap-2">
                    <label asp-for="Password" class="font-label-lg text-label-lg text-on-surface">Mật khẩu</label>
                    <div class="relative">
                        <input asp-for="Password" id="passwordInput" class="w-full h-12 px-4 rounded-lg border border-outline/20 bg-surface-container-low text-on-surface font-body-md input-focus-gold transition-all" placeholder="••••••••" />
                        <button type="button" onclick="togglePassword()" class="absolute right-4 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-primary">
                            <span class="material-symbols-outlined text-[20px]" id="toggleIcon">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-error text-sm"></span>
                </div>

                <div class="flex justify-between items-center py-2">
                    <label class="flex items-center gap-2 cursor-pointer group">
                        <input asp-for="RememberMe" class="w-4 h-4 rounded border-outline/30 text-primary-container focus:ring-primary-container/20 cursor-pointer" />
                        <span class="font-label-sm text-label-sm text-on-surface-variant group-hover:text-on-surface transition-colors">Ghi nhớ đăng nhập</span>
                    </label>
                    <a asp-controller="Account" asp-action="ForgotPassword" class="font-label-sm text-label-sm text-primary hover:underline">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="w-full h-14 bg-primary-container text-on-primary-container rounded-lg font-label-lg text-[16px] shadow-sm hover:opacity-90 active:scale-[0.98] transition-all mt-2">
                    Đăng Nhập
                </button>
            </form>

            <!-- Divider -->
            <div class="relative flex items-center gap-4 my-8">
                <div class="flex-grow h-[1px] bg-outline/10"></div>
                <span class="font-label-sm text-label-sm text-outline shrink-0">Hoặc đăng nhập với</span>
                <div class="flex-grow h-[1px] bg-outline/10"></div>
            </div>

            <!-- Social Login -->
            <a asp-action="GoogleLogin" asp-controller="Account" class="w-full h-12 flex items-center justify-center gap-3 border border-outline/20 rounded-lg bg-surface-container-lowest hover:bg-surface-container transition-colors active:scale-[0.98]">
                <svg class="w-5 h-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-1 .67-2.28 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                    <path d="M5.84 14.09c-.22-.67-.35-1.39-.35-2.09s.13-1.42.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"></path>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
                </svg>
                <span class="font-label-lg text-on-surface">Tiếp tục với Google</span>
            </a>

            <div class="mt-10 text-center">
                <p class="font-body-md text-body-md text-on-surface-variant">
                    Chưa có tài khoản? 
                    <a asp-action="Register" class="text-primary font-semibold hover:underline transition-all">Đăng ký ngay</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('mousemove', (e) => {
            const bg = document.querySelector('.login-bg-image');
            if (bg) {
                const x = (e.clientX / window.innerWidth) - 0.5;
                const y = (e.clientY / window.innerHeight) - 0.5;
                bg.style.transform = `scale(1.05) translate(${x * 20}px, ${y * 20}px)`;
            }
        });

        function togglePassword() {
            var pwdInput = document.getElementById("passwordInput");
            var toggleIcon = document.getElementById("toggleIcon");
            if (pwdInput.type === "password") {
                pwdInput.type = "text";
                toggleIcon.innerText = "visibility_off";
            } else {
                pwdInput.type = "password";
                toggleIcon.innerText = "visibility";
            }
        }
    </script>
}