@model PhucNguyenResort.ViewModels.Auth.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login-premium.css" />
}

<div class="login-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8 col-sm-10">
                <div class="login-card">
                    <h2 class="login-title">Chào mừng trở lại</h2>
                    <p class="login-subtitle">Vui lòng đăng nhập để trải nghiệm dịch vụ</p>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show text-center mb-4" role="alert" style="border-radius: 10px;">
                            <i class="fa fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-center"></div>

                        <!-- Email Input -->
                        <div class="custom-input-group">
                            <label asp-for="Email"></label>
                            <div class="input-wrapper">
                                <span class="input-icon"><i class="fa fa-envelope"></i></span>
                                <input asp-for="Email" class="custom-input" placeholder="Nhập địa chỉ Email" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger" style="font-size: 0.85rem;"></span>
                        </div>

                        <!-- Password Input -->
                        <div class="custom-input-group">
                            <label asp-for="Password"></label>
                            <div class="input-wrapper">
                                <span class="input-icon"><i class="fa fa-lock"></i></span>
                                <input asp-for="Password" class="custom-input" type="password" id="password-field" placeholder="Nhập mật khẩu" required />
                                <button type="button" class="password-toggle-btn" id="toggle-password-visibility">
                                    <i class="fa fa-eye" id="toggle-icon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger" style="font-size: 0.85rem;"></span>
                        </div>

                        <!-- Remember Me & Forgot Password -->
                        <div class="remember-container">
                            <label class="custom-checkbox">
                                <input asp-for="RememberMe" />
                                <span class="checkmark"></span>
                                Ghi nhớ đăng nhập
                            </label>
                            <a href="#" class="forgot-link">Quên mật khẩu?</a>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn-login">Đăng nhập <i class="fa fa-arrow-right ml-2"></i></button>
                    </form>

                    <div class="d-flex align-items-center my-3">
                        <hr class="flex-grow-1" style="border-color: #eee; border-top: 1px solid #ddd;" />
                        <span class="mx-3 text-muted small" style="font-weight: 500;">Hoặc</span>
                        <hr class="flex-grow-1" style="border-color: #eee; border-top: 1px solid #ddd;" />
                    </div>

                    <a asp-action="GoogleLogin" class="btn btn-block btn-light d-flex align-items-center justify-content-center border shadow-sm" style="border-radius: 12px; padding: 10px; font-weight: 600; font-size: 0.95rem; color: #444; background: #fff; transition: all 0.2s; text-decoration: none;">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google" style="width: 20px; height: 20px; margin-right: 10px;" />
                        Đăng nhập bằng Google
                    </a>

                    <div class="register-prompt mt-3">
                        Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const passwordField = document.getElementById("password-field");
            const toggleBtn = document.getElementById("toggle-password-visibility");
            const toggleIcon = document.getElementById("toggle-icon");

            if (toggleBtn && passwordField && toggleIcon) {
                toggleBtn.addEventListener("click", function () {
                    if (passwordField.type === "password") {
                        passwordField.type = "text";
                        toggleIcon.classList.remove("fa-eye");
                        toggleIcon.classList.add("fa-eye-slash");
                    } else {
                        passwordField.type = "password";
                        toggleIcon.classList.remove("fa-eye-slash");
                        toggleIcon.classList.add("fa-eye");
                    }
                });
            }
        });
    </script>
}