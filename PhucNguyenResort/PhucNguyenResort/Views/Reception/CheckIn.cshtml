@model PhucNguyenResort.ViewModels.Bookings.PreCheckinViewModel
@{
    ViewData["Title"] = "Thủ tục Check-In";
}

<div class="container" style="margin-top: 130px; margin-bottom: 50px;">
    <h3 class="font-weight-bold mb-4" style="color: #dfa974;">THỰC HIỆN CHECK-IN CHO ĐƠN ĐẶT #@Model.BookingId</h3>

    <form asp-action="CheckIn" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="BookingId" />

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white font-weight-bold">Thông tin phòng đặt</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Số phòng:</strong> @Model.RoomNumber</p>
                        <p><strong>Loại phòng:</strong> @Model.CategoryName</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Ngày Check-In:</strong> @Model.CheckInDate.ToString("dd/MM/yyyy")</p>
                        <p><strong>Ngày Check-Out:</strong> @Model.CheckOutDate.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>
            </div>
        </div>

        <h4 class="font-weight-bold mb-3">Danh sách thành viên lưu trú</h4>
        <div class="text-danger mb-3" asp-validation-summary="ModelOnly"></div>

        @if (Model.Guests != null)
        {
            for (int i = 0; i < Model.Guests.Count; i++)
            {
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-header font-weight-bold" style="background-color: #f8f9fa;">
                        @(Model.Guests[i].IsPrimaryBooker ? "Thành viên 1: Người đặt phòng chính" : $"Thành viên {i + 1}")
                        <input type="hidden" asp-for="Guests[i].IsPrimaryBooker" />
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label class="font-weight-bold">Họ và tên</label>
                                <input asp-for="Guests[i].FullName" class="form-control form-control-sm" />
                                <span asp-validation-for="Guests[i].FullName" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="font-weight-bold">Ngày sinh</label>
                                <input asp-for="Guests[i].DateOfBirth" type="date" class="form-control form-control-sm" value="@(Model.Guests[i].DateOfBirth?.ToString("yyyy-MM-dd"))" />
                                <span asp-validation-for="Guests[i].DateOfBirth" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-2">
                                <label class="font-weight-bold">Giới tính</label>
                                <input asp-for="Guests[i].Gender" class="form-control form-control-sm" placeholder="Nam/Nữ" />
                                <span asp-validation-for="Guests[i].Gender" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label class="font-weight-bold">Số CCCD / Hộ chiếu</label>
                                <input asp-for="Guests[i].PassportNumber" class="form-control form-control-sm" />
                                <span asp-validation-for="Guests[i].PassportNumber" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label class="font-weight-bold">Quốc tịch</label>
                                <input asp-for="Guests[i].Nationality" class="form-control form-control-sm" />
                                <span asp-validation-for="Guests[i].Nationality" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        <div class="text-right mt-4">
            <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
            <button type="submit" class="btn text-white" style="background-color: #dfa974;">Hoàn tất Check-In</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}