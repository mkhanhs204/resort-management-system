@model PhucNguyenResort.ViewModels.Bookings.PreCheckinViewModel
@using PhucNguyenResort.Enums

@{
    ViewData["Title"] = "Thủ Tục Check-In - Phuc Nguyen Resort";
    Layout = "_DashboardLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Thủ Tục Check-In Booking #@Model.BookingId</h1>
        <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Quay lại danh sách
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <form asp-action="CheckIn" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius: 8px;"></div>
        <input type="hidden" asp-for="BookingId" />

        <div class="row">
            <!-- Left: Guest Manifest details -->
            <div class="col-lg-8">
                <div class="card shadow mb-4">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold text-primary">Danh Sách Khách Lưu Trú</h6>
                        <a asp-action="ExportManifest" asp-route-id="@Model.BookingId" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-download fa-sm mr-1"></i> Xuất Tờ Khai Tạm Trú
                        </a>
                    </div>
                    <div class="card-body">
                        @for (int i = 0; i < Model.Guests.Count; i++)
                        {
                            var isPrimary = Model.Guests[i].IsPrimaryBooker;
                            <div class="p-3 mb-4 bg-light rounded border-left @(isPrimary ? "border-primary" : "border-info")">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="font-weight-bold text-dark mb-0">Khách #@(i + 1) @(isPrimary ? "(Trưởng đoàn)" : "")</h6>
                                    <input type="hidden" asp-for="Guests[i].IsPrimaryBooker" />
                                </div>

                                <div class="form-row">
                                    <div class="form-group col-md-8">
                                        <label asp-for="Guests[i].FullName" class="small font-weight-bold">Họ và Tên</label>
                                        <input type="text" asp-for="Guests[i].FullName" class="form-control" placeholder="NGUYEN VAN A" />
                                        <span asp-validation-for="Guests[i].FullName" class="text-danger small"></span>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label asp-for="Guests[i].Gender" class="small font-weight-bold">Giới Tính</label>
                                        <select asp-for="Guests[i].Gender" class="form-control">
                                            <option value="">-- Chọn --</option>
                                            <option value="Male">Nam</option>
                                            <option value="Female">Nữ</option>
                                            <option value="Other">Khác</option>
                                        </select>
                                        <span asp-validation-for="Guests[i].Gender" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="form-row">
                                    <div class="form-group col-md-4">
                                        <label asp-for="Guests[i].DateOfBirth" class="small font-weight-bold">Ngày Sinh</label>
                                        <input type="date" asp-for="Guests[i].DateOfBirth" class="form-control" />
                                        <span asp-validation-for="Guests[i].DateOfBirth" class="text-danger small"></span>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label asp-for="Guests[i].PassportNumber" class="small font-weight-bold">Số CCCD / Hộ Chiếu</label>
                                        <input type="text" asp-for="Guests[i].PassportNumber" class="form-control" placeholder="Số định danh" />
                                        <span asp-validation-for="Guests[i].PassportNumber" class="text-danger small"></span>
                                    </div>
                                    <div class="form-group col-md-4">
                                        <label asp-for="Guests[i].Nationality" class="small font-weight-bold">Quốc Tịch</label>
                                        <input type="text" asp-for="Guests[i].Nationality" class="form-control" placeholder="Vietnam" />
                                        <span asp-validation-for="Guests[i].Nationality" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="alert alert-warning text-dark small" role="alert">
                            <i class="fas fa-shield-alt mr-2 text-warning"></i>
                            <strong>Tuân thủ PDPD:</strong> Bằng việc nhấn nút hoàn tất, bạn xác nhận đã đối chiếu thông tin vật lý (CCCD/Hộ chiếu) của khách hàng trùng khớp với thông tin đã nhập, và khách hàng đã đồng ý cho phép xử lý dữ liệu phục vụ tạm trú.
                        </div>

                        <button type="submit" class="btn btn-success btn-lg btn-block mt-3 shadow-sm">
                            <i class="fas fa-check-circle mr-1"></i> Xác Nhận Check-In & Lưu Thông Tin
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right: Room & Booking Info -->
            <div class="col-lg-4">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Thông Tin Đặt Phòng & Xếp Phòng</h6>
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-4">
                            <i class="fas fa-hotel fa-3x text-gray-300 mb-3"></i>
                            <h5 class="text-dark font-weight-bold">Xếp Phòng Cho Đặt Phòng</h5>
                            <span class="badge badge-info px-3 py-2">@Model.CategoryName</span>
                        </div>

                        <hr />

                        <div class="mb-4">
                            <h6 class="font-weight-bold text-dark mb-3"><i class="fas fa-bed mr-2 text-primary"></i> Gán Phòng Vật Lý</h6>
                            
                            @for (int j = 0; j < Model.RoomAssignments.Count; j++)
                            {
                                <div class="p-3 mb-3 bg-light rounded border">
                                    <input type="hidden" asp-for="RoomAssignments[j].BookingDetailId" />
                                    <input type="hidden" asp-for="RoomAssignments[j].RoomCategoryId" />
                                    <input type="hidden" asp-for="RoomAssignments[j].CategoryName" />
                                    
                                    <label class="small font-weight-bold text-gray-800 d-block mb-1">
                                        Chi tiết phòng #@(j + 1): @Model.RoomAssignments[j].CategoryName
                                    </label>
                                    
                                    <select asp-for="RoomAssignments[j].SelectedRoomId" class="form-control form-control-sm">
                                        <option value="">-- Chọn phòng trống --</option>
                                        @if (Model.RoomAssignments[j].AvailableRooms != null)
                                        {
                                            @foreach (var room in Model.RoomAssignments[j].AvailableRooms)
                                            {
                                                <option value="@room.Id">Phòng @room.RoomNumber</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="RoomAssignments[j].SelectedRoomId" class="text-danger small d-block mt-1"></span>
                                </div>
                            }
                        </div>

                        <hr />

                        <div class="mb-3">
                            <span class="text-muted d-block small">Thời gian lưu trú</span>
                            <span class="text-dark font-weight-bold">@Model.CheckInDate.ToString("dd/MM/yyyy") - @Model.CheckOutDate.ToString("dd/MM/yyyy")</span>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted d-block small">Trạng thái đồng ý bảo mật (PDPD Consent)</span>
                            @if (Model.PdpdConsentChecked)
                            {
                                <span class="badge badge-success"><i class="fas fa-check-circle mr-1"></i> Đã đồng ý trực tuyến</span>
                            }
                            else
                            {
                                <span class="badge badge-warning"><i class="fas fa-exclamation-triangle mr-1"></i> Chưa đồng ý trực tuyến</span>
                            }
                        </div>

                        <hr />

                        <div class="text-muted small">
                            <p class="mb-1"><i class="fas fa-info-circle mr-1 text-info"></i> Hãy yêu cầu khách xuất trình giấy tờ tùy thân thực tế để đối chiếu.</p>
                            <p class="mb-0"><i class="fas fa-file-excel mr-1 text-success"></i> Tải file báo cáo tạm trú sau khi check-in để gửi cho cơ quan Công an.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
