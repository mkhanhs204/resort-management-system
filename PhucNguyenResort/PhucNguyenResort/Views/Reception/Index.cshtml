@model IEnumerable<PhucNguyenResort.Models.Booking>

@{
    ViewData["Title"] = "Quản Lý Đặt Phòng";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528; /* primary */
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b; /* on-surface-variant */
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 24px;
            margin-bottom: 30px;
        }
        .luxury-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        .luxury-table thead th {
            background-color: #f6f3ef; /* surface-container-low */
            color: #50453b;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 16px;
            border: none;
        }
        .luxury-table thead th:first-child {
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
        }
        .luxury-table thead th:last-child {
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }
        .luxury-table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-bottom: 1px solid #f0ede9;
            color: #1c1c1a;
            font-size: 14px;
        }
        .luxury-table tbody tr:last-child td {
            border-bottom: none;
        }
        .luxury-table tbody tr:hover {
            background-color: #fcf9f5; /* surface */
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .material-symbols-outlined.fill {
            font-variation-settings: 'FILL' 1;
        }
        .btn-luxury {
            background-color: #dfa974; /* primary-container */
            color: #633d11; /* on-primary-container */
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 20px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-luxury:hover {
            background-color: #805528;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2);
            text-decoration: none;
        }
        .btn-luxury.outline {
            background-color: transparent;
            border: 1px solid #d4c3b6;
            color: #50453b;
        }
        .btn-luxury.outline:hover {
            background-color: #f6f3ef;
            color: #805528;
            border-color: #805528;
            box-shadow: none;
        }
        .action-btn {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #d4c3b6;
            color: #50453b;
            transition: all 0.2s;
            background: transparent;
            margin: 0 2px;
            text-decoration: none;
            cursor: pointer;
        }
        .action-btn.large {
            width: auto;
            padding: 0 12px;
            gap: 4px;
            font-size: 13px;
            font-weight: 500;
        }
        .action-btn:hover {
            background: #f6f3ef;
            color: #805528;
            border-color: #805528;
            text-decoration: none;
        }
        .action-btn.delete:hover {
            background: #ffdad6;
            color: #ba1a1a;
            border-color: #ba1a1a;
        }
        .action-btn.success:hover {
            background: #e2f5ea;
            color: #0b5c2d;
            border-color: #0b5c2d;
        }
        .action-btn.info:hover {
            background: #e1f5fe;
            color: #0277bd;
            border-color: #0277bd;
        }
        .luxury-badge {
            background-color: #f0ede9;
            color: #50453b;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
        }
        .luxury-badge.blue {
            background-color: #d3e4fe;
            color: #0b1c30;
        }
        .luxury-badge.warning {
            background-color: #fff8e1;
            color: #f57f17;
        }
        .luxury-badge.success {
            background-color: #e2f5ea;
            color: #0b5c2d;
        }
        .luxury-badge.danger {
            background-color: #ffdad6;
            color: #ba1a1a;
        }
        .luxury-badge.info {
            background-color: #e1f5fe;
            color: #0277bd;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        
        /* Alert Styling */
        .luxury-alert {
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: 'Inter', sans-serif;
            border: none;
        }
        .luxury-alert.success {
            background-color: #e2f5ea;
            color: #0b5c2d;
        }
        .luxury-alert.error {
            background-color: #ffdad6;
            color: #93000a;
        }
        
        .filter-container {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }
        .filter-input {
            background-color: #f6f3ef;
            border: 1px solid transparent;
            border-radius: 8px;
            padding: 10px 16px;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            color: #1c1c1a;
            outline: none;
            transition: all 0.2s;
        }
        .filter-input:focus {
            border-color: #dfa974;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(223, 169, 116, 0.2);
        }
        .input-group-luxury {
            display: flex;
            align-items: center;
            background-color: #f6f3ef;
            border-radius: 8px;
            padding: 0 16px;
            border: 1px solid transparent;
            transition: all 0.2s;
        }
        .input-group-luxury:focus-within {
            border-color: #dfa974;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(223, 169, 116, 0.2);
        }
        .input-group-luxury .material-symbols-outlined {
            color: #827569;
            font-size: 20px;
        }
        .input-group-luxury input {
            border: none;
            background: transparent;
            padding: 10px 8px;
            outline: none;
            width: 100%;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
        }
    </style>
}

<div class="header-container mt-4">
    <div>
        <h2 class="page-title">
            @ViewData["Title"]
        </h2>
    </div>
    <div style="font-family: 'Inter', sans-serif; color: #50453b; display: flex; align-items: center; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined">calendar_today</span>
            <span>@DateTime.Now.ToString("dd MMMM, yyyy")</span>
        </div>
        @if (User.IsInRole("Receptionist") || User.IsInRole("Admin"))
        {
            <a asp-action="WalkInBooking" class="btn-luxury" style="padding: 8px 16px; font-size: 14px;">
                <span class="material-symbols-outlined" style="font-size: 20px;">add</span> Đặt Phòng Tại Quầy
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="luxury-alert success alert-dismissible fade show" role="alert" id="alert-success">
        <span class="material-symbols-outlined fill">check_circle</span>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close" style="background: none; border: none; margin-left: auto; color: inherit; cursor: pointer;">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="luxury-alert error alert-dismissible fade show" role="alert" id="alert-error">
        <span class="material-symbols-outlined fill">error</span>
        <div>@TempData["Error"]</div>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close" style="background: none; border: none; margin-left: auto; color: inherit; cursor: pointer;">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
}

<div class="luxury-card mb-4" style="padding: 16px 24px;">
    <form asp-action="Index" method="get" class="m-0">
        <div class="filter-container">
            <div style="flex: 1; min-width: 250px;">
                <div class="input-group-luxury">
                    <span class="material-symbols-outlined">search</span>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" placeholder="Mã BKG, Khách hàng, Email, Phòng..." />
                </div>
            </div>
            <div style="width: 200px;">
                <div class="input-group-luxury">
                    <span class="material-symbols-outlined">event</span>
                    <input type="date" name="dateFilter" value="@ViewBag.CurrentDate" title="Lọc theo ngày Check-in" style="cursor: pointer;" />
                </div>
            </div>
            <div style="width: 200px;">
                <select name="statusFilter" class="filter-input" style="width: 100%;">
                    <option value="">-- Tất cả trạng thái --</option>
                    @foreach (PhucNguyenResort.Enums.BookingStatus status in Enum.GetValues(typeof(PhucNguyenResort.Enums.BookingStatus)))
                    {
                        if (ViewBag.CurrentStatus != null && (PhucNguyenResort.Enums.BookingStatus)ViewBag.CurrentStatus == status)
                        {
                            <option value="@status" selected="selected">@status</option>
                        }
                        else
                        {
                            <option value="@status">@status</option>
                        }
                    }
                </select>
            </div>
            <div style="display: flex; gap: 8px;">
                <button type="submit" class="btn-luxury" style="padding: 8px 24px;">
                    <span class="material-symbols-outlined" style="font-size: 20px;">filter_alt</span> Lọc
                </button>
                <a asp-action="Index" asp-route-clearFilter="true" class="btn-luxury outline" title="Xóa bộ lọc" style="padding: 8px 16px;">
                    <span class="material-symbols-outlined" style="font-size: 20px; margin: 0;">refresh</span>
                </a>
            </div>
        </div>
    </form>
</div>

<div class="luxury-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 600; color: #1c1c1a;">Danh Sách Đặt Phòng</span>
            <span class="luxury-badge blue">@(ViewBag.TotalItems ?? 0)</span>
        </div>
    </div>
    
    <div style="overflow-x: auto;">
        <table class="luxury-table" id="bookings-table">
            <thead>
                <tr>
                    <th>BKG_ID</th>
                    <th>Khách Hàng</th>
                    <th>Phòng</th>
                    <th>Check-in</th>
                    <th>Check-out</th>
                    <th>Cọc / Tổng</th>
                    <th>Trạng Thái</th>
                    @if (User.IsInRole("Receptionist") || User.IsInRole("Admin"))
                    {
                        <th style="text-align: right;">Thao Tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><strong style="color: #1c1c1a; font-weight: 600;">#@item.BookingId</strong></td>
                            <td>
                                <strong style="color: #1c1c1a;">@item.User?.FullName</strong><br />
                                <span style="color: #827569; font-size: 13px;">@item.User?.Email</span>
                            </td>
                            <td>
                                <span class="luxury-badge" style="margin-bottom: 4px;">
                                    <span class="material-symbols-outlined" style="font-size: 14px;">meeting_room</span>
                                    @(item.BookingDetails != null && item.BookingDetails.Any(bd => bd.Room != null) ? string.Join(", ", item.BookingDetails.Where(bd => bd.Room != null).Select(bd => bd.Room!.RoomNumber)) : "Chưa xếp phòng")
                                </span><br />
                                <span style="color: #827569; font-size: 13px;">
                                    @(item.BookingDetails != null ? string.Join(", ", item.BookingDetails.GroupBy(bd => bd.RoomCategory?.CategoryName).Select(g => $"{g.Count()}x {g.Key}")) : "")
                                </span>
                            </td>
                            <td style="color: #50453b;">
                                <div style="display: flex; align-items: center; gap: 4px;">
                                    <span class="material-symbols-outlined" style="font-size: 16px; color: #827569;">login</span>
                                    @item.CheckInDate.ToString("dd/MM/yyyy")
                                </div>
                            </td>
                            <td style="color: #50453b;">
                                <div style="display: flex; align-items: center; gap: 4px;">
                                    <span class="material-symbols-outlined" style="font-size: 16px; color: #827569;">logout</span>
                                    @item.CheckOutDate.ToString("dd/MM/yyyy")
                                </div>
                            </td>
                            <td>
                                <div style="font-weight: 500; color: #805528;">@item.DepositAmount?.ToString("N0")</div>
                                <div style="color: #827569; font-size: 13px;">/ @item.TotalAmount?.ToString("N0")</div>
                            </td>
                            <td>
                                @{
                                    var badgeClass = item.BookingStatus switch
                                    {
                                        PhucNguyenResort.Enums.BookingStatus.Reserved => "warning",
                                        PhucNguyenResort.Enums.BookingStatus.Arrived => "info",
                                        PhucNguyenResort.Enums.BookingStatus.CheckedIn => "success",
                                        PhucNguyenResort.Enums.BookingStatus.CheckedOut => "",
                                        PhucNguyenResort.Enums.BookingStatus.Cancelled => "danger",
                                        PhucNguyenResort.Enums.BookingStatus.NoShow => "danger",
                                        _ => ""
                                    };
                                    var statusText = item.BookingStatus switch
                                    {
                                        PhucNguyenResort.Enums.BookingStatus.Reserved => "Reserved",
                                        PhucNguyenResort.Enums.BookingStatus.CheckedIn => "Checked-in",
                                        PhucNguyenResort.Enums.BookingStatus.CheckedOut => "Checked-out",
                                        PhucNguyenResort.Enums.BookingStatus.Cancelled => "Cancelled",
                                        PhucNguyenResort.Enums.BookingStatus.NoShow => "No-show",
                                        _ => item.BookingStatus.ToString()
                                    };
                                    var iconName = item.BookingStatus switch
                                    {
                                        PhucNguyenResort.Enums.BookingStatus.Reserved => "schedule",
                                        PhucNguyenResort.Enums.BookingStatus.Arrived => "flight_land",
                                        PhucNguyenResort.Enums.BookingStatus.CheckedIn => "how_to_reg",
                                        PhucNguyenResort.Enums.BookingStatus.CheckedOut => "done_all",
                                        PhucNguyenResort.Enums.BookingStatus.Cancelled => "cancel",
                                        PhucNguyenResort.Enums.BookingStatus.NoShow => "person_off",
                                        _ => "info"
                                    };
                                }
                                <span class="luxury-badge @badgeClass">
                                    <span class="material-symbols-outlined" style="font-size: 14px;">@iconName</span> @statusText
                                </span>
                            </td>
                            @if (User.IsInRole("Receptionist") || User.IsInRole("Admin"))
                            {
                                <td style="text-align: right; white-space: nowrap;">
                                    <div style="display: flex; justify-content: flex-end; align-items: center; gap: 8px;">
                                        @if (item.BookingStatus == PhucNguyenResort.Enums.BookingStatus.Reserved || item.BookingStatus == PhucNguyenResort.Enums.BookingStatus.PendingPayment || item.BookingStatus == PhucNguyenResort.Enums.BookingStatus.Arrived)
                                        {
                                            <a asp-action="CheckIn" asp-route-id="@item.BookingId" class="action-btn large success" title="@(item.BookingStatus == PhucNguyenResort.Enums.BookingStatus.Arrived ? "Giao phòng" : "Check-in")">
                                                <span class="material-symbols-outlined" style="font-size: 18px;">how_to_reg</span>
                                                @(item.BookingStatus == PhucNguyenResort.Enums.BookingStatus.Arrived ? "Giao phòng" : "Check-in")
                                            </a>
                                        }
                                        @if (item.BookingStatus == PhucNguyenResort.Enums.BookingStatus.CheckedIn)
                                        {
                                            <a asp-action="CheckOut" asp-route-id="@item.BookingId" class="action-btn large delete" title="Check-out">
                                                <span class="material-symbols-outlined" style="font-size: 18px;">logout</span> Check-out
                                            </a>
                                            <a asp-action="ExportManifest" asp-route-id="@item.BookingId" target="_blank" class="action-btn info" title="Báo Cáo Tạm Trú">
                                                <span class="material-symbols-outlined" style="font-size: 20px;">description</span>
                                            </a>
                                        }
                                        else if (item.BookingStatus == PhucNguyenResort.Enums.BookingStatus.CheckedOut)
                                        {
                                            <a asp-action="PrintInvoice" asp-route-id="@item.BookingId" target="_blank" class="action-btn large" title="In Hóa Đơn">
                                                <span class="material-symbols-outlined" style="font-size: 18px;">print</span> In Hóa Đơn
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="ExportManifest" asp-route-id="@item.BookingId" target="_blank" class="action-btn info" title="Báo Cáo Tạm Trú">
                                                <span class="material-symbols-outlined" style="font-size: 20px;">description</span>
                                            </a>
                                        }
                                        @if (item.BookingStatus == PhucNguyenResort.Enums.BookingStatus.Reserved)
                                        {
                                            <form asp-controller="Bookings" asp-action="Cancel" asp-route-id="@item.BookingId" method="post" style="display:inline;" onsubmit="return confirm('Xác nhận hủy booking này?');">
                                                <button type="submit" class="action-btn delete" title="Hủy Booking">
                                                    <span class="material-symbols-outlined" style="font-size: 20px;">cancel</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 40px; color: #827569;">
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
                                <span class="material-symbols-outlined" style="font-size: 48px; color: #d4c3b6;">event_busy</span>
                                <div>Không có đặt phòng nào.</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; padding-top: 20px; border-top: 1px solid #f0ede9;">
            <div style="color: #827569; font-size: 14px;">
                Hiển thị trang @ViewBag.CurrentPage / @ViewBag.TotalPages (@ViewBag.TotalItems đặt phòng)
            </div>
            <div style="display: flex; gap: 8px;">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, searchString = ViewBag.CurrentSearch, statusFilter = ViewBag.CurrentStatus, dateFilter = ViewBag.CurrentDate })" class="btn-luxury outline" style="padding: 8px 16px; font-size: 14px;">
                        <span class="material-symbols-outlined" style="font-size: 18px;">chevron_left</span> Trước
                    </a>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    if (i == ViewBag.CurrentPage)
                    {
                        <span class="btn-luxury" style="padding: 8px 16px; font-size: 14px;">@i</span>
                    }
                    else if (i == 1 || i == ViewBag.TotalPages || (i >= ViewBag.CurrentPage - 2 && i <= ViewBag.CurrentPage + 2))
                    {
                        <a href="@Url.Action("Index", new { page = i, searchString = ViewBag.CurrentSearch, statusFilter = ViewBag.CurrentStatus, dateFilter = ViewBag.CurrentDate })" class="btn-luxury outline" style="padding: 8px 16px; font-size: 14px;">@i</a>
                    }
                    else if (i == ViewBag.CurrentPage - 3 || i == ViewBag.CurrentPage + 3)
                    {
                        <span style="padding: 8px 12px; color: #827569;">...</span>
                    }
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, searchString = ViewBag.CurrentSearch, statusFilter = ViewBag.CurrentStatus, dateFilter = ViewBag.CurrentDate })" class="btn-luxury outline" style="padding: 8px 16px; font-size: 14px;">
                        Sau <span class="material-symbols-outlined" style="font-size: 18px;">chevron_right</span>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            var alerts = document.querySelectorAll('#alert-success, #alert-error');
            alerts.forEach(function (el) {
                if (el) {
                    el.style.transition = "opacity 0.5s ease";
                    el.style.opacity = "0";
                    setTimeout(() => el.remove(), 500);
                }
            });
        }, 4000);
        
        // Handle dismiss buttons
        document.querySelectorAll('.luxury-alert .close').forEach(btn => {
            btn.addEventListener('click', function() {
                var alert = this.closest('.luxury-alert');
                alert.style.transition = "opacity 0.3s ease";
                alert.style.opacity = "0";
                setTimeout(() => alert.remove(), 300);
            });
        });
    </script>
}
