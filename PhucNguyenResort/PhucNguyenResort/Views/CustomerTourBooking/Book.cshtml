@model PhucNguyenResort.ViewModels.Tours.BookTourVM
@{
    ViewData["Title"] = "Đặt Tour - " + Model.TourName;
}

@section Styles {
<style>
    .booking-page {
        background: #f8f6f3;
        padding: 40px 0 80px;
        min-height: 80vh;
    }
    .booking-breadcrumb {
        padding: 15px 0;
        font-size: 14px;
        color: #999;
    }
    .booking-breadcrumb a {
        color: #dfa974;
        text-decoration: none;
    }
    .booking-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 3px 20px rgba(0,0,0,0.06);
        padding: 30px;
        margin-bottom: 30px;
    }
    .booking-card h3 {
        font-family: 'Lora', serif;
        font-size: 22px;
        color: #19191a;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 2px solid #f0f0f0;
    }
    .tour-summary {
        display: flex;
        gap: 20px;
        margin-bottom: 25px;
    }
    .tour-summary img {
        width: 180px;
        height: 130px;
        border-radius: 8px;
        object-fit: cover;
    }
    .tour-summary-info h4 {
        font-family: 'Lora', serif;
        font-size: 22px;
        font-weight: 700;
        color: #19191a;
        margin-bottom: 10px;
    }
    .tour-summary-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        font-size: 14px;
        color: #777;
    }
    .sticky-sidebar {
        position: sticky;
        top: 120px; /* Adjusting for potential fixed header */
        z-index: 10;
        padding-bottom: 20px;
    }
    .tour-summary-meta span i {
        color: #dfa974;
        margin-right: 5px;
    }
    .form-group-custom label {
        display: block;
        font-weight: 600;
        color: #19191a;
        margin-bottom: 6px;
        font-size: 14px;
    }
    .form-group-custom .form-control {
        border: 1px solid #e0e0e0;
        height: 48px;
        border-radius: 6px;
        font-size: 15px;
    }
    .form-group-custom .form-control:focus {
        border-color: #dfa974;
        box-shadow: 0 0 0 3px rgba(223, 169, 116, 0.15);
    }
    .form-group-custom select.form-control {
        appearance: auto;
    }
    .form-group-custom .nice-select {
        display: block;
        width: 100%;
        height: 48px;
        line-height: 46px;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        font-size: 15px;
        float: none;
    }
    .form-group-custom .nice-select::after {
        right: 15px;
    }
    .form-group-custom .nice-select.open {
        border-color: #dfa974;
    }
    .form-group-custom .nice-select .list {
        width: 100%;
    }
    .payment-option {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px 20px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        margin-bottom: 12px;
        cursor: pointer;
        transition: all 0.3s;
    }
    .payment-option:hover {
        border-color: #dfa974;
        background: #faf8f5;
    }
    .payment-option.selected {
        border-color: #dfa974;
        background: #fdf5ec;
    }
    .payment-option input[type="radio"] {
        width: 20px;
        height: 20px;
        accent-color: #dfa974;
    }
    .payment-option i {
        font-size: 24px;
        color: #dfa974;
        width: 30px;
        text-align: center;
    }
    .payment-option .payment-label {
        font-weight: 600;
        color: #19191a;
        font-size: 15px;
    }
    .payment-option .payment-desc {
        font-size: 13px;
        color: #999;
    }
    .room-booking-select {
        display: none;
        margin-top: 10px;
        padding: 15px 20px;
        background: #faf8f5;
        border-radius: 8px;
    }
    .room-booking-select.show {
        display: block;
    }
    .price-summary {
        background: linear-gradient(135deg, #19191a 0%, #2d2d2d 100%);
        color: #fff;
        border-radius: 10px;
        padding: 25px 30px;
    }
    .price-summary h3 {
        color: #fff;
        border-bottom-color: rgba(255,255,255,0.15);
    }
    .price-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        font-size: 15px;
    }
    .price-row.total {
        border-top: 1px solid rgba(255,255,255,0.2);
        margin-top: 12px;
        padding-top: 15px;
        font-size: 20px;
        font-weight: 700;
    }
    .price-row.total .amount {
        color: #dfa974;
        font-family: 'Lora', serif;
        font-size: 26px;
    }
    .btn-submit-booking {
        background: #dfa974;
        color: #fff;
        border: none;
        width: 100%;
        padding: 16px;
        border-radius: 8px;
        font-size: 17px;
        font-weight: 700;
        margin-top: 20px;
        cursor: pointer;
        transition: all 0.3s;
    }
    .btn-submit-booking:hover {
        background: #c89660;
    }
    .btn-submit-booking:disabled {
        background: #ccc;
        cursor: not-allowed;
    }
    .slot-warning {
        background: #fff3e0;
        color: #e65100;
        padding: 12px 18px;
        border-radius: 8px;
        font-size: 14px;
        margin-bottom: 20px;
    }
    .slot-warning i {
        margin-right: 8px;
    }
    .validation-error {
        color: #e74c3c;
        font-size: 13px;
        margin-top: 4px;
    }
    @@media (max-width: 768px) {
        .tour-summary {
            flex-direction: column;
        }
        .tour-summary img {
            width: 100%;
            height: 200px;
        }
    }
</style>
}

<!-- Booking Page -->
<div class="booking-page">
    <div class="container">
        <div class="booking-breadcrumb">
            <a asp-action="Index">Tour</a> &raquo;
            <a asp-action="Details" asp-route-id="@Model.ScheduleId">Chi tiết</a> &raquo;
            <strong>Đặt Tour</strong>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p class="mb-0">@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-action="Book" method="post" id="bookingForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ScheduleId" />
            <input type="hidden" asp-for="TourName" />
            <input type="hidden" asp-for="TourImage" />
            <input type="hidden" asp-for="Location" />
            <input type="hidden" asp-for="DurationHours" />
            <input type="hidden" asp-for="PricePerPerson" />
            <input type="hidden" asp-for="TourDate" />
            <input type="hidden" asp-for="StartTime" />
            <input type="hidden" asp-for="AvailableSlots" />

            <div class="row">
                <!-- Left Column: Form -->
                <div class="col-lg-8">
                    <!-- Tour Summary -->
                    <div class="booking-card">
                        <h3><i class="fa fa-compass" style="color: #dfa974;"></i> Thông Tin Tour</h3>
                        <div class="tour-summary">
                            @if (!string.IsNullOrEmpty(Model.TourImage))
                            {
                                <img src="@Model.TourImage" alt="@Model.TourName" />
                            }
                            else
                            {
                                <img src="/img/room/room-b1.jpg" alt="Tour" />
                            }
                            <div class="tour-summary-info">
                                <h4>@Model.TourName</h4>
                                <div class="tour-summary-meta">
                                    <span><i class="fa fa-calendar"></i> @Model.TourDate.ToString("dd/MM/yyyy")</span>
                                    @if (Model.StartTime.HasValue)
                                    {
                                        <span><i class="fa fa-clock-o"></i> @Model.StartTime.Value.ToString(@"hh\:mm")</span>
                                    }
                                    <span><i class="fa fa-map-marker"></i> @(Model.Location ?? "Resort")</span>
                                    <span><i class="fa fa-hourglass-half"></i> @Model.DurationHours giờ</span>
                                </div>
                            </div>
                        </div>

                        @if (Model.AvailableSlots <= 5)
                        {
                            <div class="slot-warning">
                                <i class="fa fa-exclamation-triangle"></i>
                                Chỉ còn <strong>@Model.AvailableSlots chỗ trống</strong>! Hãy đặt ngay để không bỏ lỡ.
                            </div>
                        }
                    </div>

                    <!-- Participants -->
                    <div class="booking-card">
                        <h3><i class="fa fa-users" style="color: #dfa974;"></i> Số Người Tham Gia</h3>
                        <div class="form-group-custom">
                            <label asp-for="Participants"></label>
                            <input asp-for="Participants" class="form-control" type="number" min="1"
                                   max="@Model.AvailableSlots" id="participantInput"
                                   oninput="updateTotal()" />
                            <span asp-validation-for="Participants" class="validation-error"></span>
                            <small style="color: #999;">Tối đa @Model.AvailableSlots người (chỗ trống hiện tại)</small>
                        </div>
                    </div>

                    <!-- Stay Registration -->
                    <div class="booking-card">
                        <h3><i class="fa fa-id-card-o" style="color: #dfa974;"></i> Khai Báo Tạm Trú Người Đặt Chính</h3>
                        
                        <div class="form-group-custom" style="margin-bottom: 15px;">
                            <label asp-for="PrimaryGuestName">Họ và tên (như trên CCCD)</label>
                            <input type="text" asp-for="PrimaryGuestName" class="form-control" placeholder="Ví dụ: NGUYEN VAN A" />
                            <span asp-validation-for="PrimaryGuestName" class="validation-error"></span>
                        </div>

                        <div class="row" style="margin-bottom: 15px;">
                            <div class="col-md-6">
                                <div class="form-group-custom">
                                    <label asp-for="PrimaryGuestDateOfBirth">Ngày sinh</label>
                                    <input type="date" asp-for="PrimaryGuestDateOfBirth" class="form-control" />
                                    <span asp-validation-for="PrimaryGuestDateOfBirth" class="validation-error"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group-custom">
                                    <label asp-for="PrimaryGuestGender">Giới tính</label>
                                    <select asp-for="PrimaryGuestGender" class="form-control">
                                        <option value="">-- Chọn giới tính --</option>
                                        <option value="Male">Nam</option>
                                        <option value="Female">Nữ</option>
                                        <option value="Other">Khác</option>
                                    </select>
                                    <span asp-validation-for="PrimaryGuestGender" class="validation-error"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row" style="margin-bottom: 15px;">
                            <div class="col-md-6">
                                <div class="form-group-custom">
                                    <label asp-for="PrimaryGuestPassportNumber">Số CCCD / Hộ chiếu</label>
                                    <input type="text" asp-for="PrimaryGuestPassportNumber" class="form-control" placeholder="Số định danh cá nhân" />
                                    <span asp-validation-for="PrimaryGuestPassportNumber" class="validation-error"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group-custom">
                                    <label asp-for="PrimaryGuestNationality">Quốc tịch</label>
                                    <input type="text" asp-for="PrimaryGuestNationality" class="form-control" placeholder="Ví dụ: Vietnam" value="Vietnam" />
                                    <span asp-validation-for="PrimaryGuestNationality" class="validation-error"></span>
                                </div>
                            </div>
                        </div>

                        <!-- PDPD Consent Checkbox -->
                        <div class="mt-3 d-flex align-items-start" style="gap: 10px;">
                            <input type="checkbox" id="pdpdConsent" name="PdpdConsentChecked" value="true" required="required" data-val="true" data-val-required="Bạn phải đồng ý với điều khoản bảo vệ dữ liệu cá nhân (PDPD)." style="cursor: pointer; width: 18px; height: 18px; margin-top: 3px; accent-color: #dfa974;">
                            <label for="pdpdConsent" style="font-size: 13px; color: #777; cursor: pointer; line-height: 1.45; font-weight: normal; margin-bottom: 0;">
                                Tôi đồng ý cho phép Phúc Nguyên Resort thu thập và lưu trữ thông tin cá nhân nhạy cảm (số CCCD/Hộ chiếu và Ngày sinh) của các thành viên trong đoàn để khai báo tạm trú theo Nghị định 356/2025/NĐ-CP (PDPD).
                            </label>
                        </div>
                        <span asp-validation-for="PdpdConsentChecked" class="validation-error d-block mb-1"></span>
                    </div>

                    <!-- Payment Method -->
                    <div class="booking-card">
                        <h3><i class="fa fa-credit-card" style="color: #dfa974;"></i> Phương Thức Thanh Toán</h3>

                        <label class="payment-option" id="optionVNPay" onclick="selectPayment('VNPay')">
                            <input type="radio" name="PaymentMethod" value="VNPay" checked />
                            <i class="fa fa-university"></i>
                            <div>
                                <div class="payment-label">Thanh toán ngay qua VNPay</div>
                                <div class="payment-desc">Chuyển khoản ngân hàng, thẻ ATM/Visa/MasterCard</div>
                            </div>
                        </label>

                        @if (Model.AvailableRoomBookings.Any())
                        {
                            <label class="payment-option" id="optionChargeToRoom" onclick="selectPayment('ChargeToRoom')">
                                <input type="radio" name="PaymentMethod" value="ChargeToRoom" />
                                <i class="fa fa-bed"></i>
                                <div>
                                    <div class="payment-label">Ghi nợ vào phòng (Charge to Room)</div>
                                    <div class="payment-desc">Chi phí sẽ được tính vào hóa đơn khi trả phòng</div>
                                </div>
                            </label>

                            <div class="room-booking-select" id="roomBookingSelect">
                                <div class="form-group-custom">
                                    <label>Chọn phòng đang lưu trú:</label>
                                    <select asp-for="RoomBookingId" class="form-control">
                                        <option value="">-- Chọn phòng --</option>
                                        @foreach (var room in Model.AvailableRoomBookings)
                                        {
                                            <option value="@room.BookingId">@room.DisplayText</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="payment-option" style="opacity: 0.5; cursor: not-allowed;">
                                <input type="radio" disabled />
                                <i class="fa fa-bed"></i>
                                <div>
                                    <div class="payment-label">Ghi nợ vào phòng (Charge to Room)</div>
                                    <div class="payment-desc" style="color: #e74c3c;">Bạn chưa có phòng đang Check-in. Không thể sử dụng.</div>
                                </div>
                            </div>
                        }

                        <span asp-validation-for="PaymentMethod" class="validation-error"></span>
                    </div>
                </div>

                <!-- Right Column: Price Summary -->
                <div class="col-lg-4">
                    <div class="sticky-sidebar">
                        <div class="price-summary">
                            <h3><i class="fa fa-receipt" style="color: #dfa974;"></i> Tóm Tắt Đơn Hàng</h3>

                            <div class="price-row">
                                <span>Giá mỗi người</span>
                                <span>@Model.PricePerPerson.ToString("N0") VNĐ</span>
                            </div>
                            <div class="price-row">
                                <span>Số người</span>
                                <span id="displayParticipants">@Model.Participants</span>
                            </div>
                            <div class="price-row total">
                                <span>Tổng cộng</span>
                                <span class="amount" id="displayTotal">@((Model.PricePerPerson * Model.Participants).ToString("N0")) VNĐ</span>
                            </div>
                        </div>

                        <button type="submit" class="btn-submit-booking" id="btnSubmit">
                            <i class="fa fa-check-circle"></i> Xác Nhận Đặt Tour
                        </button>

                        <div style="text-align: center; margin-top: 15px;">
                            <a asp-action="Index" style="color: #999; font-size: 14px;">
                                <i class="fa fa-arrow-left"></i> Quay lại danh sách tour
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    var pricePerPerson = @((int)Model.PricePerPerson);
    var maxSlots = @Model.AvailableSlots;

    function updateTotal() {
        var participants = parseInt(document.getElementById('participantInput').value) || 0;
        if (participants > maxSlots) {
            participants = maxSlots;
            document.getElementById('participantInput').value = maxSlots;
        }
        if (participants < 1) participants = 1;

        var total = pricePerPerson * participants;
        document.getElementById('displayParticipants').innerText = participants;
        document.getElementById('displayTotal').innerText = total.toLocaleString('vi-VN') + ' VNĐ';
    }

    function selectPayment(method) {
        document.querySelectorAll('.payment-option').forEach(function(opt) {
            opt.classList.remove('selected');
        });

        if (method === 'VNPay') {
            document.getElementById('optionVNPay').classList.add('selected');
            var roomSelect = document.getElementById('roomBookingSelect');
            if (roomSelect) roomSelect.classList.remove('show');
        } else {
            var chargeOption = document.getElementById('optionChargeToRoom');
            if (chargeOption) chargeOption.classList.add('selected');
            var roomSelect = document.getElementById('roomBookingSelect');
            if (roomSelect) roomSelect.classList.add('show');
        }
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', function() {
        selectPayment('VNPay');
        updateTotal();

        // Prevent double submit
        document.getElementById('bookingForm').addEventListener('submit', function(e) {
            var btn = document.getElementById('btnSubmit');
            if (btn.disabled) {
                e.preventDefault();
                return;
            }
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Đang xử lý...';
        });
    });
</script>
}
