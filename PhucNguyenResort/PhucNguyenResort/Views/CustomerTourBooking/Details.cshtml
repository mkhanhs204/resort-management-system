@model PhucNguyenResort.ViewModels.Tours.TourDetailVM
@{
    ViewData["Title"] = "Chi Tiết Tour | Phúc Nguyên Resort";
    string imageUrl = string.IsNullOrEmpty(Model.ImageUrl) ? "https://lh3.googleusercontent.com/aida-public/AB6AXuCM9OErZMl-5BqJTmZKC5cF27v4NpOrlYot62zaWRmB2uF9gZJZJ76juU0YrC-roJA-z1a4xKW0KVcbhUW9AtMhjH7TyyHce4wAvBeI0-XIXpdiNY4MGiiesNrjzCmCswoxpU08i3Mu2Sa7u_Iy3niC8eA7cKkO1mHVPrHLFq-nUSwirX7dCC7OhZLT-6vrYK9lQp0e-wSwt0YdlOvxLhN7jhceuFNaUgo-ywtjx2QUlHaFhPoSg_N1s2t_2MYKnsIXRQAqWT3Gwps4" : Model.ImageUrl;
}

@section Styles {
    <style>
        .luxury-shadow {
            box-shadow: 0 24px 40px -10px rgba(30, 41, 59, 0.06);
        }
        .hero-overlay {
            background: linear-gradient(to top, rgba(28, 28, 26, 0.8) 0%, rgba(28, 28, 26, 0) 60%);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .fill-icon {
            font-variation-settings: 'FILL' 1;
        }
    </style>
}

<main class="pt-0 bg-background">
    <!-- Hero Section -->
    <section class="relative h-screen w-full overflow-hidden">
        <div class="absolute inset-0 w-full h-full bg-cover bg-center" style="background-image: url('@imageUrl')"></div>
        <div class="absolute inset-0 hero-overlay flex flex-col justify-end pb-section-gap-md px-margin-mobile md:px-margin-desktop">
            <div class="max-w-container-max mx-auto w-full">
                <span class="bg-primary-container text-on-primary-container px-4 py-1 rounded-full text-label-sm font-label-lg uppercase tracking-widest mb-4 inline-block">Trải Nghiệm Độc Bản</span>
                <h1 class="font-display-lg text-display-lg text-white mb-4">@Model.TourName</h1>
                <div class="flex flex-wrap gap-stack-lg text-white/90">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined">schedule</span>
                        <span class="font-label-lg">@(Model.DurationHours >= 24 ? $"{Model.DurationHours/24} Ngày" : $"{Model.DurationHours} Giờ")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined">location_on</span>
                            <span class="font-label-lg">@Model.Location</span>
                        </div>
                    }
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined">groups</span>
                        <span class="font-label-lg">Tối đa @Model.MaxCapacity khách</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Content Section -->
    <section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-section-gap-md grid grid-cols-12 gap-gutter relative">
        
        <!-- Left Column: Content -->
        <div class="col-span-12 md:col-span-8 space-y-section-gap-md">
            <!-- Overview -->
            <article>
                <h2 class="font-headline-lg text-headline-lg mb-stack-lg text-primary">Tổng Quan Chuyến Đi</h2>
                <div class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed mb-stack-md whitespace-pre-wrap">@Model.Description</div>
                
                <div class="grid grid-cols-2 md:grid-cols-3 gap-gutter pt-stack-lg mt-8 border-t border-outline/10">
                    <div class="flex flex-col gap-2 p-stack-md bg-surface-container rounded-xl border border-outline/10 text-center items-center justify-center">
                        <span class="material-symbols-outlined text-primary text-3xl mb-2" data-weight="fill">restaurant</span>
                        <span class="font-label-lg text-on-surface">Ẩm thực cao cấp</span>
                    </div>
                    <div class="flex flex-col gap-2 p-stack-md bg-surface-container rounded-xl border border-outline/10 text-center items-center justify-center">
                        <span class="material-symbols-outlined text-primary text-3xl mb-2" data-weight="fill">directions_boat</span>
                        <span class="font-label-lg text-on-surface">Di chuyển riêng</span>
                    </div>
                    <div class="flex flex-col gap-2 p-stack-md bg-surface-container rounded-xl border border-outline/10 text-center items-center justify-center">
                        <span class="material-symbols-outlined text-primary text-3xl mb-2" data-weight="fill">photo_camera</span>
                        <span class="font-label-lg text-on-surface">Chụp ảnh chuyên nghiệp</span>
                    </div>
                </div>
            </article>

            <!-- Itinerary -->
            <article>
                <h2 class="font-headline-lg text-headline-lg mb-stack-lg text-primary">Lịch Trình Chi Tiết</h2>
                <div class="relative space-y-stack-lg border-l-2 border-primary/20 ml-4 pl-8">
                    <!-- Day 1 -->
                    <div class="relative">
                        <div class="absolute -left-[41px] top-0 w-4 h-4 rounded-full bg-primary ring-4 ring-background"></div>
                        <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2">Ngày 1: Bắt đầu hành trình</h3>
                        <div class="space-y-stack-md">
                            <div class="flex gap-4">
                                <span class="font-label-lg text-primary shrink-0 w-16">09:00</span>
                                <p class="text-on-surface-variant">Xe đón quý khách tại resort, bắt đầu hành trình tham quan.</p>
                            </div>
                            <div class="flex gap-4">
                                <span class="font-label-lg text-primary shrink-0 w-16">12:30</span>
                                <p class="text-on-surface-variant">Nhận phòng/Chỗ nghỉ, thưởng thức tiệc trà chào mừng và dùng bữa trưa.</p>
                            </div>
                            <div class="flex gap-4">
                                <span class="font-label-lg text-primary shrink-0 w-16">17:00</span>
                                <p class="text-on-surface-variant">Nghỉ ngơi tự do và chuẩn bị cho bữa tối cao cấp.</p>
                            </div>
                        </div>
                    </div>
                    <!-- Day 2 -->
                    @if(Model.DurationHours > 12)
                    {
                    <div class="relative pt-8">
                        <div class="absolute -left-[41px] top-8 w-4 h-4 rounded-full bg-primary ring-4 ring-background"></div>
                        <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2">Ngày 2: Trải nghiệm & Thư giãn</h3>
                        <div class="space-y-stack-md">
                            <div class="flex gap-4">
                                <span class="font-label-lg text-primary shrink-0 w-16">06:00</span>
                                <p class="text-on-surface-variant">Tham gia hoạt động buổi sáng và thưởng thức bữa sáng nhẹ nhàng.</p>
                            </div>
                            <div class="flex gap-4">
                                <span class="font-label-lg text-primary shrink-0 w-16">09:00</span>
                                <p class="text-on-surface-variant">Tiếp tục hành trình tham quan trải nghiệm. Trở về vào buổi chiều.</p>
                            </div>
                        </div>
                    </div>
                    }
                </div>
            </article>

            <!-- Inclusion -->
            <article>
                <h2 class="font-headline-lg text-headline-lg mb-stack-lg text-primary">Dịch Vụ Bao Gồm</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary">check_circle</span>
                        <span class="text-on-surface-variant">Tất cả các bữa ăn tiêu chuẩn</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary">check_circle</span>
                        <span class="text-on-surface-variant">Hướng dẫn viên chuyên nghiệp</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary">check_circle</span>
                        <span class="text-on-surface-variant">Bảo hiểm du lịch trọn gói</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary">check_circle</span>
                        <span class="text-on-surface-variant">Nước uống và tiện ích miễn phí</span>
                    </div>
                </div>
            </article>
        </div>

        <!-- Right Column: Sticky Widget -->
        <aside class="col-span-12 md:col-span-4">
            <div class="sticky top-28 bg-surface-container-lowest border border-outline/10 p-stack-lg rounded-2xl luxury-shadow mt-12 md:mt-0">
                <div class="mb-stack-lg">
                    <span class="text-label-sm text-on-surface-variant uppercase tracking-widest">Giá mỗi khách</span>
                    <div class="flex items-baseline gap-2 mt-2">
                        <span class="font-display-lg text-headline-lg text-primary font-bold">@Model.Price.ToString("N0")</span>
                        <span class="font-label-lg text-on-surface">VNĐ</span>
                    </div>
                </div>
                
                @if (TempData["Error"] != null)
                {
                    <div class="bg-error-container text-on-error-container p-4 rounded-lg mb-4 text-sm font-medium">
                        @TempData["Error"]
                    </div>
                }

                <form asp-controller="CustomerTourBooking" asp-action="Book" method="get" class="space-y-stack-md">
                    <div>
                        <label class="font-label-lg text-on-surface block mb-2">Lịch khởi hành</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">calendar_month</span>
                            <select name="id" required class="w-full pl-10 pr-10 py-3 bg-surface-container border border-outline/15 rounded-lg focus:outline-none focus:border-primary-container transition-all appearance-none cursor-pointer">
                                @if (Model.UpcomingSchedules != null && Model.UpcomingSchedules.Any())
                                {
                                    <option value="">-- Chọn lịch trình --</option>
                                    foreach (var sch in Model.UpcomingSchedules)
                                    {
                                        <option value="@sch.ScheduleId">@sch.TourDate.ToString("dd/MM/yyyy") (Còn @sch.AvailableSlots chỗ)</option>
                                    }
                                }
                                else
                                {
                                    <option value="" disabled selected>Chưa có lịch khởi hành</option>
                                }
                            </select>
                            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
                        </div>
                    </div>

                    <div>
                        <label class="font-label-lg text-on-surface block mb-2">Số lượng khách tạm tính</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">group</span>
                            <select id="guestCount" class="w-full pl-10 pr-10 py-3 bg-surface-container border border-outline/15 rounded-lg focus:outline-none focus:border-primary-container transition-all appearance-none cursor-pointer">
                                <option value="1">1 Người lớn</option>
                                <option selected value="2">2 Người lớn</option>
                                <option value="3">3 Người lớn</option>
                                <option value="4">4 Người lớn</option>
                                <option value="5">5 Người lớn</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
                        </div>
                    </div>

                    <div class="pt-stack-md border-t border-outline/10 space-y-2">
                        <div class="flex justify-between text-body-md text-on-surface-variant">
                            <span id="priceLabel">Giá tạm tính (x2 khách)</span>
                            <span id="priceValue">@((Model.Price * 2).ToString("N0"))đ</span>
                        </div>
                        <div class="flex justify-between font-bold text-headline-sm text-on-surface pt-2">
                            <span>Tổng cộng</span>
                            <span id="totalValue" class="text-primary">@((Model.Price * 2).ToString("N0"))đ</span>
                        </div>
                    </div>

                    @if (Model.UpcomingSchedules != null && Model.UpcomingSchedules.Any())
                    {
                        <button type="submit" class="w-full bg-primary-container text-on-primary-container font-headline-sm py-4 rounded-xl hover:brightness-105 active:scale-95 transition-all shadow-lg shadow-primary-container/20 mt-4 font-bold">
                            Đặt Tour Ngay
                        </button>
                    }
                    else
                    {
                        <button type="button" disabled class="w-full bg-surface-variant text-on-surface-variant font-headline-sm py-4 rounded-xl mt-4 cursor-not-allowed">
                            Chưa có lịch mở bán
                        </button>
                    }
                </form>
                <p class="text-center text-label-sm text-on-surface-variant mt-4">
                    <span class="material-symbols-outlined text-[14px] align-text-top mr-1">verified_user</span>
                    Xác nhận tức thì qua email
                </p>
            </div>
        </aside>
    </section>

    <!-- Reviews Section (Static Mockup) -->
    <section class="bg-surface-container-low py-section-gap-lg border-t border-outline/10">
        <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-section-gap-md gap-4">
                <div>
                    <h2 class="font-headline-lg text-headline-lg text-primary mb-4">Đánh Giá Từ Khách Hàng</h2>
                    <div class="flex items-center gap-2">
                        <div class="flex text-primary">
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                        </div>
                        <span class="font-label-lg text-on-surface">@(Model.AverageRating > 0 ? Model.AverageRating.ToString("F1") : "4.9")/5 dựa trên 124 lượt đánh giá</span>
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
                <!-- Review Card 1 -->
                <div class="bg-surface p-stack-lg rounded-2xl luxury-shadow border border-outline/5">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-primary-container"></div>
                        <div>
                            <h4 class="font-label-lg text-on-surface">Minh Anh Lê</h4>
                            <p class="text-label-sm text-on-surface-variant">Tháng 10, 2023</p>
                        </div>
                    </div>
                    <p class="font-body-md text-on-surface-variant italic">"Một chuyến đi tuyệt vời vượt xa sự mong đợi. Dịch vụ chăm sóc khách hàng của Phúc Nguyên thật sự tinh tế."</p>
                </div>
                <!-- Review Card 2 -->
                <div class="bg-surface p-stack-lg rounded-2xl luxury-shadow border border-outline/5">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-tertiary-container"></div>
                        <div>
                            <h4 class="font-label-lg text-on-surface">James Wilson</h4>
                            <p class="text-label-sm text-on-surface-variant">Tháng 11, 2023</p>
                        </div>
                    </div>
                    <p class="font-body-md text-on-surface-variant italic">"Perfect organization from start to finish. The cave tour was magical and the sunrise was the highlight."</p>
                </div>
                <!-- Review Card 3 -->
                <div class="bg-surface p-stack-lg rounded-2xl luxury-shadow border border-outline/5">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-12 h-12 rounded-full overflow-hidden bg-secondary-container"></div>
                        <div>
                            <h4 class="font-label-lg text-on-surface">Thanh & Hoài</h4>
                            <p class="text-label-sm text-on-surface-variant">Tháng 12, 2023</p>
                        </div>
                    </div>
                    <p class="font-body-md text-on-surface-variant italic">"Chúng mình đã có kỷ niệm ngày cưới thật trọn vẹn. Cảm ơn team đã chuẩn bị chu đáo."</p>
                </div>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Price calculation micro-interaction
            const guestSelect = document.getElementById('guestCount');
            const priceLabel = document.getElementById('priceLabel');
            const priceValue = document.getElementById('priceValue');
            const totalValue = document.getElementById('totalValue');
            const basePrice = @Model.Price;

            function updatePrice() {
                if(!guestSelect) return;
                const count = parseInt(guestSelect.value);
                const subtotal = count * basePrice;
                
                priceLabel.innerText = `Giá tạm tính (x${count} khách)`;
                priceValue.innerText = subtotal.toLocaleString('vi-VN') + 'đ';
                totalValue.innerText = subtotal.toLocaleString('vi-VN') + 'đ';
            }

            guestSelect?.addEventListener('change', updatePrice);
        });
    </script>
}
