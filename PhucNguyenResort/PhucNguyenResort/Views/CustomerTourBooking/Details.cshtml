@model PhucNguyenResort.ViewModels.Tours.TourDetailVM
@{
    ViewData["Title"] = "Chi Tiết Tour | Phúc Nguyên Resort";
    string imageUrl = string.IsNullOrEmpty(Model.ImageUrl) ? "https://lh3.googleusercontent.com/aida-public/AB6AXuCM9OErZMl-5BqJTmZKC5cF27v4NpOrlYot62zaWRmB2uF9gZJZJ76juU0YrC-roJA-z1a4xKW0KVcbhUW9AtMhjH7TyyHce4wAvBeI0-XIXpdiNY4MGiiesNrjzCmCswoxpU08i3Mu2Sa7u_Iy3niC8eA7cKkO1mHVPrHLFq-nUSwirX7dCC7OhZLT-6vrYK9lQp0e-wSwt0YdlOvxLhN7jhceuFNaUgo-ywtjx2QUlHaFhPoSg_N1s2t_2MYKnsIXRQAqWT3Gwps4" : Model.ImageUrl;
}

@section Styles {
    <style>
        .luxury-shadow {
            box-shadow: 0 24px 40px -10px rgba(30, 41, 59, 0.06);
        }
        .hero-overlay {
            background: rgba(28, 28, 26, 0.5);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .fill-icon {
            font-variation-settings: 'FILL' 1;
        }
    </style>
}

<main class="pt-0 bg-background">
    <!-- Hero Section -->
    <section class="relative h-screen w-full overflow-hidden">
        <div class="absolute inset-0 w-full h-full bg-cover bg-center" style="background-image: url('@imageUrl')"></div>
        <div class="absolute inset-0 hero-overlay flex flex-col justify-center items-center px-margin-mobile md:px-margin-desktop text-center">
            <div class="max-w-container-max mx-auto w-full flex flex-col items-center">
                <span class="bg-primary-container text-on-primary-container px-4 py-1 rounded-full text-label-sm font-label-lg uppercase tracking-widest mb-4 inline-block">TINH HOA KHÁM PHÁ</span>
                <h1 class="font-display-lg text-display-lg text-white mb-4">@Model.TourName</h1>
                <div class="flex flex-wrap justify-center gap-stack-lg text-white/90">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined">schedule</span>
                        <span class="font-label-lg">@(Model.DurationHours >= 24 ? $"{Model.DurationHours/24} Ngày" : $"{Model.DurationHours} Giờ")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined">location_on</span>
                            <span class="font-label-lg">@Model.Location</span>
                        </div>
                    }
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined">groups</span>
                        <span class="font-label-lg">Tổng còn @Model.UpcomingSchedules.Where(s => !s.IsFull).Sum(s => s.AvailableSlots) chỗ</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Content Section -->
    <section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-section-gap-md grid grid-cols-12 gap-gutter relative">
        
        <!-- Left Column: Content -->
        <div class="col-span-12 md:col-span-8 space-y-section-gap-md">
            <!-- Overview -->
            <article>
                <h2 class="font-headline-lg text-headline-lg mb-stack-lg text-primary">Tổng Quan Chuyến Đi</h2>
                <div class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed mb-stack-md whitespace-pre-wrap">@Model.Description</div>
                
                <div class="grid grid-cols-2 md:grid-cols-3 gap-gutter pt-stack-lg mt-8 border-t border-outline/10">
                    <div class="flex flex-col gap-2 p-stack-md bg-surface-container rounded-xl border border-outline/10 text-center items-center justify-center">
                        <span class="material-symbols-outlined text-primary text-3xl mb-2" data-weight="fill">restaurant</span>
                        <span class="font-label-lg text-on-surface">Ẩm thực cao cấp</span>
                    </div>
                    <div class="flex flex-col gap-2 p-stack-md bg-surface-container rounded-xl border border-outline/10 text-center items-center justify-center">
                        <span class="material-symbols-outlined text-primary text-3xl mb-2" data-weight="fill">directions_boat</span>
                        <span class="font-label-lg text-on-surface">Di chuyển riêng</span>
                    </div>
                    <div class="flex flex-col gap-2 p-stack-md bg-surface-container rounded-xl border border-outline/10 text-center items-center justify-center">
                        <span class="material-symbols-outlined text-primary text-3xl mb-2" data-weight="fill">photo_camera</span>
                        <span class="font-label-lg text-on-surface">Chụp ảnh chuyên nghiệp</span>
                    </div>
                </div>

                <!-- Images Gallery -->
                <div class="mt-12">
                    <h3 class="font-headline-sm text-headline-sm text-primary mb-4">Hình Ảnh Trải Nghiệm</h3>
                    @{
                        var allImages = new List<string> { imageUrl };
                        if (Model.GalleryImages != null && Model.GalleryImages.Any())
                        {
                            allImages.AddRange(Model.GalleryImages);
                        }
                    }
                    
                    @if(allImages.Count == 1)
                    {
                        <div class="grid grid-cols-1 gap-4">
                            <div class="rounded-xl overflow-hidden shadow-sm gallery-img cursor-pointer relative group">
                                <img src="@allImages[0]" alt="@Model.TourName" class="w-full h-[400px] object-cover group-hover:scale-105 transition-transform duration-500" />
                                <div class="absolute inset-0 bg-black/0 flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:bg-black/20 transition-all">
                                    <span class="text-white bg-black/50 p-3 rounded-full flex items-center justify-center"><span class="material-symbols-outlined">zoom_in</span></span>
                                </div>
                            </div>
                        </div>
                    }
                    else if(allImages.Count == 2)
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            @foreach(var img in allImages)
                            {
                                <div class="rounded-xl overflow-hidden shadow-sm gallery-img cursor-pointer relative group">
                                    <img src="@img" alt="@Model.TourName" class="w-full h-[400px] object-cover group-hover:scale-105 transition-transform duration-500" />
                                    <div class="absolute inset-0 bg-black/0 flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:bg-black/20 transition-all">
                                        <span class="text-white bg-black/50 p-3 rounded-full flex items-center justify-center"><span class="material-symbols-outlined">zoom_in</span></span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                            <div class="col-span-2 row-span-2 rounded-xl overflow-hidden shadow-sm gallery-img cursor-pointer relative group">
                                <img src="@allImages[0]" alt="@Model.TourName" class="w-full h-[416px] object-cover group-hover:scale-105 transition-transform duration-500" />
                                <div class="absolute inset-0 bg-black/0 flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:bg-black/20 transition-all">
                                    <span class="text-white bg-black/50 p-3 rounded-full flex items-center justify-center"><span class="material-symbols-outlined">zoom_in</span></span>
                                </div>
                            </div>
                            <div class="rounded-xl overflow-hidden shadow-sm gallery-img cursor-pointer relative group">
                                <img src="@allImages[1]" alt="Trải nghiệm" class="w-full h-[200px] object-cover group-hover:scale-105 transition-transform duration-500" />
                                <div class="absolute inset-0 bg-black/0 flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:bg-black/20 transition-all">
                                    <span class="text-white bg-black/50 p-2 rounded-full flex items-center justify-center"><span class="material-symbols-outlined text-sm">zoom_in</span></span>
                                </div>
                            </div>
                            @if(allImages.Count > 2)
                            {
                                <div class="rounded-xl overflow-hidden shadow-sm relative group cursor-pointer gallery-img">
                                    <img src="@allImages[2]" alt="Trải nghiệm" class="w-full h-[200px] object-cover group-hover:scale-105 transition-transform duration-500" />
                                    @if(allImages.Count > 3)
                                    {
                                        <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-100 group-hover:bg-black/60 transition-colors">
                                            <span class="text-white font-label-lg flex items-center gap-2"><span class="material-symbols-outlined">zoom_in</span> +@(allImages.Count - 3) Xem thêm</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="absolute inset-0 bg-black/0 flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:bg-black/20 transition-all">
                                            <span class="text-white bg-black/50 p-2 rounded-full flex items-center justify-center"><span class="material-symbols-outlined text-sm">zoom_in</span></span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Hidden images for lightbox -->
                    @if(allImages.Count > 3)
                    {
                        <div class="hidden">
                            @for(int i = 3; i < allImages.Count; i++)
                            {
                                <div class="gallery-img">
                                    <img src="@allImages[i]" />
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Location & Weather -->
                <div class="mt-12 border-t border-outline/10 pt-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
                        <!-- Google Maps -->
                        <div>
                            <h3 class="font-headline-sm text-headline-sm text-primary mb-4 flex items-center gap-2">
                                <span class="material-symbols-outlined">location_on</span> Vị Trí
                            </h3>
                            <div class="rounded-xl overflow-hidden shadow-sm border border-outline/10 h-[280px]">
                                <iframe 
                                    src="https://maps.google.com/maps?q=Hòa Lạc, Thạch Thất, Hà Nội&t=&z=13&ie=UTF8&iwloc=&output=embed" 
                                    width="100%" 
                                    height="100%" 
                                    style="border:0;" 
                                    allowfullscreen="" 
                                    loading="lazy" 
                                    referrerpolicy="no-referrer-when-downgrade">
                                </iframe>
                            </div>
                        </div>

                        <!-- Weather Forecast -->
                        <div>
                            <h3 class="font-headline-sm text-headline-sm text-primary mb-4 flex items-center gap-2">
                                <span class="material-symbols-outlined">routine</span> Thời Tiết Dự Kiến
                            </h3>
                            <div class="rounded-xl shadow-sm border border-outline/10 p-6 bg-gradient-to-br from-blue-50 to-blue-100 h-[280px] flex flex-col justify-between">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <h4 class="font-headline-md text-slate-800">Hòa Lạc</h4>
                                        <p class="text-slate-600 font-label-lg">Hôm nay</p>
                                    </div>
                                    <span id="current-weather-icon" class="material-symbols-outlined text-5xl text-yellow-500" style="font-variation-settings: 'FILL' 1;">light_mode</span>
                                </div>
                                <div class="flex items-end gap-4 mt-2">
                                    <span id="current-temperature" class="text-display-md font-bold text-slate-800">--°C</span>
                                    <div class="text-slate-600 font-body-sm pb-1">
                                        <p id="current-weather-desc" class="font-bold">Đang tải...</p>
                                        <p id="current-weather-details">Độ ẩm: --% • Gió: --km/h</p>
                                    </div>
                                </div>
                                <div class="grid grid-cols-3 gap-2 mt-4 pt-4 border-t border-blue-200/50 text-center">
                                    <div>
                                        <p class="text-label-sm text-slate-500">Ngày mai</p>
                                        <span id="day1-icon" class="material-symbols-outlined text-yellow-500 my-1">partly_cloudy_day</span>
                                        <p id="day1-temp" class="font-label-lg text-slate-700">--°</p>
                                    </div>
                                    <div>
                                        <p class="text-label-sm text-slate-500">Ngày 3</p>
                                        <span id="day2-icon" class="material-symbols-outlined text-yellow-500 my-1">light_mode</span>
                                        <p id="day2-temp" class="font-label-lg text-slate-700">--°</p>
                                    </div>
                                    <div>
                                        <p class="text-label-sm text-slate-500">Ngày 4</p>
                                        <span id="day3-icon" class="material-symbols-outlined text-slate-400 my-1">cloud</span>
                                        <p id="day3-temp" class="font-label-lg text-slate-700">--°</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </article>

            <!-- Inclusion -->
            <article>
                <h2 class="font-headline-lg text-headline-lg mb-stack-lg text-primary">Dịch Vụ Bao Gồm</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary">check_circle</span>
                        <span class="text-on-surface-variant">Tất cả các bữa ăn tiêu chuẩn</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary">check_circle</span>
                        <span class="text-on-surface-variant">Hướng dẫn viên chuyên nghiệp</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary">check_circle</span>
                        <span class="text-on-surface-variant">Bảo hiểm du lịch trọn gói</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary">check_circle</span>
                        <span class="text-on-surface-variant">Nước uống và tiện ích miễn phí</span>
                    </div>
                </div>
            </article>
        </div>

        <!-- Right Column: Sticky Widget -->
        <aside class="col-span-12 md:col-span-4">
            <div class="sticky top-28 bg-surface-container-lowest border border-outline/10 p-stack-lg rounded-2xl luxury-shadow mt-12 md:mt-0">
                <div class="mb-stack-lg">
                    <span class="text-label-sm text-on-surface-variant uppercase tracking-widest">Giá mỗi khách</span>
                    <div class="flex items-baseline gap-2 mt-2">
                        <span class="font-display-lg text-headline-lg text-primary font-bold">@Model.Price.ToString("N0")</span>
                        <span class="font-label-lg text-on-surface">VNĐ</span>
                    </div>
                </div>
                
                @if (TempData["Error"] != null)
                {
                    <div class="bg-error-container text-on-error-container p-4 rounded-lg mb-4 text-sm font-medium">
                        @TempData["Error"]
                    </div>
                }

                <form asp-controller="CustomerTourBooking" asp-action="Book" method="get" class="space-y-stack-md">
                    <div>
                        <label class="font-label-lg text-on-surface block mb-2">Lịch khởi hành</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">calendar_month</span>
                            <select name="id" required class="w-full pl-10 py-3 bg-surface-container border border-outline/15 rounded-lg focus:outline-none focus:border-primary-container transition-all cursor-pointer">
                                @if (Model.UpcomingSchedules != null && Model.UpcomingSchedules.Any())
                                {
                                    <option value="">-- Chọn lịch trình --</option>
                                    foreach (var sch in Model.UpcomingSchedules)
                                    {
                                        if (sch.IsFull)
                                        {
                                            <option value="@sch.ScheduleId" disabled>@sch.TourDate.ToString("dd/MM/yyyy") (Hết chỗ)</option>
                                        }
                                        else
                                        {
                                            <option value="@sch.ScheduleId">@sch.TourDate.ToString("dd/MM/yyyy") (Còn @sch.AvailableSlots chỗ)</option>
                                        }
                                    }
                                }
                                else
                                {
                                    <option value="" disabled selected>Chưa có lịch khởi hành</option>
                                }
                            </select>
                        </div>
                    </div>


                    @if (Model.UpcomingSchedules != null && Model.UpcomingSchedules.Any(s => !s.IsFull))
                    {
                        <button type="submit" class="w-full bg-primary-container text-on-primary-container font-headline-sm py-4 rounded-xl hover:brightness-105 active:scale-95 transition-all shadow-lg shadow-primary-container/20 mt-4 font-bold">
                            Đặt Tour Ngay
                        </button>
                    }
                    else
                    {
                        <button type="button" disabled class="w-full bg-surface-variant text-on-surface-variant font-headline-sm py-4 rounded-xl mt-4 cursor-not-allowed">
                            Chưa có lịch mở bán hoặc đã hết chỗ
                        </button>
                    }
                </form>
                <p class="text-center text-label-sm text-on-surface-variant mt-4">
                    <span class="material-symbols-outlined text-[14px] align-text-top mr-1">verified_user</span>
                    Xác nhận tức thì qua email
                </p>
            </div>
        </aside>
    </section>

    <!-- Reviews Section (Static Mockup) -->
    <section class="bg-surface-container-low py-section-gap-lg border-t border-outline/10">
        <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-section-gap-md gap-4">
                <div>
                    <h2 class="font-headline-lg text-headline-lg text-primary mb-4">Đánh Giá Từ Khách Hàng</h2>
                    @if (Model.ReviewCount > 0)
                    {
                        <div class="flex items-center gap-2">
                            <div class="flex text-primary">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(Model.AverageRating))
                                    {
                                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined">star</span>
                                    }
                                }
                            </div>
                            <span class="font-label-lg text-on-surface">@Model.AverageRating.ToString("F1")/5 dựa trên @Model.ReviewCount lượt đánh giá</span>
                        </div>
                    }
                </div>
            </div>
            
            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
                    @foreach (var review in Model.Reviews.Take(3))
                    {
                        var avatarColors = new[] { "bg-primary-container", "bg-tertiary-container", "bg-secondary-container", "bg-error-container" };
                        var colorClass = avatarColors[review.ReviewId % avatarColors.Length];
                        var initial = !string.IsNullOrEmpty(review.UserName) ? review.UserName.Substring(0, 1).ToUpper() : "U";

                        <div class="bg-surface p-stack-lg rounded-2xl luxury-shadow border border-outline/5">
                            <div class="flex items-center gap-4 mb-4">
                                <div class="w-12 h-12 rounded-full overflow-hidden @colorClass flex items-center justify-center font-bold text-on-surface text-lg">
                                    @initial
                                </div>
                                <div>
                                    <h4 class="font-label-lg text-on-surface">@review.UserName</h4>
                                    <p class="text-label-sm text-on-surface-variant">Tháng @review.CreatedAt.Month, @review.CreatedAt.Year</p>
                                </div>
                                <div class="ml-auto flex text-primary items-center">
                                    <span class="font-bold mr-1">@review.Rating</span>
                                    <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                </div>
                            </div>
                            <p class="font-body-md text-on-surface-variant italic line-clamp-4">"@review.Comment"</p>
                        </div>
                    }
                </div>
                @if (Model.ReviewCount > 3)
                {
                    <div class="mt-8 text-center">
                        <a asp-controller="Review" asp-action="PublicList" asp-route-tourId="@Model.TourId" class="inline-flex items-center justify-center px-6 py-2 border border-primary text-primary rounded-lg hover:bg-primary hover:text-white transition-all font-label-lg">
                            Xem tất cả @Model.ReviewCount đánh giá
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="bg-surface p-stack-lg rounded-2xl text-center border border-outline/5">
                    <p class="text-on-surface-variant font-label-lg italic">Chưa có đánh giá nào cho tour này.</p>
                </div>
            }
        </div>
    </section>
    <!-- Lightbox Modal -->
    <div id="lightbox-modal" class="fixed inset-0 z-50 hidden bg-black/90 items-center justify-center">
        <button id="lightbox-close" class="absolute top-6 right-6 text-white hover:text-gray-300 transition-colors">
            <span class="material-symbols-outlined text-4xl">close</span>
        </button>
        <button id="lightbox-prev" class="absolute left-6 text-white hover:text-gray-300 transition-colors">
            <span class="material-symbols-outlined text-4xl">chevron_left</span>
        </button>
        <div class="max-w-5xl max-h-[80vh] w-full mx-4 flex justify-center relative">
            <img id="lightbox-img" src="" alt="Gallery Image" class="max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl" />
        </div>
        <button id="lightbox-next" class="absolute right-6 text-white hover:text-gray-300 transition-colors">
            <span class="material-symbols-outlined text-4xl">chevron_right</span>
        </button>
    </div>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Lightbox functionality
            const lightbox = document.getElementById('lightbox-modal');
            const lightboxImg = document.getElementById('lightbox-img');
            const btnClose = document.getElementById('lightbox-close');
            const btnPrev = document.getElementById('lightbox-prev');
            const btnNext = document.getElementById('lightbox-next');
            const galleryImages = document.querySelectorAll('.gallery-img');
            
            let currentIndex = 0;
            // High-res variants for demo purposes if needed, otherwise fallback to img src
            const imagesSrc = Array.from(galleryImages).map(el => {
                const img = el.querySelector('img');
                return img ? img.src.replace('&w=600', '&w=1200') : ''; 
            });

            function openLightbox(index) {
                currentIndex = index;
                lightboxImg.src = imagesSrc[currentIndex];
                lightbox.classList.remove('hidden');
                lightbox.classList.add('flex');
                document.body.style.overflow = 'hidden'; // Prevent scrolling
            }

            function closeLightbox() {
                lightbox.classList.add('hidden');
                lightbox.classList.remove('flex');
                document.body.style.overflow = '';
            }

            function showNext() {
                currentIndex = (currentIndex + 1) % imagesSrc.length;
                lightboxImg.src = imagesSrc[currentIndex];
            }

            function showPrev() {
                currentIndex = (currentIndex - 1 + imagesSrc.length) % imagesSrc.length;
                lightboxImg.src = imagesSrc[currentIndex];
            }

            galleryImages.forEach((item, index) => {
                item.addEventListener('click', () => openLightbox(index));
            });

            btnClose.addEventListener('click', closeLightbox);
            btnNext.addEventListener('click', showNext);
            btnPrev.addEventListener('click', showPrev);

            // Close on background click
            lightbox.addEventListener('click', function (e) {
                if (e.target === lightbox || e.target.parentElement === lightbox) {
                    closeLightbox();
                }
            });

            // Keyboard navigation
            document.addEventListener('keydown', function (e) {
                if (!lightbox.classList.contains('hidden')) {
                    if (e.key === 'Escape') closeLightbox();
                    if (e.key === 'ArrowRight') showNext();
                    if (e.key === 'ArrowLeft') showPrev();
                }
            });

            // Lấy thời tiết thực tế
            const lat = 21.0116; 
            const lon = 105.5283;
            const weatherUrl = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code&daily=weather_code,temperature_2m_max&timezone=Asia%2FBangkok&forecast_days=4`;

            function getWeatherInfo(code) {
                if (code === 0) return { text: 'Quang đãng', icon: 'light_mode', color: '#f59e0b' };
                if (code >= 1 && code <= 3) return { text: 'Có mây', icon: 'partly_cloudy_day', color: '#f59e0b' };
                if (code === 45 || code === 48) return { text: 'Sương mù', icon: 'foggy', color: '#94a3b8' };
                if (code >= 51 && code <= 67) return { text: 'Mưa', icon: 'rainy', color: '#3b82f6' };
                if (code >= 71 && code <= 77) return { text: 'Tuyết', icon: 'ac_unit', color: '#93c5fd' };
                if (code >= 80 && code <= 82) return { text: 'Mưa rào', icon: 'rainy', color: '#3b82f6' };
                if (code >= 95) return { text: 'Dông sét', icon: 'thunderstorm', color: '#475569' };
                return { text: 'Không rõ', icon: 'cloud', color: '#94a3b8' };
            }

            fetch(weatherUrl)
                .then(res => res.json())
                .then(data => {
                    const current = data.current;
                    const daily = data.daily;
                    
                    const currInfo = getWeatherInfo(current.weather_code);
                    
                    const iconEl = document.getElementById('current-weather-icon');
                    if(iconEl) {
                        iconEl.innerText = currInfo.icon;
                        iconEl.style.color = currInfo.color;
                    }
                    
                    const tempEl = document.getElementById('current-temperature');
                    if(tempEl) tempEl.innerText = Math.round(current.temperature_2m) + '°C';
                    
                    const descEl = document.getElementById('current-weather-desc');
                    if(descEl) descEl.innerText = currInfo.text;
                    
                    const detailsEl = document.getElementById('current-weather-details');
                    if(detailsEl) detailsEl.innerText = `Độ ẩm: ${current.relative_humidity_2m}% • Gió: ${current.wind_speed_10m}km/h`;

                    for (let i = 1; i <= 3; i++) {
                        const dInfo = getWeatherInfo(daily.weather_code[i]);
                        const dIconEl = document.getElementById(`day${i}-icon`);
                        if(dIconEl) {
                            dIconEl.innerText = dInfo.icon;
                            dIconEl.style.color = dInfo.color;
                        }
                        const dTempEl = document.getElementById(`day${i}-temp`);
                        if(dTempEl) dTempEl.innerText = Math.round(daily.temperature_2m_max[i]) + '°';
                    }
                })
                .catch(err => {
                    console.error("Error fetching weather:", err);
                    const descEl = document.getElementById('current-weather-desc');
                    if(descEl) descEl.innerText = 'Không thể tải dữ liệu';
                });
        });
    </script>
}
