@using PhucNguyenResort.Enums
@using System.Security.Claims
@model List<PhucNguyenResort.ViewModels.Tours.MyTourBookingItemVM>
@{
    ViewData["Title"] = "Lịch Sử Đặt Tour";
    var fullName = User.FindFirstValue(ClaimTypes.Name) ?? "Khách Hàng";
    var email = User.FindFirstValue(ClaimTypes.Email) ?? "";
    var initials = string.IsNullOrEmpty(fullName) ? "U" : fullName.Substring(0, 1).ToUpper();
}

@section Styles {
    <style>
        .custom-shadow {
            box-shadow: 0 24px 40px rgba(30, 41, 59, 0.06);
        }
        .luxury-shadow {
            box-shadow: 0 24px 40px -10px rgba(30, 41, 59, 0.06);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .status-pill {
            padding: 4px 12px;
            border-radius: 100px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .active-link {
            border-left: 3px solid #805528;
            font-weight: 700;
            color: #805528 !important;
            background-color: #f6f3ef;
        }
        .luxury-card {
            background-color: #FFFFFF;
            border: 1px solid rgba(226, 232, 240, 0.6);
            box-shadow: 0 24px 40px -10px rgba(30, 41, 59, 0.04);
        }
        .transition-soft {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
    </style>
}

<div class="pt-8 pb-section-gap-lg max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop min-h-screen bg-background">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
        
        <!-- Sidebar (4 columns) -->
        <aside class="md:col-span-4 space-y-stack-md">
            <div class="luxury-card rounded-xl p-8 text-center flex flex-col items-center">
                <div class="relative group cursor-pointer mb-6">
                    <div class="w-32 h-32 rounded-full bg-primary-container text-white flex items-center justify-center text-4xl font-headline-lg shadow-lg">
                        @initials
                    </div>
                </div>
                <h2 class="font-headline-sm text-headline-sm text-primary mb-1">@fullName</h2>
                <p class="font-body-md text-on-surface-variant opacity-70 mb-8">@email</p>

                <nav class="w-full space-y-2 text-left">
                    <a asp-controller="Profile" asp-action="Index" class="flex items-center gap-3 p-4 rounded-lg text-on-surface-variant hover:bg-surface-container-low transition-soft">
                        <span class="material-symbols-outlined">person</span>
                        <span class="font-label-lg text-label-lg">Hồ Sơ Cá Nhân</span>
                    </a>
                    <a asp-controller="Bookings" asp-action="MyBookings" class="flex items-center gap-3 p-4 rounded-lg text-on-surface-variant hover:bg-surface-container-low transition-soft">
                        <span class="material-symbols-outlined">history</span>
                        <span class="font-label-lg text-label-lg">Lịch Sử Đặt Phòng</span>
                    </a>
                    <a asp-controller="CustomerTourBooking" asp-action="MyTourBookings" class="flex items-center gap-3 p-4 rounded-lg text-primary font-bold active-link transition-soft">
                        <span class="material-symbols-outlined">tour</span>
                        <span class="font-label-lg text-label-lg">Lịch Sử Đặt Tour</span>
                    </a>
                    <a asp-controller="TableReservations" asp-action="MyReservations" class="flex items-center gap-3 p-4 rounded-lg text-on-surface-variant hover:bg-surface-container-low transition-soft">
                        <span class="material-symbols-outlined">restaurant</span>
                        <span class="font-label-lg text-label-lg">Lịch Sử Đặt Bàn</span>
                    </a>
                    <hr class="border-outline/10 my-4" />
                    <a asp-controller="Account" asp-action="Logout" class="flex items-center gap-3 p-4 rounded-lg text-error hover:bg-error-container/20 transition-soft">
                        <span class="material-symbols-outlined">logout</span>
                        <span class="font-label-lg text-label-lg">Đăng Xuất</span>
                    </a>
                </nav>
            </div>
        </aside>

        <!-- Main Content (8 columns) -->
        <div class="md:col-span-8 space-y-gutter">

            @if (TempData["Success"] != null)
            {
                <div class="bg-primary-container/20 text-on-primary-container p-4 rounded-xl border border-primary-container/30 text-center text-sm mb-6">
                    <span class="material-symbols-outlined align-middle mr-2 text-primary">check_circle</span>
                    @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="bg-error-container/20 text-error p-4 rounded-xl border border-error-container/30 text-center text-sm mb-6">
                    <span class="material-symbols-outlined align-middle mr-2">error</span>
                    @TempData["Error"]
                </div>
            }

            <div class="luxury-card rounded-xl p-8 mb-gutter">
                <div class="mb-8 border-b border-outline-variant/20 pb-4">
                    <h1 class="font-headline-md text-headline-md text-primary mb-2">Lịch Sử Đặt Tour</h1>
                    <p class="font-body-md text-on-surface-variant">Xem lại những hành trình tuyệt vời bạn đã trải nghiệm và chuẩn bị cho những chuyến đi sắp tới.</p>
                </div>

                <!-- Tour History List -->
                <div class="space-y-6">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                string imageUrl = string.IsNullOrEmpty(item.TourImage) ? "https://lh3.googleusercontent.com/aida-public/AB6AXuDoXolEoeYERw3qvGxHN3xsDHBu9_qyMy9nm3WKY4mUyN8KMnSPA329elqitw7imKCHy7j3GtjrKzDfe2ZCbi9PR_p9oTDfvg8zUh9Ggnw7K-KNEomFLHy_a53TGHJ-ahIcd3eWybbSY-BhsyAYmOw8eVXoDAP6PtVVlFjQG43jbbBIOee8N_47JCrjk6hvL9WHxIaQgLWSlSUvvCgsCK9Nzx-FCiLnKUJ6mItG2KA2zYXs4APScAT8wEz6FHZ901l55jhfzNr0zZ9e" : item.TourImage;
                
                string statusClass = "";
                string statusText = "";
                bool isOngoing = item.BookingStatus == "CheckedIn";
                bool isCancelled = item.BookingStatus == "Cancelled" || item.BookingStatus == "NoShow";
                bool isCompleted = item.BookingStatus == "Completed";
                bool isPending = item.BookingStatus == "Pending";
                bool isUpcoming = item.BookingStatus == "Confirmed";
                
                if (isUpcoming)
                {
                    statusClass = "bg-tertiary-container/30 text-on-tertiary-container";
                    statusText = "Sắp diễn ra";
                }
                else if (isOngoing)
                {
                    statusClass = "bg-primary-container text-on-primary-container";
                    statusText = "Đang diễn ra";
                }
                else if (isPending)
                {
                    statusClass = "bg-orange-50 text-orange-700 border-orange-100";
                    statusText = "Chờ thanh toán";
                }
                else if (isCompleted)
                {
                    statusClass = "bg-surface-variant text-on-surface-variant";
                    statusText = "Đã hoàn thành";
                }
                else
                {
                    statusClass = "bg-error-container text-on-error-container";
                    statusText = "Đã hủy";
                }

                <div class="tour-item bg-surface-container-lowest border border-outline-variant/30 rounded-xl luxury-shadow overflow-hidden flex flex-col md:flex-row transition-transform duration-300 hover:scale-[1.01] @(isCancelled ? "opacity-75" : "")">
                    <div class="w-full md:w-72 h-56 md:h-auto shrink-0 relative overflow-hidden @(isCancelled ? "grayscale" : (isCompleted ? "opacity-90" : ""))">
                        <img class="w-full h-full object-cover md:absolute md:inset-0" src="@imageUrl" alt="@item.TourName" />
                    </div>
                    <div class="p-5 md:p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="flex flex-col md:flex-row mb-4 gap-2">
                                <div class="w-full md:w-2/3 pr-2">
                                    <h3 class="font-headline-sm text-[20px] text-on-surface line-clamp-2">@item.TourName</h3>
                                </div>
                                <div class="w-full md:w-1/3 flex flex-col items-start gap-2">
                                    <span class="status-pill @statusClass whitespace-nowrap w-fit">@statusText</span>
                                    
                                    @if (item.BookingStatus == "CheckedIn" || item.BookingStatus == "Completed")
                                    {
                                        <span class="status-pill bg-green-100 text-green-700 border-green-200 whitespace-nowrap flex items-center w-fit">
                                            <span class="material-symbols-outlined text-[14px] mr-1">how_to_reg</span> Có mặt
                                        </span>
                                    }
                                    else if (item.BookingStatus == "NoShow")
                                    {
                                        <span class="status-pill bg-red-100 text-red-700 border-red-200 whitespace-nowrap flex items-center w-fit">
                                            <span class="material-symbols-outlined text-[14px] mr-1">person_off</span> Vắng mặt
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                                <div>
                                    <p class="font-label-sm text-[11px] text-on-surface-variant uppercase mb-1">Ngày khởi hành</p>
                                    <p class="font-body-md text-sm font-semibold">@item.TourDate.ToString("dd MMM, yyyy")</p>
                                </div>
                                <div>
                                    <p class="font-label-sm text-[11px] text-on-surface-variant uppercase mb-1">Số khách</p>
                                    <p class="font-body-md text-sm font-semibold">@item.Participants Người</p>
                                </div>
                                <div>
                                    <p class="font-label-sm text-[11px] text-on-surface-variant uppercase mb-1">Mã đặt chỗ</p>
                                    <p class="font-body-md text-sm font-semibold">#PNR-@item.TourBookingId</p>
                                </div>
                                <div>
                                    <p class="font-label-sm text-[11px] text-on-surface-variant uppercase mb-1">Tổng tiền</p>
                                    <p class="font-body-md text-sm font-bold text-primary">@item.TotalAmount.ToString("N0")đ</p>
                                </div>
                            </div>
                        </div>
                        <div class="flex flex-wrap justify-end items-center gap-3 border-t border-outline-variant/10 pt-4 mt-2">
                            @if (isCancelled)
                            {
                                <button class="px-6 py-1.5 border border-outline text-outline rounded-lg font-label-md cursor-not-allowed">Đã hủy</button>
                            }
                            else if (isCompleted)
                            {
                                if (!item.HasReviewed)
                                {
                                    <a asp-controller="Review" asp-action="Submit" asp-route-tourBookingId="@item.TourBookingId" class="px-5 py-1.5 border border-primary text-primary rounded-lg font-label-md hover:bg-primary/5 transition-all flex items-center justify-center">Đánh giá ngay</a>
                                }
                                else
                                {
                                    if (item.HasBeenEdited)
                                    {
                                        <span class="px-5 py-1.5 border border-outline-variant text-outline-variant rounded-lg font-label-md flex items-center justify-center gap-1 cursor-not-allowed" title="Đánh giá đã được chỉnh sửa 1 lần">
                                            <span class="material-symbols-outlined text-[18px]">done_all</span> Đã đánh giá
                                        </span>
                                    }
                                    else
                                    {
                                        <a asp-controller="Review" asp-action="Edit" asp-route-tourBookingId="@item.TourBookingId" class="px-5 py-1.5 border border-primary text-primary rounded-lg font-label-md hover:bg-primary/5 transition-all flex items-center justify-center gap-1">
                                            <span class="material-symbols-outlined text-[18px]">edit</span> Sửa đánh giá
                                        </a>
                                    }
                                }
                            }
                            else if (!isCompleted && !isCancelled)
                            {
                                @if (isPending)
                                {
                                    int elapsedSeconds = (int)(DateTime.Now - item.CreatedAt).TotalSeconds;
                                    <div class="text-sm text-error font-medium flex items-center gap-1 mr-2 whitespace-nowrap">
                                        <span class="material-symbols-outlined text-[16px]">schedule</span>
                                        <span class="payment-timer" data-elapsed="@elapsedSeconds">Đang tính...</span>
                                    </div>
                                }

                                if (item.CanCancel)
                                {
                                    <button type="button" class="px-5 py-1.5 border border-secondary text-secondary rounded-lg font-label-md hover:bg-secondary/5 transition-all" onclick="openCancelModal(@item.TourBookingId)">Hủy đặt chỗ</button>
                                }
                                else
                                {
                                    <button class="px-5 py-1.5 border border-outline-variant text-on-surface-variant rounded-lg font-label-md cursor-not-allowed opacity-60" title="Chỉ được hủy trước 48 giờ khởi hành">Không thể hủy (Quá hạn)</button>
                                }
                                
                                @if (isPending)
                                {
                                    <a asp-controller="CustomerTourBooking" asp-action="PayPendingBooking" asp-route-id="@item.TourBookingId" class="px-5 py-1.5 bg-primary text-on-primary rounded-lg font-label-md hover:bg-primary/90 transition-all flex items-center justify-center luxury-shadow shadow-primary/30">Thanh toán ngay</a>
                                }
                            }

                            <a asp-controller="Tours" asp-action="CheckTicket" asp-route-ticketId="@item.TourBookingId" class="px-6 py-1.5 bg-primary-container text-on-primary-container rounded-lg font-label-md hover:bg-primary transition-all flex items-center justify-center">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="py-12 text-center bg-surface-container-low rounded-xl">
                <span class="material-symbols-outlined text-4xl text-outline mb-2">history</span>
                <p class="text-on-surface-variant font-body-lg">Bạn chưa có lịch sử đặt tour nào.</p>
                <a asp-action="Index" class="inline-block mt-4 px-6 py-2 bg-primary text-on-primary rounded-lg font-label-lg hover:bg-on-primary-fixed-variant transition-all">Khám phá Tour ngay</a>
            </div>
        }
    </div>

                </div> <!-- End Tour History List space-y-6 -->
                
                @if (Model != null && Model.Count > 10)
                {
                    <!-- Pagination Container -->
                    <div id="pagination-container" class="mt-8 flex justify-center items-center space-x-2 border-t border-outline-variant/10 pt-6">
                        <!-- JS will populate buttons here -->
                    </div>
                }
            </div> <!-- End luxury-card -->
        </div> <!-- End Main Content -->
    </div> <!-- End Grid -->
</div> <!-- End Main wrapper -->

<!-- Cancel Tour Modal -->
<div id="cancel-modal" class="fixed inset-0 z-50 hidden bg-black/60 items-center justify-center backdrop-blur-sm">
    <div class="bg-surface-container-lowest rounded-xl shadow-2xl max-w-md w-full p-6 m-4 relative border border-outline-variant/30 transform transition-all">
        <h4 class="font-headline-sm text-error mb-4">Xác nhận hủy tour</h4>
        <form asp-action="CancelTourBooking" method="post">
            <input type="hidden" id="cancel-booking-id" name="id" value="" />
            
            <div class="mb-4">
                <label class="block text-label-sm font-bold text-on-surface mb-2">Lý do hủy tour (Tùy chọn)</label>
                <textarea name="reason" class="w-full p-3 rounded-lg border border-outline-variant focus:border-error focus:ring focus:ring-error/20 bg-surface-container-lowest" rows="3" placeholder="Ví dụ: Thay đổi lịch trình..."></textarea>
            </div>
            
            <div class="mb-4 p-3 bg-error-container/50 text-error rounded-lg text-sm">
                <span class="font-bold">Lưu ý:</span> Hủy tour trong vòng 48h trước giờ khởi hành sẽ <span class="font-bold">KHÔNG</span> được hoàn cọc theo chính sách của resort.
            </div>
            
            <div class="flex gap-3 mt-6">
                <button type="button" onclick="closeCancelModal()" class="flex-1 py-2.5 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container font-label-lg transition-all">
                    Đóng
                </button>
                <button type="submit" class="flex-1 py-2.5 rounded-lg bg-error text-white hover:opacity-90 font-label-lg transition-all">
                    Xác Nhận Hủy
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Cancel Modal logic
        window.openCancelModal = function(id) {
            document.getElementById('cancel-booking-id').value = id;
            const modal = document.getElementById('cancel-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        };
        
        window.closeCancelModal = function() {
            const modal = document.getElementById('cancel-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        };

        document.addEventListener('DOMContentLoaded', function() {
            const itemsPerPage = 10;
            const items = document.querySelectorAll('.tour-item');
            const totalItems = items.length;
            const totalPages = Math.ceil(totalItems / itemsPerPage);
            const paginationContainer = document.getElementById('pagination-container');
            
            if (totalPages > 1 && paginationContainer) {
                // ... (pagination logic) ... // (Wait, I need to keep the exact original pagination JS because I didn't get all of it in my head)

                let currentPage = 1;
                
                function showPage(page) {
                    currentPage = page;
                    items.forEach((item, index) => {
                        if (index >= (page - 1) * itemsPerPage && index < page * itemsPerPage) {
                            item.style.display = 'flex';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                    renderPagination();
                    
                    // Optional: scroll to top of list
                    if(page > 1) {
                        window.scrollTo({ top: document.querySelector('.tour-item').offsetTop - 100, behavior: 'smooth' });
                    }
                }
                
                function renderPagination() {
                    paginationContainer.innerHTML = '';
                    
                    // Prev Button
                    const prevBtn = document.createElement('button');
                    prevBtn.className = `w-10 h-10 flex items-center justify-center border rounded-lg transition-all ${currentPage === 1 ? 'border-outline-variant/10 text-outline-variant cursor-not-allowed' : 'border-outline-variant/30 text-on-surface-variant hover:border-primary hover:text-primary'}`;
                    prevBtn.innerHTML = '<span class="material-symbols-outlined">chevron_left</span>';
                    prevBtn.disabled = currentPage === 1;
                    prevBtn.onclick = () => showPage(currentPage - 1);
                    paginationContainer.appendChild(prevBtn);
                    
                    // Page Buttons
                    for (let i = 1; i <= totalPages; i++) {
                        const pageBtn = document.createElement('button');
                        if (i === currentPage) {
                            pageBtn.className = 'w-10 h-10 flex items-center justify-center bg-primary text-on-primary rounded-lg font-label-lg';
                        } else {
                            pageBtn.className = 'w-10 h-10 flex items-center justify-center border border-outline-variant/30 rounded-lg text-on-surface-variant hover:border-primary hover:text-primary transition-all font-label-lg';
                        }
                        pageBtn.innerText = i;
                        pageBtn.onclick = () => showPage(i);
                        paginationContainer.appendChild(pageBtn);
                    }
                    
                    // Next Button
                    const nextBtn = document.createElement('button');
                    nextBtn.className = `w-10 h-10 flex items-center justify-center border rounded-lg transition-all ${currentPage === totalPages ? 'border-outline-variant/10 text-outline-variant cursor-not-allowed' : 'border-outline-variant/30 text-on-surface-variant hover:border-primary hover:text-primary'}`;
                    nextBtn.innerHTML = '<span class="material-symbols-outlined">chevron_right</span>';
                    nextBtn.disabled = currentPage === totalPages;
                    nextBtn.onclick = () => showPage(currentPage + 1);
                    paginationContainer.appendChild(nextBtn);
                }
                
                showPage(1);
            }

            // Payment Timer Countdown Logic
            const timers = document.querySelectorAll('.payment-timer');
            if (timers.length > 0) {
                const countdownInterval = setInterval(() => {
                    let needsRefresh = false;
                    
                    timers.forEach(timer => {
                        let elapsed = parseInt(timer.getAttribute('data-elapsed')) || 0;
                        elapsed += 1;
                        timer.setAttribute('data-elapsed', elapsed);
                        
                        const maxSeconds = 120; // 2 minutes
                        const remaining = maxSeconds - elapsed;
                        
                        if (remaining <= 0) {
                            timer.innerHTML = "Đã tự động hủy";
                            needsRefresh = true;
                        } else {
                            // Format mm:ss
                            const m = Math.floor(remaining / 60);
                            const s = remaining % 60;
                            timer.innerHTML = `Còn ${m}:${s.toString().padStart(2, '0')} tự động hủy`;
                        }
                    });
                    
                    if (needsRefresh) {
                        clearInterval(countdownInterval);
                        // Refresh page after a brief moment to show "Đã hết hạn"
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    }
                }, 1000);
            }
        });
    </script>
}
