@using PhucNguyenResort.Enums
@model List<PhucNguyenResort.ViewModels.Tours.MyTourBookingItemVM>
@{
    ViewData["Title"] = "Lịch Sử Đặt Tour";
}

@section Styles {
    <style>
        .luxury-shadow {
            box-shadow: 0 24px 40px -10px rgba(30, 41, 59, 0.06);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .status-pill {
            padding: 4px 12px;
            border-radius: 100px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
    </style>
}

<main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-section-gap-md bg-background">
    <!-- Title & Breadcrumb -->
    <div class="mb-stack-lg text-center md:text-left">
        <nav class="flex items-center justify-center md:justify-start space-x-2 text-on-surface-variant mb-4 font-label-sm text-label-sm uppercase tracking-widest">
            <a class="hover:text-primary" asp-controller="Home" asp-action="Index">Trang chủ</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-primary">Lịch sử đặt tour</span>
        </nav>
        <h1 class="font-headline-lg text-headline-lg text-on-surface mb-2">Lịch Sử Đặt Tour</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto md:mx-0">Xem lại những hành trình tuyệt vời bạn đã trải nghiệm và chuẩn bị cho những chuyến đi sắp tới.</p>
    </div>

    <!-- Filter / Tabs -->
    <div class="flex flex-wrap gap-4 mb-stack-lg border-b border-outline-variant/20 pb-4">
        <button class="font-label-lg text-label-lg text-primary border-b-2 border-primary pb-4">Tất cả</button>
        <button class="font-label-lg text-label-lg text-on-surface-variant hover:text-primary transition-colors pb-4 hidden">Sắp diễn ra</button>
        <button class="font-label-lg text-label-lg text-on-surface-variant hover:text-primary transition-colors pb-4 hidden">Đã hoàn thành</button>
        <button class="font-label-lg text-label-lg text-on-surface-variant hover:text-primary transition-colors pb-4 hidden">Đã hủy</button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-primary-container text-on-primary-container p-4 rounded-xl mb-6">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-error-container text-on-error-container p-4 rounded-xl mb-6">
            @TempData["Error"]
        </div>
    }

    <!-- Tour History List -->
    <div class="space-y-6">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                string imageUrl = string.IsNullOrEmpty(item.TourImage) ? "https://lh3.googleusercontent.com/aida-public/AB6AXuDoXolEoeYERw3qvGxHN3xsDHBu9_qyMy9nm3WKY4mUyN8KMnSPA329elqitw7imKCHy7j3GtjrKzDfe2ZCbi9PR_p9oTDfvg8zUh9Ggnw7K-KNEomFLHy_a53TGHJ-ahIcd3eWybbSY-BhsyAYmOw8eVXoDAP6PtVVlFjQG43jbbBIOee8N_47JCrjk6hvL9WHxIaQgLWSlSUvvCgsCK9Nzx-FCiLnKUJ6mItG2KA2zYXs4APScAT8wEz6FHZ901l55jhfzNr0zZ9e" : item.TourImage;
                
                string statusClass = "";
                string statusText = "";
                bool isCancelled = item.BookingStatus == "Cancelled" || item.BookingStatus == "NoShow";
                bool isCompleted = item.BookingStatus == "Completed";
                bool isUpcoming = item.BookingStatus == "Confirmed" || item.BookingStatus == "Pending";
                
                if (isUpcoming)
                {
                    statusClass = "bg-tertiary-container/30 text-on-tertiary-container";
                    statusText = "Sắp diễn ra";
                }
                else if (isCompleted)
                {
                    statusClass = "bg-surface-variant text-on-surface-variant";
                    statusText = "Đã hoàn thành";
                }
                else
                {
                    statusClass = "bg-error-container text-on-error-container";
                    statusText = "Đã hủy";
                }

                <div class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl luxury-shadow overflow-hidden flex flex-col md:flex-row transition-transform duration-300 hover:scale-[1.01] @(isCancelled ? "opacity-75" : "")">
                    <div class="md:w-1/3 h-64 md:h-auto overflow-hidden @(isCancelled ? "grayscale" : (isCompleted ? "opacity-90" : ""))">
                        <img class="w-full h-full object-cover" src="@imageUrl" alt="@item.TourName" />
                    </div>
                    <div class="p-8 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="flex flex-col md:flex-row md:justify-between md:items-start mb-4 gap-2 md:gap-0">
                                <h3 class="font-headline-sm text-headline-sm text-on-surface line-clamp-2">@item.TourName</h3>
                                <span class="status-pill @statusClass whitespace-nowrap self-start">@statusText</span>
                            </div>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-6">
                                <div>
                                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">Ngày khởi hành</p>
                                    <p class="font-body-md text-body-md font-semibold">@item.TourDate.ToString("dd MMM, yyyy")</p>
                                </div>
                                <div>
                                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">Số khách</p>
                                    <p class="font-body-md text-body-md font-semibold">@item.Participants Người</p>
                                </div>
                                <div>
                                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">Mã đặt chỗ</p>
                                    <p class="font-body-md text-body-md font-semibold">#PNR-@item.TourBookingId</p>
                                </div>
                                <div>
                                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">Tổng tiền</p>
                                    <p class="font-body-md text-body-md font-bold text-primary">@item.TotalAmount.ToString("N0")đ</p>
                                </div>
                            </div>
                        </div>
                        <div class="flex justify-end gap-4 border-t border-outline-variant/10 pt-6">
                            @if (item.CanCancel)
                            {
                                <form asp-action="CancelTourBooking" method="post" class="inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy tour này không?');">
                                    <input type="hidden" name="id" value="@item.TourBookingId" />
                                    <input type="hidden" name="reason" value="Khách hàng tự hủy qua web" />
                                    <button type="submit" class="px-6 py-2 border border-secondary text-secondary rounded-lg font-label-lg text-label-lg hover:bg-secondary/5 transition-all">Hủy đặt chỗ</button>
                                </form>
                            }
                            else if (isCancelled)
                            {
                                <button class="px-8 py-2 border border-outline text-outline rounded-lg font-label-lg text-label-lg cursor-not-allowed">Đã hủy</button>
                            }
                            else if (isCompleted && !item.HasReviewed)
                            {
                                <button class="px-6 py-2 border border-primary text-primary rounded-lg font-label-lg text-label-lg hover:bg-primary/5 transition-all">Đánh giá ngay</button>
                            }

                            <a asp-action="Details" asp-route-id="@item.TourId" class="px-8 py-2 bg-primary-container text-on-primary-container rounded-lg font-label-lg text-label-lg hover:bg-primary transition-all flex items-center justify-center">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="py-12 text-center bg-surface-container-low rounded-xl">
                <span class="material-symbols-outlined text-4xl text-outline mb-2">history</span>
                <p class="text-on-surface-variant font-body-lg">Bạn chưa có lịch sử đặt tour nào.</p>
                <a asp-action="Index" class="inline-block mt-4 px-6 py-2 bg-primary text-on-primary rounded-lg font-label-lg hover:bg-on-primary-fixed-variant transition-all">Khám phá Tour ngay</a>
            </div>
        }
    </div>

    @if (Model != null && Model.Count > 10)
    {
        <!-- Pagination -->
        <div class="mt-section-gap-md flex justify-center items-center space-x-4">
            <button class="w-10 h-10 flex items-center justify-center border border-outline-variant/30 rounded-lg text-on-surface-variant hover:border-primary hover:text-primary transition-all">
                <span class="material-symbols-outlined">chevron_left</span>
            </button>
            <button class="w-10 h-10 flex items-center justify-center bg-primary text-on-primary rounded-lg font-label-lg">1</button>
            <button class="w-10 h-10 flex items-center justify-center border border-outline-variant/30 rounded-lg text-on-surface-variant hover:border-primary hover:text-primary transition-all font-label-lg">2</button>
            <button class="w-10 h-10 flex items-center justify-center border border-outline-variant/30 rounded-lg text-on-surface-variant hover:border-primary hover:text-primary transition-all">
                <span class="material-symbols-outlined">chevron_right</span>
            </button>
        </div>
    }
</main>

@section Scripts {
    <script>
        // Simple Micro-interaction for buttons
        document.querySelectorAll('button:not(:disabled)').forEach(button => {
            button.addEventListener('mousedown', () => {
                button.style.transform = 'scale(0.98)';
            });
            button.addEventListener('mouseup', () => {
                button.style.transform = 'scale(1)';
            });
            button.addEventListener('mouseleave', () => {
                button.style.transform = 'scale(1)';
            });
        });
    </script>
}
