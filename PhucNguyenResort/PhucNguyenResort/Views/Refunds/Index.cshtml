@model IEnumerable<PhucNguyenResort.Models.Refund>
@using PhucNguyenResort.Enums

@{
    ViewData["Title"] = "Quản lý Hoàn Tiền";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528; /* primary */
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b; /* on-surface-variant */
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 24px;
            margin-bottom: 30px;
        }
        .luxury-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        .luxury-table thead th {
            background-color: #f6f3ef; /* surface-container-low */
            color: #50453b;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 16px;
            border: none;
        }
        .luxury-table thead th:first-child {
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
        }
        .luxury-table thead th:last-child {
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }
        .luxury-table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-bottom: 1px solid #f0ede9;
            color: #1c1c1a;
            font-size: 14px;
        }
        .luxury-table tbody tr:last-child td {
            border-bottom: none;
        }
        .luxury-table tbody tr:hover {
            background-color: #fcf9f5; /* surface */
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .material-symbols-outlined.fill {
            font-variation-settings: 'FILL' 1;
        }
        .btn-luxury {
            background-color: #dfa974; /* primary-container */
            color: #633d11; /* on-primary-container */
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 20px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-luxury:hover {
            background-color: #805528;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2);
            text-decoration: none;
        }
        .action-btn {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #d4c3b6;
            color: #50453b;
            transition: all 0.2s;
            background: transparent;
            margin: 0 2px;
            text-decoration: none;
            cursor: pointer;
        }
        .action-btn:hover {
            background: #f6f3ef;
            color: #805528;
            border-color: #805528;
            text-decoration: none;
        }
        .action-btn.delete:hover {
            background: #ffdad6;
            color: #ba1a1a;
            border-color: #ba1a1a;
        }
        .action-btn.success:hover {
            background: #e2f5ea;
            color: #0b5c2d;
            border-color: #0b5c2d;
        }
        .luxury-badge {
            background-color: #f0ede9;
            color: #50453b;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 12px;
            display: inline-block;
        }
        .luxury-badge.blue {
            background-color: #d3e4fe;
            color: #0b1c30;
        }
        .luxury-badge.warning {
            background-color: #fff8e1;
            color: #f57f17;
        }
        .luxury-badge.success {
            background-color: #e2f5ea;
            color: #0b5c2d;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        
        /* Alert Styling */
        .luxury-alert {
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: 'Inter', sans-serif;
            border: none;
        }
        .luxury-alert.success {
            background-color: #e2f5ea;
            color: #0b5c2d;
        }
        .luxury-alert.error {
            background-color: #ffdad6;
            color: #93000a;
        }
        
        .modal-luxury .modal-content {
            border-radius: 16px;
            border: none;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.15);
        }
        .modal-luxury .modal-header {
            background-color: #805528;
            color: white;
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
            border-bottom: none;
        }
        .modal-luxury .modal-header .close {
            color: white;
            opacity: 0.8;
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            padding: 1rem;
            margin: -1rem -1rem -1rem auto;
        }
        .modal-luxury .modal-header .close:hover {
            opacity: 1;
        }
        .bank-details-box {
            background-color: #fcf9f5;
            border: 1px dashed #d4c3b6;
            border-radius: 8px;
            padding: 20px;
            position: relative;
        }
        .btn-copy {
            position: absolute;
            top: 10px;
            right: 10px;
            background: white;
            border: 1px solid #d4c3b6;
            border-radius: 4px;
            padding: 4px 8px;
            font-size: 12px;
            color: #805528;
            cursor: pointer;
        }
        .btn-copy:hover {
            background: #f6f3ef;
        }
    </style>
}

<div class="header-container mt-4">
    <div>
        <h2 class="page-title">
            Quản Lý Hoàn Tiền
        </h2>
    </div>
    <div style="font-family: 'Inter', sans-serif; color: #50453b; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined">calendar_today</span>
        <span>@DateTime.Now.ToString("dd MMMM, yyyy")</span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="luxury-alert success alert-dismissible fade show" role="alert" id="alert-success">
        <span class="material-symbols-outlined fill">check_circle</span>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close" style="background: none; border: none; margin-left: auto; color: inherit; cursor: pointer;">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="luxury-alert error alert-dismissible fade show" role="alert" id="alert-error">
        <span class="material-symbols-outlined fill">error</span>
        <div>@TempData["Error"]</div>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close" style="background: none; border: none; margin-left: auto; color: inherit; cursor: pointer;">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
}

<div class="luxury-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 600; color: #1c1c1a;">Danh Sách Yêu Cầu Hoàn Tiền</span>
            <span class="luxury-badge blue">@(Model?.Count() ?? 0)</span>
        </div>

        <div style="display: flex; align-items: center; gap: 10px;">
            <label for="refundStatusFilter" style="font-weight: 600; color: #50453b; margin: 0;">Trạng thái:</label>
            <select id="refundStatusFilter" class="form-control" style="width: 150px; background-color: #f6f3ef; border: 1px solid transparent; border-radius: 8px; padding: 8px 12px; height: auto; font-family: 'Inter', sans-serif;" onchange="location = this.value;">
                <option value="@Url.Action("Index", new { status = "" })" selected="@(ViewBag.CurrentStatus == null)">Tất cả</option>
                <option value="@Url.Action("Index", new { status = "Pending" })" selected="@(ViewBag.CurrentStatus?.ToString() == "Pending")">Chờ xử lý</option>
                <option value="@Url.Action("Index", new { status = "Completed" })" selected="@(ViewBag.CurrentStatus?.ToString() == "Completed")">Đã hoàn tiền</option>
            </select>
        </div>
    </div>
    
    <div style="overflow-x: auto;">
        <table class="luxury-table" id="refunds-table">
            <thead>
                <tr>
                    <th>Mã Refund</th>
                    <th>Mã Booking</th>
                    <th>Khách Hàng</th>
                    <th>Số Tiền (VNĐ)</th>
                    <th>Lý Do Hủy</th>
                    <th>Ngân Hàng</th>
                    <th>Trạng Thái</th>
                    <th>Ngày Tạo</th>
                    <th style="text-align: center;">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><strong style="color: #1c1c1a; font-weight: 600;">#@item.RefundId</strong></td>
                            <td>
                                <a asp-controller="Bookings" asp-action="Details" asp-route-id="@item.BookingId" style="color: #805528; text-decoration: none; font-weight: 500;">
                                    #@item.BookingId
                                </a>
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <div style="width: 32px; height: 32px; border-radius: 50%; background-color: #f0ede9; display: flex; align-items: center; justify-content: center; color: #827569;">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">person</span>
                                    </div>
                                    <span style="font-weight: 500;">@item.Booking?.User?.FullName</span>
                                </div>
                            </td>
                            <td style="font-weight: 500; color: #805528;">@(item.RefundAmount?.ToString("N0")) ₫</td>
                            <td><span style="color: #827569; font-size: 13px;">@(string.IsNullOrEmpty(item.RefundReason) ? "—" : item.RefundReason)</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.BankDetails))
                                {
                                    <button class="action-btn btn-view-bank" type="button" data-details="@item.BankDetails" title="Xem thông tin ngân hàng">
                                        <span class="material-symbols-outlined" style="font-size: 20px;">credit_card</span>
                                    </button>
                                }
                                else
                                {
                                    <span style="color: #d4c3b6;">—</span>
                                }
                            </td>
                            <td>
                                @if (item.RefundStatus == RefundStatus.Pending)
                                {
                                    <span class="luxury-badge warning" style="display: inline-flex; align-items: center; gap: 4px;">
                                        <span class="material-symbols-outlined" style="font-size: 14px;">schedule</span> Chờ Xử Lý
                                    </span>
                                }
                                else if (item.RefundStatus == RefundStatus.Completed)
                                {
                                    <span class="luxury-badge success" style="display: inline-flex; align-items: center; gap: 4px;">
                                        <span class="material-symbols-outlined" style="font-size: 14px;">check_circle</span> Đã Hoàn Tiền
                                    </span>
                                }
                            </td>
                            <td style="color: #827569; font-size: 13px;">
                                <div style="display: flex; align-items: center; gap: 4px;">
                                    <span class="material-symbols-outlined" style="font-size: 14px;">event</span>
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </td>
                            <td style="text-align: center; white-space: nowrap;">
                                @if (item.RefundStatus == RefundStatus.Pending)
                                {
                                    <form asp-action="ProcessRefund" asp-route-id="@item.RefundId" method="post" style="display:inline;" onsubmit="return confirm('Bạn xác nhận ĐÃ CHUYỂN KHOẢN số tiền @item.RefundAmount?.ToString("N0") VNĐ cho khách hàng này?');">
                                        <button type="submit" class="action-btn success" title="Duyệt hoàn tiền">
                                            <span class="material-symbols-outlined" style="font-size: 20px;">check</span>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span style="color: #d4c3b6;">—</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" style="text-align: center; padding: 40px; color: #827569;">
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
                                <span class="material-symbols-outlined" style="font-size: 48px; color: #d4c3b6;">payments</span>
                                <div>Không có yêu cầu hoàn tiền nào.</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
    {
        <div style="display: flex; justify-content: center; margin-top: 24px;">
            <ul class="pagination mb-0" style="display: flex; gap: 4px; list-style: none; padding: 0;">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="action-btn" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, status = ViewBag.CurrentStatus })" style="@(ViewBag.CurrentPage == 1 ? "opacity: 0.5; pointer-events: none;" : "")">
                        <span class="material-symbols-outlined" style="font-size: 20px;">chevron_left</span>
                    </a>
                </li>
                
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="action-btn" href="@Url.Action("Index", new { page = i, status = ViewBag.CurrentStatus })" style="@(i == ViewBag.CurrentPage ? "background: #805528; color: white; border-color: #805528;" : "")">@i</a>
                    </li>
                }
                
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="action-btn" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, status = ViewBag.CurrentStatus })" style="@(ViewBag.CurrentPage == ViewBag.TotalPages ? "opacity: 0.5; pointer-events: none;" : "")">
                        <span class="material-symbols-outlined" style="font-size: 20px;">chevron_right</span>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>

<!-- Premium Modal Thông tin chuyển khoản -->
<div class="modal fade modal-luxury" id="bankDetailsModal" tabindex="-1" role="dialog" aria-labelledby="bankDetailsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="bankDetailsModalLabel" style="font-family: 'Playfair Display', serif; display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined">account_balance</span> Chi tiết Chuyển khoản
        </h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body p-4 text-center">
        <div style="color: #805528; margin-bottom: 16px;">
            <span class="material-symbols-outlined" style="font-size: 48px;">payments</span>
        </div>
        <p class="mb-4 text-muted" style="font-size: 0.95rem; font-family: 'Inter', sans-serif;">Vui lòng thực hiện chuyển khoản đến tài khoản dưới đây để hoàn tất yêu cầu hoàn tiền.</p>
        
        <div class="bank-details-box">
            <button class="btn-copy" onclick="copyToClipboard()" title="Sao chép">
                <span class="material-symbols-outlined" style="font-size: 14px; vertical-align: middle;">content_copy</span> Copy
            </button>
            <h4 id="modalBankDetailsText" style="color: #1c1c1a; font-weight: 600; margin: 0; margin-top: 8px; white-space: pre-line; word-break: break-word; font-family: monospace; font-size: 18px;"></h4>
        </div>
        <div id="copyToast" style="display: none; color: #0b5c2d; margin-top: 12px; font-size: 0.85rem; font-weight: 500; font-family: 'Inter', sans-serif;">
            <span class="material-symbols-outlined" style="font-size: 14px; vertical-align: middle;">check_circle</span> Đã sao chép vào clipboard!
        </div>
      </div>
      <div class="modal-footer" style="border-top: none; justify-content: center; padding-bottom: 24px;">
        <button type="button" class="btn-luxury" data-dismiss="modal" style="background-color: #f0ede9; color: #50453b;">Đóng cửa sổ</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-view-bank').on('click', function() {
                var details = $(this).data('details');
                // Gán nội dung vào modal
                $('#modalBankDetailsText').text(details);
                // Reset toast
                $('#copyToast').hide();
                // Hiển thị modal
                $('#bankDetailsModal').modal('show');
            });
        });

        function copyToClipboard() {
            var text = document.getElementById("modalBankDetailsText").innerText;
            navigator.clipboard.writeText(text).then(function() {
                $('#copyToast').fadeIn().delay(2000).fadeOut();
            }, function(err) {
                console.error('Không thể sao chép: ', err);
            });
        }
        
        setTimeout(function () {
            var alerts = document.querySelectorAll('#alert-success, #alert-error');
            alerts.forEach(function (el) {
                if (el) {
                    el.style.transition = "opacity 0.5s ease";
                    el.style.opacity = "0";
                    setTimeout(() => el.remove(), 500);
                }
            });
        }, 4000);
        
        // Handle dismiss buttons
        document.querySelectorAll('.luxury-alert .close').forEach(btn => {
            btn.addEventListener('click', function() {
                var alert = this.closest('.luxury-alert');
                alert.style.transition = "opacity 0.3s ease";
                alert.style.opacity = "0";
                setTimeout(() => alert.remove(), 300);
            });
        });
    </script>
}
