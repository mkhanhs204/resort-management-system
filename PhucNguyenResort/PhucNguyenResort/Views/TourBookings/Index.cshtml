@model IEnumerable<PhucNguyenResort.Models.TourBooking>

@{
    ViewData["Title"] = "Tour Bookings";
}

<h1>Tour Bookings</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Booking</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Customer</th>
            <th>Tour Name</th>
            <th>Participants</th>
            <th>Total Price</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.TourBookingId</td>
            <td>@(item.User?.FullName ?? "Unknown")</td>
            <td>@(item.Schedule?.Tour?.TourName ?? "Unknown")</td>
            <td>@item.Participants</td>
            <td>@(item.TotalAmount?.ToString("C"))</td>
            <td>@item.BookingStatus</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.TourBookingId" class="btn btn-sm btn-warning">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.TourBookingId" class="btn btn-sm btn-info">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.TourBookingId" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
