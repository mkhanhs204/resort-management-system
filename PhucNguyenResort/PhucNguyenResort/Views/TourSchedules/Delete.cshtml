@model PhucNguyenResort.Models.TourSchedule

@{
    ViewData["Title"] = "Delete Schedule";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <h2 style="font-family: 'Lora', serif; font-weight: bold; color: #dc3545;">
            <i class="fa fa-exclamation-triangle mr-2"></i> Delete Schedule
        </h2>
    </div>
</div>

<div class="alert alert-danger" role="alert">
    <strong>Warning!</strong> Are you sure you want to delete this schedule? This action cannot be undone.
</div>

<div class="card shadow-sm border-danger" style="font-family: 'Cabin', sans-serif;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted mb-3">Tour Package</dt>
            <dd class="col-sm-9 font-weight-bold mb-3">@(Model.Tour?.TourName ?? "N/A")</dd>

            <dt class="col-sm-3 text-muted mb-3">Tour Guide</dt>
            <dd class="col-sm-9 mb-3">
                @if (Model.Guide != null)
                {
                    <span class="text-primary"><i class="fa fa-user-circle"></i> @Model.Guide.FullName</span>
                }
                else
                {
                    <span class="text-danger"><i class="fa fa-warning"></i> Not Assigned</span>
                }
            </dd>

            <dt class="col-sm-3 text-muted mb-3">Departure</dt>
            <dd class="col-sm-9 mb-3">@Model.TourDate?.ToString("dd/MM/yyyy") at @Model.StartTime?.ToString(@"hh\:mm")</dd>
        </dl>
    </div>
    <div class="card-footer bg-white border-top-0 pt-0 pb-4 px-4 mt-2">
        <form asp-action="Delete">
            <input type="hidden" asp-for="ScheduleId" />
            <button type="submit" class="btn btn-danger">
                <i class="fa fa-trash"></i> Yes, Delete it
            </button>
            <a asp-action="Index" class="btn btn-secondary ml-2">Cancel</a>
        </form>
    </div>
</div>
