@model PhucNguyenResort.Models.TourSchedule

@{
    ViewData["Title"] = "Schedule Details";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <h2 style="font-family: 'Lora', serif; font-weight: bold; color: #1a1a1a;">
            <i class="fa fa-info-circle mr-2" style="color: #dfa974;"></i> Schedule Details
        </h2>
    </div>
</div>

<div class="card shadow-sm" style="border-top: 4px solid #dfa974; font-family: 'Cabin', sans-serif;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted mb-3">Schedule ID</dt>
            <dd class="col-sm-9 font-weight-bold mb-3">#@Model.ScheduleId</dd>

            <dt class="col-sm-3 text-muted mb-3">Tour Package</dt>
            <dd class="col-sm-9 mb-3">@(Model.Tour?.TourName ?? "N/A")</dd>

            <dt class="col-sm-3 text-muted mb-3">Tour Guide</dt>
            <dd class="col-sm-9 mb-3">
                @if (Model.Guide != null)
                {
                    <span class="text-primary"><i class="fa fa-user-circle"></i> @Model.Guide.FullName</span>
                }
                else
                {
                    <span class="text-danger"><i class="fa fa-warning"></i> Not Assigned</span>
                }
            </dd>

            <dt class="col-sm-3 text-muted mb-3">Departure Date</dt>
            <dd class="col-sm-9 mb-3">@Model.TourDate?.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3 text-muted mb-3">Start Time</dt>
            <dd class="col-sm-9 mb-3">@Model.StartTime?.ToString(@"hh\:mm")</dd>

            <dt class="col-sm-3 text-muted mb-3">Available Slots</dt>
            <dd class="col-sm-9 mb-3">
                @if(Model.AvailableSlots > 0)
                {
                    <span class="text-success font-weight-bold">@Model.AvailableSlots seats left</span>
                }
                else
                {
                    <span class="text-danger font-weight-bold">Full</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer bg-white border-top-0 pt-0 pb-4 px-4 mt-2">
        <a asp-action="Edit" asp-route-id="@Model.ScheduleId" class="btn btn-warning text-white">
            <i class="fa fa-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-secondary ml-2">Back to List</a>
    </div>
</div>
