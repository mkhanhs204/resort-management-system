@model PhucNguyenResort.Models.TourSchedule

@{
    ViewData["Title"] = "Chi Tiết Lịch Trình";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title { font-family: 'Playfair Display', serif; font-size: 36px; font-weight: 700; color: #805528; margin-bottom: 4px; }
        .page-subtitle { font-family: 'Inter', sans-serif; color: #50453b; font-size: 16px; }
        .luxury-card { background: #ffffff; border-radius: 16px; box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08); border: 1px solid rgba(212, 195, 182, 0.3); font-family: 'Inter', sans-serif; padding: 32px; margin-bottom: 30px; }
        .header-container { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px; }
        .btn-luxury { background-color: #dfa974; color: #633d11; font-family: 'Inter', sans-serif; font-weight: 600; border-radius: 8px; padding: 10px 24px; border: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s ease; text-decoration: none; }
        .btn-luxury:hover { background-color: #805528; color: #ffffff; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2); text-decoration: none; }
        .btn-secondary-luxury { background-color: #f0ede9; color: #50453b; font-family: 'Inter', sans-serif; font-weight: 600; border-radius: 8px; padding: 10px 24px; border: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s ease; text-decoration: none; }
        .btn-secondary-luxury:hover { background-color: #e5e2de; color: #1c1c1a; text-decoration: none; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
        .detail-row { display: flex; padding: 16px 0; border-bottom: 1px solid #f0ede9; }
        .detail-row:last-child { border-bottom: none; }
        .detail-label { width: 35%; color: #50453b; font-weight: 600; font-size: 14px; }
        .detail-value { width: 65%; color: #1c1c1a; font-size: 15px; }
        .luxury-badge { background-color: #f0ede9; color: #50453b; font-weight: 600; padding: 6px 12px; border-radius: 8px; font-size: 14px; display: inline-block; }
        .luxury-badge.green { background-color: #e2f5ea; color: #0b5c2d; }
        .luxury-badge.blue { background-color: #d3e4fe; color: #0b1c30; }
        .luxury-badge.red { background-color: #ffdad6; color: #ba1a1a; }
    </style>
}

<div class="header-container">
    <div>
        <h2 class="page-title">Chi Tiết Lịch Trình</h2>
        <p class="page-subtitle">Lịch trình #@Model.ScheduleId</p>
    </div>
    <div style="display: flex; gap: 12px;">
        <a asp-action="Edit" asp-route-id="@Model?.ScheduleId" class="btn-luxury">
            <span class="material-symbols-outlined">edit</span> Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn-secondary-luxury">
            <span class="material-symbols-outlined">arrow_back</span> Quay lại
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="luxury-card mb-4">
            <div style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 600; color: #1c1c1a; margin-bottom: 24px;">Thông Tin Phân Công</div>
            <div>
                <div class="detail-row">
                    <div class="detail-label">Mã Lịch Trình</div>
                    <div class="detail-value"><strong style="font-size: 16px;">#@Model.ScheduleId</strong></div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">Tên Tour</div>
                    <div class="detail-value">
                        <span style="font-weight: 600; color: #805528;">@(Model.Tour?.TourName ?? "N/A")</span>
                    </div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">Hướng dẫn viên</div>
                    <div class="detail-value">
                        @if (Model.Guide != null)
                        {
                            <div style="display: flex; align-items: center; gap: 4px; font-weight: 500;">
                                <span class="material-symbols-outlined" style="font-size: 18px; color: #805528;">person</span>
                                @Model.Guide.FullName
                            </div>
                        }
                        else
                        {
                            <div style="display: flex; align-items: center; gap: 4px; color: #ba1a1a;">
                                <span class="material-symbols-outlined" style="font-size: 18px;">warning</span>
                                Chưa phân công
                            </div>
                        }
                    </div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">Thời gian khởi hành</div>
                    <div class="detail-value">
                        <span class="luxury-badge blue">
                            @Model.TourDate?.ToString("dd/MM/yyyy") lúc @Model.StartTime?.ToString(@"hh\:mm")
                        </span>
                    </div>
                </div>
                
                <div class="detail-row">
                    <div class="detail-label">Số chỗ trống</div>
                    <div class="detail-value">
                        @if(Model.AvailableSlots > 0)
                        {
                            <span class="luxury-badge green">@Model.AvailableSlots chỗ trống</span>
                        }
                        else
                        {
                            <span class="luxury-badge red">Kín chỗ</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
