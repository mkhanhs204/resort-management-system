@model IEnumerable<PhucNguyenResort.Models.TourSchedule>

@{
    ViewData["Title"] = "Tour Schedules";
}

<h1>Tour Schedules</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Schedule</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tour Name</th>
            <th>Guide</th>
            <th>Departure Date</th>
            <th>Available Slots</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.ScheduleId</td>
            <td>@(item.Tour?.TourName ?? "N/A")</td>
            <td>@(item.Guide?.FullName ?? "Not Assigned")</td>
            <td>@(item.TourDate?.ToShortDateString()) @item.StartTime</td>
            <td>@item.AvailableSlots</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ScheduleId" class="btn btn-sm btn-warning">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ScheduleId" class="btn btn-sm btn-info">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ScheduleId" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
