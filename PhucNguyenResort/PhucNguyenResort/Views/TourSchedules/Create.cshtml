@model PhucNguyenResort.Models.TourSchedule

@{
    ViewData["Title"] = "Assign New Schedule";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <h2 style="font-family: 'Lora', serif; font-weight: bold; color: #1a1a1a;">
            <i class="fa fa-calendar-plus-o mr-2" style="color: #dfa974;"></i> Assign New Schedule
        </h2>
    </div>
</div>

<div class="card shadow-sm" style="border-top: 4px solid #dfa974; font-family: 'Cabin', sans-serif;">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="TourId" class="control-label font-weight-bold">Tour Package</label>
                    <select asp-for="TourId" class="form-control" asp-items="ViewBag.Tours">
                        <option value="">-- Select Tour Package --</option>
                    </select>
                    <span asp-validation-for="TourId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="GuideId" class="control-label font-weight-bold">Tour Guide</label>
                    <select asp-for="GuideId" class="form-control" asp-items="ViewBag.Guides">
                        <option value="">-- Select Tour Guide (Optional) --</option>
                    </select>
                    <span asp-validation-for="GuideId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="TourDate" class="control-label font-weight-bold">Departure Date</label>
                    <input asp-for="TourDate" class="form-control" type="date" />
                    <span asp-validation-for="TourDate" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="StartTime" class="control-label font-weight-bold">Start Time</label>
                    <input asp-for="StartTime" class="form-control" type="time" />
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="AvailableSlots" class="control-label font-weight-bold">Available Slots</label>
                    <input asp-for="AvailableSlots" class="form-control" type="number" min="1" />
                    <span asp-validation-for="AvailableSlots" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary" style="background-color: #dfa974; border-color: #dfa974;">
                    <i class="fa fa-save"></i> Save Schedule
                </button>
                <a asp-action="Index" class="btn btn-secondary ml-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
