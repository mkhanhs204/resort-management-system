@model IEnumerable<PhucNguyenResort.ViewModels.Reviews.ReviewListVM>
@{
    ViewData["Title"] = "Khách Hàng Đánh Giá";
}

@section Styles {
    <style>
        .testimonial-page {
            padding: 80px 0;
            background: #fdfaf6;
        }
        .testimonial-item {
            background: #ffffff;
            border-radius: 10px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0px 5px 20px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s;
            height: 100%;
        }
        .testimonial-item:hover {
            transform: translateY(-5px);
            box-shadow: 0px 10px 25px rgba(0, 0, 0, 0.1);
        }
        .ti-author {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }
        .rating {
            margin-right: 15px;
        }
        .rating i {
            color: #dfa974;
            font-size: 14px;
        }
        .ti-author-text h6 {
            color: #19191a;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 2px;
        }
        .ti-author-text span {
            color: #dfa974;
            font-size: 14px;
            display: block;
        }
        .testimonial-item p {
            font-size: 16px;
            color: #707079;
            line-height: 1.8;
            font-style: italic;
            margin-bottom: 0;
        }
        .service-badge {
            display: inline-block;
            background: #f5f5f5;
            color: #888;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            margin-top: 15px;
        }
        .section-title {
            margin-bottom: 50px;
            text-align: center;
        }
        .section-title h2 {
            font-family: 'Lora', serif;
            color: #19191a;
            font-size: 44px;
            font-weight: 700;
        }
    </style>
}

<!-- Breadcrumb Section -->
<div class="breadcrumb-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb-text">
                    <h2>Đánh Giá</h2>
                    <div class="bt-option">
                        <a asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        <span>Khách Hàng Đánh Giá</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="testimonial-page">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <span>Trải Nghiệm Khách Hàng</span>
                    <h2>Cảm nhận từ khách hàng</h2>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-lg-12 text-center mb-4">
                <form method="get" class="d-inline-block">
                    <div class="btn-group mr-3" role="group" aria-label="Rating filter">
                        <a href="@Url.Action("PublicList", new { serviceType = ViewBag.CurrentServiceType })" class="btn btn-outline-secondary @(ViewBag.CurrentRating == null ? "active" : "")">Tất cả sao</a>
                        <a href="@Url.Action("PublicList", new { rating = 5, serviceType = ViewBag.CurrentServiceType })" class="btn btn-outline-secondary @(ViewBag.CurrentRating == 5 ? "active" : "")">5 Sao</a>
                        <a href="@Url.Action("PublicList", new { rating = 4, serviceType = ViewBag.CurrentServiceType })" class="btn btn-outline-secondary @(ViewBag.CurrentRating == 4 ? "active" : "")">4 Sao</a>
                        <a href="@Url.Action("PublicList", new { rating = 3, serviceType = ViewBag.CurrentServiceType })" class="btn btn-outline-secondary @(ViewBag.CurrentRating == 3 ? "active" : "")">3 Sao</a>
                        <a href="@Url.Action("PublicList", new { rating = 2, serviceType = ViewBag.CurrentServiceType })" class="btn btn-outline-secondary @(ViewBag.CurrentRating == 2 ? "active" : "")">2 Sao</a>
                        <a href="@Url.Action("PublicList", new { rating = 1, serviceType = ViewBag.CurrentServiceType })" class="btn btn-outline-secondary @(ViewBag.CurrentRating == 1 ? "active" : "")">1 Sao</a>
                    </div>
                    
                    <div class="btn-group" role="group" aria-label="Service Type filter">
                        <a href="@Url.Action("PublicList", new { rating = ViewBag.CurrentRating })" class="btn btn-outline-info @(string.IsNullOrEmpty(ViewBag.CurrentServiceType) ? "active" : "")">Mọi dịch vụ</a>
                        <a href="@Url.Action("PublicList", new { rating = ViewBag.CurrentRating, serviceType = "Room" })" class="btn btn-outline-info @(ViewBag.CurrentServiceType == "Room" ? "active" : "")">Phòng nghỉ</a>
                        <a href="@Url.Action("PublicList", new { rating = ViewBag.CurrentRating, serviceType = "Tour" })" class="btn btn-outline-info @(ViewBag.CurrentServiceType == "Tour" ? "active" : "")">Tour du lịch</a>
                    </div>
                </form>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="alert alert-success text-center">
                        @TempData["SuccessMessage"]
                    </div>
                </div>
            </div>
        }

        <div class="row">
            @if (Model != null && Model.Any())
            {
                foreach (var review in Model)
                {
                    <div class="col-lg-6 col-md-6 mb-4">
                        <div class="testimonial-item">
                            <div class="ti-author">
                                <div class="rating">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        if (i < review.Rating)
                                        {
                                            <i class="icon_star"></i>
                                        }
                                        else
                                        {
                                            <i class="icon_star-half_alt" style="color:#ddd;"></i>
                                        }
                                    }
                                </div>
                                <div class="ti-author-text">
                                    <h6>@review.UserName</h6>
                                    <span>@review.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                            <p>@(!string.IsNullOrEmpty(review.Comment) ? review.Comment : "Tuyệt vời!")</p>
                            <div class="service-badge">
                                <i class="fa @(review.ServiceType == "Room" ? "fa-bed" : "fa-map-o")"></i> @review.ServiceName
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p class="text-muted">Chưa có đánh giá nào được hiển thị.</p>
                </div>
            }
        </div>
    </div>
</section>
