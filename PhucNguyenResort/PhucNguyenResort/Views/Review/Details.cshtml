@model PhucNguyenResort.ViewModels.Reviews.ReviewListVM
@{
    ViewData["Title"] = "Chi Tiết Đánh Giá Khách Hàng";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title { font-family: 'Playfair Display', serif; font-size: 36px; font-weight: 700; color: #805528; margin-bottom: 4px; }
        .page-subtitle { font-family: 'Inter', sans-serif; color: #50453b; font-size: 16px; margin-bottom: 24px; }
        
        .luxury-card { background: #ffffff; border-radius: 16px; box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08); border: 1px solid rgba(212, 195, 182, 0.3); font-family: 'Inter', sans-serif; margin-bottom: 24px; padding: 32px; }
        
        .info-row { display: flex; margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid #f0ede9; }
        .info-row:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }
        
        .info-label { width: 200px; font-weight: 600; color: #805528; flex-shrink: 0; font-size: 15px; display: flex; align-items: center; gap: 8px; }
        .info-value { color: #1c1c1a; font-size: 15px; flex-grow: 1; line-height: 1.6; }
        
        .status-badge { display: inline-flex; align-items: center; padding: 6px 12px; border-radius: 20px; font-size: 13px; font-weight: 600; }
        .status-badge.visible { background-color: #e2f5ea; color: #0b5c2d; }
        .status-badge.hidden { background-color: #ffdad6; color: #ba1a1a; }
        
        .service-badge { display: inline-flex; align-items: center; padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: 600; background-color: #f6f3ef; color: #805528; }
        
        .btn-luxury { background-color: #dfa974; color: #633d11; font-family: 'Inter', sans-serif; font-weight: 600; border-radius: 8px; padding: 10px 20px; border: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s ease; text-decoration: none; cursor: pointer; font-size: 14px; }
        .btn-luxury:hover { background-color: #805528; color: #ffffff; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2); text-decoration: none; }
        
        .btn-outline-luxury { background-color: transparent; color: #805528; border: 1px solid #dfa974; font-family: 'Inter', sans-serif; font-weight: 600; border-radius: 8px; padding: 10px 20px; display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s ease; text-decoration: none; cursor: pointer; font-size: 14px; }
        .btn-outline-luxury:hover { background-color: #f6f3ef; color: #633d11; text-decoration: none; }
        
        .material-symbols-outlined { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; font-size: 20px; vertical-align: middle; }
        
        .star-rating { color: #f59e0b; font-variation-settings: 'FILL' 1; font-size: 22px; }
        
        .header-container { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32px; }
        
        .comment-box { background-color: #faf8f5; padding: 20px; border-radius: 12px; border: 1px solid #f0ede9; color: #50453b; font-style: italic; font-size: 16px; margin-top: 8px; }
    </style>
}

<div class="header-container">
    <div>
        <h2 class="page-title">Chi Tiết Đánh Giá</h2>
        <p class="page-subtitle">Xem chi tiết đánh giá #@Model.ReviewId của khách hàng @Model.UserName</p>
    </div>
    <div>
        <a href="@Url.Action("Manage", "Review")" class="btn-outline-luxury">
            <span class="material-symbols-outlined">arrow_back</span> Trở về danh sách
        </a>
    </div>
</div>

<div class="luxury-card">
    <div class="info-row">
        <div class="info-label">
            <span class="material-symbols-outlined">tag</span> ID Đánh Giá
        </div>
        <div class="info-value" style="font-weight: 600; color: #805528; font-size: 18px;">
            #@Model.ReviewId
        </div>
    </div>
    
    <div class="info-row">
        <div class="info-label">
            <span class="material-symbols-outlined">person</span> Khách Hàng
        </div>
        <div class="info-value" style="font-weight: 600; font-size: 16px;">
            @Model.UserName
        </div>
    </div>
    
    <div class="info-row">
        <div class="info-label">
            <span class="material-symbols-outlined">design_services</span> Dịch Vụ
        </div>
        <div class="info-value">
            @if (Model.ServiceType == "Room")
            {
                <span class="service-badge" style="margin-right: 8px;"><span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px;">bed</span> Phòng nghỉ</span>
            }
            else
            {
                <span class="service-badge" style="margin-right: 8px;"><span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px;">map</span> Tour du lịch</span>
            }
            <span style="font-weight: 500;">@Model.ServiceName</span>
        </div>
    </div>
    
    <div class="info-row">
        <div class="info-label">
            <span class="material-symbols-outlined">star</span> Số Sao
        </div>
        <div class="info-value">
            <div style="display: flex; align-items: center; gap: 4px;">
                <span style="font-weight: 700; color: #805528; font-size: 18px; margin-right: 4px;">@Model.Rating</span>
                @for (int i = 0; i < (Model.Rating ?? 0); i++)
                {
                    <span class="material-symbols-outlined star-rating">star</span>
                }
                @for (int i = (Model.Rating ?? 0); i < 5; i++)
                {
                    <span class="material-symbols-outlined star-rating" style="color: #e5e0d8;">star</span>
                }
            </div>
        </div>
    </div>
    
    <div class="info-row">
        <div class="info-label">
            <span class="material-symbols-outlined">calendar_today</span> Ngày Đăng
        </div>
        <div class="info-value" style="color: #50453b;">
            @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")
        </div>
    </div>
    
    <div class="info-row">
        <div class="info-label">
            <span class="material-symbols-outlined">visibility</span> Trạng Thái
        </div>
        <div class="info-value">
            @if (Model.IsVisible)
            {
                <span class="status-badge visible"><span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px;">visibility</span> Hiển thị</span>
            }
            else
            {
                <span class="status-badge hidden"><span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px;">visibility_off</span> Đã ẩn</span>
            }
            
            <form asp-action="ToggleVisibility" method="post" style="display:inline; margin-left: 16px;">
                <input type="hidden" name="reviewId" value="@Model.ReviewId" />
                @if (Model.IsVisible)
                {
                    <button type="submit" class="btn-outline-luxury" style="color: #ba1a1a; border-color: #ba1a1a; padding: 6px 12px; font-size: 13px;" title="Ẩn đánh giá này">
                        <span class="material-symbols-outlined" style="font-size: 16px;">visibility_off</span> Đổi sang Ẩn
                    </button>
                }
                else
                {
                    <button type="submit" class="btn-luxury" style="padding: 6px 12px; font-size: 13px;" title="Hiển thị đánh giá này">
                        <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span> Đổi sang Hiện
                    </button>
                }
            </form>
        </div>
    </div>
    
    <div class="info-row" style="flex-direction: column;">
        <div class="info-label" style="width: 100%; margin-bottom: 12px;">
            <span class="material-symbols-outlined">format_quote</span> Nội Dung Đánh Giá
        </div>
        <div class="info-value">
            <div class="comment-box">
                @(string.IsNullOrEmpty(Model.Comment) ? "Khách hàng không để lại nội dung." : Model.Comment)
            </div>
        </div>
    </div>
</div>
