@model IEnumerable<PhucNguyenResort.ViewModels.Reviews.ReviewListVM>
@{
    ViewData["Title"] = "Customer Reviews Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="font-weight-bold text-dark" style="font-family: 'Lora', serif;">Customer Reviews</h2>
            <p class="text-muted">Manage and moderate customer reviews across all services.</p>
        </div>
    </div>
    
    <div class="row mb-3">
        <div class="col-12">
            <form method="get" class="form-inline">
                <label class="mr-2 font-weight-bold">Lọc theo số sao:</label>
                <div class="btn-group mr-4" role="group">
                    <a href="@Url.Action("Manage", new { serviceType = ViewBag.CurrentServiceType })" class="btn btn-sm btn-outline-secondary @(ViewBag.CurrentRating == null ? "active" : "")">Tất cả</a>
                    <a href="@Url.Action("Manage", new { rating = 5, serviceType = ViewBag.CurrentServiceType })" class="btn btn-sm btn-outline-secondary @(ViewBag.CurrentRating == 5 ? "active" : "")">5 Sao</a>
                    <a href="@Url.Action("Manage", new { rating = 4, serviceType = ViewBag.CurrentServiceType })" class="btn btn-sm btn-outline-secondary @(ViewBag.CurrentRating == 4 ? "active" : "")">4 Sao</a>
                    <a href="@Url.Action("Manage", new { rating = 3, serviceType = ViewBag.CurrentServiceType })" class="btn btn-sm btn-outline-secondary @(ViewBag.CurrentRating == 3 ? "active" : "")">3 Sao</a>
                    <a href="@Url.Action("Manage", new { rating = 2, serviceType = ViewBag.CurrentServiceType })" class="btn btn-sm btn-outline-secondary @(ViewBag.CurrentRating == 2 ? "active" : "")">2 Sao</a>
                    <a href="@Url.Action("Manage", new { rating = 1, serviceType = ViewBag.CurrentServiceType })" class="btn btn-sm btn-outline-secondary @(ViewBag.CurrentRating == 1 ? "active" : "")">1 Sao</a>
                </div>

                <label class="mr-2 font-weight-bold">Loại dịch vụ:</label>
                <div class="btn-group" role="group">
                    <a href="@Url.Action("Manage", new { rating = ViewBag.CurrentRating })" class="btn btn-sm btn-outline-info @(string.IsNullOrEmpty(ViewBag.CurrentServiceType) ? "active" : "")">Tất cả</a>
                    <a href="@Url.Action("Manage", new { rating = ViewBag.CurrentRating, serviceType = "Room" })" class="btn btn-sm btn-outline-info @(ViewBag.CurrentServiceType == "Room" ? "active" : "")">Phòng nghỉ</a>
                    <a href="@Url.Action("Manage", new { rating = ViewBag.CurrentRating, serviceType = "Tour" })" class="btn btn-sm btn-outline-info @(ViewBag.CurrentServiceType == "Tour" ? "active" : "")">Tour du lịch</a>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="border-0 px-4 py-3 text-secondary">ID</th>
                            <th class="border-0 px-4 py-3 text-secondary">Customer</th>
                            <th class="border-0 px-4 py-3 text-secondary">Service</th>
                            <th class="border-0 px-4 py-3 text-secondary">Rating</th>
                            <th class="border-0 px-4 py-3 text-secondary">Comment</th>
                            <th class="border-0 px-4 py-3 text-secondary">Date</th>
                            <th class="border-0 px-4 py-3 text-secondary text-center">Status</th>
                            <th class="border-0 px-4 py-3 text-secondary text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3 align-middle">#@item.ReviewId</td>
                                    <td class="px-4 py-3 align-middle font-weight-bold">@item.UserName</td>
                                    <td class="px-4 py-3 align-middle">
                                        <span class="badge badge-light text-secondary border">
                                            <i class="fa @(item.ServiceType == "Room" ? "fa-bed" : "fa-map-o") mr-1"></i> @item.ServiceType
                                        </span><br/>
                                        <small class="text-muted">@item.ServiceName</small>
                                    </td>
                                    <td class="px-4 py-3 align-middle text-warning">
                                        @item.Rating <i class="fa fa-star"></i>
                                    </td>
                                    <td class="px-4 py-3 align-middle" style="max-width: 250px;">
                                        <div class="text-truncate" title="@item.Comment">
                                            @(string.IsNullOrEmpty(item.Comment) ? "-" : item.Comment)
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 align-middle">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="px-4 py-3 align-middle text-center">
                                        @if (item.IsVisible)
                                        {
                                            <span class="badge badge-success px-2 py-1"><i class="fa fa-eye"></i> Visible</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger px-2 py-1"><i class="fa fa-eye-slash"></i> Hidden</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 align-middle text-center">
                                        <form asp-action="ToggleVisibility" method="post" style="display:inline;">
                                            <input type="hidden" name="reviewId" value="@item.ReviewId" />
                                            @if (item.IsVisible)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Hide Review">
                                                    <i class="fa fa-eye-slash"></i> Hide
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Show Review">
                                                    <i class="fa fa-eye"></i> Show
                                                </button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">No reviews found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
