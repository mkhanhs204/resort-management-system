@model PhucNguyenResort.ViewModels.Tables.TableCreateVM
@using PhucNguyenResort.Enums

@{
    ViewData["Title"] = "Create Dining Table";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-lg-10 offset-lg-1">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fa fa-plus-circle mr-2"></i> @ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <h5 class="font-weight-bold mb-3">Basic Information</h5>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="TableNumber" class="form-label fw-bold"></label>
                                <input asp-for="TableNumber" class="form-control" placeholder="e.g., T01, VIP-1" />
                                <span asp-validation-for="TableNumber" class="text-danger"></span>
                            </div>

                            <div class="col-md-8 mb-3">
                                <label asp-for="TableName" class="form-label fw-bold"></label>
                                <input asp-for="TableName" class="form-control" placeholder="e.g., Garden View Table" />
                                <span asp-validation-for="TableName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Capacity" class="form-label fw-bold"></label>
                                <input asp-for="Capacity" class="form-control" type="number" min="1" max="50" />
                                <span asp-validation-for="Capacity" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Status" class="form-label fw-bold"></label>
                                <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<DiningTableStatus>()">
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="DisplayOrder" class="form-label fw-bold"></label>
                                <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />
                        <h5 class="font-weight-bold mb-3">Customer Display</h5>
                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label fw-bold"></label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="/images/tables/table-01.jpg" />
                            <small class="form-text text-muted">Use a public image path under wwwroot. If empty, customer UI will show a fallback icon.</small>
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" maxlength="500" placeholder="Short description shown to customers when choosing a table."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Area" class="form-label fw-bold"></label>
                                <input asp-for="Area" class="form-control" placeholder="Indoor, Garden, Poolside..." />
                                <span asp-validation-for="Area" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="TableType" class="form-label fw-bold"></label>
                                <input asp-for="TableType" class="form-control" placeholder="Standard, Couple, Family, VIP..." />
                                <span asp-validation-for="TableType" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="LocationNote" class="form-label fw-bold"></label>
                                <input asp-for="LocationNote" class="form-control" placeholder="Near window, garden corner..." />
                                <span asp-validation-for="LocationNote" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="custom-control custom-checkbox">
                                <input asp-for="IsReservable" class="custom-control-input" />
                                <label asp-for="IsReservable" class="custom-control-label fw-bold"></label>
                            </div>
                            <small class="form-text text-muted">Turn this off for staff-only, backup, or maintenance setup tables that should not appear in customer reservation search.</small>
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fa fa-arrow-left"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save"></i> Create Table
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
