@model IEnumerable<PhucNguyenResort.Models.DiningTable>

@{
    ViewData["Title"] = "Quản Lý Bàn Ăn";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528; /* primary */
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b; /* on-surface-variant */
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 24px;
            margin-bottom: 30px;
        }
        .luxury-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        .luxury-table thead th {
            background-color: #f6f3ef; /* surface-container-low */
            color: #50453b;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 16px;
            border: none;
        }
        .luxury-table thead th:first-child {
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
        }
        .luxury-table thead th:last-child {
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }
        .luxury-table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-bottom: 1px solid #f0ede9;
            color: #1c1c1a;
            font-size: 14px;
        }
        .luxury-table tbody tr:last-child td {
            border-bottom: none;
        }
        .luxury-table tbody tr:hover {
            background-color: #fcf9f5; /* surface */
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .material-symbols-outlined.fill {
            font-variation-settings: 'FILL' 1;
        }
        .btn-luxury {
            background-color: #dfa974; /* primary-container */
            color: #633d11; /* on-primary-container */
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 20px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-luxury:hover {
            background-color: #805528;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2);
            text-decoration: none;
        }
        .action-btn {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #d4c3b6;
            color: #50453b;
            transition: all 0.2s;
            background: transparent;
            margin: 0 2px;
            text-decoration: none;
            cursor: pointer;
        }
        .action-btn:hover {
            background: #f6f3ef;
            color: #805528;
            border-color: #805528;
            text-decoration: none;
        }
        .action-btn.delete:hover {
            background: #ffdad6;
            color: #ba1a1a;
            border-color: #ba1a1a;
        }
        .luxury-badge {
            background-color: #f0ede9;
            color: #50453b;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
        }
        .luxury-badge.blue {
            background-color: #d3e4fe;
            color: #0b1c30;
        }
        .luxury-badge.green {
            background-color: #e2f5ea;
            color: #0b5c2d;
        }
        .luxury-badge.orange {
            background-color: #ffe8d6;
            color: #9c4221;
        }
        .luxury-badge.red {
            background-color: #ffdad6;
            color: #ba1a1a;
        }
        .luxury-badge.grey {
            background-color: #e3e2e0;
            color: #44474e;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        
        /* Alert Styling */
        .luxury-alert {
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: 'Inter', sans-serif;
            border: none;
        }
        .luxury-alert.success {
            background-color: #e2f5ea;
            color: #0b5c2d;
        }
        .luxury-alert.danger {
            background-color: #ffdad6;
            color: #ba1a1a;
        }
    </style>
}

<div class="header-container mt-4">
    <div>
        <h2 class="page-title">
            @ViewData["Title"]
        </h2>
        <p class="page-subtitle">Quản lý thông tin bàn ăn hiển thị trên trang đặt bàn của khách hàng.</p>
    </div>
    <div style="font-family: 'Inter', sans-serif; color: #50453b; display: flex; align-items: center; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined">calendar_today</span>
            <span>@DateTime.Now.ToString("dd MMMM, yyyy")</span>
        </div>
        <a asp-action="Create" class="btn-luxury" style="padding: 8px 16px; font-size: 14px;">
            <span class="material-symbols-outlined" style="font-size: 20px;">add</span> Thêm Bàn Mới
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="luxury-alert success alert-dismissible fade show" role="alert" id="alert-success">
        <span class="material-symbols-outlined fill">check_circle</span>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="background: none; border: none; margin-left: auto; color: inherit; cursor: pointer; opacity: 0.5;">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="luxury-alert danger alert-dismissible fade show" role="alert" id="alert-danger">
        <span class="material-symbols-outlined fill">error</span>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="background: none; border: none; margin-left: auto; color: inherit; cursor: pointer; opacity: 0.5;">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
}

<div class="luxury-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 600; color: #1c1c1a;">Danh Sách Bàn Ăn</span>
            <span class="luxury-badge blue">@(Model?.Count() ?? 0)</span>
        </div>
    </div>
    
    <div style="overflow-x: auto;">
        <table class="luxury-table" id="dining-tables-table">
            <thead>
                <tr>
                    <th>Bàn Ăn</th>
                    <th>Thông Tin Hiển Thị</th>
                    <th>Sức Chứa</th>
                    <th>Trạng Thái</th>
                    <th>Đặt Online</th>
                    <th>Vị Trí (Order)</th>
                    <th style="text-align: right;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div style="width: 60px; height: 60px; border-radius: 8px; background-color: #f6f3ef; display: flex; align-items: center; justify-content: center; color: #827569; overflow: hidden; border: 1px solid #d4c3b6;">
                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.TableName" style="width:100%; height:100%; object-fit:cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                            <span class="material-symbols-outlined" style="display:none; font-size: 24px;">table_restaurant</span>
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined" style="font-size: 24px;">table_restaurant</span>
                                        }
                                    </div>
                                    <div>
                                        <div style="font-weight: 600; color: #1c1c1a; font-size: 16px;">@item.TableName</div>
                                        <div style="color: #827569; font-size: 13px;">Bàn @item.TableNumber</div>
                                    </div>
                                </div>
                            </td>
                            <td style="min-width: 260px;">
                                <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 4px;">
                                    @if (!string.IsNullOrWhiteSpace(item.Area))
                                    {
                                        <span class="luxury-badge" style="background-color: transparent; border: 1px solid #d4c3b6;">
                                            <span class="material-symbols-outlined" style="font-size: 14px;">pin_drop</span> @item.Area
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.TableType))
                                    {
                                        <span class="luxury-badge" style="background-color: transparent; border: 1px solid #d4c3b6;">
                                            <span class="material-symbols-outlined" style="font-size: 14px;">chair</span> @item.TableType
                                        </span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.LocationNote))
                                {
                                    <div style="color: #827569; font-size: 13px; display: flex; align-items: center; gap: 4px; margin-top: 4px;">
                                        <span class="material-symbols-outlined" style="font-size: 14px;">near_me</span> @item.LocationNote
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div style="color: #827569; font-size: 13px; margin-top: 4px; max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@item.Description">
                                        @item.Description
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="luxury-badge" style="background-color: #f6f3ef;">
                                    <span class="material-symbols-outlined" style="font-size: 16px;">groups</span> @item.Capacity Người
                                </span>
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case PhucNguyenResort.Enums.DiningTableStatus.Available:
                                        <span class="luxury-badge green">
                                            <span class="material-symbols-outlined" style="font-size: 16px;">check_circle</span> Trống
                                        </span>
                                        break;
                                    case PhucNguyenResort.Enums.DiningTableStatus.Occupied:
                                        <span class="luxury-badge red">
                                            <span class="material-symbols-outlined" style="font-size: 16px;">dining</span> Đang phục vụ
                                        </span>
                                        break;
                                    case PhucNguyenResort.Enums.DiningTableStatus.Reserved:
                                        <span class="luxury-badge orange">
                                            <span class="material-symbols-outlined" style="font-size: 16px;">event_seat</span> Đã đặt
                                        </span>
                                        break;
                                    case PhucNguyenResort.Enums.DiningTableStatus.Maintenance:
                                        <span class="luxury-badge grey">
                                            <span class="material-symbols-outlined" style="font-size: 16px;">build</span> Bảo trì
                                        </span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (item.IsReservable)
                                {
                                    <span class="luxury-badge blue">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">public</span> Cho phép
                                    </span>
                                }
                                else
                                {
                                    <span class="luxury-badge grey">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">visibility_off</span> Ẩn
                                    </span>
                                }
                            </td>
                            <td>
                                <strong style="color: #50453b;">@item.DisplayOrder</strong>
                            </td>
                            <td style="text-align: right; white-space: nowrap;">
                                <div style="display: flex; justify-content: flex-end; gap: 4px;">
                                    <a asp-action="Edit" asp-route-id="@item.TableId" class="action-btn" title="Sửa">
                                        <span class="material-symbols-outlined" style="font-size: 20px;">edit</span>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.TableId" method="post" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bàn ăn này?');">
                                        <button type="submit" class="action-btn delete" title="Xóa">
                                            <span class="material-symbols-outlined" style="font-size: 20px;">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 40px; color: #827569;">
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
                                <span class="material-symbols-outlined" style="font-size: 48px; color: #d4c3b6;">table_restaurant</span>
                                <div>Không tìm thấy bàn ăn nào.</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            var alerts = document.querySelectorAll('#alert-success, #alert-danger');
            alerts.forEach(function (el) {
                if (el) {
                    el.style.transition = "opacity 0.5s ease";
                    el.style.opacity = "0";
                    setTimeout(() => el.remove(), 500);
                }
            });
        }, 4000);
        
        // Handle dismiss buttons
        document.querySelectorAll('.luxury-alert .btn-close').forEach(btn => {
            btn.addEventListener('click', function() {
                var alert = this.closest('.luxury-alert');
                alert.style.transition = "opacity 0.3s ease";
                alert.style.opacity = "0";
                setTimeout(() => alert.remove(), 300);
            });
        });
    </script>
}
