@model PhucNguyenResort.ViewModels.MenuCategories.MenuCategoryDetailViewModel

@{
    ViewData["Title"] = "Delete Menu Category";
}

<div class="container-fluid refund-container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                    <i class="fa fa-exclamation-circle mr-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="alert alert-warning shadow-sm mb-4" role="alert">
                <h4 class="alert-heading"><i class="fa fa-exclamation-triangle"></i> Are you sure?</h4>
                <p>Are you sure you want to delete the category <strong>@Model.CategoryName</strong>?</p>
                <hr>
                <p class="mb-0 text-muted small">This action cannot be undone.</p>
            </div>

            <div class="card premium-card shadow-sm mb-4 border-danger">
                <div class="premium-card-header bg-danger text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 text-white"><i class="fa fa-trash mr-2"></i> Delete Menu Category</h4>
                    <a asp-action="Index" class="btn btn-sm btn-light text-danger fw-bold"><i class="fa fa-arrow-left"></i> Back to List</a>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Category name</dt>
                        <dd class="col-sm-8 fw-bold">@Model.CategoryName</dd>

                        <dt class="col-sm-4 text-muted">Menu items</dt>
                        <dd class="col-sm-8">
                            <span class="badge badge-light border p-2">@Model.MenuItemCount items</span>
                            @if (Model.MenuItemCount > 0)
                            {
                                <div class="text-danger mt-2 small"><i class="fa fa-info-circle"></i> You cannot delete a category that still has menu items.</div>
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light p-3">
                    <form asp-action="DeleteConfirmed" asp-route-id="@Model.CategoryId" method="post" class="d-flex gap-2 justify-content-end">
                        @Html.AntiForgeryToken()
                        @if (Model.MenuItemCount > 0)
                        {
                            <button type="button" class="btn btn-danger" disabled><i class="fa fa-trash"></i> Delete Category</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-danger"><i class="fa fa-trash"></i> Delete Category</button>
                        }
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
