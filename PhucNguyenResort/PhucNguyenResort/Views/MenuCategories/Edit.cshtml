@model PhucNguyenResort.ViewModels.MenuCategories.MenuCategoryFormViewModel

@{
    ViewData["Title"] = "Chỉnh Sửa Danh Mục Thực Đơn";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528; /* primary */
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b; /* on-surface-variant */
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 32px;
            margin-bottom: 30px;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        .form-control, .form-select {
            background-color: #f6f3ef;
            border: 1px solid transparent;
            border-radius: 8px;
            padding: 10px 16px;
            font-size: 14px;
            color: #1c1c1a;
            transition: all 0.2s;
            box-shadow: none;
        }
        .form-control:focus, .form-select:focus {
            background-color: #ffffff;
            border-color: #dfa974;
            box-shadow: 0 0 0 4px rgba(223, 169, 116, 0.1);
        }
        .form-label {
            color: #1c1c1a;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .btn-luxury {
            background-color: #dfa974;
            color: #633d11;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-luxury:hover {
            background-color: #805528;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2);
            text-decoration: none;
        }
        .btn-secondary-luxury {
            background-color: #f0ede9;
            color: #50453b;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-secondary-luxury:hover {
            background-color: #e5e2de;
            color: #1c1c1a;
            text-decoration: none;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
    </style>
}

<div class="header-container">
    <div>
        <h2 class="page-title">
            Chỉnh Sửa Danh Mục Thực Đơn
        </h2>
        <p class="page-subtitle">Cập nhật thông tin danh mục thực đơn.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-secondary-luxury">
            <span class="material-symbols-outlined">arrow_back</span> Quay lại danh sách
        </a>
    </div>
</div>

<div class="luxury-card">
    <div style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 600; color: #1c1c1a; margin-bottom: 24px;">
        Thông Tin Danh Mục
    </div>
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius: 8px;" role="alert"></div>
        <input asp-for="CategoryId" type="hidden" />
        
        <div class="row">
            <div class="col-md-6">
                <div class="mb-4">
                    <label asp-for="CategoryName" class="form-label fw-bold">Tên Danh Mục <span class="text-danger">*</span></label>
                    <input asp-for="CategoryName" class="form-control" />
                    <span asp-validation-for="CategoryName" class="text-danger small"></span>
                </div>
            </div>
        </div>
        
        <hr style="border-color: #e5e2de; margin: 32px 0;" />
        <div style="display: flex; gap: 16px;">
            <button type="submit" class="btn-luxury">
                <span class="material-symbols-outlined">save</span> Lưu Thay Đổi
            </button>
            <a asp-action="Index" class="btn-secondary-luxury">
                Hủy bỏ
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
