@model IReadOnlyList<PhucNguyenResort.ViewModels.MenuCategories.MenuCategoryListViewModel>

@{
    ViewData["Title"] = "Menu Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Menu Categories</h1>
    <a asp-action="Create" class="btn btn-primary">Add category</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th class="text-end">Menu items</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.CategoryName</td>
                <td class="text-end">@category.MenuItemCount</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@category.CategoryId" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Edit" asp-route-id="@category.CategoryId" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@category.CategoryId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
