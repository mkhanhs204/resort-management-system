@model IReadOnlyList<PhucNguyenResort.ViewModels.MenuCategories.MenuCategoryListViewModel>

@{
    ViewData["Title"] = "Menu Categories";
}

<div class="container-fluid refund-container py-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 page-title">@ViewData["Title"]</h1>
        <a asp-action="Create" class="btn btn-premium-action btn-primary shadow-sm">
            <i class="fa fa-plus-circle"></i> Add category
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card premium-card mb-4">
        <div class="premium-card-header d-flex align-items-center">
            <div class="icon-circle bg-primary text-white mr-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;">
                <i class="fa fa-list"></i>
            </div>
            <h6 class="m-0 font-weight-bold text-dark" style="font-size: 1.1rem;">Menu Categories List</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table premium-table mb-0" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th class="pl-4">Name</th>
                            <th class="text-end">Menu items</th>
                            <th class="pr-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td class="pl-4 fw-bold">@category.CategoryName</td>
                                <td class="text-end"><span class="badge badge-light border p-2">@category.MenuItemCount</span></td>
                                <td class="pr-4 text-end">
                                    <a asp-action="Edit" asp-route-id="@category.CategoryId" class="btn-action-icon edit" title="Edit"><i class="fa fa-pencil"></i></a>
                                    <a asp-action="Details" asp-route-id="@category.CategoryId" class="btn-action-icon view" title="Details"><i class="fa fa-eye"></i></a>
                                    <a asp-action="Delete" asp-route-id="@category.CategoryId" class="btn-action-icon delete" title="Delete"><i class="fa fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">No menu categories found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
