@model PhucNguyenResort.ViewModels.MenuCategories.MenuCategoryDetailViewModel

@{
    ViewData["Title"] = "Chi Tiết Danh Mục Thực Đơn";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528; /* primary */
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b; /* on-surface-variant */
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 32px;
            margin-bottom: 30px;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        .btn-luxury {
            background-color: #dfa974;
            color: #633d11;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-luxury:hover {
            background-color: #805528;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2);
            text-decoration: none;
        }
        .btn-secondary-luxury {
            background-color: #f0ede9;
            color: #50453b;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-secondary-luxury:hover {
            background-color: #e5e2de;
            color: #1c1c1a;
            text-decoration: none;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .detail-row {
            display: flex;
            padding: 16px 0;
            border-bottom: 1px solid #f0ede9;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            width: 30%;
            color: #50453b;
            font-weight: 600;
            font-size: 14px;
        }
        .detail-value {
            width: 70%;
            color: #1c1c1a;
            font-weight: 500;
            font-size: 15px;
        }
        .luxury-badge {
            background-color: #f0ede9;
            color: #50453b;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            border: 1px solid #d4c3b6;
        }
    </style>
}

<div class="header-container">
    <div>
        <h2 class="page-title">
            Chi Tiết Danh Mục
        </h2>
        <p class="page-subtitle">Thông tin của danh mục thực đơn.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-secondary-luxury">
            <span class="material-symbols-outlined">arrow_back</span> Quay lại danh sách
        </a>
    </div>
</div>

<div class="luxury-card">
    <div style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 600; color: #1c1c1a; margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined" style="color: #dfa974; font-size: 28px;">restaurant_menu</span>
        @Model.CategoryName
    </div>
    
    <div class="row">
        <div class="col-md-8">
            <div class="detail-row">
                <div class="detail-label">Tên Danh Mục</div>
                <div class="detail-value fw-bold fs-5">@Model.CategoryName</div>
            </div>
            
            <div class="detail-row">
                <div class="detail-label">Số Lượng Món Ăn</div>
                <div class="detail-value">
                    <span class="luxury-badge">
                        <span class="material-symbols-outlined" style="font-size: 16px;">set_meal</span>
                        @Model.MenuItemCount món
                    </span>
                </div>
            </div>
        </div>
    </div>
    
    <hr style="border-color: #e5e2de; margin: 32px 0;" />
    <div style="display: flex; gap: 16px;">
        <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn-luxury">
            <span class="material-symbols-outlined">edit</span> Chỉnh Sửa
        </a>
    </div>
</div>
