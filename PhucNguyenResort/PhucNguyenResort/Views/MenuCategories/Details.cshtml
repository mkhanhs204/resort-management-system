@model PhucNguyenResort.ViewModels.MenuCategories.MenuCategoryDetailViewModel

@{
    ViewData["Title"] = "Menu Category Details";
}

<h1 class="h3 mb-3">@Model.CategoryName</h1>

<dl class="row">
    <dt class="col-sm-3">Category name</dt>
    <dd class="col-sm-9">@Model.CategoryName</dd>

    <dt class="col-sm-3">Menu items</dt>
    <dd class="col-sm-9">@Model.MenuItemCount</dd>
</dl>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>
