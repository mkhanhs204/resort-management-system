@model PhucNguyenResort.ViewModels.MenuCategories.MenuCategoryDetailViewModel

@{
    ViewData["Title"] = "Menu Category Details";
}

<div class="container-fluid refund-container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card premium-card shadow-sm mb-4">
                <div class="premium-card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 text-white"><i class="fa fa-info-circle mr-2"></i> @Model.CategoryName</h4>
                    <a asp-action="Index" class="btn btn-sm btn-light text-primary fw-bold"><i class="fa fa-arrow-left"></i> Back to List</a>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Category name</dt>
                        <dd class="col-sm-8 fw-bold">@Model.CategoryName</dd>

                        <dt class="col-sm-4 text-muted">Menu items</dt>
                        <dd class="col-sm-8">
                            <span class="badge badge-light border p-2">@Model.MenuItemCount items</span>
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light p-3">
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-primary"><i class="fa fa-pencil"></i> Edit</a>
                        <a asp-action="Delete" asp-route-id="@Model.CategoryId" class="btn btn-danger"><i class="fa fa-trash"></i> Delete</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
