@model IEnumerable<PhucNguyenResort.Models.RoomCategory>

@{
    ViewData["Title"] = "Manage Room Categories";
}

<div class="container-fluid refund-container py-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 page-title">@ViewData["Title"]</h1>
        <a asp-action="Create" class="btn btn-premium-action btn-primary shadow-sm">
            <i class="fa fa-plus-circle"></i> Create New
        </a>
    </div>
    <div class="card premium-card mb-4">
        <div class="premium-card-header d-flex align-items-center">
            <div class="icon-circle bg-primary text-white mr-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;">
                <i class="fa fa-tags"></i>
            </div>
            <h6 class="m-0 font-weight-bold text-dark" style="font-size: 1.1rem;">Danh sách Hạng Phòng (Categories)</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table premium-table mb-0" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th class="pl-4">Image</th>
                            <th>@Html.DisplayNameFor(model => model.CategoryName)</th>
                            <th>@Html.DisplayNameFor(model => model.MaxAdults)</th>
                            <th>@Html.DisplayNameFor(model => model.MaxChildren)</th>
                            <th>@Html.DisplayNameFor(model => model.PricePerNight)</th>
                            <th class="pr-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td class="pl-4">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.CategoryName" class="img-thumbnail border-0 shadow-sm" style="max-width: 100px; max-height: 100px; border-radius: 12px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light text-muted d-flex align-items-center justify-content-center border" style="width: 100px; height: 60px; border-radius: 12px;"><i class="fa fa-picture-o mr-1"></i> No Image</div>
                                    }
                                </td>
                                <td class="fw-bold text-primary">@Html.DisplayFor(modelItem => item.CategoryName)</td>
                                <td><span class="badge badge-light border text-dark p-2"><i class="fa fa-user text-muted mr-1"></i> @Html.DisplayFor(modelItem => item.MaxAdults) Người lớn</span></td>
                                <td><span class="badge badge-light border text-dark p-2"><i class="fa fa-child text-muted mr-1"></i> @Html.DisplayFor(modelItem => item.MaxChildren) Trẻ em</span></td>
                                <td class="amount-text">@item.PricePerNight?.ToString("N0") VND</td>
                                <td class="pr-4 text-end">
                                    <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn-action-icon edit" title="Sửa"><i class="fa fa-pencil"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn-action-icon view" title="Xem chi tiết"><i class="fa fa-eye"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn-action-icon delete" title="Xóa"><i class="fa fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
