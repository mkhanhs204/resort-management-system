@model PhucNguyenResort.Models.RoomCategory

@{
    ViewData["Title"] = "Delete Room Category";
}

<div class="container mt-4">
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Are you sure you want to delete this?</h4>
        <p>This action cannot be undone. Any rooms associated with this category might be affected.</p>
    </div>

    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Deleting: @Model.CategoryName</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.CategoryName" class="img-fluid rounded" />
                    }
                </div>
                <div class="col-md-8">
                    <dl class="row">
                        <dt class="col-sm-4">Category ID</dt>
                        <dd class="col-sm-8">@Model.CategoryId</dd>
                        
                        <dt class="col-sm-4">Capacity</dt>
                        <dd class="col-sm-8">@Model.Capacity Persons</dd>
                        
                        <dt class="col-sm-4">Price</dt>
                        <dd class="col-sm-8">@Model.PricePerNight?.ToString("N0") VND</dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Delete" class="mt-4 border-top pt-3 d-flex justify-content-between">
                <input type="hidden" asp-for="CategoryId" />
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel and Back to List</a>
                <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
            </form>
        </div>
    </div>
</div>
