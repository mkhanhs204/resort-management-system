@model List<PhucNguyenResort.Web.Models.ViewModels.MaintenanceHistoryViewModel>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Nhật Ký Bảo Trì Kỹ Thuật";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528;
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b;
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 24px;
            margin-bottom: 30px;
        }
        .luxury-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        .luxury-table thead th {
            background-color: #f6f3ef;
            color: #50453b;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 16px;
            border: none;
        }
        .luxury-table thead th:first-child { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
        .luxury-table thead th:last-child { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
        .luxury-table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-bottom: 1px solid #f0ede9;
            color: #1c1c1a;
            font-size: 14px;
        }
        .luxury-table tbody tr:last-child td { border-bottom: none; }
        .luxury-table tbody tr:hover { background-color: #fcf9f5; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .material-symbols-outlined.fill {
            font-variation-settings: 'FILL' 1;
        }
        .luxury-badge {
            background-color: #f0ede9;
            color: #50453b;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .luxury-badge.success { background-color: #e2f5ea; color: #0b5c2d; }
        .luxury-badge.warning { background-color: #ffefd6; color: #805528; }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        .form-control-luxury {
            background-color: #f6f3ef;
            border: 1px solid transparent;
            border-radius: 8px;
            padding: 10px 16px;
            font-family: 'Inter', sans-serif;
            color: #1c1c1a;
            width: 100%;
        }
        .form-control-luxury:focus {
            border-color: #805528;
            box-shadow: 0 0 0 2px rgba(128, 85, 40, 0.2);
            background-color: #ffffff;
            outline: none;
        }
    </style>
}

<div class="header-container">
    <div>
        <h2 class="page-title">
            <span class="material-symbols-outlined" style="font-size: 36px; color: #805528; margin-right: 8px;">history</span>
            Nhật Ký Bảo Trì Kỹ Thuật
        </h2>
        <p class="page-subtitle">Hệ thống lưu trữ và tra cứu lịch sử xử lý sự cố thiết bị tại phòng nghỉ.</p>
    </div>
    <div style="font-family: 'Inter', sans-serif; color: #50453b; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined">calendar_today</span>
        <span>@DateTime.Now.ToString("dd MMMM, yyyy")</span>
    </div>
</div>

<div class="luxury-card">
    <div class="row mb-4 align-items-center">
        <div class="col-md-8 mb-2 mb-md-0">
            <div style="display: flex; align-items: center; gap: 10px; background-color: #f6f3ef; border-radius: 8px; padding: 0 16px;">
                <span class="material-symbols-outlined" style="color: #827569;">search</span>
                <input type="text" id="maintenanceSearch" style="border: none; background: transparent; padding: 10px 0; width: 100%; outline: none; font-family: 'Inter', sans-serif; color: #1c1c1a;" placeholder="Tìm số phòng, hạng phòng, kỹ thuật viên hoặc nội dung sự cố...">
            </div>
        </div>
        <div class="col-md-4">
            <select id="statusFilter" class="form-control-luxury">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Đã hoàn thành">Đã hoàn thành (Đã khắc phục)</option>
                <option value="Đang xử lý">Đang tiến hành xử lý</option>
            </select>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 style="font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 600; color: #1c1c1a; margin: 0; display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined" style="color: #805528;">handyman</span> Lịch sử sửa chữa thiết bị
        </h5>
    </div>

    <div style="overflow-x: auto;">
        <table class="luxury-table" id="maintenanceTable">
            <thead>
                <tr>
                    <th>Mã Phiếu</th>
                    <th>Số Phòng</th>
                    <th>Hạng Phòng</th>
                    <th style="min-width: 250px;">Nội Dung Ghi Nhận</th>
                    <th>Thời Gian</th>
                    <th>Kỹ Thuật Viên</th>
                    <th style="text-align: right;">Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr id="emptyRow">
                        <td colspan="7" style="text-align: center; padding: 60px 20px; color: #827569;">
                            <span class="material-symbols-outlined" style="font-size: 48px; color: #a4b5ce; margin-bottom: 16px; display: block;">assignment</span>
                            <h5 style="font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 600; color: #1c1c1a; margin-bottom: 8px;">Không tìm thấy lịch sử sửa chữa</h5>
                            <p style="font-size: 15px; margin: 0;">Hệ thống chưa ghi nhận lỗi kỹ thuật nào từ trước đến nay.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr class="m-row" data-status="@item.Status">
                            <td style="color: #827569; font-weight: 500;">#MT-@item.RequestId</td>
                            <td><strong style="color: #1c1c1a; font-size: 15px;">@item.RoomNumber</strong></td>
                            <td>@item.RoomType</td>
                            <td style="color: #1c1c1a;">@item.Description</td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 4px; font-size: 13px;">
                                    <span style="color: #827569; display: flex; align-items: center; gap: 4px;">
                                        <span class="material-symbols-outlined" style="font-size: 14px;">add_circle</span> @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                    <span style="color: #0b5c2d; display: flex; align-items: center; gap: 4px;">
                                        <span class="material-symbols-outlined" style="font-size: 14px;">check_circle</span> @(item.ResolvedAt.HasValue ? item.ResolvedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                                    </span>
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 6px; color: #50453b;">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">account_circle</span>
                                    @(string.IsNullOrEmpty(item.AssignedStaffName) ? "Chưa bàn giao" : item.AssignedStaffName)
                                </div>
                            </td>
                            <td style="text-align: right;">
                                @if (item.Status == "Đã hoàn thành")
                                {
                                    <span class="luxury-badge success">
                                        <span class="material-symbols-outlined fill" style="font-size: 14px;">check_circle</span> Đã khắc phục
                                    </span>
                                }
                                else
                                {
                                    <span class="luxury-badge warning">
                                        <span class="material-symbols-outlined fill" style="font-size: 14px;">sync</span> Đang xử lý
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                    <tr id="noMatchRow" style="display: none;">
                        <td colspan="7" style="text-align: center; padding: 40px; color: #827569;">
                            <i class="material-symbols-outlined" style="font-size: 32px; display: block; margin-bottom: 8px;">search_off</i>
                            Không có bản ghi nào khớp với điều kiện tìm kiếm.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4 pt-3" style="border-top: 1px solid #f0ede9; font-family: 'Inter', sans-serif;">
        <span style="color: #50453b; font-size: 14px;" id="rowCountSummary">
            Hiển thị <strong style="color: #1c1c1a;" id="visibleCount">@(Model?.Count ?? 0)</strong> trong tổng số <strong style="color: #1c1c1a;">@(Model?.Count ?? 0)</strong> bản ghi
        </span>
        <nav>
            <ul class="pagination pagination-sm mb-0" style="gap: 4px;">
                <li class="page-item disabled"><a class="page-link" href="#" style="border-radius: 6px; color: #827569; border: 1px solid #e5e2de;"><i class="material-symbols-outlined" style="font-size: 16px;">chevron_left</i></a></li>
                <li class="page-item active"><a class="page-link" href="#" style="border-radius: 6px; background-color: #805528; border-color: #805528; color: #fff;">1</a></li>
                <li class="page-item"><a class="page-link" href="#" style="border-radius: 6px; color: #805528; border: 1px solid #e5e2de;">2</a></li>
                <li class="page-item"><a class="page-link" href="#" style="border-radius: 6px; color: #827569; border: 1px solid #e5e2de;"><i class="material-symbols-outlined" style="font-size: 16px;">chevron_right</i></a></li>
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <style>
        .pagination .page-link {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            padding: 0;
        }
        .pagination .page-item.active .page-link {
            z-index: 3;
        }
    </style>
    <script>
        $(document).ready(function () {
            function filterMaintenanceTable() {
                var searchText = $("#maintenanceSearch").val().toLowerCase().trim();
                var selectedStatus = $("#statusFilter").val();

                var totalRows = $(".m-row").length;
                var visibleRows = 0;

                if (totalRows === 0) return;

                $(".m-row").each(function () {
                    var rowContent = $(this).text().toLowerCase();
                    var rowStatus = $(this).attr("data-status");

                    var textMatch = searchText === "" || rowContent.indexOf(searchText) > -1;
                    var statusMatch = selectedStatus === "" || rowStatus === selectedStatus;

                    if (textMatch && statusMatch) {
                        $(this).show();
                        visibleRows++;
                    } else {
                        $(this).hide();
                    }
                });

                $("#visibleCount").text(visibleRows);

                if (visibleRows === 0) {
                    $("#noMatchRow").show();
                } else {
                    $("#noMatchRow").hide();
                }
            }

            $("#maintenanceSearch").on("keyup", filterMaintenanceTable);
            $("#statusFilter").on("change", filterMaintenanceTable);
        });
    </script>
}