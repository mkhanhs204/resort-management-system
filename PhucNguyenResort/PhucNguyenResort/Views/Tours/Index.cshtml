@model IEnumerable<PhucNguyenResort.Models.Tour>

@{
    ViewData["Title"] = "Manage Tours";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center" style="border-bottom: 2px solid #eee; padding-bottom: 15px;">
            <div>
                <h2 style="font-family: 'Lora', serif; font-weight: bold; color: #1a1a1a; margin-bottom: 5px;">
                    <i class="fa fa-map-o mr-2" style="color: #dfa974;"></i> Manage Tours
                </h2>
                <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Tour Catalog Management — Master Data (UC04)</p>
            </div>
            <div class="text-muted" style="font-family: 'Cabin', sans-serif; font-size: 14px;">
                <i class="fa fa-calendar mr-2"></i> @DateTime.Now.ToString("dd MMMM, yyyy")
            </div>
        </div>
    </div>
</div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm px-4 py-3 mb-4" role="alert" id="alert-success" style="border-radius: 14px; background-color: #f0fdf4; color: #15803d; font-weight: 600;">
            <i class="fa fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm px-4 py-3 mb-4" role="alert" id="alert-error" style="border-radius: 14px; background-color: #fef2f2; color: #b91c1c; font-weight: 600;">
            <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["ErrorMessage"]
        </div>
    }

<div class="card-box shadow-sm" style="border-top: 4px solid #dfa974; font-family: 'Cabin', sans-serif;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span style="font-family: 'Lora', serif; font-size: 18px; font-weight: bold; color: #1a1a1a;">Tour List <span class="badge badge-primary ml-2" id="tour-count">@(Model?.Count() ?? 0)</span></span>
        <a asp-action="Create" class="btn btn-primary btn-sm" style="background-color: #dfa974; border-color: #dfa974;" id="btn-create-tour">
            <i class="fa fa-plus"></i> Create New Tour
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0" id="tours-table">
                <thead class="thead-dark">
                    <tr>
                        <th>#</th>
                        <th>Tour Name</th>
                        <th>Price (VND)</th>
                        <th>Capacity</th>
                        <th>Duration</th>
                        <th>Location</th>
                        <th>Image</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int rowNum = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted">@rowNum</td>
                                <td><strong>@Html.DisplayFor(modelItem => item.TourName)</strong></td>
                                <td>@(item.Price?.ToString("N0")) ₫</td>
                                <td>
                                    <span class="badge badge-info">@(item.MaxCapacity) pax</span>
                                </td>
                                <td>@(item.DurationHours) h</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Location))
                                    {
                                        <i class="fa fa-map-marker text-danger"></i> @item.Location
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.TourName" style="width:50px;height:35px;object-fit:cover;border-radius:4px;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted"><i class="fa fa-image"></i></span>
                                    }
                                </td>
                                <td class="text-center text-nowrap">
                                    <a asp-action="Details" asp-route-id="@item.TourId"
                                       class="btn btn-sm btn-outline-info" title="Details" id="btn-details-@item.TourId">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.TourId"
                                       class="btn btn-sm btn-outline-warning" title="Edit" id="btn-edit-@item.TourId">
                                        <i class="fa fa-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.TourId"
                                       class="btn btn-sm btn-outline-danger" title="Delete" id="btn-delete-@item.TourId">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                            rowNum++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="fa fa-info-circle"></i> No tours found. 
                                <a asp-action="Create">Create the first tour</a>.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            var alerts = document.querySelectorAll('#alert-success, #alert-error');
            alerts.forEach(function (el) {
                if (el) {
                    $(el).fadeOut(500);
                }
            });
        }, 4000);
    </script>
}