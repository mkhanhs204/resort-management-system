@model IEnumerable<PhucNguyenResort.Models.Tour>

@{
    ViewData["Title"] = "Manage Tours";
}

<div class="page-header">
    <h2><i class="fa fa-map-o"></i> Manage Tours</h2>
    <p class="text-muted">Tour Catalog Management — Master Data (UC04)</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="alert-success">
        <i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" id="alert-error">
        <i class="fa fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><strong>Tour List</strong> — <span class="badge badge-primary" id="tour-count">@(Model?.Count() ?? 0)</span> tour(s)</span>
        <a asp-action="Create" class="btn btn-primary btn-sm" id="btn-create-tour">
            <i class="fa fa-plus"></i> Create New Tour
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0" id="tours-table">
                <thead class="thead-dark">
                    <tr>
                        <th>#</th>
                        <th>Tour Name</th>
                        <th>Price (VND)</th>
                        <th>Capacity</th>
                        <th>Duration</th>
                        <th>Location</th>
                        <th>Image</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int rowNum = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted">@rowNum</td>
                                <td><strong>@Html.DisplayFor(modelItem => item.TourName)</strong></td>
                                <td>@(item.Price?.ToString("N0")) ₫</td>
                                <td>
                                    <span class="badge badge-info">@(item.MaxCapacity) pax</span>
                                </td>
                                <td>@(item.DurationHours) h</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Location))
                                    {
                                        <i class="fa fa-map-marker text-danger"></i> @item.Location
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.TourName" style="width:50px;height:35px;object-fit:cover;border-radius:4px;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted"><i class="fa fa-image"></i></span>
                                    }
                                </td>
                                <td class="text-center text-nowrap">
                                    <a asp-action="Details" asp-route-id="@item.TourId"
                                       class="btn btn-sm btn-outline-info" title="Details" id="btn-details-@item.TourId">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.TourId"
                                       class="btn btn-sm btn-outline-warning" title="Edit" id="btn-edit-@item.TourId">
                                        <i class="fa fa-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.TourId"
                                       class="btn btn-sm btn-outline-danger" title="Delete" id="btn-delete-@item.TourId">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                            rowNum++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="fa fa-info-circle"></i> No tours found. 
                                <a asp-action="Create">Create the first tour</a>.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts after 4 seconds
        setTimeout(function () {
            var alerts = document.querySelectorAll('#alert-success, #alert-error');
            alerts.forEach(function (el) {
                if (el) {
                    el.classList.remove('show');
                    el.classList.add('fade');
                }
            });
        }, 4000);
    </script>
}
