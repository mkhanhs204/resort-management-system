@model IEnumerable<PhucNguyenResort.Models.Tour>

@{
    ViewData["Title"] = "Manage Tours";
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,600;1,400&display=swap" rel="stylesheet">

<style>
    .tour-list-wrapper {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #1e293b;
        background: #f8fafc;
    }

    .header-panel-luxury {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid rgba(226, 232, 240, 0.8);
    }

    .btn-luxury-gold {
        background: #c29953;
        color: #ffffff !important;
        font-weight: 600;
        font-size: 13px;
        padding: 10px 20px;
        border-radius: 12px;
        border: none;
        transition: all 0.2s;
    }

        .btn-luxury-gold:hover {
            background: #b08743;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(194, 153, 83, 0.25);
        }

    /* Cấu trúc Table cao cấp */
    .table-luxury-tours {
        border-collapse: separate;
        border-spacing: 0 12px;
        width: 100%;
    }

        .table-luxury-tours thead tr th {
            border: none;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: #64748b;
            padding: 14px 20px;
        }

        .table-luxury-tours tbody tr {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 4px 10px rgba(15, 23, 42, 0.01);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .table-luxury-tours tbody tr:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(15, 23, 42, 0.05);
                background: #ffffff !important;
            }

        .table-luxury-tours tbody td {
            padding: 16px 20px !important;
            border-top: 1px solid #f1f5f9 !important;
            border-bottom: 1px solid #f1f5f9 !important;
            vertical-align: middle !important;
        }

            .table-luxury-tours tbody td:first-child {
                border-left: 1px solid #f1f5f9 !important;
                border-top-left-radius: 16px;
                border-bottom-left-radius: 16px;
            }

            .table-luxury-tours tbody td:last-child {
                border-right: 1px solid #f1f5f9 !important;
                border-top-right-radius: 16px;
                border-bottom-right-radius: 16px;
            }

    .tour-thumbnail {
        width: 65px;
        height: 44px;
        object-fit: cover;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.06);
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
    }

    .badge-pax-custom {
        background: rgba(14, 165, 233, 0.08);
        color: #0284c7;
        font-weight: 700;
        font-size: 12px;
        padding: 6px 12px;
        border-radius: 8px;
    }

    .btn-action-circle {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        margin: 0 2px;
        transition: all 0.2s;
        background: #f8fafc;
    }

        .btn-action-circle:hover {
            transform: scale(1.1);
        }
</style>

<div class="tour-list-wrapper container-fluid px-2">
    <div class="d-flex align-items-center justify-content-between p-4 mb-4 header-panel-luxury shadow-sm">
        <div class="d-flex align-items-center">
            <div class="bg-light p-3 rounded-3 mr-3 text-warning"><i class="fa fa-map-o fa-2x"></i></div>
            <div>
                <h2 class="h4 font-weight-bold mb-1" style="font-family: 'Lora', serif; color: #0f172a;">Manage Tours</h2>
                <p class="text-muted small mb-0">Tour Catalog Management — Master Data (UC04)</p>
            </div>
        </div>
        <a asp-action="Create" class="btn btn-luxury-gold shadow-sm" id="btn-create-tour">
            <i class="fa fa-plus mr-1"></i> Create New Tour
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm px-4 py-3 mb-4" role="alert" id="alert-success" style="border-radius: 14px; background-color: #f0fdf4; color: #15803d; font-weight: 600;">
            <i class="fa fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm px-4 py-3 mb-4" role="alert" id="alert-error" style="border-radius: 14px; background-color: #fef2f2; color: #b91c1c; font-weight: 600;">
            <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-luxury-tours text-center align-middle mb-0" id="tours-table">
            <thead>
                <tr>
                    <th style="width: 60px;">#</th>
                    <th class="text-left" style="min-width: 220px;">Tour Name</th>
                    <th>Price (VND)</th>
                    <th>Capacity</th>
                    <th>Duration</th>
                    <th>Location</th>
                    <th>Image</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int rowNum = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted font-weight-bold">@rowNum.ToString("D2")</td>
                            <td class="text-left font-weight-bold text-dark">
                                @Html.DisplayFor(modelItem => item.TourName)
                            </td>
                            <td class="font-weight-bold text-danger">
                                @(item.Price?.ToString("N0")) ₫
                            </td>
                            <td>
                                <span class="badge-pax-custom">@(item.MaxCapacity) pax</span>
                            </td>
                            <td class="font-weight-bold text-secondary">@(item.DurationHours) h</td>
                            <td class="text-muted small">
                                @if (!string.IsNullOrEmpty(item.Location))
                                {
                                    <span class="text-dark font-weight-medium"><i class="fa fa-map-marker text-danger mr-1"></i> @item.Location</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.TourName" class="tour-thumbnail" onerror="this.onerror=null; this.src='https://placehold.co/70x46?text=Resort';" />
                                }
                                else
                                {
                                    <div class="tour-thumbnail d-flex align-items-center justify-content-center text-muted"><i class="fa fa-image"></i></div>
                                }
                            </td>
                            <td class="text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.TourId" class="btn-action-circle text-info" title="Details" id="btn-details-@item.TourId">
                                    <i class="fa fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.TourId" class="btn-action-circle text-warning" title="Edit" id="btn-edit-@item.TourId">
                                    <i class="fa fa-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.TourId" class="btn-action-circle text-danger" title="Delete" id="btn-delete-@item.TourId">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                        rowNum++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5 bg-white" style="border-radius: 16px;">
                            <div class="py-3">
                                <i class="fa fa-info-circle fa-2x text-muted mb-2"></i>
                                <br />No tours found. <a asp-action="Create" class="font-weight-bold" style="color: #c29953;">Create the first tour</a>.
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            var alerts = document.querySelectorAll('#alert-success, #alert-error');
            alerts.forEach(function (el) {
                if (el) {
                    $(el).fadeOut(500);
                }
            });
        }, 4000);
    </script>
}