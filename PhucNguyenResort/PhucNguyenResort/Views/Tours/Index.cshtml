@model IEnumerable<PhucNguyenResort.Models.Tour>

@{
    ViewData["Title"] = "Manage Tours";
}

<div class="container mt-5 mb-5">
    <h2>Manage Tours</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Tour</a>
    </p>
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.TourName)</th>
                <th>@Html.DisplayNameFor(model => model.Price)</th>
                <th>Capacity</th>
                <th>Duration (h)</th>
                <th>@Html.DisplayNameFor(model => model.Location)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.TourName)</td>
                        <td>@Html.DisplayFor(modelItem => item.Price)</td>
                        <td>@Html.DisplayFor(modelItem => item.MaxCapacity)</td>
                        <td>@Html.DisplayFor(modelItem => item.DurationHours)</td>
                        <td>@Html.DisplayFor(modelItem => item.Location)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.TourId" class="btn btn-sm btn-warning">Edit</a> |
                            <a asp-action="Details" asp-route-id="@item.TourId" class="btn btn-sm btn-info">Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.TourId" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">No tours found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
