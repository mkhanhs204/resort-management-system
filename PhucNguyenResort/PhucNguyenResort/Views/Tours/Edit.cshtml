@model PhucNguyenResort.ViewModels.Tours.TourEditVM

@{
    ViewData["Title"] = "Edit Tour";
}

<div class="page-header">
    <h2><i class="fa fa-pencil"></i> Edit Tour</h2>
    <p class="text-muted">Update tour information. Fields marked <span class="text-danger">*</span> are required.</p>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Tour #@Model.TourId — @Model.TourName</strong>
        <a asp-action="Details" asp-route-id="@Model.TourId" class="btn btn-sm btn-outline-info">
            <i class="fa fa-eye"></i> View Details
        </a>
    </div>
    <div class="card-body">
        <form asp-action="Edit" id="edit-tour-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="TourId" />

            <div class="row">
                <div class="col-md-8">
                    <!-- Tour Name -->
                    <div class="form-group mb-3">
                        <label asp-for="TourName" class="control-label font-weight-bold">
                            Tour Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="TourName" class="form-control" id="input-tour-name" maxlength="100" />
                        <span asp-validation-for="TourName" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="form-group mb-3">
                        <label asp-for="Description" class="control-label font-weight-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" id="input-description" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Price + Capacity -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Price" class="control-label font-weight-bold">
                                    Price (VND) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="Price" type="number" step="1000" min="0" max="999999999"
                                           class="form-control" id="input-price" />
                                    <div class="input-group-append">
                                        <span class="input-group-text">₫</span>
                                    </div>
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="MaxCapacity" class="control-label font-weight-bold">
                                    Max Capacity <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="MaxCapacity" type="number" min="1" max="1000"
                                           class="form-control" id="input-max-capacity" />
                                    <div class="input-group-append">
                                        <span class="input-group-text">pax</span>
                                    </div>
                                </div>
                                <span asp-validation-for="MaxCapacity" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Duration + Location -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="DurationHours" class="control-label font-weight-bold">
                                    Duration <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="DurationHours" type="number" min="1" max="1000"
                                           class="form-control" id="input-duration-hours" />
                                    <div class="input-group-append">
                                        <span class="input-group-text">hours</span>
                                    </div>
                                </div>
                                <span asp-validation-for="DurationHours" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Location" class="control-label font-weight-bold">Location</label>
                                <input asp-for="Location" class="form-control" id="input-location" maxlength="255" />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Image URL -->
                    <div class="form-group mb-3">
                        <label asp-for="ImageUrl" class="control-label font-weight-bold">Image URL</label>
                        <input asp-for="ImageUrl" class="form-control" id="input-image-url" maxlength="255"
                               oninput="previewImage(this.value)" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <!-- Manager -->
                    <div class="form-group mb-3">
                        <label asp-for="ManagerId" class="control-label font-weight-bold">Tour guide</label>
                        <select asp-for="ManagerId" class="form-control" id="select-manager">
                            <option value="">-- Select a Tour guide --</option>
                            @if (ViewBag.Managers != null)
                            {
                                foreach (var manager in ViewBag.Managers)
                                {
                                    <option value="@manager.UserId">@manager.FullName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ManagerId" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Live Image Preview -->
                <div class="col-md-4">
                    <label class="control-label font-weight-bold">Image Preview</label>
                    <div id="image-preview-container"
                         style="border:2px dashed #ddd;border-radius:8px;min-height:200px;display:flex;align-items:center;justify-content:center;background:#f8f9fa;">
                        <div id="preview-placeholder" class="text-muted text-center @(string.IsNullOrEmpty(Model.ImageUrl) ? "" : "d-none")">
                            <i class="fa fa-image fa-3x mb-2"></i><br/>
                            <small>Enter image URL to preview</small>
                        </div>
                        <img id="preview-img" src="@Model.ImageUrl" alt="Preview"
                             class="img-fluid rounded @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")"
                             style="max-height:200px;object-fit:cover;" />
                    </div>
                </div>
            </div>

            <hr />
            <div class="form-group">
                <button type="submit" class="btn btn-warning" id="btn-submit-edit">
                    <i class="fa fa-save"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn btn-secondary" id="btn-back-to-list">
                    <i class="fa fa-arrow-left"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewImage(url) {
            var img = document.getElementById('preview-img');
            var placeholder = document.getElementById('preview-placeholder');
            if (url && url.trim() !== '') {
                img.src = url;
                img.classList.remove('d-none');
                placeholder.classList.add('d-none');
                img.onerror = function () {
                    img.classList.add('d-none');
                    placeholder.classList.remove('d-none');
                };
            } else {
                img.classList.add('d-none');
                placeholder.classList.remove('d-none');
            }
        }
    </script>
}
