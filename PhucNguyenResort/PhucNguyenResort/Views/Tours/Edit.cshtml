@model PhucNguyenResort.ViewModels.Tours.TourEditVM

@{
    ViewData["Title"] = "Chỉnh Sửa Tour";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528;
            margin-bottom: 4px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b;
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 32px;
            margin-bottom: 30px;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        .form-control {
            background-color: #f6f3ef;
            border: 1px solid transparent;
            border-radius: 8px;
            padding: 10px 16px;
            font-size: 14px;
            color: #1c1c1a;
            transition: all 0.2s;
            box-shadow: none;
        }
        .form-control:focus {
            background-color: #ffffff;
            border-color: #dfa974;
            box-shadow: 0 0 0 4px rgba(223, 169, 116, 0.1);
        }
        .input-group-text {
            background-color: #e5e2de;
            border: none;
            color: #50453b;
            font-weight: 600;
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }
        .form-group label {
            color: #1c1c1a;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .btn-luxury {
            background-color: #dfa974;
            color: #633d11;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-luxury:hover {
            background-color: #805528;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2);
            text-decoration: none;
        }
        .btn-secondary-luxury {
            background-color: #f0ede9;
            color: #50453b;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-secondary-luxury:hover {
            background-color: #e5e2de;
            color: #1c1c1a;
            text-decoration: none;
        }
        .btn-outline-luxury {
            background-color: transparent;
            color: #805528;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 8px 16px;
            border: 1px solid #805528;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-outline-luxury:hover {
            background-color: #805528;
            color: #ffffff;
            text-decoration: none;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .image-preview-box {
            border: 2px dashed #d4c3b6;
            border-radius: 12px;
            min-height: 240px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fcf9f5;
            transition: all 0.3s;
        }
    </style>
}

<div class="header-container">
    <div>
        <h2 class="page-title">
            Chỉnh Sửa Tour
        </h2>
        <p class="page-subtitle">Cập nhật thông tin tour. Các trường có dấu <span class="text-danger">*</span> là bắt buộc.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-secondary-luxury" id="btn-back-to-list-header">
            <span class="material-symbols-outlined">arrow_back</span> Quay lại danh sách
        </a>
    </div>
</div>

<div class="luxury-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <span style="font-family: 'Playfair Display', serif; font-size: 24px; font-weight: 600; color: #1c1c1a;">Tour #@Model.TourId — @Model.TourName</span>
        <a asp-action="Details" asp-route-id="@Model.TourId" class="btn-outline-luxury">
            <span class="material-symbols-outlined">visibility</span> Xem chi tiết
        </a>
    </div>
    <div>
        <form asp-action="Edit" id="edit-tour-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius: 8px;" role="alert"></div>
            <input type="hidden" asp-for="TourId" />

            <div class="row">
                <div class="col-md-8">
                    <!-- Tour Name -->
                    <div class="form-group mb-4">
                        <label asp-for="TourName">
                            Tên Tour <span class="text-danger">*</span>
                        </label>
                        <input asp-for="TourName" class="form-control" id="input-tour-name" maxlength="100" />
                        <span asp-validation-for="TourName" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="form-group mb-4">
                        <label asp-for="Description">Mô tả</label>
                        <textarea asp-for="Description" class="form-control" id="input-description" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Price + Capacity -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                <label asp-for="Price">
                                    Giá (VNĐ) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="Price" type="number" step="any" min="0" max="999999999"
                                           class="form-control" id="input-price" />
                                    <div class="input-group-append">
                                        <span class="input-group-text">₫</span>
                                    </div>
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                <label asp-for="MaxCapacity">
                                    Sức chứa tối đa <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="MaxCapacity" type="number" min="1" max="1000"
                                           class="form-control" id="input-max-capacity" />
                                    <div class="input-group-append">
                                        <span class="input-group-text">khách</span>
                                    </div>
                                </div>
                                <span asp-validation-for="MaxCapacity" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Duration + Location -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                <label asp-for="DurationHours">
                                    Thời lượng <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="DurationHours" type="number" min="1" max="1000"
                                           class="form-control" id="input-duration-hours" />
                                    <div class="input-group-append">
                                        <span class="input-group-text">giờ</span>
                                    </div>
                                </div>
                                <span asp-validation-for="DurationHours" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                <label asp-for="Location">Địa điểm</label>
                                <input asp-for="Location" class="form-control" id="input-location" maxlength="255" />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Image URL -->
                    <div class="form-group mb-4">
                        <label asp-for="ImageUrl">URL Hình Ảnh</label>
                        <input asp-for="ImageUrl" class="form-control" id="input-image-url" maxlength="255"
                               oninput="previewImage(this.value)" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                </div>

                <!-- Live Image Preview -->
                <div class="col-md-4">
                    <label style="color: #1c1c1a; font-size: 14px; font-weight: 600; margin-bottom: 8px; display: block;">Xem trước hình ảnh</label>
                    <div id="image-preview-container" class="image-preview-box">
                        <div id="preview-placeholder" style="text-align: center; color: #a4b5ce;" class="@(string.IsNullOrEmpty(Model.ImageUrl) ? "" : "d-none")">
                            <span class="material-symbols-outlined" style="font-size: 48px; margin-bottom: 8px;">image</span><br/>
                            <small>Nhập URL để xem trước</small>
                        </div>
                        <img id="preview-img" src="@Model.ImageUrl" alt="Preview"
                             class="img-fluid rounded @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")"
                             style="max-height:240px;object-fit:cover; border-radius: 8px;" />
                    </div>
                </div>
            </div>

            <hr style="border-color: #e5e2de; margin: 32px 0;" />
            <div style="display: flex; gap: 16px;">
                <button type="submit" class="btn-luxury" id="btn-submit-edit">
                    <span class="material-symbols-outlined">save</span> Lưu Thay Đổi
                </button>
                <a asp-action="Index" class="btn-secondary-luxury" id="btn-back-to-list">
                    Hủy bỏ
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewImage(url) {
            var img = document.getElementById('preview-img');
            var placeholder = document.getElementById('preview-placeholder');
            if (url && url.trim() !== '') {
                img.src = url;
                img.classList.remove('d-none');
                placeholder.classList.add('d-none');
                img.onerror = function () {
                    img.classList.add('d-none');
                    placeholder.classList.remove('d-none');
                };
            } else {
                img.classList.add('d-none');
                placeholder.classList.remove('d-none');
            }
        }
    </script>
}
