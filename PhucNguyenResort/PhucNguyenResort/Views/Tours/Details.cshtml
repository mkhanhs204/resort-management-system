@model PhucNguyenResort.Models.Tour

@{
    ViewData["Title"] = "Tour Details";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fa fa-info-circle"></i> Tour Details</h2>
        <p class="text-muted">Tour #@Model.TourId</p>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model?.TourId" class="btn btn-warning" id="btn-edit-tour">
            <i class="fa fa-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-secondary" id="btn-back-to-list">
            <i class="fa fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <!-- Left: Info -->
    <div class="col-md-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header"><strong>Tour Information</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Tour Name</dt>
                    <dd class="col-sm-8"><strong>@Html.DisplayFor(model => model.TourName)</strong></dd>

                    <dt class="col-sm-4 text-muted">Description</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(Model?.Description))
                        {
                            @Html.DisplayFor(model => model.Description)
                        }
                        else
                        {
                            <em class="text-muted">No description provided.</em>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Price</dt>
                    <dd class="col-sm-8">
                        <span class="badge badge-success" style="font-size:14px;">
                            @(Model?.Price?.ToString("N0")) ₫
                        </span>
                    </dd>

                    <dt class="col-sm-4 text-muted">Max Capacity</dt>
                    <dd class="col-sm-8">
                        <span class="badge badge-info">@(Model?.MaxCapacity) pax</span>
                    </dd>

                    <dt class="col-sm-4 text-muted">Duration</dt>
                    <dd class="col-sm-8">@(Model?.DurationHours) hours</dd>

                    <dt class="col-sm-4 text-muted">Location</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model?.Location))
                        {
                            <i class="fa fa-map-marker text-danger"></i> @Model.Location
                        }
                        else
                        {
                            <em class="text-muted">Not specified</em>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Tour guide</dt>
                    <dd class="col-sm-8">
                        @if (Model?.Manager != null)
                        {
                            <span class="text-primary font-weight-bold">
                                <i class="fa fa-user-circle"></i> @Model.Manager.FullName
                            </span>
                        }
                        else
                        {
                            <em class="text-muted">Not assigned</em>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <!-- Schedules summary -->
        @if (Model?.TourSchedules != null && Model.TourSchedules.Any())
        {
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong><i class="fa fa-calendar"></i> Tour Schedules</strong>
                    <span class="badge badge-warning ml-2">@Model.TourSchedules.Count</span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Schedule ID</th>
                                <th>Start Date</th>
                                <th>Available Slots</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in Model.TourSchedules)
                            {
                                <tr>
                                    <td>#@schedule.ScheduleId</td>
                                    <td>@schedule.TourDate?.ToString("dd/MM/yyyy") @schedule.StartTime?.ToString(@"hh\:mm")</td>
                                    <td>@schedule.AvailableSlots</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Right: Image -->
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header"><strong>Tour Image</strong></div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.TourName"
                         class="img-fluid rounded" style="max-height:300px;object-fit:cover;" />
                }
                else
                {
                    <div class="text-muted py-5">
                        <i class="fa fa-image fa-3x mb-2"></i><br/>
                        <small>No image available</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
