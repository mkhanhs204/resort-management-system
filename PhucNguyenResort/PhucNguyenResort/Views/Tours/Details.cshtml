@model PhucNguyenResort.Models.Tour

@{
    ViewData["Title"] = "Tour Details";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center" style="border-bottom: 2px solid #eee; padding-bottom: 15px;">
            <div>
                <h2 style="font-family: 'Lora', serif; font-weight: bold; color: #1a1a1a; margin-bottom: 5px;">
                    <i class="fa fa-info-circle mr-2" style="color: #dfa974;"></i> Tour Details
                </h2>
                <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Tour #@Model.TourId</p>
            </div>
            <div>
                <a asp-action="Edit" asp-route-id="@Model?.TourId" class="btn btn-warning" style="font-family: 'Cabin', sans-serif; background-color: #dfa974; border-color: #dfa974; color: white;" id="btn-edit-tour">
                    <i class="fa fa-pencil"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary" style="font-family: 'Cabin', sans-serif;" id="btn-back-to-list">
                    <i class="fa fa-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Left: Info -->
    <div class="col-md-7">
        <div class="card-box shadow-sm mb-4" style="border-top: 4px solid #dfa974;">
            <div class="mb-3" style="font-family: 'Lora', serif; font-size: 18px; font-weight: bold; color: #1a1a1a;">Tour Information</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Tour Name</dt>
                    <dd class="col-sm-8"><strong>@Html.DisplayFor(model => model.TourName)</strong></dd>

                    <dt class="col-sm-4 text-muted">Description</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(Model?.Description))
                        {
                            @Html.DisplayFor(model => model.Description)
                        }
                        else
                        {
                            <em class="text-muted">No description provided.</em>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Price</dt>
                    <dd class="col-sm-8">
                        <span class="badge badge-success" style="font-size:14px;">
                            @(Model?.Price?.ToString("N0")) ₫
                        </span>
                    </dd>

                    <dt class="col-sm-4 text-muted">Max Capacity</dt>
                    <dd class="col-sm-8">
                        <span class="badge badge-info">@(Model?.MaxCapacity) pax</span>
                    </dd>

                    <dt class="col-sm-4 text-muted">Duration</dt>
                    <dd class="col-sm-8">@(Model?.DurationHours) hours</dd>

                    <dt class="col-sm-4 text-muted">Location</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model?.Location))
                        {
                            <i class="fa fa-map-marker text-danger"></i> @Model.Location
                        }
                        else
                        {
                            <em class="text-muted">Not specified</em>
                        }
                    </dd>


                </dl>
            </div>
        </div>

        <!-- Schedules summary -->
        @if (Model?.TourSchedules != null && Model.TourSchedules.Any())
        {
            <div class="card-box shadow-sm" style="border-top: 4px solid #17a2b8;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span style="font-family: 'Lora', serif; font-size: 18px; font-weight: bold; color: #1a1a1a;"><i class="fa fa-calendar mr-2" style="color: #17a2b8;"></i> Tour Schedules</span>
                    <span class="badge badge-warning">@Model.TourSchedules.Count</span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Schedule ID</th>
                                <th>Start Date</th>
                                <th>Available Slots</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in Model.TourSchedules)
                            {
                                <tr>
                                    <td>#@schedule.ScheduleId</td>
                                    <td>@schedule.TourDate?.ToString("dd/MM/yyyy") @schedule.StartTime?.ToString(@"hh\:mm")</td>
                                    <td>@schedule.AvailableSlots</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Right: Image -->
    <div class="col-md-5">
        <div class="card-box shadow-sm" style="border-top: 4px solid #dfa974;">
            <div class="mb-3" style="font-family: 'Lora', serif; font-size: 18px; font-weight: bold; color: #1a1a1a;">Tour Image</div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.TourName"
                         class="img-fluid rounded" style="max-height:300px;object-fit:cover;" />
                }
                else
                {
                    <div class="text-muted py-5">
                        <i class="fa fa-image fa-3x mb-2"></i><br/>
                        <small>No image available</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
