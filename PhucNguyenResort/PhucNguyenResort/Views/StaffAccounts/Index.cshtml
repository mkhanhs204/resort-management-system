@model IEnumerable<PhucNguyenResort.Models.User>

@{
    ViewData["Title"] = "Quản Lý Tài Khoản Người Dùng";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title { font-family: 'Playfair Display', serif; font-size: 36px; font-weight: 700; color: #805528; margin-bottom: 4px; }
        .page-subtitle { font-family: 'Inter', sans-serif; color: #50453b; font-size: 16px; margin-bottom: 32px; }
        .btn-luxury { background-color: #dfa974; color: #633d11; font-family: 'Inter', sans-serif; font-weight: 600; border-radius: 8px; padding: 10px 24px; border: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s ease; text-decoration: none; }
        .btn-luxury:hover { background-color: #805528; color: #ffffff; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2); text-decoration: none; }
        .table-luxury { background: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08); border: 1px solid rgba(212, 195, 182, 0.3); font-family: 'Inter', sans-serif; margin-bottom: 24px; }
        .table-luxury table { width: 100%; border-collapse: collapse; margin-bottom: 0; }
        .table-luxury th { background-color: #fcf9f5; color: #805528; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; padding: 16px 24px; border-bottom: 2px solid rgba(212, 195, 182, 0.3); text-align: left; }
        .table-luxury td { padding: 16px 24px; border-bottom: 1px solid #f0ede9; color: #1c1c1a; font-size: 15px; vertical-align: middle; }
        .table-luxury tbody tr:hover { background-color: #faf8f5; }
        .table-luxury tbody tr:last-child td { border-bottom: none; }
        
        .action-btn { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 8px; margin-right: 8px; transition: all 0.2s; color: #50453b; background-color: #f0ede9; text-decoration: none; border: none; }
        .action-btn:hover { text-decoration: none; }
        .action-btn.edit:hover { background-color: #dfa974; color: #ffffff; }
        .action-btn.block:hover { background-color: #ba1a1a; color: #ffffff; }
        .action-btn.unblock:hover { background-color: #0b5c2d; color: #ffffff; }
        
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; font-size: 20px; }
        
        .status-badge { display: inline-flex; align-items: center; padding: 6px 12px; border-radius: 20px; font-size: 13px; font-weight: 600; }
        .status-badge.verified { background-color: #e2f5ea; color: #0b5c2d; }
        .status-badge.unverified { background-color: #fff8e6; color: #946c00; }
        .status-badge.blocked { background-color: #ffdad6; color: #ba1a1a; margin-top: 4px; }
        
        .role-badge { display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 13px; font-weight: 500; background-color: #f0ede9; color: #50453b; }
    </style>
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h2 class="page-title">@ViewData["Title"]</h2>
        <p class="page-subtitle" style="margin-bottom: 0;">Quản lý và cấp quyền cho nhân viên</p>
    </div>
    <a asp-action="Create" class="btn-luxury">
        <span class="material-symbols-outlined">person_add</span> Tạo Tài Khoản Mới
    </a>
</div>

<div class="luxury-card mb-4" style="background: #ffffff; border-radius: 16px; box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08); border: 1px solid rgba(212, 195, 182, 0.3); padding: 24px;">
    <form asp-action="Index" method="get">
        <div class="row align-items-end">
            <div class="col-md-3 mb-3 mb-md-0">
                <label style="font-size: 13px; font-weight: 600; color: #827569; margin-bottom: 8px; display: block;">Tìm theo tên/email</label>
                <div class="input-group-luxury" style="display: flex; align-items: center; background: #f6f3ef; border-radius: 8px; padding: 2px 12px; border: 1px solid transparent;">
                    <span class="material-symbols-outlined" style="color: #827569; font-size: 20px;">search</span>
                    <input type="text" name="name" value="@ViewBag.CurrentName" style="border: none; background: transparent; outline: none; padding: 6px; width: 100%;" placeholder="Nhập tên..." />
                </div>
            </div>
            <div class="col-md-3 mb-3 mb-md-0">
                <label style="font-size: 13px; font-weight: 600; color: #827569; margin-bottom: 8px; display: block;">Vai trò</label>
                <div class="input-group-luxury" style="display: flex; align-items: center; background: #f6f3ef; border-radius: 8px; padding: 2px 12px; border: 1px solid transparent;">
                    <span class="material-symbols-outlined" style="color: #827569; font-size: 20px;">badge</span>
                    <select name="roleId" asp-items="@ViewBag.RoleId" style="border: none; background: transparent; outline: none; padding: 6px; width: 100%;">
                        <option value="">Tất cả vai trò</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3 mb-3 mb-md-0">
                <label style="font-size: 13px; font-weight: 600; color: #827569; margin-bottom: 8px; display: block;">Trạng thái</label>
                <div class="input-group-luxury" style="display: flex; align-items: center; background: #f6f3ef; border-radius: 8px; padding: 2px 12px; border: 1px solid transparent;">
                    <span class="material-symbols-outlined" style="color: #827569; font-size: 20px;">filter_list</span>
                    <select name="status" style="border: none; background: transparent; outline: none; padding: 6px; width: 100%;">
                        <option value="">Tất cả trạng thái</option>
                        <option value="verified" selected="@(ViewBag.CurrentStatus == "verified")">Đang hoạt động</option>
                        <option value="blocked" selected="@(ViewBag.CurrentStatus == "blocked")">Bị khóa</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3 d-flex" style="gap: 12px;">
                <button type="submit" class="btn-luxury" style="padding: 6px 20px; height: 36px; display: flex; align-items: center; font-size: 14px;">
                    <span class="material-symbols-outlined" style="font-size: 18px; margin-right: 4px;">filter_alt</span> Lọc
                </button>
                <a asp-action="Index" class="btn-luxury" style="padding: 6px 20px; height: 36px; background-color: transparent; border: 1px solid #d4c3b6; color: #50453b; display: flex; align-items: center; font-size: 14px; text-decoration: none;">
                    <span class="material-symbols-outlined" style="font-size: 18px; margin-right: 4px;">restart_alt</span> Xóa
                </a>
            </div>
        </div>
    </form>
</div>

@if (TempData["SuccessMessage"] != null)
{
    var messageType = TempData["MessageType"]?.ToString() ?? "success";
    var bgColor = messageType == "danger" ? "#ffdad6" : "#e2f5ea";
    var textColor = messageType == "danger" ? "#ba1a1a" : "#0b5c2d";
    var borderColor = messageType == "danger" ? "#f4c6c2" : "#c6e9d6";
    var iconName = messageType == "danger" ? "lock" : "check_circle";

    <div class="alert alert-dismissible fade show mb-4" role="alert" style="background-color: @bgColor; color: @textColor; border: 1px solid @borderColor; border-radius: 8px; font-family: 'Inter', sans-serif;">
        <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 8px;">@iconName</span>
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close" style="background: none; border: none; font-size: 20px; float: right; color: @textColor; opacity: 0.5;">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="table-luxury">
    <table>
        <thead>
            <tr>
                <th>Họ và Tên</th>
                <th>Email</th>
                <th>Số Điện Thoại</th>
                <th>Vai Trò</th>
                <th>Trạng Thái</th>
                <th style="text-align: right;">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="font-weight: 600;">@item.FullName</td>
                    <td style="color: #50453b;">@item.Email</td>
                    <td style="color: #50453b;">@(item.PhoneNumber ?? "Chưa có")</td>
                    <td>
                        <span class="role-badge">@item.Role?.RoleName</span>
                    </td>
                    <td>
                        <div style="display: flex; align-items: center;">
                            @if (item.IsBlocked)
                            {
                                <span class="status-badge blocked" style="margin-top: 0;">Bị khóa</span>
                            }
                            else if (item.IsActive)
                            {
                                <span class="status-badge verified">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="status-badge unverified">Chưa xác thực</span>
                            }
                        </div>
                    </td>
                    <td style="text-align: right;">
                        <div style="display: flex; justify-content: flex-end;">
                            <a asp-action="Edit" asp-route-id="@item.UserId" class="action-btn edit" title="Chỉnh sửa">
                                <span class="material-symbols-outlined">edit</span>
                            </a>
                            
                            <form asp-action="ToggleBlockStatus" asp-route-id="@item.UserId" method="post" style="display: inline-block; margin: 0;">
                                @if (!item.IsBlocked)
                                {
                                    <button type="submit" class="action-btn block" onclick="return confirm('Bạn có chắc chắn muốn KHÓA tài khoản này không?');" title="Khóa tài khoản">
                                        <span class="material-symbols-outlined">lock</span>
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="action-btn unblock" onclick="return confirm('Bạn có chắc chắn muốn MỞ KHÓA tài khoản này không?');" title="Mở khóa tài khoản">
                                        <span class="material-symbols-outlined">lock_open</span>
                                    </button>
                                }
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (ViewBag.TotalPages > 1)
{
    var currentRole = Context.Request.Query["roleId"].ToString();
    <div class="mt-4 d-flex justify-content-center">
        <nav>
            <ul class="pagination" style="gap: 5px;">
                <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" style="border-radius: 8px; color: #805528; border-color: #d4c3b6;" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, name = ViewBag.CurrentName, roleId = currentRole, status = ViewBag.CurrentStatus })">Trước</a>
                </li>
                
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    if (i == 1 || i == ViewBag.TotalPages || (i >= ViewBag.CurrentPage - 2 && i <= ViewBag.CurrentPage + 2))
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" style="border-radius: 8px; @(i == ViewBag.CurrentPage ? "background-color: #dfa974; border-color: #dfa974; color: white;" : "color: #805528; border-color: #d4c3b6;")" href="@Url.Action("Index", new { page = i, name = ViewBag.CurrentName, roleId = currentRole, status = ViewBag.CurrentStatus })">@i</a>
                        </li>
                    }
                    else if (i == ViewBag.CurrentPage - 3 || i == ViewBag.CurrentPage + 3)
                    {
                        <li class="page-item disabled"><span class="page-link" style="border-radius: 8px; color: #805528; border-color: #d4c3b6;">...</span></li>
                    }
                }
                
                <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" style="border-radius: 8px; color: #805528; border-color: #d4c3b6;" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, name = ViewBag.CurrentName, roleId = currentRole, status = ViewBag.CurrentStatus })">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
}
