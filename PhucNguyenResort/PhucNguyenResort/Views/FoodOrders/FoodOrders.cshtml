@using PhucNguyenResort.Enums
@model IEnumerable<PhucNguyenResort.ViewModels.FoodOrders.FoodOrderDetailViewModel>
@{
    ViewData["Title"] = "Quản lý Đơn Gọi Món";
    Layout = "_DashboardLayout";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b;
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 32px;
            margin-bottom: 30px;
        }
        .luxury-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        .luxury-table thead th {
            background-color: #f6f3ef;
            color: #50453b;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 16px;
            border: none;
        }
        .luxury-table thead th:first-child { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
        .luxury-table thead th:last-child { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
        .luxury-table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-bottom: 1px solid #f0ede9;
            color: #1c1c1a;
            font-size: 14px;
        }
        .luxury-table tbody tr:last-child td { border-bottom: none; }
        .luxury-table tbody tr:hover { background-color: #fcf9f5; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .material-symbols-outlined.fill {
            font-variation-settings: 'FILL' 1;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        .btn-luxury {
            background-color: #dfa974;
            color: #633d11;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 8px 16px;
            border: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all 0.3s ease;
            text-decoration: none;
            font-size: 13px;
        }
        .btn-luxury:hover {
            background-color: #805528;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2);
            text-decoration: none;
        }
        .btn-luxury.success {
            background-color: #e2f5ea;
            color: #0b5c2d;
        }
        .btn-luxury.success:hover {
            background-color: #0b5c2d;
            color: #ffffff;
        }
        .btn-luxury.danger {
            background-color: #ffdad6;
            color: #ba1a1a;
        }
        .btn-luxury.danger:hover {
            background-color: #ba1a1a;
            color: #ffffff;
        }
        .btn-luxury.warning {
            background-color: #f6e6cd;
            color: #805528;
        }
        .btn-luxury.warning:hover {
            background-color: #e5b875;
            color: #633d11;
        }
        .btn-secondary-luxury {
            background-color: #f0ede9;
            color: #50453b;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 8px 16px;
            border: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all 0.3s ease;
            text-decoration: none;
            font-size: 13px;
        }
        .btn-secondary-luxury:hover {
            background-color: #e5e2de;
            color: #1c1c1a;
            text-decoration: none;
        }
        .btn-secondary-luxury:disabled {
            background-color: #e5e2de;
            color: #a4b5ce;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        .luxury-badge {
            background-color: #f0ede9;
            color: #50453b;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 12px;
            display: inline-block;
        }
        .luxury-badge.success { background-color: #e2f5ea; color: #0b5c2d; }
        .luxury-badge.warning { background-color: #fff4ce; color: #7a5900; }
        .luxury-badge.danger { background-color: #ffdad6; color: #ba1a1a; }
        .luxury-badge.info { background-color: #d3e4fe; color: #0b1c30; }
        
        .luxury-alert {
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: 'Inter', sans-serif;
            border: none;
        }
        .luxury-alert.success { background-color: #e2f5ea; color: #0b5c2d; }
        .luxury-alert.error { background-color: #ffdad6; color: #93000a; }

        /* Timeline styles */
        .timeline-container { display: flex; align-items: center; justify-content: space-between; position: relative; width: 100%; margin-bottom: 10px; }
        .timeline-line { position: absolute; top: 50%; left: 0; right: 0; height: 4px; background-color: #f0ede9; z-index: 1; transform: translateY(-50%); border-radius: 2px; }
        .timeline-line-fill { position: absolute; top: 50%; left: 0; height: 4px; background-color: #805528; z-index: 2; transform: translateY(-50%); transition: width 0.3s ease; border-radius: 2px; }
        .timeline-step { position: relative; z-index: 3; background-color: #ffffff; border: 4px solid #f0ede9; border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; }
        .timeline-step.active, .timeline-step.completed { border-color: #805528; background-color: #805528; color: white; }
        .timeline-label { font-size: 11px; position: absolute; top: 28px; white-space: nowrap; color: #827569; font-weight: 600; font-family: 'Inter', sans-serif; }
        .timeline-step.active .timeline-label, .timeline-step.completed .timeline-label { color: #805528; }
        .step-pending { left: 0%; transform: translateX(-50%); }
        .step-cooking { left: 50%; transform: translateX(-50%); }
        .step-delivered { left: 100%; transform: translateX(-50%); }
    </style>
}

<div class="header-container">
    <div>
        <h2 class="page-title">
            <span class="material-symbols-outlined" style="font-size: 36px;">receipt_long</span> Quản lý Đơn Gọi Món
        </h2>
        <p class="page-subtitle">Theo dõi đơn gọi món phục vụ phòng và phục vụ bàn.</p>
    </div>
</div>

<div class="row" id="food-orders-section">
    <div class="col-lg-12">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="luxury-alert success">
                <span class="material-symbols-outlined fill">check_circle</span>
                <div>@TempData["SuccessMessage"]</div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="luxury-alert error">
                <span class="material-symbols-outlined fill">error</span>
                <div>@TempData["ErrorMessage"]</div>
            </div>
        }
        
        <div class="luxury-card">
            <div class="table-responsive">
                <table class="luxury-table">
                    <thead>
                        <tr>
                            <th>Đơn hàng</th>
                            <th>Vị trí Phục vụ</th>
                            <th>Món ăn</th>
                            <th>Bếp</th>
                            <th width="250">Trạng thái Đơn</th>
                            <th class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 40px; color: #827569;">
                                    <div style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
                                        <span class="material-symbols-outlined" style="font-size: 48px; color: #d4c3b6;">inbox</span>
                                        <div>Không tìm thấy đơn gọi món nào.</div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var order in Model)
                            {
                                var isTableService = order.OrderType == FoodOrderType.TableService;
                                var locationLabel = isTableService
                                    ? $"Bàn {(string.IsNullOrWhiteSpace(order.TableNumber) ? "N/A" : order.TableNumber)}"
                                    : $"Phòng {(string.IsNullOrWhiteSpace(order.RoomNumber) ? "N/A" : order.RoomNumber)}";
                                var locationDetail = isTableService
                                    ? order.TableName
                                    : order.CustomerName;
                                var typeBadge = isTableService ? "info" : "warning";

                                <tr>
                                    <td>
                                        <strong style="color: #1c1c1a;">#@order.FoodOrderId</strong><br />
                                        <small style="color: #827569;">@order.OrderedAt.ToString("HH:mm dd/MM")</small><br />
                                        <span class="luxury-badge @typeBadge" style="margin-top: 4px;">@order.OrderType</span>
                                    </td>
                                    <td>
                                        <strong style="color: #1c1c1a;">@locationLabel</strong><br />
                                        <small style="color: #50453b;">@locationDetail</small>
                                        @if (!string.IsNullOrWhiteSpace(order.CustomerNote))
                                        {
                                            <div style="font-size: 12px; margin-top: 6px; background: #fcf9f5; border-left: 2px solid #805528; padding: 4px 8px; color: #50453b;">
                                                <strong style="color: #1c1c1a;">Ghi chú:</strong> @order.CustomerNote
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <ul style="list-style: none; padding: 0; margin: 0; font-size: 13px; color: #1c1c1a;">
                                            @foreach (var item in order.Items.Take(2))
                                            {
                                                <li style="margin-bottom: 4px;">
                                                    <span style="font-weight: 600;">@item.Quantity</span> x @item.ItemName
                                                    @if (!string.IsNullOrWhiteSpace(item.ItemNote))
                                                    {
                                                        <div style="font-size: 12px; color: #827569; font-style: italic; padding-left: 12px; display: flex; align-items: center; gap: 4px;">
                                                            <span class="material-symbols-outlined" style="font-size: 14px;">format_quote</span> @item.ItemNote
                                                        </div>
                                                    }
                                                </li>
                                            }
                                            @if (order.Items.Count > 2)
                                            {
                                                <li style="color: #827569; font-style: italic; margin-top: 4px;">+ @(order.Items.Count - 2) món khác...</li>
                                            }
                                        </ul>
                                    </td>
                                    <td>
                                        @if (order.KitchenStatus == KotStatus.Pending)
                                        {
                                            <span class="luxury-badge warning"><span class="material-symbols-outlined" style="font-size: 14px; vertical-align: text-bottom;">schedule</span> Chờ xử lý</span>
                                        }
                                        else if (order.KitchenStatus == KotStatus.Cooking)
                                        {
                                            <span class="luxury-badge info"><span class="material-symbols-outlined" style="font-size: 14px; vertical-align: text-bottom;">local_fire_department</span> Đang nấu</span>
                                        }
                                        else if (order.KitchenStatus == KotStatus.Ready || order.KitchenStatus == KotStatus.Completed)
                                        {
                                            <span class="luxury-badge success"><span class="material-symbols-outlined fill" style="font-size: 14px; vertical-align: text-bottom;">check_circle</span> Đã xong</span>
                                        }
                                        else
                                        {
                                            <span class="luxury-badge">@order.KitchenStatus</span>
                                        }
                                    </td>
                                    <td>
                                        @if (order.OrderStatus == FoodOrderStatus.Cancelled)
                                        {
                                            <div style="text-align: center;">
                                                <span class="luxury-badge danger" style="padding: 6px 16px; font-size: 13px;">Đã hủy</span>
                                            </div>
                                        }
                                        else
                                        {
                                            var fillWidth = "0%";
                                            if (order.OrderStatus == FoodOrderStatus.Cooking) fillWidth = "50%";
                                            if (order.OrderStatus == FoodOrderStatus.Delivered) fillWidth = "100%";

                                            <div style="padding: 12px 16px;">
                                                <div class="timeline-container">
                                                    <div class="timeline-line"></div>
                                                    <div class="timeline-line-fill" style="width: @fillWidth"></div>
                                                    <div class="timeline-step @(order.OrderStatus >= FoodOrderStatus.Pending ? "completed" : "")">
                                                        <span class="timeline-label step-pending">Chờ xử lý</span>
                                                    </div>
                                                    <div class="timeline-step @(order.OrderStatus >= FoodOrderStatus.Cooking ? "completed" : "")">
                                                        <span class="timeline-label step-cooking">Đang nấu</span>
                                                    </div>
                                                    <div class="timeline-step @(order.OrderStatus == FoodOrderStatus.Delivered ? "completed" : "")">
                                                        <span class="timeline-label step-delivered">Đã giao</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-right">
                                        <form asp-controller="Dashboard" asp-action="UpdateFoodOrderStatus" method="post" style="display: inline-block;">
                                            <input type="hidden" name="foodOrderId" value="@order.FoodOrderId" />
                                            @if (order.OrderStatus == FoodOrderStatus.Pending)
                                            {
                                                <input type="hidden" name="newStatus" value="@FoodOrderStatus.Cooking" />
                                                <button type="submit" class="btn-luxury"><span class="material-symbols-outlined" style="font-size: 18px;">play_arrow</span> Bắt đầu nấu</button>
                                            }
                                            else if (order.OrderStatus == FoodOrderStatus.Cooking)
                                            {
                                                var isKotReady = order.KitchenStatus == KotStatus.Ready || order.KitchenStatus == KotStatus.Completed;
                                                <input type="hidden" name="newStatus" value="@FoodOrderStatus.Delivered" />
                                                <button type="submit" class="btn-luxury success" @(isKotReady ? "" : "disabled title='Bếp chưa báo món ăn đã hoàn thành'")><span class="material-symbols-outlined" style="font-size: 18px;">local_shipping</span> Đánh dấu đã giao</button>
                                            }
                                            else if (order.OrderStatus == FoodOrderStatus.Delivered)
                                            {
                                                if (isTableService)
                                                {
                                                    <a asp-controller="TableFoodOrders" asp-action="Checkout" asp-route-reservationId="@order.TableReservationId" class="btn-luxury warning">
                                                        <span class="material-symbols-outlined" style="font-size: 18px;">credit_card</span> Thanh toán Bàn
                                                    </a>
                                                }
                                                else if (!order.IsChargedToRoom)
                                                {
                                                    <button type="submit" asp-action="ChargeFoodOrderToRoom" class="btn-luxury warning" title="Ghi nhận vào chi phí phòng"><span class="material-symbols-outlined" style="font-size: 18px;">payments</span> Ghi nhận vào phòng</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn-secondary-luxury" disabled title="Đã ghi nhận lúc @order.ChargedAt?.ToString("HH:mm")"><span class="material-symbols-outlined fill" style="font-size: 18px;">check_circle</span> Đã ghi nhận</button>
                                                }
                                            }
                                        </form>
                                        @if (order.OrderStatus == FoodOrderStatus.Pending)
                                        {
                                            <form asp-controller="Dashboard" asp-action="UpdateFoodOrderStatus" method="post" style="display: inline-block; margin-left: 4px;" onsubmit="return confirm('Hủy đơn hàng này?');">
                                                <input type="hidden" name="foodOrderId" value="@order.FoodOrderId" />
                                                <input type="hidden" name="newStatus" value="@FoodOrderStatus.Cancelled" />
                                                <button type="submit" class="btn-luxury danger" title="Hủy đơn" style="padding: 8px;"><span class="material-symbols-outlined" style="font-size: 18px;">close</span></button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
