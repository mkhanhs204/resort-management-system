@using PhucNguyenResort.Enums
@model IEnumerable<PhucNguyenResort.ViewModels.FoodOrders.FoodOrderDetailViewModel>
@{
    ViewData["Title"] = "Manage Food Orders";
    Layout = "_DashboardLayout";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center" style="border-bottom: 2px solid #eee; padding-bottom: 15px;">
            <div>
                <h2 style="font-family: 'Lora', serif; font-weight: bold; color: #1a1a1a; margin-bottom: 5px;">
                    <i class="fa fa-list mr-2" style="color: #007bff;"></i> Manage Food Orders
                </h2>
                <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">Monitor room service and table service food orders.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline-container { display: flex; align-items: center; justify-content: space-between; position: relative; width: 100%; margin-bottom: 10px; }
    .timeline-line { position: absolute; top: 50%; left: 0; right: 0; height: 4px; background-color: #e9ecef; z-index: 1; transform: translateY(-50%); }
    .timeline-line-fill { position: absolute; top: 50%; left: 0; height: 4px; background-color: #007bff; z-index: 2; transform: translateY(-50%); transition: width 0.3s ease; }
    .timeline-step { position: relative; z-index: 3; background-color: #fff; border: 4px solid #e9ecef; border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; }
    .timeline-step.active, .timeline-step.completed { border-color: #007bff; background-color: #007bff; color: white; }
    .timeline-label { font-size: 11px; position: absolute; top: 28px; white-space: nowrap; color: #6c757d; font-weight: 600; }
    .timeline-step.active .timeline-label, .timeline-step.completed .timeline-label { color: #007bff; }
    .step-pending { left: 0%; transform: translateX(-50%); }
    .step-cooking { left: 50%; transform: translateX(-50%); }
    .step-delivered { left: 100%; transform: translateX(-50%); }
</style>

<div class="row" id="food-orders-section">
    <div class="col-lg-12">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }
        <div class="card-box" style="border-top: 5px solid #007bff;">
            <div class="table-responsive">
                <table class="table table-hover align-middle" style="font-family: 'Cabin', sans-serif;">
                    <thead class="bg-light">
                        <tr>
                            <th>Order</th>
                            <th>Service Location</th>
                            <th>Items</th>
                            <th>Kitchen</th>
                            <th width="250">Order Status</th>
                            <th class="text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="fa fa-inbox fa-2x mb-2"></i><br />No food orders found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var order in Model)
                            {
                                var isTableService = order.OrderType == FoodOrderType.TableService;
                                var locationLabel = isTableService
                                    ? $"Table {(string.IsNullOrWhiteSpace(order.TableNumber) ? "N/A" : order.TableNumber)}"
                                    : $"Room {(string.IsNullOrWhiteSpace(order.RoomNumber) ? "N/A" : order.RoomNumber)}";
                                var locationDetail = isTableService
                                    ? order.TableName
                                    : order.CustomerName;
                                var typeBadge = isTableService ? "badge-info" : "badge-primary";

                                <tr>
                                    <td>
                                        <strong>#@order.FoodOrderId</strong><br />
                                        <small class="text-muted">@order.OrderedAt.ToString("HH:mm dd/MM")</small><br />
                                        <span class="badge @typeBadge">@order.OrderType</span>
                                    </td>
                                    <td>
                                        <strong>@locationLabel</strong><br />
                                        <small class="text-muted">@locationDetail</small>
                                        @if (!string.IsNullOrWhiteSpace(order.CustomerNote))
                                        {
                                            <div style="font-size: 11px; margin-top: 4px; background: #fffbeb; border-left: 2px solid #d97706; padding: 2px 4px;"><strong>Note:</strong> @order.CustomerNote</div>
                                        }
                                    </td>
                                    <td>
                                        <ul class="list-unstyled mb-0" style="font-size: 13px;">
                                            @foreach (var item in order.Items.Take(2))
                                            {
                                                <li>
                                                    @item.Quantity x @item.ItemName
                                                    @if (!string.IsNullOrWhiteSpace(item.ItemNote))
                                                    {
                                                        <div style="font-size: 11px; color: #6c757d; font-style: italic; padding-left: 10px;">- @item.ItemNote</div>
                                                    }
                                                </li>
                                            }
                                            @if (order.Items.Count > 2)
                                            {
                                                <li class="text-muted font-italic">+ @(order.Items.Count - 2) more...</li>
                                            }
                                        </ul>
                                    </td>
                                    <td>
                                        @if (order.KitchenStatus == KotStatus.Pending)
                                        {
                                            <span class="badge badge-warning"><i class="fa fa-clock-o"></i> Pending</span>
                                        }
                                        else if (order.KitchenStatus == KotStatus.Cooking)
                                        {
                                            <span class="badge badge-info"><i class="fa fa-fire"></i> Cooking</span>
                                        }
                                        else if (order.KitchenStatus == KotStatus.Ready || order.KitchenStatus == KotStatus.Completed)
                                        {
                                            <span class="badge badge-success"><i class="fa fa-check"></i> Ready</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">@order.KitchenStatus</span>
                                        }
                                    </td>
                                    <td>
                                        @if (order.OrderStatus == FoodOrderStatus.Cancelled)
                                        {
                                            <span class="badge badge-danger w-100 py-2">Cancelled</span>
                                        }
                                        else
                                        {
                                            var fillWidth = "0%";
                                            if (order.OrderStatus == FoodOrderStatus.Cooking) fillWidth = "50%";
                                            if (order.OrderStatus == FoodOrderStatus.Delivered) fillWidth = "100%";

                                            <div class="px-3 pb-3 pt-1">
                                                <div class="timeline-container">
                                                    <div class="timeline-line"></div>
                                                    <div class="timeline-line-fill" style="width: @fillWidth"></div>
                                                    <div class="timeline-step @(order.OrderStatus >= FoodOrderStatus.Pending ? "completed" : "")">
                                                        <span class="timeline-label step-pending">Pending</span>
                                                    </div>
                                                    <div class="timeline-step @(order.OrderStatus >= FoodOrderStatus.Cooking ? "completed" : "")">
                                                        <span class="timeline-label step-cooking">Cooking</span>
                                                    </div>
                                                    <div class="timeline-step @(order.OrderStatus == FoodOrderStatus.Delivered ? "completed" : "")">
                                                        <span class="timeline-label step-delivered">Delivered</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-right">
                                        <form asp-controller="Dashboard" asp-action="UpdateFoodOrderStatus" method="post" class="d-inline">
                                            <input type="hidden" name="foodOrderId" value="@order.FoodOrderId" />
                                            @if (order.OrderStatus == FoodOrderStatus.Pending)
                                            {
                                                <input type="hidden" name="newStatus" value="@FoodOrderStatus.Cooking" />
                                                <button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-play mr-1"></i> Start Cooking</button>
                                            }
                                            else if (order.OrderStatus == FoodOrderStatus.Cooking)
                                            {
                                                var isKotReady = order.KitchenStatus == KotStatus.Ready || order.KitchenStatus == KotStatus.Completed;
                                                <input type="hidden" name="newStatus" value="@FoodOrderStatus.Delivered" />
                                                <button type="submit" class="btn btn-sm btn-success" @(isKotReady ? "" : "disabled title='Kitchen has not marked this order ready yet'")><i class="fa fa-truck mr-1"></i> Mark Delivered</button>
                                            }
                                            else if (order.OrderStatus == FoodOrderStatus.Delivered)
                                            {
                                                if (isTableService)
                                                {
                                                    <a asp-controller="TableFoodOrders" asp-action="Checkout" asp-route-reservationId="@order.TableReservationId" class="btn btn-sm btn-outline-warning font-weight-bold">
                                                        <i class="fa fa-credit-card mr-1"></i> Table Checkout
                                                    </a>
                                                }
                                                else if (!order.IsChargedToRoom)
                                                {
                                                    <button type="submit" asp-action="ChargeFoodOrderToRoom" class="btn btn-sm btn-warning font-weight-bold" title="Charge to room bill"><i class="fa fa-money mr-1"></i> Charge Room</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-secondary" disabled title="Charged at @order.ChargedAt?.ToString("HH:mm")"><i class="fa fa-check-circle mr-1"></i> Charged</button>
                                                }
                                            }
                                        </form>
                                        @if (order.OrderStatus == FoodOrderStatus.Pending)
                                        {
                                            <form asp-controller="Dashboard" asp-action="UpdateFoodOrderStatus" method="post" class="d-inline ml-1" onsubmit="return confirm('Cancel this order?');">
                                                <input type="hidden" name="foodOrderId" value="@order.FoodOrderId" />
                                                <input type="hidden" name="newStatus" value="@FoodOrderStatus.Cancelled" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="Cancel order"><i class="fa fa-times"></i></button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
