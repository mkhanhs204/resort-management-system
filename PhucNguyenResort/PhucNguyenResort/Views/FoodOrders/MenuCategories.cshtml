@model PhucNguyenResort.ViewModels.FoodOrders.MenuCategoryBrowseViewModel

@{
    ViewData["Title"] = "Room Service";
}

<div class="rs-page">
    <div class="rs-container">

        @* -- Booking Info Bar -- *@
        @if (Model.BookingId > 0)
        {
            <div class="rs-booking-bar">
                <div class="booking-info">
                    <span class="room-badge"><i class="fa fa-bed"></i> Room @Model.RoomNumber</span>
                    <span class="booking-id">Booking #@Model.BookingId · @Model.CustomerName</span>
                </div>
                <div class="booking-actions">
                    <a asp-action="MyOrders" class="rs-btn rs-btn-outline rs-btn-sm">
                        <i class="fa fa-list"></i> My Orders
                    </a>
                </div>
            </div>
        }

        @* -- Hero Section -- *@
        <div class="rs-hero">
            <h1>Room <span>Service</span></h1>
            <p>Explore our curated dining experience, delivered straight to your room</p>
        </div>

        @* -- Messages -- *@
        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="rs-alert rs-alert-info">
                <i class="fa fa-info-circle"></i> @Model.Message
            </div>
        }

        @* -- Category Cards Grid -- *@
        @if (Model.Categories.Any())
        {
            <div class="rs-categories-grid">
                @foreach (var category in Model.Categories)
                {
                    <a asp-action="OrderMenu"
                       asp-route-bookingId="@(Model.BookingId > 0 ? Model.BookingId : null)"
                       asp-route-categoryId="@category.CategoryId"
                       class="rs-category-card" id="category-card-@category.CategoryId">
                        @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                        {
                            <img src="@category.ImageUrl" alt="@category.CategoryName"
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                            <div class="no-image-placeholder" style="display:none;">
                                <i class="fa fa-cutlery"></i>
                            </div>
                        }
                        else
                        {
                            <div class="no-image-placeholder">
                                <i class="fa fa-cutlery"></i>
                            </div>
                        }
                        <div class="card-overlay">
                            <h3>@category.CategoryName</h3>
                            <span class="item-count">@category.ItemCount item@(category.ItemCount != 1 ? "s" : "")</span>
                        </div>
                    </a>
                }
            </div>

            @* -- View Full Menu Button -- *@
            <div class="rs-view-full-menu">
                <a asp-action="OrderMenu"
                   asp-route-bookingId="@(Model.BookingId > 0 ? Model.BookingId : null)"
                   class="rs-btn rs-btn-primary" id="view-full-menu-btn">
                    <i class="fa fa-th-large"></i> View Full Menu
                </a>
            </div>
        }
        else
        {
            <div class="rs-empty-state">
                <div class="empty-icon"><i class="fa fa-cutlery"></i></div>
                <h3>No Menu Available</h3>
                <p>Our kitchen is currently not serving. Please check back later.</p>
            </div>
        }

        @* -- Bottom Navigation -- *@
        <div class="rs-bottom-nav">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-action="MyOrders">
                    <i class="fa fa-clock-o"></i> My Orders
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">
                    <i class="fa fa-sign-in"></i> Sign in to order
                </a>
            }
        </div>

    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/room-service.css" />
}
