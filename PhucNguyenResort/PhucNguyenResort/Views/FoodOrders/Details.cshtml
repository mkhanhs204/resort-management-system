        @model PhucNguyenResort.ViewModels.FoodOrders.FoodOrderDetailViewModel

@{
    ViewData["Title"] = "Food Order Details";
}

<div class="container my-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Food Order #@Model.FoodOrderId</h1>
        <a asp-action="RoomService" asp-route-bookingId="@Model.BookingId" class="btn btn-outline-secondary">Back to room service order</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Booking</dt>
                <dd class="col-sm-9">#@Model.BookingId - @Model.CustomerName - Room @Model.RoomNumber</dd>

                <dt class="col-sm-3">Order status</dt>
                <dd class="col-sm-9">@Model.OrderStatus</dd>

                <dt class="col-sm-3">Kitchen status</dt>
                <dd class="col-sm-9">@(Model.KitchenStatus?.ToString() ?? "Pending")</dd>

                <dt class="col-sm-3">Ordered at</dt>
                <dd class="col-sm-9">@Model.OrderedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                <dt class="col-sm-3">Total amount</dt>
                <dd class="col-sm-9">@Model.TotalAmount.ToString("N0") VND</dd>
            </dl>
        </div>
    </div>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Item</th>
                <th>Category</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Unit price</th>
                <th class="text-end">Line total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ItemName</td>
                    <td>@item.CategoryName</td>
                    <td class="text-end">@item.Quantity</td>
                    <td class="text-end">@item.UnitPrice.ToString("N0") VND</td>
                    <td class="text-end">@item.LineTotal.ToString("N0") VND</td>
                </tr>
            }
        </tbody>
    </table>
</div>
