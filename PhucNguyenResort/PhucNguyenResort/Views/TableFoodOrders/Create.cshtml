@model PhucNguyenResort.ViewModels.TableFoodOrders.TableFoodOrderCreateViewModel
@{
    ViewData["Title"] = "Create Table Food Order";
    Layout = "_DashboardLayout";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <div class="d-flex justify-content-between align-items-center" style="border-bottom: 2px solid #eee; padding-bottom: 15px;">
            <div>
                <h2 style="font-family: 'Lora', serif; font-weight: bold; color: #1a1a1a; margin-bottom: 5px;">
                    <i class="fa fa-cutlery mr-2" style="color: #007bff;"></i> Create Table Food Order
                </h2>
                <p class="text-muted mb-0" style="font-family: 'Cabin', sans-serif;">
                    @Model.ReservationCode - @Model.TableName (@Model.TableNumber) - Party @Model.PartySize
                </p>
            </div>
            <div>
                <a asp-action="ByReservation" asp-route-reservationId="@Model.ReservationId" class="btn btn-outline-primary mr-2">
                    <i class="fa fa-list mr-1"></i> Orders
                </a>
                <a asp-controller="Dashboard" asp-action="TableReservations" class="btn btn-outline-secondary">
                    <i class="fa fa-arrow-left mr-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="ReservationId" type="hidden" />
    <input asp-for="ReservationCode" type="hidden" />
    <input asp-for="TableName" type="hidden" />
    <input asp-for="TableNumber" type="hidden" />
    <input asp-for="PartySize" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card-box mb-4" style="border-left: 5px solid #007bff;">
        <label asp-for="CustomerNote" class="font-weight-bold">Order note</label>
        <textarea asp-for="CustomerNote" class="form-control" rows="3" maxlength="500" placeholder="Shared note for this table order"></textarea>
        <span asp-validation-for="CustomerNote" class="text-danger"></span>
    </div>

    <div class="card-box" style="border-top: 5px solid #007bff;">
        <div class="table-responsive">
            <table class="table table-hover align-middle" style="font-family: 'Cabin', sans-serif;">
                <thead class="bg-light">
                    <tr>
                        <th>Item</th>
                        <th>Category</th>
                        <th class="text-right">Price</th>
                        <th style="width: 120px;">Qty</th>
                        <th style="width: 260px;">Item note</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No menu items are currently available.</td>
                        </tr>
                    }
                    else
                    {
                        @for (var i = 0; i < Model.Items.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input asp-for="Items[i].MenuItemId" type="hidden" />
                                    <input asp-for="Items[i].ItemName" type="hidden" />
                                    <input asp-for="Items[i].CategoryName" type="hidden" />
                                    <input asp-for="Items[i].ImageUrl" type="hidden" />
                                    <input asp-for="Items[i].Price" type="hidden" />
                                    <strong>@Model.Items[i].ItemName</strong>
                                </td>
                                <td>@Model.Items[i].CategoryName</td>
                                <td class="text-right">@Model.Items[i].Price.ToString("N0") VND</td>
                                <td>
                                    <input asp-for="Items[i].Quantity" type="number" min="0" max="1000" class="form-control form-control-sm" />
                                    <span asp-validation-for="Items[i].Quantity" class="text-danger"></span>
                                </td>
                                <td>
                                    <input asp-for="Items[i].ItemNote" class="form-control form-control-sm" maxlength="500" placeholder="Less spicy, no onion..." />
                                    <span asp-validation-for="Items[i].ItemNote" class="text-danger"></span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="text-right">
            <button type="submit" class="btn btn-primary" @(Model.Items.Any() ? null : "disabled")>
                <i class="fa fa-paper-plane mr-1"></i> Submit Order
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
