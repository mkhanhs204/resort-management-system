@using PhucNguyenResort.Enums
@model IReadOnlyList<PhucNguyenResort.ViewModels.TableFoodOrders.TableFoodOrderListViewModel>
@{
    ViewData["Title"] = "Danh sách Đơn Gọi Món";
    Layout = "_DashboardLayout";
    var checkout = ViewBag.Checkout as PhucNguyenResort.ViewModels.TableFoodOrders.TableFoodOrderCheckoutViewModel;
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .page-title {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: #805528;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .page-subtitle {
            font-family: 'Inter', sans-serif;
            color: #50453b;
            font-size: 16px;
        }
        .luxury-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 40px -8px rgba(30, 41, 59, 0.08);
            border: 1px solid rgba(212, 195, 182, 0.3);
            font-family: 'Inter', sans-serif;
            padding: 32px;
            margin-bottom: 30px;
        }
        .luxury-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        .luxury-table thead th {
            background-color: #f6f3ef;
            color: #50453b;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 16px;
            border: none;
        }
        .luxury-table thead th:first-child { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
        .luxury-table thead th:last-child { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
        .luxury-table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-bottom: 1px solid #f0ede9;
            color: #1c1c1a;
            font-size: 14px;
        }
        .luxury-table tbody tr:last-child td { border-bottom: none; }
        .luxury-table tbody tr:hover { background-color: #fcf9f5; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .material-symbols-outlined.fill {
            font-variation-settings: 'FILL' 1;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
        }
        .btn-luxury {
            background-color: #dfa974;
            color: #633d11;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-luxury:hover {
            background-color: #805528;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(128, 85, 40, 0.2);
            text-decoration: none;
        }
        .btn-luxury.warning {
            background-color: #f6e6cd;
            color: #805528;
        }
        .btn-luxury.warning:hover {
            background-color: #e5b875;
            color: #633d11;
        }
        .btn-secondary-luxury {
            background-color: #f0ede9;
            color: #50453b;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 24px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-secondary-luxury:hover {
            background-color: #e5e2de;
            color: #1c1c1a;
            text-decoration: none;
        }
        .luxury-badge {
            background-color: #f0ede9;
            color: #50453b;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 12px;
            display: inline-block;
        }
        .luxury-badge.success { background-color: #e2f5ea; color: #0b5c2d; }
        .luxury-badge.warning { background-color: #fff4ce; color: #7a5900; }
        .luxury-badge.danger { background-color: #ffdad6; color: #ba1a1a; }
        .luxury-badge.info { background-color: #d3e4fe; color: #0b1c30; }
        
        .luxury-alert {
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: 'Inter', sans-serif;
            border: none;
        }
        .luxury-alert.success { background-color: #e2f5ea; color: #0b5c2d; }
        .luxury-alert.error { background-color: #ffdad6; color: #93000a; }
    </style>
}

<div class="header-container">
    <div>
        <h2 class="page-title">
            <span class="material-symbols-outlined" style="font-size: 36px;">list_alt</span> Danh sách Đơn Gọi Món
        </h2>
        <p class="page-subtitle">
            @checkout?.ReservationCode - @checkout?.TableName (@checkout?.TableNumber) - Số khách: @checkout?.PartySize
        </p>
    </div>
    <div style="display: flex; gap: 12px;">
        <a asp-action="Create" asp-route-reservationId="@checkout?.ReservationId" class="btn-luxury">
            <span class="material-symbols-outlined">add</span> Tạo Đơn Mới
        </a>
        <a asp-action="Checkout" asp-route-reservationId="@checkout?.ReservationId" class="btn-luxury warning">
            <span class="material-symbols-outlined">payments</span> Thanh Toán
        </a>
        <a asp-controller="Dashboard" asp-action="TableReservations" class="btn-secondary-luxury">
            <span class="material-symbols-outlined">arrow_back</span> Quay lại
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="luxury-alert success">
        <span class="material-symbols-outlined fill">check_circle</span>
        <div>@TempData["SuccessMessage"]</div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="luxury-alert error">
        <span class="material-symbols-outlined fill">error</span>
        <div>@TempData["ErrorMessage"]</div>
    </div>
}

<div class="luxury-card">
    <div class="table-responsive">
        <table class="luxury-table">
            <thead>
                <tr>
                    <th>Đơn hàng</th>
                    <th>Thời gian Đặt</th>
                    <th>Trạng thái</th>
                    <th>Bếp</th>
                    <th class="text-right">Tổng tiền</th>
                    <th>Thanh toán</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 40px; color: #827569;">
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
                                <span class="material-symbols-outlined" style="font-size: 48px; color: #d4c3b6;">receipt_long</span>
                                <div>Không tìm thấy đơn gọi món nào.</div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var order in Model)
                    {
                        <tr>
                            <td><strong style="color: #1c1c1a;">#@order.FoodOrderId</strong></td>
                            <td style="color: #50453b;">@order.OrderedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="luxury-badge @(order.OrderStatus == FoodOrderStatus.Cancelled ? "danger" : order.OrderStatus == FoodOrderStatus.Delivered ? "success" : "warning")">
                                    @order.OrderStatus
                                </span>
                            </td>
                            <td style="color: #50453b;">@(order.KitchenStatus?.ToString() ?? "N/A")</td>
                            <td class="text-right" style="font-weight: 500; color: #805528;">@order.TotalAmount.ToString("N0") VND</td>
                            <td>
                                @if (order.IsChargedToRoom)
                                {
                                    <span class="luxury-badge success">Ghi nhận vào phòng</span>
                                }
                                else if (order.IsPaidAtRestaurant)
                                {
                                    <span class="luxury-badge info">Đã thanh toán tại nhà hàng</span>
                                }
                                else
                                {
                                    <span class="luxury-badge">Chưa thanh toán</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
